---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title?: string;
	description?: string;
	ogType?: 'website' | 'article';
	ogImage?: string;
	ogImageAlt?: string;
}

const { title, description, ogType, ogImage, ogImageAlt } = Astro.props;
---

<BaseLayout title={title} description={description} ogType={ogType} ogImage={ogImage} ogImageAlt={ogImageAlt}>
	<slot />
</BaseLayout>
