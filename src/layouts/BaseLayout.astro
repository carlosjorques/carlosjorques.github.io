---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { IDENTITY } from '../data/identity';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${IDENTITY.name} · ${IDENTITY.title}`,
	description = `${IDENTITY.title}. Control intelligence for ${IDENTITY.umbrella} — embedded control software, diagnostics, validation, and production delivery.`,
} = Astro.props;

const siteTitle = title.includes('Carlos Jorques') ? title : `${title} | Carlos Jorques`;
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const basePath = baseUrl.replace(/\/$/, '');
const pathname = Astro.url.pathname.startsWith(basePath)
	? Astro.url.pathname
	: `${basePath}${Astro.url.pathname}`;
const canonical = new URL(pathname, Astro.site ?? Astro.url.origin);
const pageType = (() => {
	const firstSegment = Astro.url.pathname.replace(basePath, '').split('/').filter(Boolean)[0];
	return firstSegment || 'home';
})();
---

<!doctype html>
<html lang="en" data-theme="bright">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(() => {
				try {
					const savedTheme = window.localStorage.getItem('color-theme');
					const theme = savedTheme === 'dark' || savedTheme === 'bright' ? savedTheme : 'bright';
					document.documentElement.dataset.theme = theme;
					document.documentElement.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
				} catch {
					document.documentElement.dataset.theme = 'bright';
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={`${normalizedBase}favicon.svg`} />
		<link rel="icon" href={`${normalizedBase}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<title>{siteTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: IDENTITY.name,
			jobTitle: IDENTITY.title,
			url: canonical.href,
			sameAs: ['https://www.linkedin.com/in/carlosjorques/'],
		})} />
	</head>
	<body data-page-type={pageType}>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-shell">
			<SiteHeader />
			<div class="main-content">
				<main id="main-content" class="main-body">
					<slot />
				</main>
				<SiteFooter />
			</div>
		</div>
		<script is:inline>
			(() => {
				const trackedSelector = '[data-analytics-event]';

				const clean = (value) => {
					if (typeof value !== 'string') return undefined;
					const trimmed = value.trim();
					return trimmed ? trimmed : undefined;
				};

				const getLinkText = (element) =>
					clean(element.dataset.ctaText) ?? clean(element.textContent?.replace(/\s+/g, ' '));

				const buildPayload = (element, extras = {}) => ({
					cta_id: clean(element.dataset.ctaId),
					cta_text: getLinkText(element),
					placement: clean(element.dataset.ctaPlacement),
					page_type: clean(document.body?.dataset.pageType) ?? 'unknown',
					destination: clean(element.dataset.destination) ?? clean(element.getAttribute('href')),
					intent: clean(element.dataset.ctaIntent),
					source_section: clean(element.dataset.sourceSection),
					...extras,
				});

				const track = (eventName, payload = {}) => {
					const event = clean(eventName);
					if (!event) return;

					const detail = { event, ...payload };
					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push(detail);

					if (typeof window.gtag === 'function') {
						window.gtag('event', event, payload);
					}

					window.dispatchEvent(new CustomEvent('portfolio:analytics', { detail }));
				};

				window.trackPortfolioEvent = track;

				document.addEventListener('click', (event) => {
					const target = event.target instanceof Element ? event.target.closest(trackedSelector) : null;
					if (!target) return;
					track(target.dataset.analyticsEvent, buildPayload(target));
				});
			})();
		</script>
	</body>
</html>
