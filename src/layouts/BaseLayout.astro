---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CONTACT_DESTINATIONS, IDENTITY } from '../data/identity';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	ogType?: 'website' | 'article';
	ogImage?: string;
	ogImageAlt?: string;
}

const {
	title = `${IDENTITY.name} · ${IDENTITY.primaryTitle}`,
	description = 'Carlos Jorques is a Control Systems Technical Lead who leads the design and delivery of embedded control software for complex dynamic systems.',
	ogType = 'website',
	ogImage = `${(import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`)}images/og-carlos-jorques.png`,
	ogImageAlt = `${IDENTITY.name}, ${IDENTITY.primaryTitle}: embedded control for complex dynamic systems.`,
} = Astro.props;

const siteTitle = title.includes(IDENTITY.name) ? title : `${title} | ${IDENTITY.name}`;
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pageType = (() => {
	const firstSegment = Astro.url.pathname.split('/').filter(Boolean)[0];
	return firstSegment || 'home';
})();
---

<!doctype html>
<html lang="en" data-theme="bright">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(() => {
				try {
					const savedTheme = window.localStorage.getItem('color-theme');
					const theme = savedTheme === 'dark' || savedTheme === 'bright' ? savedTheme : 'bright';
					document.documentElement.dataset.theme = theme;
					document.documentElement.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
				} catch {
					document.documentElement.dataset.theme = 'bright';
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={`${normalizedBase}favicon.svg`} />
		<link rel="icon" href={`${normalizedBase}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={`Writing by ${IDENTITY.name}`} href={`${normalizedBase}rss.xml`} />
		<title>{siteTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />
		{ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url.origin)} />}
		{ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
		{ogImage && <meta name="twitter:card" content="summary_large_image" />}
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			'@id': new URL('/#person', Astro.site ?? Astro.url.origin).href,
			name: IDENTITY.name,
			jobTitle: IDENTITY.primaryTitle,
			alternateName: IDENTITY.secondaryDescriptors,
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Valencia',
				addressCountry: 'ES',
			},
			url: new URL('/', Astro.site ?? Astro.url.origin).href,
			sameAs: [CONTACT_DESTINATIONS.linkedin],
			worksFor: { '@type': 'Organization', name: 'ALTEN', url: 'https://www.alten.com/' },
			alumniOf: [
				{ '@type': 'CollegeOrUniversity', name: 'Lund University', url: 'https://www.lu.se/' },
				{ '@type': 'CollegeOrUniversity', name: 'Universitat Politècnica de València', url: 'https://www.upv.es/' },
			],
			hasCredential: [
				{ '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: 'PhD in Mechanical Engineering', recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Lund University' } },
				{ '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: 'MSc in Electrical Engineering', recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Lund University' } },
				{ '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: 'MSc in Industrial Engineering', recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Universitat Politècnica de València' } },
			],
			knowsAbout: ['Embedded control systems', 'Model predictive control', 'State estimation', 'Thermal management of electric vehicles', 'Electric powertrain control', 'Diagnostics and fault handling', 'ISO 26262', 'AUTOSAR', 'MIL/SIL/HIL validation', 'Technical leadership'],
			knowsLanguage: ['en', 'es', 'sv', 'ca'],
		})} />
		<slot name="head" />
	</head>
	<body data-page-type={pageType}>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-shell">
			<SiteHeader />
			<div class="main-content">
				<main id="main-content" class="main-body">
					<slot />
				</main>
				<SiteFooter />
			</div>
		</div>
		<script is:inline>
			(() => {
				const trackedSelector = '[data-analytics-event]';

				const clean = (value) => {
					if (typeof value !== 'string') return undefined;
					const trimmed = value.trim();
					return trimmed ? trimmed : undefined;
				};

				const getLinkText = (element) =>
					clean(element.dataset.ctaText) ?? clean(element.textContent?.replace(/\s+/g, ' '));

				const buildPayload = (element, extras = {}) => ({
					cta_id: clean(element.dataset.ctaId),
					cta_text: getLinkText(element),
					placement: clean(element.dataset.ctaPlacement),
					page_type: clean(document.body?.dataset.pageType) ?? 'unknown',
					destination: clean(element.dataset.destination) ?? clean(element.getAttribute('href')),
					intent: clean(element.dataset.ctaIntent),
					source_section: clean(element.dataset.sourceSection),
					...extras,
				});

				const track = (eventName, payload = {}) => {
					const event = clean(eventName);
					if (!event) return;

					const detail = { event, ...payload };
					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push(detail);

					if (typeof window.gtag === 'function') {
						window.gtag('event', event, payload);
					}

					window.dispatchEvent(new CustomEvent('portfolio:analytics', { detail }));
				};

				window.trackPortfolioEvent = track;

				document.addEventListener('click', (event) => {
					const target = event.target instanceof Element ? event.target.closest(trackedSelector) : null;
					if (!target) return;
					track(target.dataset.analyticsEvent, buildPayload(target));
				});
			})();
		</script>
	</body>
</html>
