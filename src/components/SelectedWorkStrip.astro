---
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);

const selectedWork = [
	{
		title: 'Embedded controls for electrified and heavy-duty systems',
		linkText: 'View selected work',
		href: withBase('/work'),
		ctaId: 'selected-work-electrified-heavy-duty',
	},
	{
		title: 'Autonomous and intelligent machines',
		linkText: 'Explore applied domains',
		href: withBase('/work'),
		ctaId: 'selected-work-autonomous-machines',
	},
	{
		title: 'Research, patents, and publications',
		linkText: 'View publications and patents',
		href: withBase('/work'),
		ctaId: 'selected-work-research-publications',
	},
];
---

<section class="selected-work" aria-labelledby="selected-work-title">
	<div class="page-container">
		<div class="selected-work__header">
			<h2 id="selected-work-title">Selected work</h2>
			<p>
				A compact path into the engineering evidence behind the profile: applied
				systems, product contexts, publications, and patents.
			</p>
		</div>

		<div class="selected-work__list">
			{selectedWork.map((item, index) => (
				<article class="selected-work__item">
					<span class="selected-work__index">{String(index + 1).padStart(2, '0')}</span>
					<h3>{item.title}</h3>
					<a
						href={item.href}
						data-analytics-event="cta_click"
						data-cta-id={item.ctaId}
						data-cta-placement="home-selected-work"
						data-cta-intent="proof"
						data-source-section="selected-work"
					>
						{item.linkText}
					</a>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.selected-work {
		background: var(--color-section-bg);
		padding-block: clamp(var(--spacing-09), 6vw, var(--spacing-10));
	}

	.selected-work__header {
		display: grid;
		gap: var(--spacing-03);
		max-width: var(--measure-reading);
		margin-bottom: clamp(var(--spacing-06), 3vw, var(--spacing-07));
		padding-right: clamp(0rem, 6vw, var(--spacing-10));
	}

	.selected-work__header h2 {
		margin: 0;
		font-size: var(--type-section-title-size);
		line-height: var(--type-section-title-line);
		letter-spacing: var(--type-section-title-tracking);
		font-weight: var(--type-section-title-weight);
		max-width: 13ch;
	}

	.selected-work__header p {
		margin: 0;
		max-width: var(--measure-compact);
		color: var(--color-body-text);
		font-size: var(--type-section-intro-size);
		line-height: var(--type-section-intro-line);
		letter-spacing: var(--type-section-intro-tracking);
	}

	.selected-work__list {
		display: grid;
		border-top: 1px solid var(--color-border);
	}

	.selected-work__item {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: clamp(var(--spacing-05), 2vw, var(--spacing-06));
		align-items: center;
		padding: var(--spacing-05) 0;
		border-bottom: 1px solid var(--color-border);
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			padding-inline var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.selected-work__item:hover {
		background: color-mix(in srgb, var(--color-surface-soft) 88%, var(--color-page));
		padding-inline: var(--spacing-05);
	}

	.selected-work__index {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: var(--type-chip-weight);
		letter-spacing: var(--type-chip-tracking);
		line-height: var(--type-chip-line);
	}

	.selected-work__item h3 {
		margin: 0;
		font-size: var(--type-card-title-size);
		line-height: var(--type-card-title-line);
		font-weight: var(--type-card-title-weight);
	}

	.selected-work__item a {
		color: var(--color-link);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: var(--type-chip-weight);
		letter-spacing: var(--type-chip-tracking);
		line-height: var(--type-chip-line);
		text-transform: uppercase;
		text-decoration: none;
		border-bottom: 1px solid transparent;
		white-space: nowrap;
		width: fit-content;
		transition:
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.selected-work__item a:hover,
	.selected-work__item a:focus-visible {
		color: var(--color-link-hover);
		border-bottom-color: var(--color-link-hover);
		transform: translateX(4px);
	}

	.selected-work__item a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	@media (max-width: 760px) {
		.selected-work__item {
			grid-template-columns: auto minmax(0, 1fr);
			align-items: start;
		}

		.selected-work__item a {
			grid-column: 2;
		}
	}
</style>
