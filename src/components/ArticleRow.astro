---
interface Props {
	number: string;
	title: string;
	description: string;
	href: string;
	analyticsEvent?: string;
	ctaId?: string;
	placement?: string;
	intent?: string;
	sourceSection?: string;
}

const {
	number,
	title,
	description,
	href,
	analyticsEvent = 'writing_article_click',
	ctaId,
	placement = 'article-row',
	intent = 'authority',
	sourceSection = 'writing',
} = Astro.props;
---

<a
	href={href}
	class="article-link"
	data-analytics-event={analyticsEvent}
	data-cta-id={ctaId}
	data-cta-placement={placement}
	data-cta-intent={intent}
	data-source-section={sourceSection}
>
	<span class="article-link__number">{number}</span>
	<span>
		<h3 class="article-link__title">{title}</h3>
		<p class="article-link__description">{description}</p>
	</span>
	<span class="article-link__arrow" aria-hidden="true">→</span>
</a>

<style>
	.article-link {
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr) auto;
		gap: var(--spacing-07);
		align-items: center;
		color: inherit;
		text-decoration: none;
		border-top: 1px solid var(--color-border);
		padding: var(--spacing-05);
		margin-inline: calc(var(--spacing-05) * -1);
		transition:
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.article-link:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.article-link__number {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-muted);
	}

	.article-link__title {
		margin: 0 0 var(--spacing-02);
		font-size: 1.125rem;
		font-weight: 600;
		max-width: 34ch;
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
		transition: text-decoration-color var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.article-link__description {
		margin: 0;
		max-width: var(--measure-compact);
		padding-right: var(--spacing-06);
		font-size: 0.875rem;
		color: var(--color-body-text);
		line-height: 1.5;
	}

	.article-link__arrow {
		display: inline-block;
		color: var(--color-muted);
		transition: transform var(--motion-duration-moderate-01) var(--motion-standard-productive);
	}

	.article-link:hover,
	.article-link:focus-visible {
		border-color: var(--color-border-strong);
		background: color-mix(in srgb, var(--color-surface-soft) 88%, var(--color-page));
		transform: translateX(4px);
	}

	.article-link:hover .article-link__title,
	.article-link:focus-visible .article-link__title {
		text-decoration-color: var(--color-border-strong);
	}

	.article-link:hover .article-link__arrow,
	.article-link:focus-visible .article-link__arrow {
		transform: translateX(3px);
	}

	.article-link:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	@media (max-width: 640px) {
		.article-link {
			grid-template-columns: 36px minmax(0, 1fr) auto;
			gap: var(--spacing-05);
		}
	}
</style>
