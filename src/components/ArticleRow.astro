---
interface Props {
	number: string;
	title: string;
	description: string;
	href: string;
}

const { number, title, description, href } = Astro.props;
---

<a href={href} class="article-link">
	<span class="article-link__number">{number}</span>
	<span>
		<h3 class="article-link__title">{title}</h3>
		<p class="article-link__description">{description}</p>
	</span>
	<span class="article-link__arrow" aria-hidden="true">→</span>
</a>

<style>
	.article-link {
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: center;
		color: inherit;
		text-decoration: none;
		border-top: 1px solid var(--color-border);
		padding-block: 1.35rem;
		transition: border-color 160ms ease-out, background-color 160ms ease-out;
	}

	.article-link:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.article-link__number {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.article-link__title {
		margin: 0 0 0.25rem;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
		transition: text-decoration-color 160ms ease-out;
	}

	.article-link__description {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-muted);
		line-height: 1.45;
	}

	.article-link__arrow {
		display: inline-block;
		color: var(--color-accent);
		transition: transform 180ms ease-out;
	}

	.article-link:hover,
	.article-link:focus-visible {
		border-color: var(--color-border-strong);
		background: var(--color-accent-wash);
	}

	.article-link:hover .article-link__title,
	.article-link:focus-visible .article-link__title {
		text-decoration-color: var(--color-accent);
	}

	.article-link:hover .article-link__arrow,
	.article-link:focus-visible .article-link__arrow {
		transform: translateX(3px);
	}

	.article-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	@media (max-width: 640px) {
		.article-link {
			grid-template-columns: 36px minmax(0, 1fr) auto;
			gap: 1rem;
		}
	}
</style>
