---
import { TAG_GROUPS } from '../../data/tagGroups';
import { toTopicSlug, type WritingArticle } from '../../data/writing';

/**
 * Topic chips that hide rows by their `data-topics` attribute.
 * Works on any page with `[data-filter-item]` rows, `[data-filter-group]` wrappers
 * (hidden when they become empty) and an optional `[data-filter-empty]` message.
 */
interface Props {
	articles: readonly WritingArticle[];
}

const { articles } = Astro.props;
const topics = Object.keys(TAG_GROUPS).filter((topic) => articles.some((article) => article.topics.includes(topic)));
---

<div class="writing-filter" role="group" aria-labelledby="writing-filter-label">
	<span id="writing-filter-label" class="writing-filter__label">Topics</span>
	<button class="writing-filter__chip" type="button" data-filter="" aria-pressed="true">All</button>
	{topics.map((topic) => <button class="writing-filter__chip" type="button" data-filter={toTopicSlug(topic)} aria-pressed="false">{topic}</button>)}
	<p class="visually-hidden" data-filter-status aria-live="polite"></p>
</div>

<style>
	.writing-filter { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem 1.1rem; margin: 0 0 2.5rem; }
	.writing-filter__label { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-chip-size); letter-spacing: var(--type-chip-tracking); line-height: 1.4; text-transform: uppercase; }
	.writing-filter__chip { border: 0; background: transparent; padding: 0; color: var(--color-muted); font-family: var(--font-body); font-size: .9rem; line-height: 1.5; text-decoration: none; cursor: pointer; }
	.writing-filter__chip:hover { color: var(--color-link); text-decoration: underline; text-underline-offset: .2em; }
	.writing-filter__chip[aria-pressed='true'] { color: var(--color-text); font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .3em; }
	.writing-filter__chip:focus-visible { outline: 2px solid var(--color-link); outline-offset: 3px; }
	.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<script>
	const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
	const items = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-item]'));
	// Innermost groups first, so a parent sees the state of its children.
	const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-group]')).reverse();
	const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
	const status = document.querySelector<HTMLElement>('[data-filter-status]');

	const apply = (topic: string, label: string) => {
		let visible = 0;
		items.forEach((item) => {
			const match = !topic || (item.dataset.topics ?? '').split(' ').includes(topic);
			item.hidden = !match;
			if (match) visible += 1;
		});
		groups.forEach((group) => {
			group.hidden = !group.querySelector('[data-filter-item]:not([hidden])');
		});
		chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === topic)));
		if (empty) empty.hidden = visible > 0;
		if (status) status.textContent = `${label}: ${visible} ${visible === 1 ? 'article' : 'articles'}`;
		// Lets other scripts react, for example "Show all", which shows every match while a topic is active.
		document.dispatchEvent(new CustomEvent('writing-filter', { detail: { topic } }));
	};

	chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.filter ?? '', chip.textContent?.trim() ?? '')));
</script>
