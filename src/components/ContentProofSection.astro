---
import SeniorityProof from './SeniorityProof.astro';
---

<section class="content-proof" aria-label="Site focus and professional proof">
	<div class="page-container">
		<div class="content-proof__inner">
			<p class="site-intro">
				Developing ideas on control systems, embedded software, diagnostics, automation, and the
				technical decisions that make complex machines safe and reliable.
			</p>
		</div>
	</div>
</section>

<SeniorityProof />

<style>
	.content-proof {
		background: var(--color-section-bg);
	}

	.content-proof__inner {
		padding-block: clamp(2rem, 4.5vw, 3.25rem) clamp(1.2rem, 2.5vw, 1.75rem);
	}

	.site-intro {
		max-width: 760px;
		margin: 0;
		color: var(--color-body-text);
		font-family: var(--font-sans);
		font-size: clamp(1rem, 1.25vw, 1.15rem);
		line-height: 1.55;
	}

	@media (max-width: 640px) {
		.content-proof__inner {
			padding-block: 1.75rem 1.25rem;
		}
	}
</style>
