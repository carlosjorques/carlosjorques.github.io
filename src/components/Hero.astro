---
interface Props {
	eyebrow?: string;
	body?: string;
}

const {
	eyebrow = 'Embedded Control Systems Architect',
	body = 'With 10+ years in automotive embedded systems, I lead software teams building reliable control software for complex physical products.',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero-inner">
		<div class="hero-copy">
			<p class="eyebrow">{eyebrow}</p>
			<h1 id="hero-heading">
				Hello. I am <strong>Carlos Jorques</strong>, an Embedded Control Systems Architect and
				technical team leader.
			</h1>
			<p class="lead">{body}</p>
			<nav class="hero-links" aria-label="Homepage primary links">
				<a href={`${baseUrl}contact/`}>Get in touch <span aria-hidden="true">-&gt;</span></a>
			</nav>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(4.8rem, 10vw, 8.25rem);
		padding-bottom: clamp(3.75rem, 8vw, 6.5rem);
	}

	.hero-inner {
		width: min(100%, var(--content-width));
		margin-inline: auto;
	}

	.hero-copy {
		display: grid;
		max-width: 650px;
		gap: 1rem;
	}

	h1 {
		max-width: 650px;
		font-size: clamp(2.1rem, 4vw, 3.25rem);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.22;
	}

	h1 strong {
		font-weight: 800;
	}

	.lead {
		max-width: 520px;
		color: var(--color-text);
		font-size: 0.98rem;
		line-height: 1.52;
		opacity: 1;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 0.55rem;
	}

	.hero-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-bottom: 1px solid transparent;
		padding-bottom: 0.12rem;
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		text-decoration: none;
	}

	.hero-links span {
		color: var(--color-accent);
		transition: transform 0.18s ease;
	}

	.hero-links a:hover {
		border-bottom-color: var(--color-accent);
		color: var(--color-text);
	}

	.hero-links a:hover span {
		transform: translateX(3px);
	}

	@media (max-width: 620px) {
		.hero {
			padding-top: 3.25rem;
		}
	}
</style>
