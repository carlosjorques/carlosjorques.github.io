---
interface Props {
	body?: string;
}

const {
	body = 'With 10+ years in automotive embedded systems, I lead software teams building reliable control software for complex physical products.',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero__copy">
		<h1 id="hero-heading">
			Hello. I am <strong>Carlos Jorques</strong>,<br />an Embedded Control Systems Architect<br />and
			technical team leader.
		</h1>
		<p class="hero__lead">{body}</p>
		<a class="hero__link" href={`${baseUrl}contact/`}>Get in touch</a>
	</div>
</section>

<style>
	.hero {
		padding: 0;
		background: var(--color-hero);
	}

	.hero__copy {
		max-width: 760px;
	}

	.hero h1 {
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-sans);
		font-size: clamp(2.1rem, 4vw, 4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.12;
	}

	.hero h1 strong {
		font-weight: 700;
	}

	.hero__lead {
		max-width: 620px;
		margin-top: 1.5rem;
		color: var(--color-text);
		font-family: var(--font-sans);
		font-size: clamp(1rem, 1.3vw, 1.2rem);
		line-height: 1.55;
		opacity: 1;
	}

	.hero__link {
		display: inline-flex;
		margin-top: 1.5rem;
		border-bottom: 1px solid var(--color-accent);
		color: var(--color-text);
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		text-transform: uppercase;
	}

	.hero__link:hover {
		color: var(--color-text);
	}

	@media (max-width: 620px) {
		.hero h1 {
			font-size: clamp(2.1rem, 10vw, 3rem);
		}
	}
</style>
