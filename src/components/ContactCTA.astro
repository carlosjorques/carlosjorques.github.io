---
interface Props {
	eyebrow?: string;
	title?: string;
	body?: string;
	primaryLabel?: string;
	primaryHref?: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	tertiaryHref?: string;
	tertiaryLabel?: string;
	sourceSection?: string;
}

const {
	eyebrow = 'Contact',
	title = 'Interested in embedded control architecture, physical systems, or technical leadership?',
	body = 'Use the contact page for role conversations, collaboration, project context, or focused technical questions.',
	primaryHref = 'contact/',
	primaryLabel = 'Contact me',
	secondaryHref = 'work/',
	secondaryLabel = 'View work',
	tertiaryHref,
	tertiaryLabel,
	sourceSection = 'contact-cta',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) =>
	href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')
		? href
		: `${normalizedBase}${href.replace(/^\//, '')}`;
const isExternal = (href: string) => href.startsWith('http');
const eventName = (href: string) => href.startsWith('writing') ? 'writing_article_click' : href.startsWith('http') ? 'linkedin_outbound_click' : 'cta_click';
const intent = (href: string) => href.startsWith('writing') ? 'authority' : href.startsWith('http') ? 'professional-profile' : href.includes('contact') ? 'contact' : 'proof';
---

<section class="contact-cta">
	<div>
		<p class="contact-cta__label">{eyebrow}</p>
		<h2>{title}</h2>
		<p>{body}</p>
	</div>
	<div class="button-row">
		<a
			class="button primary"
			href={withBase(primaryHref)}
			data-analytics-event="cta_click"
			data-cta-id="contact-cta-primary"
			data-cta-placement="contact-cta"
			data-cta-intent="contact"
			data-source-section={sourceSection}
			data-destination={withBase(primaryHref)}
		>
			{primaryLabel}
		</a>
		<a
			class="button"
			href={withBase(secondaryHref)}
			data-analytics-event={eventName(secondaryHref)}
			data-cta-id="contact-cta-secondary"
			data-cta-placement="contact-cta"
			data-cta-intent={intent(secondaryHref)}
			data-source-section={sourceSection}
			data-destination={withBase(secondaryHref)}
			target={isExternal(secondaryHref) ? '_blank' : undefined}
			rel={isExternal(secondaryHref) ? 'noopener noreferrer' : undefined}
		>
			{secondaryLabel}
		</a>
		{tertiaryHref && tertiaryLabel && (
			<a
				class="button"
				href={withBase(tertiaryHref)}
				data-analytics-event={eventName(tertiaryHref)}
				data-cta-id="contact-cta-tertiary"
				data-cta-placement="contact-cta"
				data-cta-intent={intent(tertiaryHref)}
				data-source-section={sourceSection}
				data-destination={withBase(tertiaryHref)}
				target={isExternal(tertiaryHref) ? '_blank' : undefined}
				rel={isExternal(tertiaryHref) ? 'noopener noreferrer' : undefined}
			>
				{tertiaryLabel}
			</a>
		)}
	</div>
</section>

<style>
	.contact-cta {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(1rem, 2.4vw, 1.4rem);
		align-items: start;
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius);
		background: var(--color-card-bg);
		padding: clamp(1.15rem, 3vw, 1.6rem);
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.contact-cta:hover,
	.contact-cta:focus-within {
		border-color: var(--color-card-border-hover);
		background: var(--color-card-bg-hover);
	}

	.contact-cta div:first-child {
		display: grid;
		gap: 0.65rem;
		max-width: 720px;
	}

	.contact-cta__label {
		margin: 0;
		color: var(--color-accent-text);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: var(--type-meta-weight);
		letter-spacing: var(--type-meta-tracking);
		line-height: var(--type-meta-line);
		text-transform: uppercase;
	}

	.contact-cta h2 {
		max-width: 16ch;
		color: var(--color-text);
		font-size: clamp(1.55rem, 2.5vw, 2.35rem);
		letter-spacing: -0.045em;
		line-height: 1.05;
	}

	.contact-cta p:not(.contact-cta__label) {
		max-width: 64ch;
		color: var(--color-body-text);
		font-size: var(--type-card-body-size);
		line-height: var(--type-card-body-line);
		overflow-wrap: anywhere;
	}

	.contact-cta .button-row {
		display: grid;
		gap: 0.75rem;
	}

	.contact-cta .button-row > .button {
		width: 100%;
	}

	@media (min-width: 850px) {
		.contact-cta {
			grid-template-columns: minmax(0, 1fr) auto;
		}

		.contact-cta .button-row {
			min-width: 210px;
			align-self: center;
		}
	}
</style>
