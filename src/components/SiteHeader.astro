---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
const basePath = baseUrl.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(basePath, '') || '/';
const isActive = (href: string) => {
	const normalized = href.endsWith('/') ? href : `${href}/`;
	return href === '/' ? currentPath === '/' : currentPath.startsWith(normalized);
};
---

<header class="site-header">
	<div class="page-container site-header__inner">
		<a class="site-header__brand" href={withBase('/')}>Carlos Jorques</a>

		<nav class="site-header__nav" aria-label="Primary navigation">
			<a href={withBase('/writing')} aria-current={isActive('/writing') ? 'page' : undefined}>Writing</a>
			<a href={withBase('/about')} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
			<a href={withBase('/work')} aria-current={isActive('/work') ? 'page' : undefined}>Work</a>
			<a href={withBase('/contact')} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
		</nav>

		<label class="theme-toggle">
			<input
				class="theme-toggle__input"
				type="checkbox"
				data-theme-toggle
				aria-label="Switch to dark color theme"
			/>
			<span class="theme-toggle__track" aria-hidden="true">
				<span class="theme-toggle__thumb"></span>
			</span>
		</label>
	</div>
</header>

<style>
	.site-header {
		--header-bg: var(--color-dark-surface);
		--header-text: var(--color-on-dark);
		--header-link: var(--color-on-dark-muted-soft);
		--header-border: var(--color-on-dark-border-soft);
		--header-accent: var(--color-accent-bright);

		background: var(--header-bg);
		border-bottom: 1px solid var(--header-border);
	}

	.site-header__inner {
		min-height: 68px;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 2rem;
	}

	.site-header__brand {
		color: var(--header-text);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 2.25rem;
	}

	.site-header__nav a {
		color: var(--header-link);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		border-bottom: 1px solid transparent;
		padding-bottom: 0.15rem;
		transition: color 160ms ease-out, border-color 160ms ease-out;
	}

	.site-header__nav a:hover,
	.site-header__nav a:focus-visible,
	.site-header__nav a[aria-current="page"] {
		color: var(--header-accent);
		border-bottom-color: var(--header-accent);
	}

	.site-header__brand:focus-visible,
	.site-header__nav a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	.theme-toggle {
		--toggle-width: 46px;
		--toggle-height: 23px;
		--toggle-track-height: 14px;
		--toggle-thumb-size: 23px;
		display: inline-flex;
		width: var(--toggle-width);
		height: var(--toggle-height);
		align-items: center;
		justify-content: center;
		border-radius: 99em;
		cursor: pointer;
		position: relative;
		flex: 0 0 var(--toggle-width);
	}

	.theme-toggle__input {
		position: absolute;
		inset: 0;
		appearance: none;
		cursor: pointer;
		margin: 0;
		opacity: 0;
		z-index: 2;
	}

	.theme-toggle__track {
		display: block;
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: var(--toggle-track-height);
		transform: translateY(-50%);
		border: 1px solid var(--header-border);
		border-radius: 999px;
		background: linear-gradient(
				to right,
				var(--brand-porcelain) 50%,
				var(--brand-graphite) 50%
			)
			no-repeat;
		background-size: 205%;
		background-position: 0;
		transition: background-position 240ms ease-out;
	}

	.theme-toggle__thumb {
		position: absolute;
		top: 50%;
		left: 0;
		width: var(--toggle-thumb-size);
		height: var(--toggle-thumb-size);
		transform: translateY(-50%);
		border-radius: 50%;
		background: var(--brand-paper);
		box-shadow: 0 0 0 1px rgba(16, 20, 20, 0.24);
		transition:
			left 240ms ease-out,
			background-color 240ms ease-out,
			box-shadow 240ms ease-out;
	}

	.theme-toggle__thumb::before,
	.theme-toggle__thumb::after {
		content: "";
		position: absolute;
		inset: 0;
		transition:
			opacity 180ms ease-out,
			transform 240ms ease-out;
	}

	.theme-toggle__thumb::before {
		width: 13px;
		height: 13px;
		margin: auto;
		background: url("data:image/svg+xml,%3Csvg width='13' height='13' viewBox='0 0 24 24' fill='%23101417' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20.8 14.6A8 8 0 0 1 9.4 3.2 9.2 9.2 0 1 0 20.8 14.6Z'/%3E%3C/svg%3E")
			center / contain no-repeat;
	}

	.theme-toggle__thumb::after {
		width: 13px;
		height: 13px;
		margin: auto;
		background: url("data:image/svg+xml,%3Csvg width='13' height='13' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='12' cy='12' r='4.2' stroke='%23f6f3ec' stroke-width='2.6'/%3E%3Cpath d='M12 2.5V5M12 19v2.5M21.5 12H19M5 12H2.5M18.7 5.3l-1.8 1.8M7.1 16.9l-1.8 1.8M18.7 18.7l-1.8-1.8M7.1 7.1 5.3 5.3' stroke='%23f6f3ec' stroke-width='2.6' stroke-linecap='round'/%3E%3C/svg%3E")
			center / contain no-repeat;
		opacity: 0;
	}

	.theme-toggle__input:focus-visible + .theme-toggle__track {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	.theme-toggle__input:checked + .theme-toggle__track {
		background-position: 100%;
	}

	.theme-toggle__input:checked + .theme-toggle__track .theme-toggle__thumb {
		left: calc(100% - var(--toggle-thumb-size));
		background: var(--brand-graphite-deep);
		box-shadow: 0 0 0 1px rgba(246, 243, 236, 0.28);
	}

	.theme-toggle__input:checked + .theme-toggle__track .theme-toggle__thumb::before {
		opacity: 0;
		transform: rotate(90deg) scale(0.78);
	}

	.theme-toggle__input:checked + .theme-toggle__track .theme-toggle__thumb::after {
		opacity: 1;
		transform: rotate(-8deg);
	}

	@media (max-width: 640px) {
		.site-header__inner {
			min-height: auto;
			padding-block: 1rem;
			grid-template-columns: 1fr auto;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.site-header__brand {
			align-self: center;
		}

		.site-header__nav {
			grid-column: 1 / -1;
			gap: 1.25rem;
			flex-wrap: wrap;
			justify-content: flex-start;
		}

		.theme-toggle {
			align-self: center;
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLInputElement>('[data-theme-toggle]');
	const root = document.documentElement;

	const applyTheme = (theme: 'bright' | 'dark') => {
		root.dataset.theme = theme;
		root.style.colorScheme = theme === 'dark' ? 'dark' : 'light';

		try {
			window.localStorage.setItem('color-theme', theme);
		} catch {
			// Theme persistence is optional; the control still works for this page.
		}

		if (!toggle) {
			return;
		}

		const nextThemeLabel = theme === 'dark' ? 'light' : 'dark';
		toggle.checked = theme === 'dark';
		toggle.setAttribute('aria-label', `Switch to ${nextThemeLabel} color theme`);
	};

	if (toggle) {
		const initialTheme = root.dataset.theme === 'dark' ? 'dark' : 'bright';
		applyTheme(initialTheme);

		toggle.addEventListener('change', () => {
			applyTheme(root.dataset.theme === 'dark' ? 'bright' : 'dark');
		});
	}
</script>
