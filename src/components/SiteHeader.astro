---
import { IDENTITY } from '../data/identity';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`;
const basePath = baseUrl.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(basePath, '') || '/';
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header page-container">
	<a class="site-header__brand" href={withBase('/')} aria-label={`${IDENTITY.name} home`} aria-current={isActive('/') ? 'page' : undefined}>{IDENTITY.name}</a>

	<div class="site-header__actions">
		<nav class="site-header__nav site-header__nav--desktop" aria-label="Primary navigation">
			<a href={withBase('/work/')} aria-current={isActive('/work/') ? 'page' : undefined}>Work</a>
			<a href={withBase('/writing/')} aria-current={isActive('/writing/') ? 'page' : undefined}>Writing</a>
			<a href={withBase('/about/')} aria-current={isActive('/about/') ? 'page' : undefined}>About</a>
			<a href={withBase('/cv/')} aria-current={isActive('/cv/') ? 'page' : undefined}>CV</a>
			<a href={withBase('/contact/')} aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a>
		</nav>

		<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark color theme">
			<svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5V5M12 19v2.5M21.5 12H19M5 12H2.5M18.7 5.3l-1.8 1.8M7.1 16.9l-1.8 1.8M18.7 18.7l-1.8-1.8M7.1 7.1 5.3 5.3"></path></svg>
			<svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 14.6A8 8 0 0 1 9.4 3.2 9.2 9.2 0 1 0 20.8 14.6Z"></path></svg>
		</button>

		<details class="site-header__mobile" data-mobile-menu>
			<summary aria-label="Open navigation menu" aria-controls="mobile-navigation" aria-expanded="false"><span></span><span></span><span></span></summary>
			<nav class="site-header__mobile-panel" id="mobile-navigation" aria-label="Mobile navigation">
				<a class="site-header__mobile-brand" href={withBase('/')} aria-label={`${IDENTITY.name} home`} aria-current={isActive('/') ? 'page' : undefined}>{IDENTITY.name}</a>
				<a href={withBase('/work/')} aria-current={isActive('/work/') ? 'page' : undefined}>Work</a>
				<a href={withBase('/writing/')} aria-current={isActive('/writing/') ? 'page' : undefined}>Writing</a>
				<a href={withBase('/about/')} aria-current={isActive('/about/') ? 'page' : undefined}>About</a>
				<a href={withBase('/cv/')} aria-current={isActive('/cv/') ? 'page' : undefined}>CV</a>
				<a href={withBase('/contact/')} aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a>
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header { min-height: 72px; display:flex; align-items:center; justify-content:space-between; gap:2rem; background:var(--color-header-bg); }
	.site-header__brand { min-height:44px; display:inline-flex; align-items:center; color:var(--color-header-text); font-size:1.3rem; font-weight:800; letter-spacing:-.04em; text-decoration:none; }
	.site-header__actions,.site-header__nav { display:flex; align-items:center; gap:.85rem; }
	.site-header__nav { gap:2rem; }
	.site-header__nav a { min-height:44px; display:inline-flex; align-items:center; gap:.35rem; color:var(--color-header-link); font-size:.95rem; font-weight:600; letter-spacing:-.02em; text-decoration:none; cursor:pointer; list-style:none; transition:opacity 120ms ease; }
	.site-header__nav a:hover,.site-header__nav a:focus-visible { opacity:.68; }
	.site-header__nav a[aria-current='page'] { text-decoration:underline; text-underline-offset:.3em; }
	.theme-toggle { width:44px; height:44px; display:grid; place-items:center; position:relative; border:1px solid var(--color-border); border-radius:50%; color:var(--color-header-text); cursor:pointer; background:transparent; }
	.theme-toggle__icon { position:absolute; width:1.2rem; height:1.2rem; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; opacity:0; transform:scale(.7); transition:opacity 160ms ease,transform 160ms ease; }
	:global(:root:not([data-theme='dark'])) .theme-toggle__icon--sun,:global(:root[data-theme='bright']) .theme-toggle__icon--sun,:global(:root[data-theme='dark']) .theme-toggle__icon--moon { opacity:1; transform:scale(1); }
	.site-header__mobile { display:none; }
	@media (max-width:720px) {
		.site-header { min-height:68px; }
		.site-header__nav--desktop { display:none; }
		.site-header__mobile { display:block; }
		.site-header__mobile > summary { width:44px; height:44px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.22rem; cursor:pointer; list-style:none; position:relative; z-index:60; }
		.site-header__mobile > summary::-webkit-details-marker { display:none; }
		.site-header__mobile > summary span { width:1.1rem; height:2px; background:var(--color-text); transition:transform 140ms ease,opacity 140ms ease; }
		.site-header__mobile[open] > summary span:nth-child(1){transform:translateY(6px) rotate(45deg)}
		.site-header__mobile[open] > summary span:nth-child(2){opacity:0}
		.site-header__mobile[open] > summary span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
		.site-header__mobile-panel { position:fixed; inset:0; z-index:50; min-height:100dvh; padding:6rem 1.25rem 2rem; display:flex; flex-direction:column; align-items:center; background:var(--color-page); overflow-y:auto; }
		.site-header__mobile-panel > a { width:min(100%,24rem); min-height:56px; display:flex; align-items:center; border-bottom:1px solid var(--color-border); color:var(--color-text); font-size:1.12rem; font-weight:600; text-decoration:none; }
		.site-header__mobile-panel > a[aria-current='page'] { color:var(--color-link); }
		.site-header__mobile-panel .site-header__mobile-brand { position:fixed; top:.75rem; left:.75rem; z-index:55; width:auto; border:0; font-size:1.3rem; font-weight:800; letter-spacing:-.04em; }
		.site-header__mobile-panel .site-header__mobile-brand[aria-current='page'] { color:var(--color-text); }
	}
</style>

<script>
	const root = document.documentElement;
	const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	themeToggle?.addEventListener('click', () => {
		const theme = root.dataset.theme === 'dark' ? 'bright' : 'dark';
		root.dataset.theme = theme;
		root.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
		try { localStorage.setItem('color-theme', theme); } catch {}
	});
	const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
	const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>('summary');
	const closeMobileMenu = (returnFocus = false) => {
		if (!mobileMenu) return;
		mobileMenu.open = false;
		document.documentElement.classList.remove('menu-open');
		mobileMenuSummary?.setAttribute('aria-expanded', 'false');
		if (returnFocus) mobileMenuSummary?.focus();
	};
	mobileMenu?.addEventListener('toggle', () => {
		document.documentElement.classList.toggle('menu-open', mobileMenu.open);
		mobileMenuSummary?.setAttribute('aria-expanded', String(mobileMenu.open));
	});
	mobileMenu?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && mobileMenu?.open) closeMobileMenu(true);
	});
	mobileMenu?.querySelectorAll<HTMLAnchorElement>('.site-header__mobile-panel a:not(.site-header__mobile-brand)').forEach((link) => {
		link.addEventListener('click', () => closeMobileMenu());
	});
	window.matchMedia('(min-width: 721px)').addEventListener('change', () => closeMobileMenu());
</script>
