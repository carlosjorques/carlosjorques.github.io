---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
const basePath = baseUrl.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(basePath, '') || '/';
const isActive = (href: string) => {
	const normalized = href.endsWith('/') ? href : `${href}/`;
	return href === '/' ? currentPath === '/' : currentPath.startsWith(normalized);
};
---

<header class="site-header">
	<div class="page-container site-header__inner">
		<a class="site-header__brand" href={withBase('/')}>Carlos Jorques</a>

		<nav class="site-header__nav" aria-label="Primary navigation">
			<a href={withBase('/writing')} aria-current={isActive('/writing') ? 'page' : undefined}>Writing</a>
			<a href={withBase('/about')} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
			<a href={withBase('/work')} aria-current={isActive('/work') ? 'page' : undefined}>Work</a>
			<a href={withBase('/contact')} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
		</nav>

		<button
			class="theme-toggle"
			type="button"
			data-theme-toggle
			aria-label="Switch to dark color theme"
			aria-pressed="false"
		>
			<span class="theme-toggle__track" aria-hidden="true">
				<span class="theme-toggle__thumb"></span>
			</span>
			<span class="theme-toggle__label" data-theme-label>Dark</span>
		</button>
	</div>
</header>

<style>
	.site-header {
		background: var(--color-hero);
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		min-height: 68px;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 2rem;
	}

	.site-header__brand {
		color: var(--color-text);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 2.25rem;
	}

	.site-header__nav a {
		color: var(--color-text);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		border-bottom: 1px solid transparent;
		padding-bottom: 0.15rem;
		transition: color 160ms ease-out, border-color 160ms ease-out;
	}

	.site-header__nav a:hover,
	.site-header__nav a:focus-visible,
	.site-header__nav a[aria-current="page"] {
		color: var(--color-accent);
		border-bottom-color: var(--color-accent);
	}

	.site-header__brand:focus-visible,
	.site-header__nav a:focus-visible,
	.theme-toggle:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	.theme-toggle {
		display: inline-flex;
		min-height: 34px;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-text);
		cursor: pointer;
		font: inherit;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		line-height: 1;
		padding: 0.35rem 0.65rem;
		text-transform: uppercase;
		transition:
			background-color 160ms ease-out,
			border-color 160ms ease-out,
			color 160ms ease-out;
	}

	.theme-toggle:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.theme-toggle__track {
		position: relative;
		width: 30px;
		height: 16px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-page);
	}

	.theme-toggle__thumb {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 10px;
		height: 10px;
		border-radius: 999px;
		background: var(--color-accent);
		transition: transform 160ms ease-out;
	}

	:global(:root[data-theme="dark"]) .theme-toggle__thumb {
		transform: translateX(14px);
	}

	@media (max-width: 640px) {
		.site-header__inner {
			min-height: auto;
			padding-block: 1rem;
			grid-template-columns: 1fr auto;
			align-items: flex-start;
			gap: 0.75rem;
		}

		.site-header__brand {
			align-self: center;
		}

		.site-header__nav {
			grid-column: 1 / -1;
			gap: 1.25rem;
			flex-wrap: wrap;
			justify-content: flex-start;
		}

		.theme-toggle {
			align-self: center;
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const label = document.querySelector<HTMLElement>('[data-theme-label]');
	const root = document.documentElement;

	const applyTheme = (theme: 'bright' | 'dark') => {
		root.dataset.theme = theme;
		root.style.colorScheme = theme === 'dark' ? 'dark' : 'light';

		try {
			window.localStorage.setItem('color-theme', theme);
		} catch {
			// Theme persistence is optional; the control still works for this page.
		}

		if (!toggle || !label) {
			return;
		}

		const nextTheme = theme === 'dark' ? 'bright' : 'dark';
		label.textContent = nextTheme === 'dark' ? 'Dark' : 'Bright';
		toggle.setAttribute('aria-label', `Switch to ${nextTheme} color theme`);
		toggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
	};

	if (toggle) {
		const initialTheme = root.dataset.theme === 'dark' ? 'dark' : 'bright';
		applyTheme(initialTheme);

		toggle.addEventListener('click', () => {
			applyTheme(root.dataset.theme === 'dark' ? 'bright' : 'dark');
		});
	}
</script>
