---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
---

<section class="next-index" aria-labelledby="next-index-title">
	<div class="page-container">
		<p id="next-index-title" class="section-label">Start here</p>

		<div class="next-index__grid">
			<a href={withBase('/writing')} class="next-index__item">
				<span class="next-index__number">[01]</span>
				<span class="next-index__title">
					<span>Writing</span>
					<span class="next-index__arrow" aria-hidden="true">→</span>
				</span>
				<span class="next-index__description">
					Essays and notes on control systems, embedded software, diagnostics, and physical behavior.
				</span>
			</a>

			<a href={withBase('/about')} class="next-index__item">
				<span class="next-index__number">[02]</span>
				<span class="next-index__title">
					<span>About</span>
					<span class="next-index__arrow" aria-hidden="true">→</span>
				</span>
				<span class="next-index__description">
					Professional background, education, motivation, and technical leadership.
				</span>
			</a>

			<a href={withBase('/work')} class="next-index__item">
				<span class="next-index__number">[03]</span>
				<span class="next-index__title">
					<span>Work</span>
					<span class="next-index__arrow" aria-hidden="true">→</span>
				</span>
				<span class="next-index__description">
					Selected technical work, research, patents, publications, and engineering contributions.
				</span>
			</a>

			<a href={withBase('/contact')} class="next-index__item">
				<span class="next-index__number">[04]</span>
				<span class="next-index__title">
					<span>Contact</span>
					<span class="next-index__arrow" aria-hidden="true">→</span>
				</span>
				<span class="next-index__description">
					Email, LinkedIn, and CV for hiring or collaboration.
				</span>
			</a>
		</div>
	</div>
</section>

<style>
	.next-index {
		background: #ffffff;
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.section-label {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.next-index__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.8rem;
	}

	.next-index__item {
		display: block;
		min-height: 136px;
		padding: 1.15rem;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-card-border);
		background: var(--color-card-bg);
		transition:
			transform 180ms ease-out,
			border-color 180ms ease-out,
			background-color 180ms ease-out,
			box-shadow 180ms ease-out;
	}

	.next-index__number {
		display: block;
		margin-bottom: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--color-card-accent);
	}

	.next-index__title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-card-text);
	}

	.next-index__arrow {
		display: inline-block;
		color: var(--color-card-accent);
		transition: transform 180ms ease-out;
	}

	.next-index__description {
		display: block;
		margin-top: 0.65rem;
		max-width: 220px;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		line-height: 1.45;
		color: var(--color-card-muted);
	}

	.next-index__item:hover,
	.next-index__item:focus-visible {
		transform: translateY(-2px);
		border-color: var(--color-card-border-hover);
		background: var(--color-card-bg-hover);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
		outline: none;
	}

	.next-index__item:hover .next-index__arrow,
	.next-index__item:focus-visible .next-index__arrow {
		transform: translateX(3px);
	}

	.next-index__item:hover .next-index__title,
	.next-index__item:focus-visible .next-index__title {
		text-decoration: underline;
		text-decoration-color: var(--color-card-accent);
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
	}

	.next-index__item:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.next-index__grid {
			grid-template-columns: repeat(2, 1fr);
		}

	}

	@media (max-width: 640px) {
		.next-index {
			padding-block: 2.75rem;
		}

		.next-index__grid {
			grid-template-columns: 1fr;
		}

		.next-index__item {
			min-height: auto;
		}

		.next-index__description {
			max-width: none;
		}
	}
</style>
