---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
---

<section class="next-index" aria-labelledby="next-index-title">
	<div class="page-container">
		<p id="next-index-title" class="section-label">Where to go next</p>

		<div class="next-index__grid">
			<a href={withBase('/writing')} class="next-index__item">
				<span class="next-index__number">01</span>
				<span class="next-index__title">
					<span>Writing</span>
					<span class="next-index__arrow" aria-hidden="true">→</span>
				</span>
				<span class="next-index__description">
					Essays and notes on control systems, embedded software, diagnostics, and physical behavior.
				</span>
			</a>

			<a href={withBase('/about')} class="next-index__item">
				<span class="next-index__number">02</span>
				<span class="next-index__title">
					<span>About</span>
					<span class="next-index__arrow" aria-hidden="true">→</span>
				</span>
				<span class="next-index__description">
					Professional background, education, motivation, and technical leadership.
				</span>
			</a>

			<a href={withBase('/work')} class="next-index__item">
				<span class="next-index__number">03</span>
				<span class="next-index__title">
					<span>Work</span>
					<span class="next-index__arrow" aria-hidden="true">→</span>
				</span>
				<span class="next-index__description">
					Selected technical work, research, patents, publications, and engineering contributions.
				</span>
			</a>

			<a href={withBase('/contact')} class="next-index__item">
				<span class="next-index__number">04</span>
				<span class="next-index__title">
					<span>Contact</span>
					<span class="next-index__arrow" aria-hidden="true">→</span>
				</span>
				<span class="next-index__description">
					Email, LinkedIn, and CV for hiring or collaboration.
				</span>
			</a>
		</div>
	</div>
</section>

<style>
	.next-index {
		background: var(--color-page);
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.section-label {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.next-index__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(1.25rem, 3vw, 1.75rem);
	}

	.next-index__item {
		position: relative;
		display: block;
		min-height: 132px;
		padding: 1.35rem 1.5rem;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-border-soft);
		background: #ffffff;
		transition:
			background-color 180ms ease-out,
			border-color 180ms ease-out,
			color 180ms ease-out,
			box-shadow 180ms ease-out;
	}

	.next-index__item + .next-index__item {
		border-left: 1px solid var(--color-border-soft);
	}

	.next-index__number {
		display: block;
		margin-bottom: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--color-accent);
		transition: color 180ms ease-out;
	}

	.next-index__title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		transition: color 180ms ease-out;
	}

	.next-index__arrow {
		display: inline-block;
		color: var(--color-accent);
		transition:
			transform 180ms ease-out,
			color 180ms ease-out;
	}

	.next-index__description {
		display: block;
		margin-top: 0.65rem;
		max-width: 220px;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		line-height: 1.45;
		color: var(--color-muted);
		transition: color 180ms ease-out;
	}

	.next-index__item:hover,
	.next-index__item:focus-visible {
		border-color: var(--color-border);
		background: #ffffff;
		color: inherit;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06);
		outline: none;
	}

	.next-index__item:hover .next-index__number,
		.next-index__item:focus-visible .next-index__number,
		.next-index__item:hover .next-index__arrow,
		.next-index__item:focus-visible .next-index__arrow {
		color: var(--color-accent);
	}

	.next-index__item:hover .next-index__arrow,
	.next-index__item:focus-visible .next-index__arrow {
		transform: translateX(3px);
	}

	.next-index__item:hover .next-index__title,
	.next-index__item:focus-visible .next-index__title {
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
	}

	.next-index__item:hover .next-index__description,
	.next-index__item:focus-visible .next-index__description {
		color: var(--color-muted);
	}

	.next-index__item:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.next-index__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.next-index__item:nth-child(3) {
			border-left: 1px solid var(--color-border-soft);
			border-top: 1px solid var(--color-border-soft);
		}

		.next-index__item:nth-child(4) {
			border-top: 1px solid var(--color-border-soft);
		}
	}

	@media (max-width: 640px) {
		.next-index {
			padding-block: 2.75rem;
		}

		.next-index__grid {
			grid-template-columns: 1fr;
		}

		.next-index__item {
			min-height: auto;
			padding: 1.25rem;
		}

		.next-index__item + .next-index__item {
			border-left: 1px solid var(--color-border-soft);
			border-top: 1px solid var(--color-border-soft);
		}

		.next-index__item:nth-child(3),
		.next-index__item:nth-child(4) {
			border-top: 1px solid var(--color-border-soft);
		}

		.next-index__description {
			max-width: none;
		}

		.next-index__item:hover,
		.next-index__item:focus-visible {
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.next-index__item,
		.next-index__arrow {
			transform: none !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>
