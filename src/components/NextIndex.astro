---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
---

<section class="next-index" aria-labelledby="next-index-title">
	<p id="next-index-title" class="section-label">Where to go next</p>

	<div class="next-index__grid">
		<a href={withBase('/writing')} class="next-index__item">
			<span class="next-index__number">01</span>
			<span class="next-index__title">
				<span>Writing</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Technical essays on control systems, embedded software, diagnostics, and physical-system behavior.
			</span>
		</a>

		<a href={withBase('/about')} class="next-index__item">
			<span class="next-index__number">02</span>
			<span class="next-index__title">
				<span>About</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Professional background, education, motivation, and technical leadership.
			</span>
		</a>

		<a href={withBase('/work')} class="next-index__item">
			<span class="next-index__number">03</span>
			<span class="next-index__title">
				<span>Work</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Selected technical work, research, patents, publications, and engineering contributions.
			</span>
		</a>

		<a href={withBase('/contact')} class="next-index__item">
			<span class="next-index__number">04</span>
			<span class="next-index__title">
				<span>Contact</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Email, LinkedIn, and CV access for hiring, collaboration, or technical discussion.
			</span>
		</a>
	</div>
</section>

<section class="proof-stripe" aria-label="Professional credibility signals">
	<div class="proof-stripe__item">
		<span>10+ years</span>
		<strong>Automotive embedded systems</strong>
	</div>
	<div class="proof-stripe__item">
		<span>Technical leader</span>
		<strong>Model-based control software</strong>
	</div>
	<div class="proof-stripe__item">
		<span>PhD-trained</span>
		<strong>Real-time control and diagnostics</strong>
	</div>
	<div class="proof-stripe__item">
		<span>Production scope</span>
		<strong>EV, powertrain, safety, MIL/SIL/HIL</strong>
	</div>
</section>

<style>
	.next-index {
		position: relative;
		z-index: 1;
		margin-top: clamp(3rem, 6vw, 5rem);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.section-label {
		margin: 0;
		padding-block: 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
		border-bottom: 1px solid var(--color-border);
	}

	.next-index__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}

	.next-index__item {
		position: relative;
		display: block;
		min-height: 132px;
		padding: 1.35rem 1.5rem 1.35rem 0;
		color: inherit;
		text-decoration: none;
		transition: background-color 160ms ease-out;
	}

	.next-index__item + .next-index__item {
		padding-left: 1.5rem;
		border-left: 1px solid var(--color-border);
	}

	.next-index__number {
		display: block;
		margin-bottom: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.next-index__title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.next-index__arrow {
		display: inline-block;
		color: var(--color-accent);
		transition: transform 180ms ease-out;
	}

	.next-index__description {
		display: block;
		margin-top: 0.65rem;
		max-width: 220px;
		font-size: 0.88rem;
		line-height: 1.45;
		color: var(--color-muted);
	}

	.proof-stripe {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-bottom: 1px solid var(--color-border);
	}

	.proof-stripe__item {
		display: grid;
		min-height: 74px;
		align-content: center;
		gap: 0.25rem;
		padding: 0.85rem 1.25rem 0.85rem 0;
	}

	.proof-stripe__item + .proof-stripe__item {
		border-left: 1px solid var(--color-border-soft);
		padding-left: 1.25rem;
	}

	.proof-stripe__item span {
		color: var(--color-soft);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.proof-stripe__item strong {
		color: var(--color-muted);
		font-size: 0.86rem;
		font-weight: 500;
		line-height: 1.35;
	}

	.next-index__item:hover,
	.next-index__item:focus-visible {
		background: rgba(26, 95, 180, 0.035);
	}

	.next-index__item:hover .next-index__arrow,
	.next-index__item:focus-visible .next-index__arrow {
		transform: translateX(3px);
	}

	.next-index__item:hover .next-index__title,
	.next-index__item:focus-visible .next-index__title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
	}

	.next-index__item:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.next-index__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.proof-stripe {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.next-index__item:nth-child(3) {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.next-index__item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}

		.proof-stripe__item:nth-child(3) {
			border-left: 0;
			border-top: 1px solid var(--color-border-soft);
			padding-left: 0;
		}

		.proof-stripe__item:nth-child(4) {
			border-top: 1px solid var(--color-border-soft);
		}
	}

	@media (max-width: 640px) {
		.next-index {
			margin-top: 2.5rem;
		}

		.next-index__grid {
			grid-template-columns: 1fr;
		}

		.proof-stripe {
			grid-template-columns: 1fr;
		}

		.next-index__item {
			min-height: auto;
			padding: 1.25rem 0;
		}

		.next-index__item + .next-index__item {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.next-index__item:nth-child(3),
		.next-index__item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}

		.next-index__description {
			max-width: none;
		}

		.proof-stripe__item {
			min-height: auto;
			padding: 0.85rem 0;
		}

		.proof-stripe__item + .proof-stripe__item {
			border-left: 0;
			border-top: 1px solid var(--color-border-soft);
			padding-left: 0;
		}
	}
</style>
