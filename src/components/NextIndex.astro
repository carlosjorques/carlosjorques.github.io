---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
---

<section class="next-index" aria-label="Start here">
	<div class="next-index__bar">
		<span class="next-index__bar-dot"></span>
		<span class="next-index__bar-dot"></span>
		<span class="next-index__bar-dot"></span>
		<span class="next-index__bar-label">Start here</span>
	</div>

	<div class="next-index__grid">
		<a href={withBase('/writing')} class="next-index__item">
			<span class="next-index__number">[01]</span>
			<span class="next-index__title">
				<span>Writing</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Essays and notes on control systems, embedded software, diagnostics, and physical behavior.
			</span>
		</a>

		<a href={withBase('/about')} class="next-index__item">
			<span class="next-index__number">[02]</span>
			<span class="next-index__title">
				<span>About</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Professional background, education, motivation, and technical leadership.
			</span>
		</a>

		<a href={withBase('/work')} class="next-index__item">
			<span class="next-index__number">[03]</span>
			<span class="next-index__title">
				<span>Work</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Selected technical work, research, patents, publications, and engineering contributions.
			</span>
		</a>

		<a href={withBase('/contact')} class="next-index__item">
			<span class="next-index__number">[04]</span>
			<span class="next-index__title">
				<span>Contact</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Email, LinkedIn, and CV for hiring or collaboration.
			</span>
		</a>
	</div>
</section>

<style>
	.next-index {
		position: relative;
		z-index: 1;
		margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
		background: var(--color-index-bg, #f7f7f5);
		border: 1px solid var(--color-index-border);
		box-shadow: 0 10px 28px rgba(26, 26, 26, 0.035);
	}

	.next-index__bar {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		border-bottom: 1px solid var(--color-index-border);
		background: var(--color-index-bar);
		padding: 0.7rem 1rem;
	}

	.next-index__bar-dot {
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: #b8b5ad;
	}

	.next-index__bar-label {
		margin-left: 0.35rem;
		color: var(--color-soft);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.next-index__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}

	.next-index__item {
		position: relative;
		display: block;
		min-height: 126px;
		padding: 1.25rem 1.4rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 160ms ease-out;
	}

	.next-index__item + .next-index__item {
		border-left: 1px solid var(--color-index-border);
	}

	.next-index__number {
		display: block;
		margin-bottom: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.next-index__title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.next-index__arrow {
		display: inline-block;
		color: var(--color-accent);
		transition: transform 180ms ease-out;
	}

	.next-index__description {
		display: block;
		margin-top: 0.65rem;
		max-width: 220px;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		line-height: 1.45;
		color: var(--color-muted);
	}

	.next-index__item:hover,
	.next-index__item:focus-visible {
		background: rgba(26, 95, 180, 0.025);
		outline: none;
	}

	.next-index__item:hover .next-index__arrow,
	.next-index__item:focus-visible .next-index__arrow {
		transform: translateX(3px);
	}

	.next-index__item:hover .next-index__title,
	.next-index__item:focus-visible .next-index__title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
	}

	.next-index__item:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: -2px;
	}

	@media (max-width: 900px) {
		.next-index__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.next-index__item:nth-child(3) {
			border-left: 0;
			border-top: 1px solid var(--color-index-border);
		}

		.next-index__item:nth-child(4) {
			border-top: 1px solid var(--color-index-border);
		}
	}

	@media (max-width: 640px) {
		.next-index {
			margin-top: 2rem;
		}

		.next-index__grid {
			grid-template-columns: 1fr;
		}

		.next-index__item {
			min-height: auto;
			padding: 1.25rem;
		}

		.next-index__item + .next-index__item {
			border-left: 0;
			border-top: 1px solid var(--color-index-border);
		}

		.next-index__item:nth-child(3),
		.next-index__item:nth-child(4) {
			border-top: 1px solid var(--color-index-border);
		}

		.next-index__description {
			max-width: none;
		}
	}
</style>
