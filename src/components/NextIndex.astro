---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
---

<section class="next-index" aria-labelledby="next-index-title">
	<p id="next-index-title" class="section-label">Where to go next</p>

	<div class="next-index__grid">
		<a href={withBase('/writing')} class="next-index__item">
			<span class="next-index__number">01</span>
			<span class="next-index__title">
				<span>Writing</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Essays and notes on control systems, embedded software, diagnostics, and physical behavior.
			</span>
		</a>

		<a href={withBase('/about')} class="next-index__item">
			<span class="next-index__number">02</span>
			<span class="next-index__title">
				<span>About</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Professional background, education, motivation, and technical leadership.
			</span>
		</a>

		<a href={withBase('/work')} class="next-index__item">
			<span class="next-index__number">03</span>
			<span class="next-index__title">
				<span>Work</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Selected technical work, research, patents, publications, and engineering contributions.
			</span>
		</a>

		<a href={withBase('/contact')} class="next-index__item">
			<span class="next-index__number">04</span>
			<span class="next-index__title">
				<span>Contact</span>
				<span class="next-index__arrow" aria-hidden="true">→</span>
			</span>
			<span class="next-index__description">
				Email, LinkedIn, and CV for hiring or collaboration.
			</span>
		</a>
	</div>
</section>

<style>
	.next-index {
		position: relative;
		z-index: 1;
		margin-top: clamp(3rem, 6vw, 5rem);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.section-label {
		margin: 0;
		padding-block: 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
		border-bottom: 1px solid var(--color-border);
	}

	.next-index__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}

	.next-index__item {
		position: relative;
		display: block;
		min-height: 132px;
		padding: 1.35rem 1.5rem 1.35rem 0;
		color: inherit;
		text-decoration: none;
		transition: background-color 160ms ease-out;
	}

	.next-index__item + .next-index__item {
		padding-left: 1.5rem;
		border-left: 1px solid var(--color-border);
	}

	.next-index__number {
		display: block;
		margin-bottom: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.next-index__title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.next-index__arrow {
		display: inline-block;
		color: var(--color-accent);
		transition: transform 180ms ease-out;
	}

	.next-index__description {
		display: block;
		margin-top: 0.65rem;
		max-width: 220px;
		font-size: 0.88rem;
		line-height: 1.45;
		color: var(--color-muted);
	}

	.next-index__item:hover,
	.next-index__item:focus-visible {
		background: rgba(26, 95, 180, 0.035);
	}

	.next-index__item:hover .next-index__arrow,
	.next-index__item:focus-visible .next-index__arrow {
		transform: translateX(3px);
	}

	.next-index__item:hover .next-index__title,
	.next-index__item:focus-visible .next-index__title {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
	}

	.next-index__item:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.next-index__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.next-index__item:nth-child(3) {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.next-index__item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}
	}

	@media (max-width: 640px) {
		.next-index {
			margin-top: 2.5rem;
		}

		.next-index__grid {
			grid-template-columns: 1fr;
		}

		.next-index__item {
			min-height: auto;
			padding: 1.25rem 0;
		}

		.next-index__item + .next-index__item {
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.next-index__item:nth-child(3),
		.next-index__item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}

		.next-index__description {
			max-width: none;
		}
	}
</style>
