---
import { IDENTITY, LINKEDIN_URL } from '../data/identity';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);
const linkedinHref = LINKEDIN_URL;
---

<footer class="site-footer" id="site-footer-contact">
	<div class="page-container site-footer__inner">
		<span>{IDENTITY.brandLine}</span>

		<nav class="site-footer__links" aria-label="Footer links">
			<a
				href={linkedinHref}
				target="_blank"
				rel="noopener noreferrer"
				data-analytics-event="linkedin_outbound_click"
				data-cta-id="footer-linkedin"
				data-cta-placement="footer"
				data-cta-intent="professional-profile"
				data-source-section="footer"
			>
				LinkedIn
			</a>
			<a
				href={withBase('/cv/Carlos_Jorques_CV.pdf')}
				download
				data-analytics-event="cta_click"
				data-cta-id="footer-cv"
				data-cta-placement="footer"
				data-cta-intent="proof"
				data-source-section="footer"
			>
				CV (PDF)
			</a>
			<a href={withBase('/privacy')}>Privacy</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-footer-bg);
		padding-block: 0 3rem;
		color: var(--color-footer-text);
	}

	.site-footer__inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		font-family: var(--font-body);
		font-size: var(--type-body-size);
		line-height: var(--type-body-line);
		padding-top: 3rem;
		border-top: 1px solid var(--color-footer-border);
	}

	.site-footer__inner > span {
		color: var(--color-footer-text);
	}

	.site-footer__links {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
		font-family: var(--font-body);
		font-size: .95rem;
		font-weight: 600;
		letter-spacing: -.02em;
		text-transform: none;
	}

	.site-footer__links a {
		color: var(--color-footer-link);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		padding-bottom: 0.15rem;
		transition:
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.site-footer__links a:hover,
	.site-footer__links a:focus-visible {
		color: var(--color-footer-link-hover);
		border-bottom-color: var(--color-footer-link-hover);
		transform: translateY(-1px);
	}

	.site-footer__links a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}
</style>
