---
interface Props {
	number: string;
	label: string;
	statement: string;
	secondary?: string;
	expandedId?: string;
	hasToggle?: boolean;
}

const { number, label, statement, secondary, expandedId, hasToggle = true } = Astro.props;
const contentId = expandedId ?? `signal-path-${number}`;
---

<article class="signal-path-item">
	<div class="signal-path-item__node" aria-hidden="true"></div>
	<div class="signal-path-item__content">
		<p class="signal-path-item__label">{number} - {label}</p>
		<h2>{statement}</h2>
		{secondary && <p class="signal-path-item__secondary">{secondary}</p>}
		{hasToggle ? (
			<>
				<button
					class="signal-path-item__toggle"
					type="button"
					aria-expanded="false"
					aria-controls={contentId}
					data-signal-toggle
				>
					Read more
				</button>
				<div class="signal-path-item__extra" id={contentId} data-signal-extra>
					<div class="signal-path-item__extra-inner">
						<slot />
					</div>
				</div>
			</>
		) : (
			<div class="signal-path-item__body">
				<slot />
			</div>
		)}
	</div>
</article>
