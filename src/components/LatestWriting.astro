---
import ArticleRow from './ArticleRow.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);

const articles = [
	{
		number: '01',
		title: 'Closed-loop thinking',
		description: 'Why feedback remains the central idea behind reliable physical systems.',
		href: withBase('/writing/closed-loop-thinking'),
	},
	{
		number: '02',
		title: 'From model to machine',
		description: 'What changes when a control algorithm leaves simulation and meets real hardware.',
		href: withBase('/writing/from-model-to-machine'),
	},
	{
		number: '03',
		title: 'Debugging behavior',
		description: 'A first-principles approach to diagnosing embedded control systems.',
		href: withBase('/writing/debugging-behavior'),
	},
];
---

<section class="latest">
	<div class="page-container">
		<p class="latest__label">Latest writing</p>

		<div class="latest__intro-wrap">
			<p class="latest__intro">
				Developing ideas on control systems, embedded software, diagnostics, automation, and the technical decisions that make complex machines safe and reliable.
			</p>

			<aside class="proof-rail" aria-label="Professional proof points">
				<span class="proof-rail__item">
					<span class="proof-rail__label">10+ years</span>
					<span class="proof-rail__text">Automotive embedded systems</span>
				</span>

				<span class="proof-rail__item">
					<span class="proof-rail__label">Technical leadership</span>
					<span class="proof-rail__text">Model-based software teams</span>
				</span>

				<span class="proof-rail__item">
					<span class="proof-rail__label">PhD-trained</span>
					<span class="proof-rail__text">Real-time control and diagnostics</span>
				</span>

				<span class="proof-rail__item">
					<span class="proof-rail__label">Production context</span>
					<span class="proof-rail__text">EV, powertrain, safety, and validation</span>
				</span>
			</aside>
		</div>

		{articles.map((article) => <ArticleRow {...article} />)}
	</div>
</section>

<style>
	.latest {
		background: var(--color-page);
		border-top: 1px solid var(--color-border-soft);
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.latest__label,
	.section-label {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.latest__intro {
		max-width: 720px;
		margin: 0;
		font-size: clamp(1rem, 1.25vw, 1.15rem);
		line-height: 1.55;
		color: var(--color-text);
	}

	.latest__intro-wrap {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.proof-rail {
		display: grid;
		gap: 0.85rem;
		padding-left: 1.25rem;
		border-left: 1px solid var(--color-border-soft);
	}

	.proof-rail__item {
		display: block;
	}

	.proof-rail__label {
		display: block;
		margin-bottom: 0.16rem;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-soft);
	}

	.proof-rail__text {
		display: block;
		font-size: 0.8rem;
		line-height: 1.35;
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.latest__intro-wrap {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.proof-rail {
			max-width: 640px;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			padding-left: 0;
			padding-top: 1.25rem;
			border-top: 1px solid var(--color-border-soft);
			border-left: 0;
		}
	}

	@media (max-width: 640px) {
		.latest__intro-wrap {
			margin-bottom: 2rem;
		}

		.proof-rail {
			grid-template-columns: 1fr;
		}
	}
</style>
