---
import { getCollection } from 'astro:content';
import ArticleRow from './ArticleRow.astro';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);
const toSlug = (id: string) => id.replace(/\.md$/, '');
const articles = (await getCollection('writing'))
	.filter((entry) => !entry.data.draft)
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
	.slice(0, 3)
	.map((entry, index) => ({
		number: String(index + 1).padStart(2, '0'),
		title: entry.data.title,
		description: entry.data.description,
		href: withBase(`/writing/${toSlug(entry.id)}/`),
		ctaId: `home-writing-${toSlug(entry.id)}`,
	}));
---

<section class="latest" aria-labelledby="writing-title">
	<div class="page-container">
		<div class="latest__header">
			<h2 id="writing-title">Technical insights</h2>
			<p class="latest__intro">
				Published notes on control systems, electrification, diagnostics, and real-time embedded software:
				technical challenges, production constraints, and reliable machine behavior.
			</p>
		</div>

		{articles.map((article) => <ArticleRow {...article} placement="home-writing" sourceSection="latest-writing" />)}

		<div class="latest__footer">
			<a
				href={withBase('/writing')}
				data-analytics-event="cta_click"
				data-cta-id="home-view-all-writing"
				data-cta-placement="home-writing"
				data-cta-intent="authority"
				data-source-section="latest-writing"
			>
				View all writing
			</a>
		</div>
	</div>
</section>

<style>
	.latest {
		background: var(--color-section-bg);
		border-top: 1px solid var(--color-border-soft);
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.latest__header {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
		margin-bottom: clamp(var(--spacing-07), 4vw, var(--spacing-09));
	}

	.latest__header h2 {
		margin: 0;
		font-size: var(--type-section-title-size);
		line-height: var(--type-section-title-line);
		letter-spacing: var(--type-section-title-tracking);
		font-weight: var(--type-section-title-weight);
		max-width: 13ch;
	}

	.latest__intro {
		max-width: 720px;
		margin: 0;
		font-size: var(--type-section-intro-size);
		line-height: var(--type-section-intro-line);
		letter-spacing: var(--type-section-intro-tracking);
		color: var(--color-body-text);
	}

	.latest__footer {
		margin-top: clamp(var(--spacing-06), 3vw, var(--spacing-07));
	}

	.latest__footer a {
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: var(--type-chip-weight);
		letter-spacing: var(--type-chip-tracking);
		text-transform: uppercase;
		color: var(--color-link);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition:
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.latest__footer a:hover,
	.latest__footer a:focus-visible {
		color: var(--color-link-hover);
		border-bottom-color: var(--color-link-hover);
		transform: translateX(4px);
	}

	.latest__footer a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}
</style>
