---
import ArticleRow from './ArticleRow.astro';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);

const articles = [
	{
		number: '01',
		title: 'Closed-loop thinking',
		description: 'Why feedback remains the central idea behind reliable physical systems.',
		href: withBase('/writing/closed-loop-thinking'),
	},
	{
		number: '02',
		title: 'From model to machine',
		description: 'What changes when a control algorithm leaves simulation and meets real hardware.',
		href: withBase('/writing/from-model-to-machine'),
	},
	{
		number: '03',
		title: 'Debugging behavior',
		description: 'A first-principles approach to diagnosing embedded control systems.',
		href: withBase('/writing/debugging-behavior'),
	},
];
---

<section class="latest" aria-labelledby="writing-title">
	<div class="page-container">
		<div class="latest__header">
			<h2 id="writing-title">Technical insights</h2>
			<p class="latest__intro">
				Writing about control systems, electrification, diagnostics, and real-time embedded software.
				These articles discuss and research about technical challenges and solutions, production constraints, and reliable machine behavior.
			</p>
		</div>

		{articles.map((article) => <ArticleRow {...article} />)}

		<div class="latest__footer">
			<a href={withBase('/writing')}>View all writing</a>
		</div>
	</div>
</section>

<style>
	.latest {
		background: var(--color-section-bg);
		border-top: 1px solid var(--color-border-soft);
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.latest__header {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
		margin-bottom: clamp(var(--spacing-07), 4vw, var(--spacing-09));
	}

	.latest__header h2 {
		margin: 0;
		font-size: var(--type-section-title-size);
		line-height: var(--type-section-title-line);
		letter-spacing: var(--type-section-title-tracking);
		font-weight: var(--type-section-title-weight);
		max-width: 13ch;
	}

	.latest__intro {
		max-width: 720px;
		margin: 0;
		font-size: var(--type-section-intro-size);
		line-height: var(--type-section-intro-line);
		letter-spacing: var(--type-section-intro-tracking);
		color: var(--color-body-text);
	}

	.latest__footer {
		margin-top: clamp(var(--spacing-06), 3vw, var(--spacing-07));
	}

	.latest__footer a {
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: var(--type-chip-weight);
		letter-spacing: var(--type-chip-tracking);
		text-transform: uppercase;
		color: var(--color-link);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition:
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.latest__footer a:hover,
	.latest__footer a:focus-visible {
		color: var(--color-link-hover);
		border-bottom-color: var(--color-link-hover);
		transform: translateX(4px);
	}

	.latest__footer a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}
</style>
