---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
const heroVideoUrl = `${baseUrl}videos/333466_1_5.mp4`;
---

<section class="hero-area">
	<video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
		<source src={heroVideoUrl} type="video/mp4" />
	</video>
	<div class="page-container">
		<div class="hero">
			<div class="hero__copy">
				<p class="hero-kicker">Embedded Control Systems Architect · Technical Leader</p>

				<h1 class="hero-name">Carlos Jorques</h1>
				<p class="hero-statement">
					Control Intelligence for Complex Physical Systems.
				</p>
				<p class="hero-substatement">
					With 10+ years of experience in the automotive industry, I lead the design of embedded control software that helps machines sense, decide, act, and operate reliably under real-world constraints.
				</p>

				<div class="hero-links" aria-label="Primary contact links">
					<a href={withBase('/contact')}>Contact</a>
					<a href={withBase('/work')}>Work</a>
					<a href={withBase('/about')}>About</a>
				</div>
			</div>

			<aside class="home-proof" aria-label="Professional proof points">
				<div class="home-proof__grid">
					<div class="home-proof__item">
						<span class="home-proof__value">10+ years</span>
						<span class="home-proof__label">Embedded controls in production environments</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">OEM / Tier 1</span>
						<span class="home-proof__label">Automotive, heavy-duty, and client delivery</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">Standard Compliance</span>
						<span class="home-proof__label">ISO 26262, A-SPICE, AUTOSAR-oriented development</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">PhD-trained</span>
						<span class="home-proof__label">Control systems, diagnostics, modeling, and optimization</span>
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.hero-area {
		--hero-bg: var(--hero-gradient-light);
		--hero-text: var(--color-text);
		--hero-muted: var(--color-muted);
		--hero-muted-soft: var(--color-soft);
		--hero-border: var(--color-border);
		--hero-border-soft: var(--color-border-soft);
		--hero-accent: var(--cocoa-line);
		--hero-accent-warm: var(--color-text);
		--hero-video-opacity: 0.08;
		--hero-video-overlay: linear-gradient(
			180deg,
			rgba(248, 236, 228, 0.9) 0%,
			rgba(232, 199, 187, 0.74) 54%,
			rgba(234, 214, 207, 0.84) 100%
		);

		position: relative;
		overflow: hidden;
		background: var(--hero-bg);
		color: var(--hero-text);
		padding-block: clamp(4.5rem, 8vw, 7.5rem) clamp(3rem, 5vw, 4.5rem);
	}

	.hero-area::before {
		content: "";
		position: absolute;
		inset: auto -8% -24% 38%;
		height: 18rem;
		background: linear-gradient(90deg, rgba(248, 236, 228, 0.2), rgba(80, 103, 124, 0.28));
		transform: rotate(-3deg);
		pointer-events: none;
	}

	:global(:root[data-theme="dark"]) .hero-area {
		--hero-bg: var(--hero-gradient-dark);
		--hero-text: var(--color-text);
		--hero-muted: var(--color-muted);
		--hero-muted-soft: var(--color-soft);
		--hero-border: var(--color-border);
		--hero-border-soft: var(--color-border-soft);
		--hero-accent: var(--blue-fog);
		--hero-accent-warm: var(--warm-paper);
		--hero-video-opacity: 0.12;
		--hero-video-overlay: linear-gradient(
			105deg,
			rgba(16, 22, 29, 0.94) 0%,
			rgba(32, 43, 69, 0.86) 58%,
			rgba(53, 73, 93, 0.74) 100%
		);

		background: var(--hero-bg);
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: var(--hero-video-opacity);
		pointer-events: none;
	}

	.hero-area .page-container {
		position: relative;
		z-index: 2;
	}

	.hero-area::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: var(--hero-video-overlay);
		pointer-events: none;
	}

	.hero {
		position: relative;
		z-index: 1;
	}

	.hero__copy {
		max-width: 940px;
		margin-inline: auto;
		text-align: center;
	}

	.hero-kicker,
	.hero-name,
	.hero-statement,
	.hero-substatement,
	.hero-links,
	.home-proof {
		animation: carbon-enter-up var(--motion-duration-slow-01) var(--motion-entrance-expressive) both;
	}

	.hero-name {
		animation-delay: 40ms;
	}

	.hero-statement {
		animation-delay: 90ms;
	}

	.hero-substatement {
		animation-delay: 140ms;
	}

	.hero-links {
		animation-delay: 190ms;
	}

	.home-proof {
		animation-delay: 240ms;
	}

	.hero-kicker {
		margin: 0 0 var(--spacing-05);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--hero-muted);
	}

	.hero-name {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(2.8rem, 6vw, 5.8rem);
		line-height: 0.95;
		font-weight: 700;
		letter-spacing: 0;
		color: var(--hero-text);
	}

	.hero-statement {
		max-width: 620px;
		margin: var(--spacing-07) auto 0;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		line-height: 1.08;
		font-weight: 400;
		color: var(--hero-text);
		font-family: var(--font-mono);
	}

	@supports ((-webkit-background-clip: text) or (background-clip: text)) {
		.hero-statement {
			background: var(--slogan-gradient-light);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
		}

		:global(:root[data-theme="dark"]) .hero-statement {
			background: var(--slogan-gradient-dark);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
		}
	}

	.hero-substatement {
		max-width: 680px;
		margin: var(--spacing-07) auto 0;
		font-size: clamp(1.05rem, 1.25vw, 1.2rem);
		line-height: 1.5;
		font-weight: 400;
		color: var(--hero-muted);
	}

	.hero-links {
		margin-top: var(--spacing-09);
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero-links a {
		color: var(--hero-text);
		text-decoration: none;
		border-bottom: 1px solid var(--hero-accent);
		padding-bottom: 0.15rem;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.hero-links a:hover,
	.hero-links a:focus-visible {
		color: var(--hero-accent);
		border-bottom-color: var(--hero-accent);
		transform: translateY(-1px);
	}

	.hero-links a:active {
		transform: translateY(0);
		transition-duration: var(--motion-duration-fast-01);
	}

	.hero-links a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	.home-proof {
		margin-top: clamp(3rem, 5vw, 6rem);
		padding-top: clamp(1rem, 2vw, 1.25rem);
		border-top: 1px solid var(--hero-border);
	}

	.home-proof__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0;
	}

	.home-proof__item {
		min-height: 58px;
		padding: 0.15rem 1.1rem 0.15rem 0;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.home-proof__item:hover {
		transform: translateY(-1px);
	}

	.home-proof__item + .home-proof__item {
		padding-left: 1.1rem;
		border-left: 1px solid var(--hero-border-soft);
	}

	.home-proof__value {
		display: block;
		margin-bottom: var(--spacing-02);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.075em;
		text-transform: uppercase;
		color: var(--hero-accent-warm);
	}

	.home-proof__label {
		display: block;
		max-width: 230px;
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--hero-muted-soft);
	}

	@media (max-width: 900px) {
		.hero-area::after {
			opacity: 1;
		}

		.home-proof__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.home-proof__item:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}

		.home-proof__item:nth-child(3),
		.home-proof__item:nth-child(4) {
			margin-top: var(--spacing-03);
			padding-top: var(--spacing-03);
			border-top: 1px solid var(--hero-border-soft);
		}
	}

	@media (max-width: 640px) {
		.hero-area {
			padding-block: 3.5rem 2.5rem;
		}

		.hero-name {
			font-size: clamp(2.4rem, 15vw, 4rem);
		}

		.hero-statement {
			font-size: clamp(1.35rem, 7vw, 2rem);
		}

		.hero-links {
			gap: 1rem;
		}

		.home-proof {
			margin-top: var(--spacing-07);
		}

		.home-proof__grid {
			grid-template-columns: 1fr;
		}

		.home-proof__item {
			min-height: auto;
			padding: 0.75rem 0;
		}

		.home-proof__item:first-child {
			padding-top: 0;
		}

		.home-proof__item:last-child {
			padding-bottom: 0;
		}

		.home-proof__item + .home-proof__item,
		.home-proof__item:nth-child(3),
		.home-proof__item:nth-child(4) {
			margin-top: 0;
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--hero-border-soft);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-video {
			display: none;
		}
	}
</style>
