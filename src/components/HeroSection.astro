---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
const heroVideoUrl = `${baseUrl}videos/333466_1_5.mp4`;
const cvUrl = `${baseUrl}cv/Carlos_Jorques_CV.pdf`;
---

<section class="hero-area">
	<div class="page-container">
		<div class="hero">
			<div class="hero__copy">
				<p class="hero-kicker">Carlos Jorques · Embedded Control Systems Architect</p>

				<h1 class="hero-name">Embedded Control Systems Architect</h1>
				<p class="hero-statement">
					Control Intelligence for <span class="hero-statement__gradient">Physical Systems.</span>
				</p>
				<p class="hero-substatement">
					I lead the design of production-ready embedded control systems for vehicles and smart machines, connecting sensing, signal processing, embedded software, control algorithms, diagnostics, actuation, safety, and delivery.
				</p>

				<div class="hero-links" aria-label="Primary contact links">
					<a class="hero-link hero-link--primary" href={withBase('/contact')}>Contact me</a>
					<a class="hero-link" href={withBase('/cases')}>View cases</a>
					<a class="hero-link" href={cvUrl} download>Download CV</a>
				</div>
			</div>

			<aside class="hero-visual" aria-label="Automotive-inspired embedded systems visual">
				<div class="hero-visual__media">
					<video autoplay muted loop playsinline preload="metadata" aria-hidden="true">
						<source src={heroVideoUrl} type="video/mp4" />
					</video>
				</div>
				<div class="hero-visual__label">
					<span>Sensing</span>
					<span>Control</span>
					<span>Actuation</span>
				</div>
			</aside>

			<aside class="home-proof" aria-label="Professional proof points">
				<div class="home-proof__grid">
					<div class="home-proof__item">
						<span class="home-proof__value">10+ years</span>
						<span class="home-proof__label">Embedded controls in production environments</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">OEM / Tier 1</span>
						<span class="home-proof__label">Automotive, heavy-duty, and client delivery</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">Standard Compliance</span>
						<span class="home-proof__label">ISO 26262, A-SPICE, AUTOSAR-oriented development</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">PhD-trained</span>
						<span class="home-proof__label">Control systems, diagnostics, modeling, and optimization</span>
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.hero-area {
		--hero-bg: var(--hero-gradient);
		--hero-text: var(--deep-glass);
		--hero-muted: var(--shadow-blue);
		--hero-muted-soft: var(--cocoa-line);
		--hero-border: rgba(127, 98, 91, 0.22);
		--hero-border-soft: rgba(80, 103, 124, 0.2);
		--hero-accent: var(--shadow-blue);
		--hero-accent-warm: var(--rose-stone);

		position: relative;
		overflow: hidden;
		background: var(--hero-bg);
		color: var(--hero-text);
		padding-block: clamp(4.5rem, 8vw, 7.5rem) clamp(3rem, 5vw, 4.5rem);
		transition:
			background-color 180ms ease-out,
			color 180ms ease-out;
	}

	.hero-area::before {
		content: "";
		position: absolute;
		inset: auto -8% -24% 38%;
		height: 18rem;
		background: linear-gradient(90deg, rgba(248, 236, 228, 0.2), rgba(80, 103, 124, 0.28));
		transform: rotate(-3deg);
		pointer-events: none;
	}

	:global(:root[data-theme="dark"]) .hero-area {
		--hero-bg: var(--color-dark-surface);
		--hero-text: var(--color-on-dark);
		--hero-muted: var(--color-on-dark-muted);
		--hero-muted-soft: var(--color-on-dark-muted-soft);
		--hero-border: var(--color-on-dark-border);
		--hero-border-soft: var(--color-on-dark-border-soft);
		--hero-accent: var(--color-accent);
		--hero-accent-warm: var(--rose-stone);
		background:
			linear-gradient(105deg, rgba(16, 22, 29, 0.96), rgba(53, 73, 93, 0.84) 58%, rgba(188, 200, 212, 0.2)),
			var(--hero-bg);
	}

	.hero-area .page-container {
		position: relative;
		z-index: 2;
	}

	.hero {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1.06fr) minmax(18rem, 0.72fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: end;
	}

	.hero__copy {
		max-width: 760px;
		text-align: left;
	}

	.hero-kicker,
	.hero-name,
	.hero-statement,
	.hero-substatement,
	.hero-links,
	.home-proof {
		animation: carbon-enter-up var(--motion-duration-slow-01) var(--motion-entrance-expressive) both;
	}

	.hero-name {
		animation-delay: 40ms;
	}

	.hero-statement {
		animation-delay: 90ms;
	}

	.hero-substatement {
		animation-delay: 140ms;
	}

	.hero-links {
		animation-delay: 190ms;
	}

	.home-proof {
		animation-delay: 240ms;
	}

	.hero-kicker {
		margin: 0 0 var(--spacing-05);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--hero-muted);
	}

	.hero-name {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(2.65rem, 5.8vw, 5.5rem);
		line-height: 0.98;
		font-weight: 700;
		letter-spacing: 0;
		color: var(--hero-text);
	}

	.hero-statement {
		max-width: 680px;
		margin: var(--spacing-07) 0 0;
		font-size: clamp(1.7rem, 3vw, 2.75rem);
		line-height: 1.08;
		font-weight: 400;
		color: var(--hero-text);
		font-family: Georgia, "Times New Roman", serif;
		font-style: italic;
	}

	@supports ((-webkit-background-clip: text) or (background-clip: text)) {
		.hero-statement__gradient {
			background: var(--slogan-gradient);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
		}
	}

	.hero-substatement {
		max-width: 700px;
		margin: var(--spacing-07) 0 0;
		font-size: clamp(1rem, 1.25vw, 1.16rem);
		line-height: 1.65;
		font-weight: 400;
		color: var(--hero-muted);
	}

	.hero-links {
		margin-top: var(--spacing-09);
		display: flex;
		justify-content: flex-start;
		gap: 0.8rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero-link {
		display: inline-flex;
		min-height: 40px;
		align-items: center;
		border: 1px solid var(--hero-accent);
		color: var(--hero-accent);
		padding: 0.55rem 0.95rem;
		text-decoration: none;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.hero-link--primary {
		background: var(--deep-glass);
		border-color: var(--deep-glass);
		color: var(--warm-paper);
	}

	:global(:root[data-theme="dark"]) .hero-link--primary {
		background: var(--warm-paper);
		border-color: var(--warm-paper);
		color: var(--deep-glass);
	}

	.hero-link:hover,
	.hero-link:focus-visible {
		background: var(--hero-accent);
		border-color: var(--hero-accent);
		color: var(--warm-paper);
		transform: translateY(-1px);
	}

	.hero-link--primary:hover,
	.hero-link--primary:focus-visible {
		background: transparent;
		color: var(--hero-accent);
	}

	.hero-link:active {
		transform: translateY(0);
		transition-duration: var(--motion-duration-fast-01);
	}

	.hero-link:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	.hero-visual {
		position: relative;
		min-height: clamp(20rem, 34vw, 27rem);
		border: 1px solid rgba(255, 250, 246, 0.34);
		background:
			linear-gradient(150deg, rgba(255, 250, 246, 0.2), rgba(16, 22, 29, 0.04)),
			linear-gradient(120deg, rgba(188, 200, 212, 0.5), rgba(216, 170, 160, 0.34));
		box-shadow: 0 24px 80px rgba(16, 22, 29, 0.12);
		overflow: hidden;
	}

	.hero-visual__media {
		position: absolute;
		inset: 2.25rem 2.25rem 5.5rem;
		background: var(--deep-glass);
		box-shadow: 0 18px 56px rgba(16, 22, 29, 0.24);
		overflow: hidden;
	}

	.hero-visual__media::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(155deg, rgba(16, 22, 29, 0.62), rgba(53, 73, 93, 0.3) 55%, rgba(188, 200, 212, 0.12));
		pointer-events: none;
	}

	.hero-visual video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.8;
	}

	.hero-visual__label {
		position: absolute;
		left: 2.35rem;
		right: 2.35rem;
		bottom: 2rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--hero-muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.home-proof {
		grid-column: 1 / -1;
		margin-top: clamp(3rem, 5vw, 6rem);
		padding-top: clamp(1rem, 2vw, 1.25rem);
		border-top: 1px solid var(--hero-border);
	}

	.home-proof__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0;
	}

	.home-proof__item {
		min-height: 58px;
		padding: 0.15rem 1.1rem 0.15rem 0;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.home-proof__item:hover {
		transform: translateY(-1px);
	}

	.home-proof__item + .home-proof__item {
		padding-left: 1.1rem;
		border-left: 1px solid var(--hero-border-soft);
	}

	.home-proof__value {
		display: block;
		margin-bottom: var(--spacing-02);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--hero-accent-warm);
	}

	.home-proof__label {
		display: block;
		max-width: 230px;
		font-size: 0.82rem;
		line-height: 1.35;
		color: var(--hero-muted-soft);
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.home-proof__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.home-proof__item:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}

		.home-proof__item:nth-child(3),
		.home-proof__item:nth-child(4) {
			margin-top: var(--spacing-03);
			padding-top: var(--spacing-03);
			border-top: 1px solid var(--hero-border-soft);
		}
	}

	@media (max-width: 640px) {
		.hero-area {
			padding-block: 3.5rem 2.5rem;
		}

		.hero-name {
			font-size: clamp(2.4rem, 15vw, 4rem);
		}

		.hero-statement {
			font-size: clamp(1.35rem, 7vw, 2rem);
		}

		.hero-links {
			gap: 1rem;
		}

		.hero-link {
			width: 100%;
			justify-content: center;
		}

		.hero-visual {
			min-height: 18rem;
		}

		.hero-visual__media {
			inset: 1rem 1rem 4.5rem;
		}

		.hero-visual__label {
			left: 1rem;
			right: 1rem;
			bottom: 1.5rem;
		}

		.home-proof {
			margin-top: var(--spacing-07);
		}

		.home-proof__grid {
			grid-template-columns: 1fr;
		}

		.home-proof__item {
			min-height: auto;
			padding: 0.75rem 0;
		}

		.home-proof__item:first-child {
			padding-top: 0;
		}

		.home-proof__item:last-child {
			padding-bottom: 0;
		}

		.home-proof__item + .home-proof__item,
		.home-proof__item:nth-child(3),
		.home-proof__item:nth-child(4) {
			margin-top: 0;
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--hero-border-soft);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-visual video {
			display: none;
		}
	}
</style>
