---
const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
const linkedInUrl = 'REPLACE_WITH_LINKEDIN_URL';
const cvUrl = 'REPLACE_WITH_CV_URL';
---

<section class="hero-area">
	<div class="page-container">
		<div class="hero">
			<div class="hero__copy">
				<p class="hero-kicker">Embedded Controls Architect · Technical Leader</p>

				<h1 class="hero-name">Carlos Jorques</h1>

				<p class="hero-statement">
					I lead the design of control strategies for complex intelligent systems.
				</p>
				<p class="hero-substatement">
					Reliabale embedded software for safety-critical applications.
				</p>

				<div class="hero-links" aria-label="Primary contact links">
					<a href={withBase('/contact')}>Contact</a>
					<a href={linkedInUrl}>LinkedIn</a>
					<a href={cvUrl}>CV</a>
				</div>
			</div>

			<aside class="home-proof" aria-label="Professional proof points">
				<div class="home-proof__grid">
					<div class="home-proof__item">
						<span class="home-proof__value">10+ years</span>
						<span class="home-proof__label">Embedded controls in production environments</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">OEM / Tier 1</span>
						<span class="home-proof__label">Automotive, heavy-duty, and client delivery context</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">Safety-related</span>
						<span class="home-proof__label">ISO 26262, A-SPICE, AUTOSAR-oriented development</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">PhD-trained</span>
						<span class="home-proof__label">Control systems, diagnostics, modeling, and evidence</span>
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.hero-area {
		position: relative;
		overflow: hidden;
		background: #1a1a1aff;
		padding-block: clamp(4.5rem, 8vw, 7.5rem) clamp(3rem, 5vw, 4.5rem);
	}

	.hero-area .page-container {
		position: relative;
		z-index: 1;
	}

	.hero {
		position: relative;
		z-index: 1;
	}

	.hero__copy {
		max-width: 940px;
		margin-inline: auto;
		text-align: center;
	}

	.hero-kicker {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #2f8cff;
	}

	.hero-name {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(2.8rem, 6vw, 5.8rem);
		line-height: 0.95;
		font-weight: 700;
		letter-spacing: 0;
		color: #ffffff;
	}

	.hero-statement {
		max-width: 760px;
		margin: 1.35rem auto 0;
		font-family: var(--font-sans);
		font-size: clamp(1.4rem, 2.4vw, 2.25rem);
		line-height: 1.18;
		font-weight: 400;
		letter-spacing: 0;
		color: #ffffff;
	}

	.hero-substatement {
		max-width: 760px;
		margin: 1rem auto 0;
		font-family: var(--font-sans);
		font-size: clamp(1.5rem, 1.4vw, 1rem);
		line-height: 1.18;
		font-weight: 200;
		letter-spacing: 0;
		color: #ffffff;
	}
	.hero-links {
		margin-top: 1.75rem;
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero-links a {
		color: #ffffff;
		text-decoration: none;
		border-bottom: 1px solid #2f8cff;
		padding-bottom: 0.15rem;
		transition: color 160ms ease-out, border-color 160ms ease-out;
	}

	.hero-links a:hover,
	.hero-links a:focus-visible {
		color: #2f8cff;
		border-bottom-color: #2f8cff;
	}

	.hero-links a:focus-visible {
		outline: 2px solid #2f8cff;
		outline-offset: 4px;
	}

	.home-proof {
		margin-top: clamp(3rem, 5vw, 6rem);
		padding-top: clamp(1rem, 2vw, 1.25rem);
		border-top: 1px solid rgba(247, 247, 247, 0.14);
	}

	.home-proof__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0;
	}

	.home-proof__item {
		min-height: 58px;
		padding: 0.15rem 1.1rem 0.15rem 0;
	}

	.home-proof__item + .home-proof__item {
		padding-left: 1.1rem;
		border-left: 1px solid rgba(247, 247, 247, 0.12);
	}

	.home-proof__value {
		display: block;
		margin-bottom: 0.22rem;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(47, 140, 255, 0.92);
	}

	.home-proof__label {
		display: block;
		max-width: 230px;
		font-size: 0.82rem;
		line-height: 1.35;
		color: rgba(247, 247, 247, 0.66);
	}

	@media (max-width: 900px) {
		.hero-area::after {
			width: 56vw;
			opacity: 0.18;
		}

		.home-proof__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.home-proof__item:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}

		.home-proof__item:nth-child(3),
		.home-proof__item:nth-child(4) {
			margin-top: 0.8rem;
			padding-top: 0.8rem;
			border-top: 1px solid rgba(247, 247, 247, 0.12);
		}
	}

	@media (max-width: 640px) {
		.hero-area {
			padding-block: 3.5rem 2.5rem;
		}

		.hero-area::after {
			display: none;
		}

		.hero-name {
			font-size: clamp(2.4rem, 15vw, 4rem);
		}

		.hero-statement {
			font-size: clamp(1.35rem, 7vw, 2rem);
		}

		.hero-links {
			gap: 1rem;
		}

		.home-proof {
			margin-top: 1.8rem;
		}

		.home-proof__grid {
			grid-template-columns: 1fr;
		}

		.home-proof__item {
			min-height: auto;
			padding: 0.75rem 0;
		}

		.home-proof__item:first-child {
			padding-top: 0;
		}

		.home-proof__item:last-child {
			padding-bottom: 0;
		}

		.home-proof__item + .home-proof__item,
		.home-proof__item:nth-child(3),
		.home-proof__item:nth-child(4) {
			margin-top: 0;
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid rgba(247, 247, 247, 0.12);
		}
	}
</style>
