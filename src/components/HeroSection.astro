---
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);
const heroVideoUrl = `${normalizedBase}videos/333466_1_5.mp4`;
---

<section class="hero-area">
	<video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
		<source src={heroVideoUrl} type="video/mp4" />
	</video>
	<div class="page-container">
		<div class="hero">
			<div class="hero__copy">
				<p class="hero-kicker section-eyebrow">Embedded Control Architect · Technical Leader</p>

				<h1 class="hero-name hero-title">Carlos Jorques</h1>
				<p class="hero-statement hero-role">
					<span>Control software for</span>
					<span>software-defined physical systems.</span>
				</p>
				<p class="hero-substatement hero-summary">
					With 10+ years in automotive and production embedded systems, I lead embedded control software development that helps teams close the gap between control design and real-world behavior, making complex systems predictable, maintainable, and trusted beyond simulation.
				</p>

				<div class="hero-links" aria-label="Primary contact links">
					<a href={withBase('/work')}>Work</a>
					<a href={withBase('/about')}>About</a>
					<a href={withBase('/contact')}>Contact</a>
				</div>
			</div>

			<aside class="home-proof" aria-label="Professional proof points">
				<div class="home-proof__grid">
					<div class="home-proof__item">
						<span class="home-proof__value">10+ Years</span>
						<span class="home-proof__label">Embedded controls in production environments</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">OEM / Tier 1</span>
						<span class="home-proof__label">Automotive, heavy-duty, and client delivery</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">Standards &amp; Quality</span>
						<span class="home-proof__label">ISO 26262, A-SPICE, AUTOSAR-oriented development</span>
					</div>

					<div class="home-proof__item">
						<span class="home-proof__value">PhD-Trained</span>
						<span class="home-proof__label">Control systems, diagnostics, modeling, and optimization</span>
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>

<style>
	.hero-area {
		--hero-video-opacity: 0.1;

		position: relative;
		overflow: hidden;
		background: var(--hero-gradient);
		color: var(--color-hero-text);
		padding-block: clamp(4.5rem, 8vw, 7.5rem) clamp(3rem, 5vw, 4.5rem);
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: var(--hero-video-opacity);
		pointer-events: none;
	}

	.hero-area .page-container {
		position: relative;
		z-index: 2;
	}

	.hero-area::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: var(--hero-video-overlay);
		pointer-events: none;
	}

	.hero {
		position: relative;
		z-index: 1;
	}

	.hero__copy {
		max-width: 940px;
		margin-inline: auto;
		text-align: center;
	}

	.hero-kicker,
	.hero-name,
	.hero-statement,
	.hero-substatement,
	.hero-links,
	.home-proof {
		animation: carbon-enter-up var(--motion-duration-slow-01) var(--motion-entrance-expressive) both;
	}

	.hero-name {
		animation-delay: 40ms;
	}

	.hero-statement {
		animation-delay: 90ms;
	}

	.hero-substatement {
		animation-delay: 140ms;
	}

	.hero-links {
		animation-delay: 190ms;
	}

	.home-proof {
		animation-delay: 240ms;
	}

	.hero-kicker {
		margin: 0 0 var(--spacing-05);
		font-family: var(--font-mono);
		font-size: var(--type-eyebrow-size);
		font-weight: var(--type-eyebrow-weight);
		letter-spacing: var(--type-eyebrow-tracking);
		text-transform: uppercase;
		color: var(--color-hero-kicker);
	}

	.hero-name {
		margin: 0;
		margin-inline: auto;
		width: fit-content;
		font-size: var(--type-hero-name-size);
		line-height: var(--type-hero-name-line);
		letter-spacing: var(--type-hero-name-tracking);
		font-weight: var(--type-hero-name-weight);
		color: var(--color-hero-text);
	}

	.hero-statement {
		max-width: 760px;
		margin: var(--spacing-07) auto 0;
		font-size: var(--type-hero-role-size);
		line-height: var(--type-hero-role-line);
		letter-spacing: var(--type-hero-role-tracking);
		font-weight: var(--type-hero-role-weight);
		color: var(--color-hero-text);
	}

	.hero-statement span {
		display: block;
	}

	@supports ((-webkit-background-clip: text) or (background-clip: text)) {
		.hero-statement {
			background: var(--slogan-gradient);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
		}
	}

	.hero-substatement {
		max-width: 680px;
		margin: var(--spacing-07) auto 0;
		font-size: var(--type-hero-summary-size);
		line-height: var(--type-hero-summary-line);
		letter-spacing: var(--type-hero-summary-tracking);
		font-weight: var(--type-hero-summary-weight);
		color: var(--color-hero-text);
	}

	.hero-links {
		margin-top: var(--spacing-09);
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: var(--type-nav-size);
		font-weight: var(--type-nav-weight);
		letter-spacing: var(--type-nav-tracking);
		text-transform: uppercase;
	}

	.hero-links a {
		color: var(--color-hero-link);
		text-decoration: none;
		border-bottom: 1px solid var(--color-hero-link-hover);
		padding-bottom: 0.15rem;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.hero-links a:hover,
	.hero-links a:focus-visible {
		color: var(--color-hero-link-hover);
		border-bottom-color: var(--color-hero-link-hover);
		transform: translateY(-1px);
	}

	.hero-links a:active {
		transform: translateY(0);
		transition-duration: var(--motion-duration-fast-01);
	}

	.hero-links a:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	.home-proof {
		margin-top: clamp(3rem, 5vw, 6rem);
		padding-top: clamp(0.85rem, 1.6vw, 1.1rem);
		border-top: 1px solid var(--color-border);
	}

	.home-proof__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0;
	}

	.home-proof__item {
		min-height: 52px;
		padding: 0.15rem 1.1rem 0.15rem 0;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.home-proof__item:hover {
		transform: translateY(-1px);
	}

	.home-proof__item + .home-proof__item {
		padding-left: 1.1rem;
		border-left: 1px solid var(--color-border-soft);
	}

	.home-proof__value {
		display: block;
		margin-bottom: 0.35rem;
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: 600;
		letter-spacing: var(--type-meta-tracking);
		text-transform: uppercase;
		color: var(--color-hero-proof-value);
	}

	.home-proof__label {
		display: block;
		max-width: 230px;
		font-family: var(--font-body);
		font-size: var(--type-meta-size);
		line-height: 1.45;
		letter-spacing: 0;
		color: var(--color-hero-proof-label);
	}

	@media (max-width: 900px) {
		.hero-area::after {
			opacity: 1;
		}

		.home-proof__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.home-proof__item:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}

		.home-proof__item:nth-child(3),
		.home-proof__item:nth-child(4) {
			margin-top: var(--spacing-03);
			padding-top: var(--spacing-03);
			border-top: 1px solid var(--color-border-soft);
		}
	}

	@media (max-width: 640px) {
		.hero-area {
			padding-block: 3.5rem 2.5rem;
		}

		.hero-name {
			font-size: var(--type-hero-name-size);
		}

		.hero-statement {
			font-size: var(--type-hero-role-size);
		}

		.hero-links {
			gap: 1rem;
		}

		.home-proof {
			margin-top: var(--spacing-07);
		}

		.home-proof__grid {
			grid-template-columns: 1fr;
		}

		.home-proof__item {
			min-height: auto;
			padding: 0.75rem 0;
		}

		.home-proof__item:first-child {
			padding-top: 0;
		}

		.home-proof__item:last-child {
			padding-bottom: 0;
		}

		.home-proof__item + .home-proof__item,
		.home-proof__item:nth-child(3),
		.home-proof__item:nth-child(4) {
			margin-top: 0;
			padding-left: 0;
			border-left: 0;
			border-top: 1px solid var(--color-border-soft);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-video {
			display: none;
		}
	}
</style>
