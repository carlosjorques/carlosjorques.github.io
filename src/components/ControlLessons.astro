			cur.forEach((t, i) => {
				const upto = Math.min(t.run.x.length, Math.max(1, Math.round(t.run.x.length * frac)));
				if (!t.run.x.length) return;
				if (i === 0) {
					fills.push(el('svg:path', { class: 'cl__fill cl__fill--power', d: areaOf(t.run, 1, upto) }));
					fills.push(el('svg:path', { class: 'cl__fill cl__fill--brake', d: areaOf(t.run, -1, upto) }));
				}
				lines.push(el('svg:path', { class: `cl__line ${styles[i]}`, d: pathOf(t.run, 'v', YV, upto) }));
				lines.push(el('svg:path', { class: `cl__line cl__line--pedal ${styles[i]}`, d: pathOf(t.run, 'pedal', YP, upto) }));
				if (i === 0 && lv.ffLine && t.run.ff.length) lines.push(el('svg:path', { class: 'cl__line cl__line--ff', d: pathOf(t.run, 'ff', YP, upto) }));
			});
