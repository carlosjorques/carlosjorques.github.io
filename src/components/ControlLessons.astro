			const pts = hs.map((h, i) => `${X((route.length * i) / 120).toFixed(1)} ${YR(h).toFixed(1)}`);
			r.push(el('svg:path', { class: 'cl__ground', d: `M${X(0)} ${P.road[1]} L${pts.join(' L')} L${X(route.length)} ${P.road[1]} Z` }));
