			const i = lead ? at(lead) : -1;
			const km = lead && lead.x.length ? lead.x[i] : 0;
			placeOne(truck, km, 0);
			cursor.setAttribute('x1', X(km).toFixed(1)); cursor.setAttribute('x2', X(km).toFixed(1));
			const second = cur[1]?.run;
			truck2.style.display = second ? '' : 'none';
			if (second && second.x.length) placeOne(truck2, second.x[at(second)], 12);
			const parts = [];
			if (lead && lead.x.length) {
				if (second && second.x.length) parts.push(['a', `${cur[0].label.split(',')[0]}: ${Math.round(lead.v[i])} km/h`], ['b', `   ${cur[1].label.split(',')[0]}: ${Math.round(second.v[at(second)])} km/h`]);
				else parts.push(['a', `${Math.round(lead.v[i])} km/h`], ['m', `   pedal ${pedalText(lead.pedal[i])}`]);
