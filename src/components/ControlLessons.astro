				if (n) setStars(lv.id, n);
				note = `Run ${runs}: ${res.text}`;
			}
			if (done && lv.predict && guess) note += lv.predict.right ? ` You guessed ${guess.toLowerCase()}${guess === lv.predict.right ? ', which is right.' : '; the note below explains why.'}` : ` You guessed ${guess.toLowerCase()}.`;
			if (done && index < LEVELS.length - 1) note += ' The next level is open.';
