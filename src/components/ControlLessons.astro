---
// Game console for the article "Build a cruise controller yourself". The Markdown holds one placeholder,
//   <div class="cl-game" data-cl-game></div>
// which becomes a level picker and one level at a time. A level unlocks when the previous one is passed or skipped.
// After each level a short note links to the theory section of the article, found by its H3 "Level n: ...".
// Links of the form #play-<id> anywhere in the page open that level. The truck model is in src/scripts/cruise.js.
---

<script>
	import { road, makeSim, simulate, measure, shake, plan } from '../scripts/cruise.js';

	const STORE = 'control-lessons-v1';
	const ROADS = {
		hill: road([[0, 0], [0.6, 2], [2.4, 0]], 3.4),
		steep: road([[0, 0], [0.6, 4], [1.6, 0]], 3.2),
		roll: road([[0, 0], [0.8, 2.5], [2.0, 0], [2.6, -3], [3.6, 0], [4.2, 1.5], [5.2, 0]], 6),
	};
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const phone = matchMedia('(max-width: 640px)');
	const f1 = (v) => v.toFixed(1);
	const dev = (r, a, b) => { const m = measure(r, a, b); return Math.max(m.low, m.high); };
	const droop = (r, a, b) => {
		let s = 0, n = 0;
		r.x.forEach((x, i) => { if (x >= a && x <= b) { s += r.ref[i] - r.v[i]; n += 1; } });
		return s / Math.max(n, 1);
	};
	const strokes = (r) => r.activity / 30;
	const pedalText = (p) => (p >= 0 ? `${Math.round(p)}% power` : `${Math.round(-p)}% brake`);
	const knob = (key, label, min, max, step, value, fmt, ends, lever = false) => ({ key, label, min, max, step, value, fmt, ends, lever });
	const kpKnob = (v) => knob('kp', 'Proportional gain, Kp', 0, 20, 0.5, v, (x) => `${f1(x)} kN per km/h`, ['Gentle', 'Strong']);
	const kiKnob = (v) => knob('ki', 'Integral gain, Ki', 0, 4, 0.05, v, (x) => `${x.toFixed(2)} kN per km/h per s`, ['None', 'Strong']);
	let ffBase = null, fbBase = null;
	const baseRun = () => (ffBase ??= simulate({ route: ROADS.roll, ctrl: { mode: 'pi', kp: 4, ki: 0.5, antiWindup: true, ff: true, ffMass: 40 } }));
	const fbRun = () => (fbBase ??= simulate({ route: ROADS.roll, ctrl: { mode: 'pi', kp: 4, ki: 0.5, antiWindup: true } }));
	const kwh = (r) => `${r.energy.toFixed(2)} kWh, ${r.brake.toFixed(2)} kWh braked away`;

	// Each level: road, knobs, how to run it, and three tiers of stars (or a single "done" for the explore levels).
	const LEVELS = [
		{
			id: 'drive', title: 'Can you hold 80 km/h?', road: 'hill', band: 3, live: true,
			goal: 'Keep the truck at 80 km/h over the hill. Press start, then drag up or down on the pedal plot, or use the arrow keys.',
			knobs: [knob('pedal', 'Pedal', -100, 100, 5, 30, pedalText, ['Brake', 'Full power'], true)],
			tiers: ['Within ±8 km/h', 'Within ±5 km/h', 'Within ±3 km/h'],
			score: ([r]) => { const d = dev(r); return { pass: [d <= 8, d <= 5, d <= 3], text: `furthest from 80 km/h: ${f1(d)} km/h.` }; },
		},
		{
			id: 'open', title: 'Can one fixed pedal do it?', road: 'hill', band: 3, explore: 2, dur: 6500,
			goal: 'Set the pedal once, and the truck drives the whole road with it.',
			predict: { q: 'Is there one pedal position that does it?', options: ['Yes', 'No'], right: 'No' },
			knobs: [knob('pedal', 'Fixed pedal', 0, 100, 1, 28, pedalText, ['Idle', 'Full power'], true)],
			ctrl: (k) => ({ mode: 'fixed', pedal: k.pedal }),
			tiers: ['Within ±3 km/h for the whole road'],
			score: ([r]) => { const m = measure(r); return { pass: [Math.max(m.low, m.high) <= 3], text: `lowest ${f1(80 - m.low)} km/h, highest ${f1(80 + m.high)} km/h.` }; },
			done: 'No fixed pedal does it: enough pedal for the hill is too much for the flat.',
		},
		{
			id: 'onoff', title: 'Can a simple rule beat you?', road: 'hill', band: 3,
			goal: 'The computer drives like a thermostat: full power below the lower line, no power above the upper one. Set how far apart the lines are.',
			predict: { q: 'Will this rule hold the speed closer to 80 km/h than you did in level 1?', options: ['Yes', 'No'] },
			knobs: [knob('band', 'Switching lines', 0.25, 3, 0.25, 0.5, (x) => `80 ± ${x} km/h`, ['Close together', 'Far apart'])],
			ctrl: (k) => ({ mode: 'onoff', band: 2 * k.band }),
			lines: (k) => [{ v: 80 + k.band, label: 'Power off above', up: true }, { v: 80 - k.band, label: 'Power on below', up: false }],
			tiers: ['Within ±5 km/h', 'Within ±3 km/h', 'Within ±3 km/h and at most 6 switches a minute'],
			score: ([r]) => { const d = dev(r); return { pass: [d <= 5, d <= 3, d <= 3 && r.switches <= 6], text: `within ±${f1(d)} km/h, ${f1(r.switches)} switches a minute.` }; },
		},
		{
			id: 'p', title: 'Can the pedal move more gently?', road: 'hill', band: 3,
			goal: 'The controller pushes harder the slower the truck is. Set how hard, so the truck loses little speed on the climb without shaking.',
			knobs: [kpKnob(1)],
			ctrl: (k) => ({ mode: 'pi', kp: k.kp }),
			tiers: ['At most 4 km/h slow on the climb, no shaking', 'At most 2 km/h slow', 'At most 1 km/h slow'],
			score: ([r]) => {
				const d = droop(r, 1.9, 2.4), s = shake(r), calm = s <= 8;
				return { pass: [calm && d <= 4, calm && d <= 2, calm && d <= 1], text: `${f1(d)} km/h slow at the end of the climb, pedal reversed ${s} times${calm ? '' : ', the truck shakes'}.` };
			},
		},
		{
			id: 'pi', title: 'Can you remove the last km/h?', road: 'hill', band: 3,
			goal: 'The integral keeps pushing whilst any error is left. Reach 80 km/h on the climb, with a small overshoot after the top.',
			knobs: [kpKnob(4), kiKnob(0)],
			ctrl: (k) => ({ mode: 'pi', kp: k.kp, ki: k.ki }),
			tiers: ['Back to 80 km/h on the climb (within 0.3 km/h)', 'Within ±3 km/h everywhere', 'Within ±2 km/h, without shaking'],
			score: ([r]) => {
				const d = Math.abs(droop(r, 1.9, 2.4)), e = dev(r), s = shake(r);
				return { pass: [d <= 0.3 && s <= 12, d <= 0.3 && e <= 3 && s <= 12, d <= 0.3 && e <= 2 && s <= 8], text: `${f1(d)} km/h off at the end of the climb, within ±${f1(e)} km/h, pedal reversed ${s} times.` };
			},
		},
		{
			id: 'robust', title: 'Can one tuning work every day?', road: 'hill', band: 3,
			goal: 'One tuning now drives a full truck (40 t) and an empty one (15 t) at once. Find one that works for both.',
			knobs: [kpKnob(8), kiKnob(0.6)],
			runs: (k) => [{ label: 'Heavy day, 40 t', mass: 40000 }, { label: 'Light day, 15 t', mass: 15000 }].map((t) => ({ ...t, ctrl: { mode: 'pi', kp: k.kp, ki: k.ki } })),
			tiers: ['Both days within ±4 km/h', 'Both days within ±3 km/h, little shaking', 'Both days within ±2.5 km/h, no shaking'],
			score: (rs) => {
				const e = Math.max(...rs.map((r) => dev(r))), s = Math.max(...rs.map(shake));
				return { pass: [e <= 4, e <= 3 && s <= 12, e <= 2.5 && s <= 10], text: `worst day within ±${f1(e)} km/h. Pedal reversed ${shake(rs[0])} times on the heavy day and ${shake(rs[1])} times on the light day.` };
			},
		},
		{
			id: 'windup', title: 'What if the engine is too weak?', road: 'steep', band: 3,
			goal: 'The 4% hill is too steep for the engine to hold 80 km/h. Drive it once, then switch on anti-windup below and drive again.',
			knobs: [kpKnob(4), kiKnob(0.5)],
			toggles: [{ key: 'aw', label: 'Anti-windup', hint: 'Stops the integral whilst the engine is at its limit' }],
			ctrl: (k) => ({ mode: 'pi', kp: k.kp, ki: k.ki, antiWindup: k.aw }),
			tiers: ['Overshoot after the top under 10 km/h', 'Under 4 km/h', 'Under 2 km/h'],
			score: ([r]) => { const o = measure(r, 1.6).high, low = measure(r, 0, 1.6).low; return { pass: [o <= 10, o <= 4, o <= 2], text: `${f1(low)} km/h lost on the hill, ${f1(o)} km/h overshoot after the top.` }; },
		},
		{
			id: 'noise', title: 'What if the sensor is noisy?', road: 'hill', band: 3, noise: 1,
			goal: 'The speed signal now jitters by about ±1 km/h. Filter it so the pedal calms down, but not so much that the truck reacts late.',
			knobs: [kpKnob(4), kiKnob(0.5), knob('filter', 'Speed filter', 0, 3, 0.1, 0, (x) => (x ? `${f1(x)} s` : 'off'), ['Off', 'Heavy'])],
			ctrl: (k) => ({ mode: 'pi', kp: k.kp, ki: k.ki, filter: k.filter, antiWindup: true }),
			tiers: ['Under 40 pedal strokes a minute, within ±4 km/h', 'Under 20 strokes, within ±3 km/h', 'Under 10 strokes, within ±3 km/h'],
			score: ([r]) => { const s = strokes(r), e = dev(r); return { pass: [s <= 40 && e <= 4, s <= 20 && e <= 3, s <= 10 && e <= 3], text: `${Math.round(s)} full pedal strokes a minute, within ±${f1(e)} km/h.` }; },
		},
		{
			id: 'ff', title: 'What if the controller knows the road?', road: 'roll', band: 3, ffLine: true,
			goal: 'The controller reads the slope from the map and pushes before the speed drops. Tell it how heavy the truck is.',
			knobs: [knob('mass', 'Mass the controller assumes', 10, 60, 1, 20, (x) => `${x} t`, ['10 t', '60 t'])],
			ctrl: (k) => ({ mode: 'pi', kp: 4, ki: 0.5, antiWindup: true, ff: true, ffMass: k.mass }),
			compare: () => ({ label: 'Feedback only, no map', run: fbRun() }),
			tiers: ['Within ±2.5 km/h', 'Within ±1.5 km/h', 'Within ±1.1 km/h'],
			score: ([r]) => { const e = dev(r); return { pass: [e <= 2.5, e <= 1.5, e <= 1.1], text: `within ±${f1(e)} km/h over the whole road, against ±${f1(dev(fbRun()))} km/h with feedback alone.` }; },
		},
		{
			id: 'plan', title: 'What if the speed may move a little?', road: 'roll', band: 0,
			goal: 'Let the speed drift a little, and the computer plans the whole road for the least energy. Choose how far it may drift from 80 km/h.',
			predict: { q: 'Can a speed that moves use less energy than a constant 80 km/h?', options: ['Yes', 'No'], right: 'Yes' },
			knobs: [knob('band', 'Allowed speed band', 1, 6, 1, 1, (x) => `80 ± ${x} km/h`, ['Tight', 'Loose'])],
			runs: (k) => [{ label: 'Truck following the plan', ctrl: { mode: 'plan', plan: plan(ROADS.roll, { band: k.band }), kp: 4, ki: 0.5, antiWindup: true, ff: true, ffMass: 40 } }],
			compare: () => ({ label: 'Constant 80 km/h (level 9)', run: baseRun() }),
			bars: ([r]) => [{ label: 'Constant 80 km/h', run: baseRun(), kind: 'cmp' }, { label: 'Planned speed', run: r, kind: 'a' }],
			tiers: ['At least 1% less energy', 'At least 2.5% less', 'At least 3% less, at most 1% later'],
			score: ([r]) => {
				const b = baseRun(), save = 100 * (1 - r.energy / b.energy), late = (100 * (r.time - b.time)) / b.time;
				return { pass: [save >= 1, save >= 2.5, save >= 3 && late <= 1], text: `${f1(save)}% less energy at the wheels, ${late >= 0 ? `${f1(late)}% later` : `${f1(-late)}% earlier`}.` };
			},
		},
	];

	const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || '{}'); } catch { return {}; } };
	const save = (p) => { try { localStorage.setItem(STORE, JSON.stringify(p)); } catch { /* private mode */ } };
	let progress = load();
	const listeners = new Set();
	const notify = () => listeners.forEach((fn) => fn());
	const setStars = (id, stars) => {
		if ((progress[id] ?? 0) >= stars) return;
		progress = { ...progress, [id]: stars };
		save(progress);
		notify();
	};
	const skipped = (id) => !!progress[`${id}:skip`];
	const cleared = (id) => (progress[id] ?? 0) > 0 || skipped(id);
	// Levels opened from a #play-<id> link (the article's "Play level N" links or a shared URL) stay unlocked for this visit.
	const linked = new Set();
	const unlocked = (i) => i === 0 || linked.has(i) || cleared(LEVELS[i - 1].id);
	const allCleared = () => LEVELS.every((l) => cleared(l.id));
	// The summary groups the levels in the four steps named in the article.
	const STAGES = [
		{ name: 'Feedback', from: 0, to: 2 },
		{ name: 'Tuning', from: 3, to: 5 },
		{ name: 'Physical limits', from: 6, to: 7 },
		{ name: 'Knowledge of the truck and the road', from: 8, to: 9 },
	];
	const starText = (lv, n) => (lv.explore ? (n ? 'done' : 'not done') : `${n} of 3 stars`);
	const starGlyphs = (lv, n) => (lv.explore ? (n ? '✓' : '') : '★★★'.slice(0, n) + '☆☆☆'.slice(0, 3 - n));

	const NS = 'http://www.w3.org/2000/svg';
	const el = (tag, attrs = {}, text) => {
		const e = tag.startsWith('svg:') ? document.createElementNS(NS, tag.slice(4)) : document.createElement(tag);
		Object.entries(attrs).forEach(([k, v]) => v !== undefined && v !== false && e.setAttribute(k, v === true ? '' : v));
		if (text !== undefined) e.textContent = text;
		return e;
	};
	const theoryOf = (i) => [...document.querySelectorAll('h3[id]')].find((h) => h.textContent.trim().startsWith(`Level ${i + 1}:`));

	// What the reader should take from each level, shown in the game once it is passed or skipped.
	const AHA = {
		drive: 'You just closed a control loop: read the speed, compare it with 80 km/h, move the pedal. The truck responds about 1.5 s late, so a correction tends to come too late and then go too far.',
		open: 'No fixed pedal works for both the flat and the climb. Without measuring the speed, nothing can react to the hill. This is why controllers use feedback.',
		onoff: 'A simple rule holds the speed, but only by slamming the pedal between zero and full power. The closer the lines, the tighter the speed and the more often the pedal switches.',
		p: 'Pushing in proportion to the error is gentle, but it always leaves the truck a little slow on the climb, because extra force only comes from an error. With too much gain, the delay makes the pedal shake.',
		pi: 'The integral keeps pushing until the error is gone. It works as a memory, and the same memory causes the swing after the top of the hill.',
		robust: 'One tuning has to work on every day, so it is set for the hardest case. The price is a slightly slower response for the full truck.',
		windup: 'At its limit, the engine cannot remove the error, but the integral keeps adding it up. Anti-windup stops it, and the overshoot after the top falls to about 1 km/h.',
		noise: 'A filter calms the pedal, but it also delays the measurement. The heavier the filter, the later the controller reacts.',
		ff: 'Knowing the slope lets the controller push before the speed drops. How much it helps depends on how well it knows the truck, here its mass.',
		plan: 'A speed that may move a little lets the truck brake less on the descent and save energy. In a predictive controller, an engineer tunes exactly this band: how much the speed may move in exchange for energy.',
	};

	const build = (host, lv, index, go) => {
		const id = `cl-${lv.id}`;
		const route = ROADS[lv.road];
		const values = Object.fromEntries([...(lv.knobs ?? []).map((k) => [k.key, k.value]), ...(lv.toggles ?? []).map((t) => [t.key, false])]);
		let W = 720;
		const ml = 46, mr = 10;
		const P = { road: [6, 58], speed: [84, 240], pedal: [270, 400] };
		const H = 424;
		host.replaceChildren();
		host.id ||= id;
		host.classList.add('is-live');

		const head = el('div', { class: 'cl__head' });
		const levelEl = el('p', { class: 'cl__level' });
		levelEl.append(el('span', { class: 'cl__level-n' }, `Level ${index + 1}`), el('span', { class: 'cl__level-t' }, lv.title));
		head.append(levelEl);
		const starsEl = el('p', { class: 'cl__stars' });
		head.append(starsEl);
		const goal = el('p', { class: 'cl__goal' });
		goal.append(el('span', { class: 'cl__step' }, 'Goal'), lv.goal);
		const tiers = el('ul', { class: 'cl__tiers', 'aria-label': lv.explore ? 'Goal' : 'Stars' });
		const tierEls = lv.tiers.map((t, i) => {
			const li = el('li');
			li.append(el('span', { class: 'cl__tier-mark', 'aria-hidden': 'true' }, lv.explore ? '✓' : '★'.repeat(i + 1)), el('span', {}, t));
			tiers.append(li);
			return li;
		});
		const lock = el('p', { class: 'cl__lock' });

		// Prediction before the run: the reader commits to a guess, then the run answers it.
		let guess = null;
		const pred = lv.predict ? el('div', { class: 'cl__predict', role: 'group', 'aria-label': 'What do you think?' }) : null;
		if (pred) {
			pred.append(el('p', { class: 'cl__step' }, 'What do you think?'), el('p', {}, lv.predict.q));
			lv.predict.options.forEach((o) => {
				const b = el('button', { type: 'button', 'aria-pressed': 'false' }, o);
				b.addEventListener('click', () => {
					guess = o;
					pred.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
					runBtn.disabled = false;
					msg.textContent = startHint;
				});
				pred.append(b);
			});
		}

		const svg = el('svg:svg', { viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': '' });
		const g = (cls) => { const n = el('svg:g', { class: cls }); svg.append(n); return n; };
		const gAxes = g('cl__axes'), gRoad = g('cl__road'), gBand = g('cl__bandg'), gRef = g('cl__refg'), gGhost = g('cl__ghosts'), gFill = g('cl__fills'), gLines = g('cl__lines'), gMarks = g('cl__marks'), gTags = g('cl__tags'), gTruck = g('cl__truckg');
		const stage = el('div', { class: 'cl__stage' });
		const ready = el('p', { class: 'cl__ready', 'aria-hidden': 'true' });
		// The plot box holds the svg and everything placed on it, so percentages refer to the plot alone.
		const plot = el('div', { class: 'cl__plot' });
		plot.append(svg, ready);
		stage.append(plot);
		const legend = el('p', { class: 'cl__legend' });
		const bars = el('div', { class: 'cl__bars' });

		// Scales
		const X = (km) => ml + ((W - ml - mr) * km) / route.length;
		let vlo = 70, vhi = 90;
		const YV = (v) => P.speed[1] - ((P.speed[1] - P.speed[0]) * (Math.min(Math.max(v, vlo - 2), vhi + 2) - vlo)) / (vhi - vlo);
		const YP = (p) => (P.pedal[0] + P.pedal[1]) / 2 - ((P.pedal[1] - P.pedal[0]) / 2) * (Math.min(Math.max(p, -100), 100) / 100);
		const hs = Array.from({ length: 121 }, (_, i) => route.heightAt((route.length * i) / 120));
		const hmin = Math.min(...hs), hmax = Math.max(...hs, hmin + 1);
		const YR = (h) => P.road[1] - 8 - ((P.road[1] - P.road[0] - 14) * (h - hmin)) / (hmax - hmin);

		let busy = false;
		let live = null;
		// armLive starts a waiting live run on the first pedal movement.
		let armLive = null;
		const knobsWrap = el('div', { class: 'cl__knobs' });
		const inputs = {};
		(lv.knobs ?? []).forEach((k) => {
			const inId = `${id}-${k.key}`;
			const out = el('output', { for: inId }, k.fmt(k.value));
			const input = el('input', { id: inId, type: 'range', min: k.min, max: k.max, step: k.step, value: k.value, 'aria-valuetext': k.fmt(k.value) });
			input.addEventListener('input', () => {
				values[k.key] = Number(input.value);
				if (k.lever) armLive?.();
				out.textContent = k.fmt(values[k.key]);
				input.setAttribute('aria-valuetext', out.textContent);
				if (!busy && !live && (lv.lines || lv.id === 'plan')) drawRuns(1);
			});
			inputs[k.key] = input;
			if (k.lever && lv.live) {
				// The pedal lever sits beside the pedal plot, on the same vertical scale: up is power, down is brake.
				const wrap = el('div', { class: 'cl__lever' });
				wrap.style.top = `${((100 * YP(k.max)) / H).toFixed(2)}%`;
				wrap.style.height = `${((100 * (YP(k.min) - YP(k.max))) / H).toFixed(2)}%`;
				const top = el('div', { class: 'cl__lever-head' });
				top.append(el('label', { for: inId }, k.label), out);
				// On a phone the lever lies flat under the plot (see the CSS), with brake on the left and power on the right.
				const setOrient = () => input.setAttribute('aria-orientation', phone.matches ? 'horizontal' : 'vertical');
				setOrient();
				phone.addEventListener('change', setOrient);
				input.addEventListener('keydown', (e) => { if (/^(Arrow|Page|Home|End)/.test(e.key)) armLive?.(); });
				wrap.append(top, el('span', { class: 'cl__lever-end cl__lever-end--brake', 'aria-hidden': 'true' }, 'Brake'), input, el('span', { class: 'cl__lever-end cl__lever-end--power', 'aria-hidden': 'true' }, 'Power'));
				// The whole pedal plot is a drag area for the pedal, on the same scale as the lever.
				const zone = el('div', { class: 'cl__padzone', 'aria-hidden': 'true' });
				zone.style.top = wrap.style.top;
				zone.style.height = wrap.style.height;
				const setFromY = (e) => {
					const r = zone.getBoundingClientRect();
					const f = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
					const v = Math.round((k.max - f * (k.max - k.min)) / k.step) * k.step;
					if (Number(input.value) !== v) { input.value = String(v); input.dispatchEvent(new Event('input')); }
				};
				zone.addEventListener('pointerdown', (e) => { if (!live) return; e.preventDefault(); zone.setPointerCapture(e.pointerId); setFromY(e); });
				zone.addEventListener('pointermove', (e) => { if (zone.hasPointerCapture(e.pointerId)) setFromY(e); });
				plot.append(zone);
				stage.append(wrap);
				stage.classList.add('has-lever');
				return;
			}
			const wrap = el('div', { class: 'cl__knob' });
			const lab = el('label', { for: inId });
			lab.append(el('span', {}, k.label), out);
			input.setAttribute('aria-describedby', `${inId}-ends`);
			const ends = el('span', { class: 'cl__ends', id: `${inId}-ends` });
			ends.append(el('span', {}, k.ends[0]), el('span', {}, k.ends[1]));
			wrap.append(lab, input, ends);
			knobsWrap.append(wrap);
		});
		(lv.toggles ?? []).forEach((t) => {
			const lab = el('label', { class: 'cl__toggle' });
			const input = el('input', { type: 'checkbox' });
			const state = el('span', { class: 'cl__toggle-state' }, 'Off');
