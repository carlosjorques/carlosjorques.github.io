		let history = [];
		let current = null;
		let anim = 0;
		const styles = ['cl__line--a', 'cl__line--b'];
		const drawRuns = (frac = 1, liveRun) => {
			const cur = liveRun ? [{ run: liveRun, label: 'You' }] : current?.traces ?? [];
			const all = [...cur.map((t) => t.run), ...history.flatMap((h) => h.traces.slice(0, 1).map((t) => t.run)), ...(current?.compare ? [current.compare.run] : [])];
