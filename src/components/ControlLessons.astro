		const drawAxes = (step) => {
			const a = [];
			const tick = (y, t, cls = 'cl__grid') => { a.push(el('svg:line', { class: cls, x1: ml, x2: W - mr, y1: y, y2: y })); a.push(el('svg:text', { class: 'cl__tick', x: ml - 6, y: y + 4, 'text-anchor': 'end' }, t)); };
