			gMarks.replaceChildren(...marks);
			placeTrucks(cur, frac);
		};
		const drawLegend = () => {
			const items = [['cl__key--ref', lv.id === 'plan' ? 'Planned speed' : 'Target, 80 km/h']];
			if (lv.band) items.push(['cl__key--band', 'Goal band']);
			if (lv.id === 'plan') items.push(['cl__key--band', 'Allowed band']);
			if (lv.lines) items.push(['cl__key--switch', 'Switching lines']);
			const cur = current?.traces ?? (lv.runs ? lv.runs(values) : [{ label: lv.live ? 'You' : 'This run' }]);
			cur.forEach((t, i) => items.push([`cl__key--${'ab'[i]}`, t.label ?? 'This run']));
			if (lv.ffLine) items.push(['cl__key--ff', 'Pedal from the map']);
			if (lv.compare) items.push(['cl__key--cmp', lv.compare().label]);
