				r.push(el('svg:text', { class: 'cl__slope', x: X(mid), y: YR(route.heightAt(mid)) - 6, 'text-anchor': 'middle' }, `${slope > 0 ? '+' : '−'}${Math.abs(slope)}%`));
			});
			gRoad.replaceChildren(...r);
		};
		const makeTruck = (cls) => {
			const t = el('svg:g', { class: `cl__truck ${cls}` });
			t.append(el('svg:rect', { x: -15, y: -9, width: 20, height: 9, rx: 1 }), el('svg:rect', { x: 6, y: -8, width: 8, height: 8, rx: 1.5 }));
