		const readout = el('svg:text', { class: 'cl__readout', x: W - mr, y: P.speed[0] - 6, 'text-anchor': 'end' });
		gTruck.append(cursor, truck2, truck, readout);
		const placeOne = (t, km, lift) => {
			const h = route.heightAt(km), k0 = Math.max(0, km - 0.05), k1 = Math.min(route.length, km + 0.05);
			const ang = (Math.atan2(YR(route.heightAt(k1)) - YR(route.heightAt(k0)), X(k1) - X(k0)) * 180) / Math.PI;
