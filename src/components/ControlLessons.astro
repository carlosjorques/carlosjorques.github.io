			};
			anim = requestAnimationFrame(frame);
		};
		const runOnce = () => {
			if (busy) return;
			if (current) history.push(current);
			const spec = lv.runs ? lv.runs(values) : [{ label: 'This run', ctrl: lv.ctrl(values) }];
			const traces = spec.map((s) => ({ label: s.label, run: simulate({ route, ctrl: s.ctrl, mass: s.mass, noise: lv.noise }) }));
			current = { traces, compare: lv.compare?.() };
			drawLegend();
			setPhase('drive');
			if (still) { msg.textContent = 'Driving…'; animate(() => finish(traces)); return; }
			busy = true;
			drawRuns(0);
			ready.textContent = 'The controller drives. Watch the speed.';
			msg.textContent = ready.textContent;
			host.setAttribute('data-ready', '');
			setTimeout(() => { host.removeAttribute('data-ready'); msg.textContent = 'Driving…'; animate(() => finish(traces)); }, 1500);
		};

		// Live driving for level 1: the lever is the pedal; the simulation runs four times faster than real time.
		const stopLive = (finished) => {
			if (!live) return;
			cancelAnimationFrame(anim);
			const r = live.sim.out;
			live = null;
			armLive = null;
			runBtn.textContent = 'Start driving';
			host.removeAttribute('data-driving');
			host.removeAttribute('data-ready');
			if (finished) { current = { traces: [{ label: 'You', run: r }] }; drawLegend(); drawRuns(1); finish(current.traces); }
			else { msg.textContent = 'Stopped. Press start to drive again.'; drawRuns(1, r); setPhase('intro'); }
		};
		const startLive = () => {
			if (current) history.push(current);
			current = null;
			const sim = makeSim({ route, ctrl: { mode: 'manual', manual: () => values.pedal } });
			live = { sim, on: false };
			runBtn.textContent = 'Stop';
			host.setAttribute('data-driving', '');
			host.setAttribute('data-ready', '');
			ready.textContent = phone.matches ? 'Move the pedal to start \u2193' : 'Move the pedal to start \u2192';
			drawLegend();
			drawRuns(1, sim.out);
			msg.textContent = phone.matches ? 'Drag on the pedal plot or the slider. Right is power.' : 'Drag up or down on the pedal plot to start. Up is power, down is brake.';
			setPhase('drive');
			inputs.pedal?.focus({ preventScroll: true });
			const frame = (t) => {
				if (!live) return;
				live.acc += Math.min(0.1, (t - live.last) / 1000) * 4;
				live.last = t;
				while (live.acc >= 0.05 && !sim.done()) { sim.step(); live.acc -= 0.05; }
				drawRuns(1, sim.out);
				if (sim.done()) { stopLive(true); return; }
				anim = requestAnimationFrame(frame);
			};
			// The clock starts with the first pedal movement, so the reader can look at the plot first.
			armLive = () => {
				if (!live || live.on) return;
				live.on = true; live.last = performance.now(); live.acc = 0;
				host.removeAttribute('data-ready');
				msg.textContent = 'Driving. Keep it at 80 km/h.';
				anim = requestAnimationFrame(frame);
			};
		};
		runBtn.addEventListener('click', () => {
			if (lv.live) { if (live) stopLive(false); else startLive(); return; }
			runOnce();
		});

		const layout = () => {
			const next = host.clientWidth < 560 ? 440 : 720;
			if (next === W && svg.dataset.laid) return;
			W = next;
			svg.dataset.laid = '1';
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			drawRuns(1, live?.sim.out);
		};
		layout();
		new ResizeObserver(layout).observe(host);
		drawLegend();
		describe();
		showState();
	};

	// The game: a level picker and one level at a time. Locked levels cannot be picked; links to #play-<id> open a level.
	document.querySelectorAll('[data-cl-game]').forEach((game) => {
		game.replaceChildren();
		game.classList.add('is-live');
		const sum = el('p', { class: 'cl-game__sum', 'aria-live': 'polite' });
		const reset = el('button', { type: 'button', class: 'cl-game__reset' }, 'Reset progress');
		reset.addEventListener('click', () => { progress = {}; save(progress); history.replaceState(null, '', location.pathname); location.reload(); });
		const sumLink = el('button', { type: 'button', class: 'cl-game__reset cl-game__tosum' }, 'Summary');
		sumLink.addEventListener('click', () => go(LEVELS.length, false));
		// Full screen: the Fullscreen API where it exists, a fixed overlay elsewhere (iPhone Safari).
		const fsB = el('button', { type: 'button', class: 'cl-game__reset cl-game__fs', 'aria-pressed': 'false' }, 'Full screen');
		const isFull = () => document.fullscreenElement === game || game.classList.contains('is-full');
		const syncFs = () => {
			const on = isFull();
			fsB.textContent = on ? 'Exit full screen' : 'Full screen';
			fsB.setAttribute('aria-pressed', String(on));
			document.documentElement.classList.toggle('cl-noscroll', game.classList.contains('is-full'));
			// Scale the whole game to the screen; the layout is designed for about 880 x 820 px.
			const w = innerWidth, h = innerHeight;
			game.style.setProperty('--fs-zoom', on && w >= 700 ? Math.min(2.2, Math.max(0.85, Math.min((w - 48) / 880, h / 820))).toFixed(3) : '1');
		};
		addEventListener('resize', () => { if (isFull()) syncFs(); });
		fsB.addEventListener('click', () => {
			if (document.fullscreenElement === game) document.exitFullscreen();
			else if (game.classList.contains('is-full')) game.classList.remove('is-full');
			else if (document.fullscreenEnabled && game.requestFullscreen) game.requestFullscreen().catch(() => game.classList.add('is-full')).finally(syncFs);
			else game.classList.add('is-full');
			syncFs();
		});
		document.addEventListener('fullscreenchange', syncFs);
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && game.classList.contains('is-full')) { game.classList.remove('is-full'); syncFs(); } });
		// Links out of the game (theory, projects) leave full screen first.
		game.addEventListener('click', (e) => {
			const a = e.target.closest?.('a[href]');
			if (!a || a.getAttribute('href').startsWith('#play-') || !isFull()) return;
			const href = a.getAttribute('href');
			if (href.startsWith('#')) { e.preventDefault(); setTimeout(() => { document.getElementById(href.slice(1))?.scrollIntoView(); history.replaceState(null, '', href); }, 200); }
			if (document.fullscreenElement === game) document.exitFullscreen();
			game.classList.remove('is-full');
			syncFs();
		});
		const top = el('div', { class: 'cl-game__top' });
		const tools = el('span', { class: 'cl-game__tools' });
		tools.append(sumLink, reset, fsB);
		top.append(sum, tools);
		const nav = el('ol', { class: 'cl-game__nav', 'aria-label': 'Levels' });
		let active = -1;
		const picks = LEVELS.map((lv, i) => {
			const li = el('li');
			const b = el('button', { type: 'button', class: 'cl-game__pick' });
			b.append(el('span', { class: 'cl-game__n' }, String(i + 1)), el('span', { class: 'cl-game__s', 'aria-hidden': 'true' }));
			b.addEventListener('click', () => go(i, false));
			li.append(b);
			nav.append(li);
			return b;
		});
		// Start screen: the challenge and how the game works, shown until the reader accepts it.
		const intro = el('div', { class: 'cl-game__intro', id: 'play-start', tabindex: '-1' });
		intro.hidden = true;
		const acceptB = el('button', { type: 'button', class: 'cl-game__accept' }, 'Accept the challenge');
		const how = el('ul', { class: 'cl-game__how' });
		[
			'Level 1 is yours: drive the truck with the pedal.',
			'From level 2, a computer drives. You design its controller, then watch the run.',
			'Earn stars, or skip a level, to open the next one.',
		].forEach((t) => how.append(el('li', {}, t)));
		intro.append(
			el('p', { class: 'cl-game__intro-title' }, 'Hold 80 km/h over the hill'),
			el('p', { class: 'cl-game__intro-lead' }, 'Drive this 40-tonne truck at a constant 80 km/h over a 2% hill. Then design the controller that drives it better than you, and become a control engineer for a day.'),
			how,
			el('p', { class: 'cl-game__intro-ask' }, 'Do you accept the challenge?'),
			acceptB,
		);
		acceptB.addEventListener('click', () => {
			progress = { ...progress, started: 1 };
			save(progress);
			go(0, true);
			panels[0].querySelector('.cl__run')?.focus({ preventScroll: true });
		});
		game.append(top, intro, nav);
		const renderNav = () => {
			let earned = 0, passed = 0;
			LEVELS.forEach((lv, i) => {
				const n = progress[lv.id] ?? 0, open = unlocked(i), skip = !n && skipped(lv.id);
				if (n) passed += 1;
				if (!lv.explore) earned += n;
				const b = picks[i];
				b.disabled = !open;
				b.lastChild.textContent = n ? starGlyphs(lv, n) : skip ? 'skipped' : open ? 'open' : 'locked';
				b.setAttribute('aria-label', `Level ${i + 1}: ${lv.title} ${n ? starText(lv, n) : skip ? 'skipped' : open ? 'open' : 'locked'}`);
				b.dataset.state = n ? 'passed' : skip ? 'skipped' : open ? 'open' : 'locked';
				if (i === active) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
			});
			const stars = LEVELS.filter((l) => !l.explore).length * 3;
			sum.textContent = `${passed} of ${LEVELS.length} levels passed, ${earned} of ${stars} stars`;
			reset.hidden = !Object.keys(progress).length;
			sumLink.hidden = !allCleared() || active === LEVELS.length;
			if (active === LEVELS.length) renderEnd();
		};
		const end = el('div', { class: 'cl-game__end', id: 'play-summary', tabindex: '-1' });
		end.hidden = true;
		const conceptOf = (i) => {
			const t = theoryOf(i)?.textContent.trim().replace(/^Level \d+:\s*/, '');
			return t ? t[0].toUpperCase() + t.slice(1) : LEVELS[i].title;
		};
		const renderEnd = () => {
			let earned = 0, skips = 0, missing = 0;
			LEVELS.forEach((lv) => {
				const n = progress[lv.id] ?? 0;
				if (!lv.explore) { earned += n; if (n < 3) missing += 1; }
				if (!n) skips += 1;
			});
			const stars = LEVELS.filter((l) => !l.explore).length * 3;
			const kids = [
				el('p', { class: 'cl-game__end-kicker' }, 'Summary'),
				el('p', { class: 'cl-game__end-title' }, skips ? `All ten levels done, ${skips} skipped` : 'All ten levels passed'),
				el('p', { class: 'cl-game__end-stars' }, `\u2605 ${earned} of ${stars} stars`),
				el('p', { class: 'cl-game__end-lead' }, 'On one truck and one road, the controller grew from your own foot on the pedal to a planner that reads the road ahead. These are the ideas it took, in the order a control engineer adds them.'),
			];
			const grid = el('div', { class: 'cl-game__end-grid' });
			STAGES.forEach((st) => {
				const box = el('div', { class: 'cl-game__end-stage' });
				box.append(el('p', { class: 'cl-game__end-name' }, `${st.name} (levels ${st.from + 1} to ${st.to + 1})`.replace(/levels (\d+) to (\d+)/, (m, a, b) => (Number(b) - Number(a) === 1 ? `levels ${a} and ${b}` : m))));
				const ul = el('ul');
				for (let i = st.from; i <= st.to; i += 1) {
					const lv = LEVELS[i], n = progress[lv.id] ?? 0;
					const b = el('button', { type: 'button', class: 'cl-game__end-row', 'data-state': n ? 'passed' : 'skipped' });
					b.append(el('span', { class: 'cl-game__end-n' }, String(i + 1)), el('span', { class: 'cl-game__end-c' }, conceptOf(i)), el('span', { class: 'cl-game__end-s', 'aria-hidden': 'true' }, n ? starGlyphs(lv, n) : 'skipped'));
					b.setAttribute('aria-label', `Level ${i + 1}, ${conceptOf(i)}: ${n ? starText(lv, n) : 'skipped'}. Drive it again.`);
					b.addEventListener('click', () => go(i, true));
					const li = el('li');
					li.append(b);
					ul.append(li);
				}
				box.append(ul);
				grid.append(box);
			});
			kids.push(grid);
			if (missing || skips) kids.push(el('p', { class: 'cl-game__end-hint' }, `Pick a level to drive it again.${missing ? ` ${missing === 1 ? 'One level still has' : `${missing} levels still have`} stars to earn.` : ''}`));
			const links = el('p', { class: 'cl-game__end-links' });
			const after = document.getElementById('what-the-game-teaches-about-control-engineering');
			if (after) links.append(el('a', { href: `#${after.id}`, class: 'cl-game__end-main' }, 'Read what the game teaches'));
			links.append(el('a', { href: '/work/' }, 'See the projects behind it'));
			kids.push(el('p', { class: 'cl-game__end-close' }, 'A production truck adds what the game leaves out: actuators that interact, temperatures that no sensor measures, models that drift as the truck ages and faults that the software has to catch.'), links);
			end.replaceChildren(...kids);
		};
		const go = (i, scroll, initial) => {
			active = i;
			game.removeAttribute('data-start');
			intro.hidden = true;
			panels.forEach((p, j) => { p.hidden = j !== i; });
			end.hidden = i !== LEVELS.length;
			renderNav();
			if (!initial || location.hash.startsWith('#play-')) history.replaceState(null, '', i === LEVELS.length ? '#play-summary' : `#play-${LEVELS[i].id}`);
			if (i === LEVELS.length && scroll) end.focus({ preventScroll: true });
			if (scroll && game.getBoundingClientRect().top < 0) game.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
			if (scroll && isFull()) game.scrollTo({ top: 0 });
		};
		const panels = LEVELS.map((lv, i) => {
			const p = el('div', { class: 'cl', id: `play-${lv.id}` });
			p.hidden = true;
			game.append(p);
			build(p, lv, i, go);
			return p;
		});
		game.append(end);
		listeners.add(renderNav);
		const fromHash = () => { const m = location.hash.match(/^#play-(.+)$/); return !m ? -1 : m[1] === 'summary' ? (allCleared() ? LEVELS.length : -1) : LEVELS.findIndex((l) => l.id === m[1]); };
		let first = fromHash();
		if (first >= 0 && first < LEVELS.length && !unlocked(first)) { linked.add(first); notify(); }
		if (first < 0) first = allCleared() ? LEVELS.length : LEVELS.findIndex((l, i) => unlocked(i) && !cleared(l.id));
		go(first < 0 ? 0 : first, false, true);
		if (!progress.started && !LEVELS.some((l) => cleared(l.id)) && !location.hash.startsWith('#play-')) {
			game.setAttribute('data-start', '');
			intro.hidden = false;
			panels[0].hidden = true;
		}
		document.addEventListener('click', (e) => {
			const a = e.target.closest?.('a[href^="#play-"]');
			if (!a) return;
			const i = a.getAttribute('href') === '#play-summary' ? (allCleared() ? LEVELS.length : -1) : LEVELS.findIndex((l) => `#play-${l.id}` === a.getAttribute('href'));
			if (i < 0) return;
			e.preventDefault();
			if (i < LEVELS.length && !linked.has(i)) { linked.add(i); notify(); }
			go(i, false);
			game.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
		});
	});
</script>

