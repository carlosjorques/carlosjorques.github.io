---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	company: string;
	deliveryContext?: string;
	context: string;
	description: string;
	ownership: string;
	cardMetrics: { label: string; value: string }[];
	image: ImageMetadata;
	imageAlt: string;
	slug: string;
}
const { title, company, deliveryContext, context, description, ownership, cardMetrics, image, imageAlt, slug } = Astro.props;
const href = `${import.meta.env.BASE_URL}work/${slug}/`;
---

<article class="project-card">
	<a
		class="project-card__link"
		href={href}
		aria-label={`Open project: ${title}`}
		data-analytics-event="cta_click"
		data-cta-id={`work-project-${slug}`}
		data-cta-placement="work-projects"
		data-cta-intent="proof"
		data-source-section="work-projects"
		data-destination={href}
	>
		<div class="project-card__body">
			<header class="project-card__header">
				<p class="project-card__eyebrow">{company} <span aria-hidden="true">·</span> {context}</p>
				{deliveryContext && <p class="project-card__delivery">{deliveryContext}</p>}
				<h2>{title}</h2>
			</header>
			<p class="project-card__ownership">{ownership}</p>
			<p class="project-card__summary">{description}</p>
			<div class="project-card__evidence" aria-label={`${title} selected facts`}>
				<dl>
					{cardMetrics.slice(0, 2).map((metric) => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}
				</dl>
			</div>
			<span class="project-card__read">Open project <span aria-hidden="true">→</span></span>
		</div>
		<figure class="project-card__media"><Image src={image} alt={imageAlt} widths={[480, 720, 960]} sizes="(min-width: 768px) 45vw, 100vw" /></figure>
	</a>
</article>

<style>
	.project-card { min-width: 0; padding: clamp(1.25rem, 3vw, 2.25rem) 0; border-top: 1px solid var(--color-border); }
	.project-card:first-child { padding-top: 0; }
	.project-card__link { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .95fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: stretch; min-width: 0; background: var(--color-card-bg); padding: clamp(1.25rem, 3vw, 2rem); color: inherit; text-decoration: none; transition: background-color var(--motion-duration-fast-02) var(--motion-standard-productive); }
	.project-card__link:hover, .project-card__link:focus-visible { background: var(--color-card-bg-hover); }
	.project-card__media { order: 2; min-width: 0; min-height: 16rem; height: 100%; margin: 0; overflow: hidden; background: var(--color-surface-soft); border-radius: var(--radius); }
	.project-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.project-card__body { display: grid; align-content: center; gap: .85rem; min-width: 0; max-width: 52rem; }
	.project-card__header { display: grid; gap: .5rem; min-width: 0; }
	.project-card__eyebrow { margin: 0; color: var(--color-accent-text); font-family: var(--font-mono); font-size: var(--type-eyebrow-size); font-weight: var(--type-eyebrow-weight); letter-spacing: var(--type-eyebrow-tracking); line-height: var(--type-eyebrow-line); text-transform: uppercase; }
	.project-card h2 { max-width: none; margin: 0; font-family: var(--font-display); font-size: clamp(1.45rem, 2.2vw, 2.15rem); font-weight: 700; line-height: 1.06; letter-spacing: -.045em; text-wrap: balance; }
	.project-card__delivery { margin: -.25rem 0 0; color: var(--color-muted); font-size: .82rem; line-height: 1.45; }
	.project-card__ownership { margin: 0; color: var(--color-text); font-size: var(--type-card-body-size); font-weight: 700; line-height: 1.4; }
	.project-card__summary { margin: 0; color: var(--color-muted); font-size: var(--type-card-body-size); line-height: 1.6; }
	.project-card__eyebrow, .project-card__ownership, .project-card__summary { min-width: 0; overflow-wrap: anywhere; }
	.project-card__evidence { padding-top: .75rem; }
	.project-card__evidence dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem 1rem; margin: 0; }
	.project-card__evidence div { display: grid; gap: .2rem; min-width: 0; }
	.project-card__evidence dt { color: var(--color-accent-text); font-family: var(--font-mono); font-size: .7rem; font-weight: 600; letter-spacing: .07em; line-height: 1.35; text-transform: uppercase; }
	.project-card__evidence dd { margin: 0; color: var(--color-text); font-size: .86rem; line-height: 1.45; overflow-wrap: anywhere; }
	.project-card__read { display: inline-flex; justify-self: start; align-items: center; gap: .4rem; margin-top: .15rem; color: var(--color-link); font-family: var(--font-mono); font-size: var(--type-button-size); font-weight: var(--type-button-weight); letter-spacing: var(--type-button-tracking); line-height: 1.4; text-transform: uppercase; text-decoration: underline; text-underline-offset: .2em; }
	.project-card__link:hover .project-card__read, .project-card__link:focus-visible .project-card__read { color: var(--color-link-hover); }
	@media (max-width: 700px) {
		.project-card__link { grid-template-columns: 1fr; gap: 1.25rem; }
		.project-card__body { order: 1; }
		.project-card__media { order: 2; min-height: 0; height: auto; aspect-ratio: 16 / 9; }
	}
	@media (max-width: 420px) { .project-card__evidence dl { grid-template-columns: 1fr; } }
</style>
