---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectOutcome } from '../data/projectCards';

interface Props {
	title: string;
	company: string;
	context: string;
	role: string;
	hook: string;
	outcomes: readonly ProjectOutcome[];
	image: ImageMetadata;
	imageAlt: string;
	slug: string;
	headingLevel?: 2 | 3;
	eager?: boolean;
}
const { title, company, context, role, hook, outcomes, image, imageAlt, slug, headingLevel = 2, eager = false } = Astro.props;
const href = `${import.meta.env.BASE_URL}work/${slug}/`;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="project-card">
	<div class="project-card__body">
		<p class="project-card__eyebrow">{company} <span aria-hidden="true">·</span> {context} <span aria-hidden="true">·</span> <span class="project-card__role">{role}</span></p>
		<Heading class="project-card__title">
			<a
				class="project-card__link"
				href={href}
				data-analytics-event="cta_click"
				data-cta-id={`work-project-${slug}`}
				data-cta-placement="work-projects"
				data-cta-intent="proof"
				data-source-section="work-projects"
				data-destination={href}>{title}</a
			>
		</Heading>
		<p class="project-card__hook">{hook}</p>
		<dl class="project-card__outcomes">
			{
				outcomes.map(({ value, label }) => (
					<div>
						<dt>{value}</dt>
						<dd>{label}</dd>
					</div>
				))
			}
		</dl>
		<span class="project-card__read" aria-hidden="true">Read the project →</span>
	</div>
	<figure class="project-card__media">
		<Image src={image} alt={imageAlt} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 50vw, 100vw" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
	</figure>
</article>

<style>
	.project-card { position: relative; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(1.5rem, 3.5vw, 3rem); align-items: center; padding-block: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--color-border); }
	.project-card__body { display: grid; gap: 1rem; min-width: 0; }
	.project-card__eyebrow { margin: 0; color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-eyebrow-size); font-weight: var(--type-eyebrow-weight); letter-spacing: var(--type-eyebrow-tracking); line-height: var(--type-eyebrow-line); text-transform: none; }
		.project-card__role { color: var(--color-text); white-space: nowrap; }
	.project-card__title { max-width: none; margin: 0; font-family: var(--font-display); font-size: clamp(1.4rem, 2.1vw, 1.75rem); font-weight: 600; line-height: 1.15; letter-spacing: -.02em; text-wrap: balance; }
	.project-card__link { color: var(--color-text); text-decoration: none; }
	/* The title link covers the whole project block, so the block is clickable with a short accessible name. */
	.project-card__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
	.project-card__link:focus-visible { outline: none; }
	.project-card:has(.project-card__link:focus-visible) { outline: 2px solid var(--color-link); outline-offset: 4px; }
	.project-card__hook { margin: 0; color: var(--color-body-text, var(--color-text)); font-size: var(--type-card-body-size); line-height: 1.65; }
	.project-card__outcomes { display: flex; gap: 1rem 1.5rem; margin: .25rem 0 0; }
	.project-card__outcomes div { display: grid; flex: 1 1 0; align-content: start; gap: .15rem; min-width: max-content; }
	.project-card__outcomes dt { color: var(--color-text); font-family: var(--font-display); justify-self: start; font-size: clamp(1.25rem, 1.7vw, 1.45rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.15; white-space: nowrap; background: var(--mark-band); }
	.project-card__outcomes dd { width: 0; min-width: 100%; margin: 0; color: var(--color-muted); font-size: .86rem; line-height: 1.4; }
	.project-card__read { justify-self: start; margin-top: .25rem; color: var(--color-text); font-family: var(--font-mono); font-size: var(--type-button-size); font-weight: var(--type-button-weight); letter-spacing: var(--type-button-tracking); line-height: 1.4; text-transform: none; text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: .2em; }
	.project-card:hover .project-card__read { color: var(--color-link-hover); }
	.project-card:hover .project-card__link { color: var(--color-link-hover); }
	.project-card__media { min-width: 0; margin: 0; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; background: var(--color-surface-soft); }
	.project-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform var(--motion-duration-moderate-01) var(--motion-standard-productive); }
	.project-card:hover .project-card__media img { transform: scale(1.02); }
	@media (prefers-reduced-motion: reduce) { .project-card__media img { transition: none; } .project-card:hover .project-card__media img { transform: none; } }
	@media (max-width: 900px) {
		.project-card { grid-template-columns: 1fr; gap: 1rem; }
		/* On one column, the eyebrow and title come before the image, so each project starts with its name. */
		.project-card__body { display: contents; }
		.project-card__eyebrow, .project-card__title { order: -2; }
		.project-card__media { order: -1; aspect-ratio: 16 / 9; }
		.project-card__read { margin-top: 0; }
	}
	@media (max-width: 520px) { .project-card__outcomes { flex-direction: column; } }
</style>
