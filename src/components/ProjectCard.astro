---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { title: string; company: string; context: string; description: string; role: string; tags: string[]; image: ImageMetadata; imageAlt: string; slug: string; }
const { title, company, context, description, role, tags, image, imageAlt, slug } = Astro.props;
const href = `${import.meta.env.BASE_URL}work/${slug}/`;
---

<article class="project-card">
	<div class="project-card__layout">
		<figure class="project-card__media"><Image src={image} alt={imageAlt} widths={[480, 720, 960]} sizes="(min-width: 768px) 45vw, 100vw" /></figure>
		<div class="project-card__body">
			<header class="project-card__header">
				<p class="project-card__eyebrow">{company} <span aria-hidden="true">·</span> {context}</p>
				<h2>{title}</h2>
			</header>
			<div class="project-card__summary">
				<p class="project-card__subtitle">{role}</p>
				<p class="project-card__content">{description}</p>
			</div>
			<ul class="tag-list" aria-label={`${title} labels`}>{tags.slice(0, 2).map((tag) => <li class="tag">{tag}</li>)}</ul>
			<a class="project-card__read" href={href} aria-label={`View project details for ${title}`}>View project details <span aria-hidden="true">→</span></a>
		</div>
	</div>
</article>

<style>
	.project-card { min-width: 0; padding: clamp(1.5rem, 3vw, 2.5rem) 0; border-top: 1px solid var(--color-border); }
	.project-card:first-child { padding-top: 0; border-top: 0; }
	.project-card__layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
	.project-card__media { min-width: 0; margin: 0; background: var(--color-surface-soft); }
	.project-card__media img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius);}
	.project-card__body { display: grid; align-content: start; gap: .8rem; min-width: 0; max-width: 52rem; }
	.project-card__header { display: grid; gap: .55rem; min-width: 0; }
	.project-card__summary { display: grid; gap: .55rem; min-width: 0; }
	.project-card__eyebrow { margin: 0; color: var(--color-accent-text); font-family: var(--font-mono); font-size: var(--type-eyebrow-size); font-weight: var(--type-eyebrow-weight); letter-spacing: var(--type-eyebrow-tracking); line-height: var(--type-eyebrow-line); text-transform: uppercase; }
	.project-card h2 { max-width: none; margin: 0; font-family: var(--font-display); font-size: clamp(1.2rem, 1.7vw, 1.45rem); font-weight: 700; line-height: 1.12; letter-spacing: -.03em; text-wrap: balance; }
	.project-card__subtitle { margin: 0; color: var(--color-text); font-size: var(--type-card-body-size); font-weight: 700; line-height: 1.35; }
	.project-card__content { margin: 0; color: var(--color-muted); font-size: var(--type-card-body-size); line-height: 1.62; }
	.project-card__eyebrow, .project-card__subtitle, .project-card__content { min-width: 0; overflow-wrap: anywhere; }
	.project-card .tag-list { gap: 0; list-style: none; }
	.project-card .tag { border: 0; background: transparent; padding: 0; color: var(--color-text); font-size: .8rem; line-height: 1.45; }
	.project-card .tag + .tag::before { content: '·'; display: inline-block; margin: 0 .55rem; color: var(--color-border-strong); }
	.project-card__read { display: inline-flex; justify-self: start; align-items: center; gap: .4rem; margin-top: 0; color: var(--color-link); font-family: var(--font-body); font-size: .875rem; font-weight: 400; line-height: 1.7; text-decoration: underline; text-underline-offset: .2em; }
	.project-card__read:hover, .project-card__read:focus-visible { color: var(--color-text); }
	@media (max-width: 700px) {
		.project-card__layout { grid-template-columns: 1fr; gap: 1rem; }
		.project-card__media img { aspect-ratio: 16 / 9; }
	}
</style>
