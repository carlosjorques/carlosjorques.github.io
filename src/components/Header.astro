---
const navItems = [
	{ href: '/writing/', label: 'Writing' },
	{ href: '/about/', label: 'About' },
	{ href: '/research/', label: 'Work' },
	{ href: '/contact/', label: 'Contact' },
];

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.slice(1)}`);
const path = Astro.url.pathname.replace(baseUrl.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-header__brand" href={withBase('/')} aria-label="Carlos Jorques home">
			Carlos Jorques
		</a>
		<nav class="site-header__nav" aria-label="Primary navigation">
			{
				navItems.map((item) => (
					<a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 4;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		max-width: var(--content-width);
		min-height: 68px;
		margin-inline: auto;
		padding: 0 64px;
		gap: 2rem;
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		color: var(--color-text);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		gap: 2.25rem;
	}

	.site-header__nav a {
		color: var(--color-text);
		border-bottom: 1px solid transparent;
		padding-bottom: 0.15rem;
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		text-decoration: none;
		transition: border-color 160ms ease;
	}

	.site-header__nav a:hover,
	.site-header__nav a:focus-visible,
	.site-header__nav a[aria-current='page'] {
		border-bottom-color: var(--color-accent);
		color: var(--color-text);
	}

	.site-header__brand:focus-visible,
	.site-header__nav a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
	}

	@media (max-width: 760px) {
		.site-header__inner {
			padding: 0 24px;
		}

		.site-header__nav {
			gap: 1.25rem;
		}
	}

	@media (max-width: 560px) {
		.site-header__inner {
			min-height: auto;
			align-items: flex-start;
			flex-direction: column;
			padding-top: 1rem;
			padding-bottom: 1rem;
			gap: 0.75rem;
		}

		.site-header__nav {
			flex-wrap: wrap;
			row-gap: 0.5rem;
		}
	}
</style>
