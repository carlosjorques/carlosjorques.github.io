---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<article class="expertise-card">
	<h3>{title}</h3>
	<p>{description}</p>
</article>

<style>
	.expertise-card {
		min-height: 0;
		border-top: 1px solid var(--color-border);
		padding: 1rem 0 0;
		transition:
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.expertise-card:hover {
		transform: translateY(-2px);
	}

	.expertise-card h3 {
		display: grid;
		grid-template-columns: 18px minmax(0, 1fr);
		gap: 0.6rem;
		align-items: start;
		margin-bottom: var(--spacing-03);
	}

	.expertise-card h3::before {
		width: 18px;
		height: 18px;
		border: 1px solid var(--color-card-border);
		background: var(--color-card-bg);
		content: '';
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.expertise-card:hover h3::before {
		border-color: var(--color-card-border-hover);
		background: var(--color-card-bg-hover);
		transform: scale(0.88);
	}

	.expertise-card p {
		font-size: var(--type-compact-size);
		line-height: var(--type-compact-line);
	}
</style>
