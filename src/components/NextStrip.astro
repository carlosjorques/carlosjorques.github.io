---
const baseUrl = import.meta.env.BASE_URL;

const items = [
	{
		number: '01',
		title: 'Writing',
		description:
			'Essays and notes on control systems, embedded software, diagnostics, and physical behavior.',
		href: `${baseUrl}writing/`,
	},
	{
		number: '02',
		title: 'About',
		description: 'Background, experience, education, values, and technical leadership.',
		href: `${baseUrl}about/`,
	},
	{
		number: '03',
		title: 'Work',
		description: 'Research, patents, publications, and selected engineering contributions.',
		href: `${baseUrl}research/`,
	},
	{
		number: '04',
		title: 'Contact',
		description: 'Get in touch by email, LinkedIn, or CV.',
		href: `${baseUrl}contact/`,
	},
];
---

<section class="next-strip" aria-labelledby="next-heading">
	<div class="strip-inner">
		<h2 class="eyebrow" id="next-heading">Where to go next</h2>
		<div class="next-grid">
			{
				items.map((item) => (
					<a href={item.href} class="next-item">
						<span class="item-number">{item.number}</span>
						<span class="item-title">
							{item.title}
							<span aria-hidden="true">&rarr;</span>
						</span>
						<span class="item-description">{item.description}</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.next-strip {
		margin-inline: -2.75rem;
		margin-bottom: clamp(3rem, 6vw, 5rem);
		border-block: 1px solid rgba(245, 243, 238, 0.16);
		background: #3f4443;
		color: var(--color-surface);
		padding-inline: 2.75rem;
	}

	.strip-inner {
		width: min(100%, var(--content-width));
		margin-inline: auto;
	}

	.next-strip .eyebrow {
		padding: 1.8rem 0 1rem;
		color: var(--color-surface);
	}

	.next-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top: 0;
	}

	.next-item {
		position: relative;
		display: grid;
		min-height: 112px;
		align-content: start;
		gap: 0.75rem;
		border-right: 1px solid rgba(245, 243, 238, 0.56);
		padding: 1.1rem 1.65rem 1.7rem 0;
		color: var(--color-surface);
		text-decoration: none;
	}

	.next-item + .next-item {
		padding-left: 1.65rem;
	}

	.next-item:last-child {
		border-right: 0;
	}

	.item-number {
		position: absolute;
		overflow: hidden;
		width: 1px;
		height: 1px;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.item-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		color: var(--color-surface);
		font-family: var(--font-mono);
		font-size: 1.12rem;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.item-title span {
		display: none;
	}

	.item-description {
		max-width: 190px;
		color: rgba(250, 249, 246, 0.82);
		font-size: 0.73rem;
		line-height: 1.45;
	}

	.next-item:hover {
		color: var(--color-surface);
	}

	@media (max-width: 900px) {
		.next-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.next-item:nth-child(2n) {
			border-right: 0;
			padding-right: 0;
		}

		.next-item:nth-child(n + 3) {
			border-top: 1px solid rgba(245, 243, 238, 0.28);
		}
	}

	@media (max-width: 1024px) {
		.next-strip {
			margin-inline: -1.5rem;
			padding-inline: 1.5rem;
		}
	}

	@media (max-width: 680px) {
		.next-strip {
			margin-inline: -1rem;
			padding-inline: 1rem;
		}
	}

	@media (max-width: 620px) {
		.next-grid {
			grid-template-columns: 1fr;
		}

		.next-item,
		.next-item + .next-item {
			min-height: 0;
			border-right: 0;
			border-top: 1px solid rgba(245, 243, 238, 0.28);
			padding: 1rem 0;
		}

		.next-item:first-child {
			border-top: 0;
		}
	}
</style>
