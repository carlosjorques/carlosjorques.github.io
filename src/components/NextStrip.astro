---
const baseUrl = import.meta.env.BASE_URL;

const items = [
	{
		number: '01',
		title: 'Writing',
		description:
			'Essays and notes on control systems, embedded software, diagnostics, and physical behavior.',
		href: `${baseUrl}writing/`,
	},
	{
		number: '02',
		title: 'About',
		description: 'Background, experience, education, values, and technical leadership.',
		href: `${baseUrl}about/`,
	},
	{
		number: '03',
		title: 'Work',
		description: 'Research, patents, publications, and selected engineering contributions.',
		href: `${baseUrl}research/`,
	},
	{
		number: '04',
		title: 'Contact',
		description: 'Get in touch by email, LinkedIn, or CV.',
		href: `${baseUrl}contact/`,
	},
];
---

<section class="next-strip" aria-labelledby="next-heading">
	<div class="next-strip__inner">
		<h2 class="next-strip__label" id="next-heading">Where to go next</h2>
		<div class="next-strip__grid">
			{
				items.map((item) => (
					<a href={item.href} class="next-strip__item">
						<span class="next-strip__number">{item.number}</span>
						<span class="next-strip__title">{item.title}</span>
						<span class="next-strip__description">{item.description}</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.next-strip {
		margin-bottom: clamp(3rem, 6vw, 5rem);
		background: var(--color-strip);
		color: var(--color-strip-text);
	}

	.next-strip__inner {
		width: min(100% - 48px, var(--content-width));
		margin-inline: auto;
		padding-block: 2.75rem;
	}

	.next-strip__label {
		margin: 0 0 1.75rem;
		color: var(--color-strip-text);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.next-strip__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}

	.next-strip__item {
		position: relative;
		display: grid;
		min-height: 96px;
		align-content: start;
		gap: 0.45rem;
		padding-right: 2rem;
		color: var(--color-strip-text);
		text-decoration: none;
	}

	.next-strip__item + .next-strip__item {
		padding-left: 2rem;
	}

	.next-strip__item + .next-strip__item::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		width: 1px;
		height: 72%;
		transform: translateY(-50%);
		background: var(--color-strip-line);
	}

	.next-strip__number {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.next-strip__title {
		color: var(--color-strip-text);
		font-family: var(--font-sans);
		font-size: 1.08rem;
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.25;
	}

	.next-strip__description {
		max-width: 190px;
		color: var(--color-strip-muted);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		line-height: 1.5;
	}

	@media (max-width: 760px) {
		.next-strip__inner {
			width: min(100% - 32px, var(--content-width));
		}

		.next-strip__grid {
			grid-template-columns: 1fr;
		}

		.next-strip__item {
			min-height: 0;
			padding: 1.25rem 0;
		}

		.next-strip__item + .next-strip__item {
			padding-left: 0;
			border-top: 1px solid var(--color-strip-line);
		}

		.next-strip__item + .next-strip__item::before {
			display: none;
		}
	}
</style>
