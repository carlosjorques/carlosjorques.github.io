---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);

const professionalBackpack = [
    {
        context: 'TIMELINE & VALIDATION',
        anchor: '10+ Years of Systems Engineering',
        description: 'Delivering production-ready embedded controls across Scania, Mahle, Alten, and Tier-1 clients.',
    },
    {
        context: 'LEADERSHIP SCALE',
        anchor: 'Technical Architecture & Direction',
        description: 'Guiding cross-functional teams across model-based control development, embedded software, and full validation loops.',
    },
    {
        context: 'LIFECYCLE SCOPE',
        anchor: 'System-Level Production Delivery',
        description: 'Architecting controls, active diagnostics, safety constraints, and end-to-end integration for harsh environments.',
    },
    {
        context: 'R&D DEPTH',
        anchor: 'PhD Foundation & IP Generation',
        description: 'Translating peer-reviewed research, academic rigor, and granted patents into viable commercial architectures.',
    },
];

const workPrinciples = [
    {
        title: 'Start from system behavior',
        description:
            'Before writing code or defining interfaces, I model the system’s physical realities: dynamic response, core stability, fault mitigation, and timing requirements.',
    },
    {
        title: 'Deliberately reduce physical uncertainty',
        description:
            'I treat unknown variables as engineering risks. I isolate them early using real-world experiments, predictive simulation, and structural test evidence.',
    },
    {
        title: 'Lead through explicit technical clarity',
        description:
            'Complex algorithms are only useful if teams can execute them. I align cross-functional domains around architectural trade-offs, clear safety limits, and distinct ownership.',
    },
];

const capabilities = [
    {
        challenge: 'How should the machine govern its behavior?',
        domain: 'Controls Architecture',
        description:
            'Defining core dynamic intent, transient handling, and operating envelope boundaries before internal software complexity takes over.',
    },
    {
        challenge: 'How does that behavior translate cleanly into execution?',
        domain: 'Real-Time Embedded Software',
        description:
            'Shaping model-based pipelines, optimizing generated code boundaries, handling critical timing loops, and enforcing clean target compilation.',
    },
    {
        challenge: 'How does the machine protect itself if something goes wrong?',
        domain: 'Diagnostics & Fault Isolation',
        description:
            'Designing robust observability, signal health monitoring, and defensive degradation strategies so assets never fail silently or dangerously.',
    },
    {
        challenge: 'How do we mathematically verify that it is ready?',
        domain: 'Validation & Loop Testing',
        description:
            'Bridging functional requirements with physical proof points using Model-, Software-, and Hardware-in-the-Loop (MIL/SIL/HIL) test execution.',
    },
    {
        challenge: 'How does it unify with the broader platform?',
        domain: 'System Integration',
        description:
            'Synthesizing physical actuators, complex sensors, data buses, calibration parameters, and varied structural subsystems under real operating loads.',
    },
    {
        challenge: 'How do we scale the engineering velocity?',
        domain: 'Technical Leadership',
        description:
            'Translating abstract operational goals into clear delivery tracks, empowering multi-disciplinary engineering assets with crisp technical ownership.',
    },
];

const appliedExpertise = [
    {
        domain: 'Electrified Powertrains & High-Voltage Thermal Management',
        focus: 'Heavy transport thermal coordination, battery management system interfaces, and highly constrained energy management loops.',
    },
    {
        domain: 'Safety-Critical Diagnostics & Dependable Operation',
        focus: 'Active software layers that observe, catch, adapt, and reliably transition physical machines into predictable, safe states during failure cycles.',
    },
    {
        domain: 'Autonomous Machine Systems & Heavy Mobility',
        focus: 'Industrial-grade autonomous propulsion, torque control mechanics, functional safety monitoring, and synchronized fleet field behavior.',
    },
    {
        domain: 'Rigid Industry Regulatory Constraints',
        focus: 'Direct, hands-on production deployment navigating ISO 26262 frameworks, A-SPICE compliance matrices, AUTOSAR layouts, and modern CI/CD systems.',
    },
];
---

<Layout
    title="About Carlos Jorques | Embedded Controls Architect"
    description="About Carlos Jorques, an embedded controls architect and technical leader developing control algorithms and real-time embedded software for reliable physical systems."
>
    <section class="about-hero">
        <div class="page-container about-hero__inner">
            <p class="eyebrow">The Profile</p>
            <h1>Hi, I’m Carlos Jorques.</h1>
            <p class="about-hero__lead">
                I am deeply fascinated by automatic control systems that transform passive, unresponsive machinery into intelligent, highly perceptive systems—assets capable of understanding their environments, making autonomous safety decisions, and acting reliably in real-world scenarios.
            </p>
            <p class="about-hero__body">
                This fascination has driven my career as an Embedded Controls Architect and Technical Leader. My expertise lies at the intersection where complex software algorithms interact directly with physical hardware constraints. While my day-to-day work is rooted in automotive and heavy industrial machinery, the underlying principles apply universally across all advanced autonomous platforms—from electric road vehicles to rockets and orbital satellites.
            </p>
            <p class="about-hero__body">
                Over the past decade, I have architected and deployed production software for major industry platforms, including heavy-duty Scania trucks, autonomous Volvo CE haulers, and advanced Mahle powertrain configurations. 
            </p>
            <div class="button-row" aria-label="About page primary navigation links">
                <a class="button primary" href={withBase('/contact')}>Get in Touch / Access CV</a>
                <a class="button" href={withBase('/work')}>Explore Selected Work</a>
                <a class="button" href={withBase('/writing')}>Read Engineering Log</a>
            </div>
        </div>
    </section>

    <section class="section about-proof" aria-labelledby="backpack-title">
        <div class="page-container">
            <div class="section-intro section-intro--compact">
                <h2 id="backpack-title">My Professional Backpack</h2>
                <p>
                    A balanced synthesis of heavy production delivery, cross-functional engineering management, and a rigorous academic background in predictive control theory.
                </p>
            </div>
            <div class="proof-grid">
                {professionalBackpack.map((item) => (
                    <article class="proof-item">
                        <p>{item.context}</p>
                        <h3>{item.anchor}</h3>
                        <span>{item.description}</span>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section about-split" aria-labelledby="narrative-title">
        <div class="page-container about-split__grid">
            <div class="split-heading">
                <h2 id="narrative-title">The Question Driving the Engineering</h2>
            </div>
            <div class="about-copy">
                <p>
                    <em>How do we make physical machinery smart enough to assist humans safely and predictably under unpredictable conditions?</em> That core challenge has driven my path. What began during my childhood as an instinctive urge to pull things apart to observe their mechanisms eventually evolved into a structured engineering pursuit.
                </p>
                <p>
                    Control theory provided the mathematical framework to answer this question. Electrical engineering and subsequent doctoral research armed me with the diagnostic and modeling toolsets needed to reason through system uncertainty. 
                </p>
                <p>
                    However, real-world execution is where these theories face their true test. Production engineering introduces strict real-time execution limits, hardware cost boundaries, regulatory safety criteria, and tight organizational deadlines. My job is to ensure advanced theoretical architectures survive and excel inside these intense operational environments.
                </p>
                <p>
                    Earlier in my career, I focused on advancing the state-of-the-art through deep academic research—contributing peer-reviewed findings and defensive patents in real-time in-cycle combustion controls, virtual sensing structures, fault identification engines, and high-speed FPGA processing. Today, I scale that knowledge, translating complex engineering principles into production vehicles alongside high-performing teams.
                </p>
                <div class="in-context-cta">
                    <span>Interested in the empirical evidence?</span>
                    <a href={withBase('/work')} class="text-link">Review My Patents & Academic Publications →</a>
                </div>
            </div>
        </div>
    </section>

    <section class="section about-work-style" aria-labelledby="work-style-title">
        <div class="page-container about-split__grid">
            <div class="split-heading">
                <h2 id="work-style-title">How I Approach Execution</h2>
                <p>
                    Developing an elegant algorithm is only half the battle. The real engineering triumph is configuring that code so it can be reliably compiled, integrated, verified, and trusted in the field.
                </p>
            </div>
            <div class="work-style-list">
                {workPrinciples.map((item) => (
                    <article>
                        <h3>{item.title}</h3>
                        <p>{item.description}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="skills-flow-title">
        <div class="page-container">
            <div class="section-intro">
                <h2 id="skills-flow-title">Where My Capabilities Apply</h2>
                <p>
                    To keep things transparent for technical screeners, engineering managers, and recruitment partners, here are the systematic problem domains I own and resolve:
                </p>
            </div>
            <div class="capability-grid">
                {capabilities.map((item) => (
                    <article class="capability-item">
                        <p class="capability-item__area">{item.domain}</p>
                        <h3>{item.challenge}</h3>
                        <p>{item.description}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="concrete-expertise-title">
        <div class="page-container">
            <div class="section-intro">
                <h2 id="concrete-expertise-title">Areas of Applied Domain Expertise</h2>
                <p>
                    The abstract engineering logic of modeling, loops, testing, and architecture becomes highly concrete when mapped to these specific production and vehicle environments:
                </p>
            </div>
            <div class="challenge-grid">
                {appliedExpertise.map((item) => (
                    <article class="challenge-item">
                        <h3>{item.domain}</h3>
                        <p>{item.focus}</p>
                    </article>
                ))}
            </div>
            <div class="section-footer-cta">
                <p>Want to see the complete timeline of my corporate assignments and technical roles?</p>
                <a class="text-link" href={withBase('/contact')}>Request Full CV or Connect via LinkedIn →</a>
            </div>
        </div>
    </section>

    <section class="section about-final" aria-labelledby="final-title">
        <div class="page-container about-final__inner">
            <div>
                <h2 id="final-title">Let's Connect</h2>
                <p>
                    Whether you are an executive talent sourcer looking to fill a strategic technical leadership vacancy, a fellow engineer aiming to talk control systems design, or looking to collaborate on critical real-time embedded safety projects—reach out directly.
                </p>
            </div>
            <div class="about-final__actions">
                <a class="button primary" href={withBase('/contact')}>Initiate Direct Contact</a>
                <a class="button" href="https://linkedin.com" target="_blank" rel="noopener noreferrer">View My LinkedIn Profile</a>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* ALL YOUR ORIGINAL STYLES PRESERVED WITH COMPATIBILITY ADJUSTMENTS FOR CLEAN LAYOUTS */
    .about-hero {
        padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
        border-bottom: 1px solid var(--color-border-soft);
    }

    .about-hero__inner {
        display: grid;
        gap: 1.2rem;
        max-width: 880px;
    }

    .about-hero h1 {
        max-width: 780px;
        font-size: clamp(2.5rem, 6vw, 4.75rem);
        line-height: 1;
    }

    .about-hero__lead {
        max-width: 760px;
        color: var(--color-text);
        font-size: clamp(1.15rem, 2vw, 1.45rem);
        line-height: 1.55;
    }

    .about-hero__body {
        max-width: 760px;
        color: var(--color-muted);
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .about-hero .button-row {
        margin-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .section-intro--compact {
        margin-bottom: 1.5rem;
    }

    .proof-grid {
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
    }

    .proof-item {
        display: grid;
        gap: 0.45rem;
        padding: 1.2rem 0;
    }

    .proof-item + .proof-item {
        border-top: 1px solid var(--color-border);
    }

    .proof-item p {
        color: var(--color-accent);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .proof-item h3 {
        font-size: 1.2rem;
        line-height: 1.35;
        color: var(--color-text);
    }

    .proof-item span {
        max-width: 100%;
        color: var(--color-muted);
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .about-split__grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        align-items: start;
    }

    .split-heading {
        display: grid;
        gap: 0.65rem;
        max-width: 760px;
    }

    .about-split h2,
    .section-intro h2,
    .about-final h2 {
        max-width: 760px;
        font-size: clamp(1.7rem, 3.5vw, 2.65rem);
        line-height: 1.08;
    }

    .split-heading p,
    .about-final p {
        max-width: 700px;
        color: var(--color-muted);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .about-copy {
        display: grid;
        gap: 1.2rem;
        max-width: 760px;
        color: var(--color-muted);
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .in-context-cta, .section-footer-cta {
        margin-top: 1rem;
        padding: 1rem;
        background: rgba(var(--color-text-rgb), 0.02);
        border-left: 3px solid var(--color-accent);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    
    .in-context-cta span, .section-footer-cta p {
        font-size: 0.9rem;
        color: var(--color-text);
    }

    .work-style-list {
        display: grid;
        max-width: 760px;
        border-top: 1px solid var(--color-border);
    }

    .work-style-list article {
        display: grid;
        gap: 0.45rem;
        border-bottom: 1px solid var(--color-border);
        padding: 1.2rem 0;
    }

    .work-style-list h3,
    .capability-item h3,
    .challenge-item h3 {
        font-size: 1.15rem;
        line-height: 1.35;
        color: var(--color-text);
    }

    .work-style-list p,
    .capability-item p,
    .challenge-item p,
    .section-intro p {
        color: var(--color-muted);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .capability-item__area {
        color: var(--color-accent) !important;
        font-family: var(--font-mono);
        font-size: 0.72rem !important;
        font-weight: 600;
        letter-spacing: 0.06em;
        line-height: 1.25 !important;
        text-transform: uppercase;
        margin-bottom: 0.2rem;
    }

    .section-intro {
        display: grid;
        gap: 0.65rem;
        max-width: 760px;
        margin-bottom: 2rem;
    }

    .capability-grid,
    .challenge-grid {
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
    }

    .capability-item,
    .challenge-item {
        display: grid;
        gap: 0.55rem;
        padding: 1.5rem 0;
    }

    .capability-item + .capability-item,
    .challenge-item + .challenge-item {
        border-top: 1px solid var(--color-border);
    }

    .text-link {
        width: fit-content;
        color: var(--color-accent);
        font-weight: 700;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
    }

    .text-link:hover,
    .text-link:focus-visible {
        color: var(--color-text);
    }

    .about-final {
        border-top: 1px solid var(--color-border-soft);
        margin-top: 2rem;
    }

    .about-final__inner {
        display: grid;
        gap: 1.4rem;
        align-items: start;
    }

    .about-final__inner > div:first-child {
        display: grid;
        gap: 0.7rem;
    }

    .about-final__actions {
        display: grid;
        gap: 0.9rem;
        align-items: start;
    }

    .about-final__actions > .button {
        width: 100%;
    }

    @media (min-width: 760px) {
        .proof-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .proof-item {
            padding: 1.5rem;
        }

        .proof-item + .proof-item {
            border-top: 0;
            border-left: 1px solid var(--color-border);
        }

        .proof-item:nth-child(3) {
            border-left: 0;
            border-top: 1px solid var(--color-border);
        }

        .proof-item:nth-child(4) {
            border-top: 1px solid var(--color-border);
        }

        .capability-grid,
        .challenge-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .capability-item,
        .challenge-item {
            padding: 1.5rem;
        }

        .capability-item + .capability-item,
        .challenge-item + .challenge-item {
            border-top: 0;
            border-left: 1px solid var(--color-border);
        }

        .capability-item:nth-child(odd),
        .challenge-item:nth-child(odd) {
            border-left: 0;
        }

        .capability-item:nth-child(n + 3),
        .challenge-item:nth-child(n + 3) {
            border-top: 1px solid var(--color-border);
        }
    }

    @media (min-width: 980px) {
        .about-split__grid {
            grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1fr);
            gap: clamp(2rem, 5vw, 4rem);
        }

        .capability-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .capability-item:nth-child(3n + 1) {
            border-left: 0;
        }

        .capability-item:nth-child(3) {
            border-top: 0;
        }

        .capability-item:nth-child(4) {
            border-top: 1px solid var(--color-border);
        }

        .about-final__inner {
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 2rem;
        }

        .about-final__actions {
            min-width: 230px;
        }
    }

    @media (max-width: 640px) {
        .about-hero {
            padding-block: 3.5rem 2.75rem;
        }
    }
</style>