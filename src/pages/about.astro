---
import Layout from '../layouts/Layout.astro';
import AboutStoryBlock from '../components/AboutStoryBlock.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { CONTACT_DESTINATIONS, IDENTITY } from '../data/identity';
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#') ? href : `${normalizedBase}${href.replace(/^\//, '')}`;
const portraitUrl = withBase('/images/carlos-jorques-intro.webp');
---

<Layout title={`About ${IDENTITY.name} | ${IDENTITY.primaryTitle}`} description={`About ${IDENTITY.name}, an ${IDENTITY.primaryTitle} focused on control system design and implementation in embedded systems, multidisciplinary engineering, and system integration.`}>
	<div class="about-page">
		<section class="about-hero" aria-labelledby="about-title">
			<p class="about-eyebrow">About me</p>
			<div class="about-hero__layout">
				<div class="about-hero__copy">
					<h1 id="about-title">I lead the design of embedded control systems that shape how complex machines sense, decide, and act reliably.</h1>
					<p class="about-hero__lead">I’m Carlos, an <strong>{IDENTITY.primaryTitle} and {IDENTITY.supportingDescriptor}</strong> who combines hands-on control system design and implementation with technical direction across diagnostics and system integration.</p>
					<nav class="about-hero__actions" aria-label="About quick links">
						<a href={withBase('/cv/')}>View CV</a>
						<a href={withBase('/work/')}>Selected work</a>
						<a href={withBase('/contact/')}>Contact</a>
					</nav>
				</div>
				<figure class="about-portrait-frame">
					<img class="about-portrait" src={portraitUrl} alt="Carlos Jorques" width="768" height="1024" loading="eager" decoding="async" />
				</figure>
			</div>
		</section>

		<AboutStoryBlock
			id="background"
			label="Background"
			title="Production embedded controls for complex physical systems"
			intro="For more than 12 years, I have developed production embedded control software for electric trucks, autonomous machines, power electronics, and other complex vehicle systems."
			disclosureLabel="See my production background"
			expanded={[
				"At Scania, Volvo CE, and MAHLE Electronics, I have worked with international teams to turn control concepts into software, validation evidence, and production-ready machine behaviour. The work spans electric trucks, autonomous machinery, power electronics, and motor control."
			]}
			collapsible={true}
		/>

		<AboutStoryBlock
			id="approach"
			label="Engineering approach"
			title="Reliable behaviour guides my decisions"
			intro="I favour solutions that are clear, robust, and practical to implement. Control performance matters, but so do hardware limits, fault response, and the evidence that the system behaves as intended."
			disclosureLabel="How I make engineering decisions"
			expanded={[
				"I start by clarifying the intended behaviour, the physical limits, and what the available measurements can reliably tell us. That helps me decide what belongs in the control logic, how interfaces should behave, and what should happen when signals or operating conditions are uncertain.",
				"I use models, software tests, and experiments on hardware to challenge those decisions. When measured behaviour differs from expectations, I investigate the assumptions, implementation, and interfaces before adding complexity. The aim is software that can be understood, validated, and maintained."
			]}
			collapsible={true}
		/>

		<AboutStoryBlock
			id="collaboration"
			label="Technical Leadership"
			title="Making difficult engineering work clear enough to deliver"
			intro="I set technical direction and help engineers make clear decisions together, keeping system behaviour, software quality, and delivery priorities connected."
			disclosureLabel="How I help teams deliver"
			expanded={[
				"I have led a team of three embedded software engineers across client assignments, contributing to technical direction, planning, software quality, and mentoring. At MAHLE, I also served as Scrum Master for a six person team.",
				"I help teams clarify responsibilities, make technical risks visible, and resolve issues where disciplines meet. I connect delivery decisions to the system’s intended behaviour and the available validation evidence."
			]}
			collapsible={true}
		/>

		<AboutStoryBlock
			id="origin"
			label="Personal story"
			title="Why I care about controllable machines"
			intro="What makes a machine truly intelligent? I have been fascinated by that question for as long as I can remember."
			disclosureLabel="Read the story behind my work"
			expanded={[
				"I started experimenting with electronics at eight, but the moment that set my direction came later, at Campus Party Valencia. I watched a line-following robot I had built wobble and overshoot, while other robots moved smoothly through the same turns. The hardware was capable of more — the difference was in how the system was controlled.",
				"That gap has shaped how I think about intelligent machines ever since: not sophisticated logic, but the ability to sense what's happening, judge what matters under uncertainty, and act on it reliably. That question took me through Electrical Engineering and into an industrial doctorate. My industrial doctorate focused on automatic control, connecting control theory, embedded implementation, and experimental validation. Later, I moved into the automotive industry, where I learned that a sound idea also has to survive noisy signals, limited resources, and deadlines.",
				"That combination of curiosity and production experience now shapes how I work. I enjoy exploring difficult problems, but I also know that engineering creates value only when a solution can be understood, maintained, validated, and delivered."
			]}
		/>

		<AboutStoryBlock
			id="beyond-engineering"
			label="Beyond Engineering"
			title="More than what I build"
			intro="Outside work, I keep learning through basketball, making things, and time with the people who keep work in perspective."
			disclosureLabel="A little more beyond work"
			expanded={[
				"Basketball has been part of my life since childhood, and it still is. I enjoy competing, staying sharp, and helping younger players develop. Being part of a team working toward a shared goal outside of engineering keeps that instinct alive in a different way.",
				"I'm naturally curious, and I like trying things I haven't done before, whether that means picking up a new skill, testing an idea, or occasionally building something — through 3D printing, lamp design, painting, electronics, or home automation. These projects are less about the outcome and more about the habit of staying curious.",
				"Most importantly, time with my partner, our child, our dog, and friends keeps work in perspective and reminds me to protect space for the people and experiences that matter beyond engineering."
			]}
			withBottomBorder
		/>


		<section class="section about-closing" aria-label="Contact">
			<ContactCTA
				title="Have an embedded systems opportunity, technical question, or collaboration in mind?"
				body="I’m open to related roles, technical leadership opportunities, freelance engineering work, and conversations about embedded controls, electrification, diagnostics, and intelligent physical systems."
				primaryLabel="Start a conversation"
				secondaryHref={CONTACT_DESTINATIONS.linkedin}
				secondaryLabel="Connect on LinkedIn"
				tertiaryHref="/work/"
				tertiaryLabel="Explore selected work"
			/>
		</section>
	</div>
</Layout>

<style>
	.about-page { width:min(calc(100% - 5rem),var(--content-width)); margin:0 auto; padding:0; }
	.about-eyebrow,.section-rail { font-family:var(--font-mono); font-size:.82rem; font-weight:600; letter-spacing:.08em; line-height:1.4; text-transform:uppercase; color:var(--color-muted); }
	.about-hero { padding:clamp(3rem,5vw,4.6rem) 0 0; }
	.about-eyebrow { margin:0; }
	.about-hero__layout { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(15rem,20rem); gap:2.5rem; align-items:start; margin:1rem 0 5rem; }
	.about-hero__copy { display:grid; gap:1rem; align-content:start; }
	.about-hero h1 { max-width:none; margin:0; font-size:clamp(2.6rem,3.8vw,3.5rem); font-weight:800; letter-spacing:-.05em; line-height:1.02; }
	.about-hero__lead { max-width:52rem; margin:0; font-size:1.08rem; line-height:1.7; color:var(--color-text); }
	.about-hero__lead strong { font-weight:700; }
	.about-hero__actions { display:none; }
	.about-story { display:grid; gap:1rem; margin:0; max-width:52rem; }
	.about-story p,.story-block p { margin:0; font-size:1.08rem; line-height:1.7; color:var(--color-text); }
	.about-portrait-frame { align-self:start; width:100%; aspect-ratio:3 / 4; margin:0; overflow:hidden; border-radius:1.5rem; }
	.about-portrait { display:block; width:100%; height:auto; aspect-ratio:3 / 4; border-radius:1.5rem; box-shadow:0 18px 40px rgba(23,23,23,.08); }
	.editorial-section { display:grid; grid-template-columns:16rem minmax(0,1fr); gap:0rem; padding:1rem 0; border-top:1px solid var(--color-border); scroll-margin-top:2rem; }
	.section-rail h2,.section-rail p { margin:0; max-width:none; color:inherit; font:inherit; letter-spacing:inherit; text-transform:inherit; }
	.story-block { display:grid; gap:.65rem; max-width:52rem; }
	.story-block h2 { max-width:none; width:100%; margin:0; font-size:1.1625rem; line-height:1.16; letter-spacing:-.035em; font-weight:600; }
	.story-block .intro { color:var(--color-muted); }
	.story-block blockquote { margin:.5rem 0 0; padding-left:1rem; border-left:2px solid var(--color-border-strong); }
	.story-block a { color:var(--color-link); text-underline-offset:.2em; }
	.story-disclosure { margin-top:0; }
	.story-disclosure summary { width:fit-content; display:inline-flex; align-items:center; gap:.4rem; padding:0; border:0; color:var(--color-link); cursor:pointer; font-family:var(--font-body); font-size:.875rem; font-weight:400; line-height:1.7; list-style:none; text-decoration:underline; text-underline-offset:.2em; }
	.story-disclosure summary::-webkit-details-marker { display:none; }
	.story-disclosure summary:hover { color:var(--color-text); }
	.story-disclosure__open { display:none; }
	.story-disclosure__arrow { transition:transform 140ms ease; }
	.story-disclosure[open] .story-disclosure__closed { display:none; }
	.story-disclosure[open] .story-disclosure__open { display:inline; }
	.story-disclosure[open] .story-disclosure__arrow { transform:rotate(180deg); }
	.story-disclosure__content { display:grid; gap:.65rem; margin-top:.65rem; }
	.story-disclosure__content p { color:var(--color-muted); font-size:1.08rem; line-height:1.7; }
	.about-closing { padding:5rem 0; }
	:global(#beyond-engineering) { border-bottom:1px solid var(--color-border); }

	.about-closing .story-block { grid-column:1 / -1; }
	#approach { margin-top:0; }
	#background { padding-top:0; }
	@media(max-width:1100px){.about-hero__layout{grid-template-columns:1fr}.about-portrait-frame{width:min(100%,16rem)}}
	@media(max-width:720px){.about-hero{padding:3rem 0 0}.about-hero h1{font-size:clamp(2.15rem,10vw,2.45rem);line-height:1.04}.about-hero__actions{display:flex;flex-wrap:wrap;gap:.45rem 1rem;margin-top:0}.about-hero__actions a{color:var(--color-link);font-size:.92rem;font-weight:600;text-underline-offset:.2em}.editorial-section{grid-template-columns:1fr}.about-hero__lead,.about-story p,.story-block p{font-size:1.05rem}.button{width:100%}}
	@media(max-width:640px){.about-page{width:min(calc(100% - 32px),var(--content-width))}}
</style>
