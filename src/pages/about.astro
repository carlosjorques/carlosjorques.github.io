---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);

const proofPoints = [
	{
		label: 'Production experience',
		value: '10+ years',
		description: 'Automotive embedded systems and production-oriented engineering environments.',
	},
	{
		label: 'Engineering scope',
		value: 'Embedded systems',
		description: 'Embedded controls, diagnostics, validation, safety-related constraints, and integration.',
	},
	{
		label: 'Technical leadership',
		value: 'Model-based teams',
		description: 'Technical direction across model-based control, embedded software, testing, and delivery.',
	},
	{
		label: 'Analytical foundation',
		value: 'PhD-level rigor',
		description: 'Real-time control, diagnostics, modeling, and evidence-based reasoning.',
	},
];

const workPrinciples = [
	{
		title: 'Start from system behavior',
		description:
			'I connect target machine behavior — response, stability, fault handling, timing, and observability — with the software, diagnostics, and validation decisions needed to make that behavior reliable.',
	},
	{
		title: 'Make trade-offs explicit',
		description:
			'I lead technical work by clarifying constraints, risks, assumptions, and decision criteria across controls, software, calibration, test evidence, and integration feedback.',
	},
	{
		title: 'Design for production reality',
		description:
			'I treat diagnostics, safety-related constraints, testability, maintainability, and delivery quality as part of the architecture, not as late additions.',
	},
];

const capabilityGroups = [
	{
		title: 'Controls architecture',
		description:
			'Translating control intent, dynamic behavior, and system constraints into clear architecture decisions.',
	},
	{
		title: 'Real-time embedded software',
		description:
			'Shaping model-based implementation, generated code boundaries, interfaces, timing, and maintainability.',
	},
	{
		title: 'Diagnostics and fault handling',
		description:
			'Building observability, fault response, degradation behavior, and system confidence into systems that cannot afford to fail silently.',
	},
	{
		title: 'Validation and production readiness',
		description:
			'Connecting requirements, simulation, validation, integration feedback, and production deployment to reduce delivery risk.',
	},
	{
		title: 'System integration',
		description:
			'Aligning sensing, actuation, calibration, software interfaces, and machine-level response.',
	},
	{
		title: 'Technical leadership',
		description:
			'Creating clarity around trade-offs, ownership, quality, and delivery sequence so teams can move with autonomy and accountability.',
	},
];

const evidenceLinks = [
	{
		title: 'Writing',
		description:
			'Technical thinking on embedded controls, diagnostics, physical systems, software architecture, and engineering judgment.',
		href: withBase('/writing'),
		linkText: 'Read technical writing',
	},
	{
		title: 'Work',
		description:
			'Selected public-safe evidence of projects, engineering contributions, publications, patents, and research context.',
		href: withBase('/work'),
		linkText: 'View selected work',
	},
	{
		title: 'CV and contact',
		description:
			'For formal career details, contact information, LinkedIn, and CV access, use the contact page.',
		href: withBase('/contact'),
		linkText: 'Go to contact and CV details',
	},
];
---

<Layout
	title="About Carlos Jorques | Embedded Controls Architect"
	description="About Carlos Jorques, an embedded controls architect and technical leader working across control engineering, real-time embedded software, diagnostics, safety, and reliable physical systems."
>
	<section class="about-hero">
		<div class="page-container about-hero__inner">
			<p class="eyebrow">About</p>
			<h1>About Carlos Jorques</h1>
			<p class="about-hero__lead">
				I help turn complex physical system behavior into embedded control software that
				can be reasoned about, validated, and delivered in production.
			</p>
			<p class="about-hero__body">
				I operate as a senior embedded controls architect and technical leader across
				control architecture, real-time embedded software, diagnostics, validation,
				and system integration. My work is usually shaped by safety-related constraints,
				production delivery, and the need to make complex machines behave reliably outside
				ideal conditions.
			</p>
			<p class="about-hero__body">
				The roles that fit me best involve vehicles, electrified powertrains, battery and
				thermal systems, smart machines, and teams that need clear technical judgment from
				early ambiguity to production-ready decisions.
			</p>
			<div class="button-row" aria-label="About page primary links">
				<a class="button primary" href={withBase('/work')}>View selected work</a>
				<a class="button" href={withBase('/writing')}>Read technical writing</a>
				<a class="button" href={withBase('/contact')}>Contact</a>
			</div>
		</div>
	</section>

	<section class="section about-proof" aria-labelledby="proof-title">
		<div class="page-container">
			<div class="section-intro section-intro--compact">
				<h2 id="proof-title">Professional proof points</h2>
			</div>
			<div class="proof-grid">
				{proofPoints.map((item) => (
					<article class="proof-item">
						<p>{item.label}</p>
						<h3>{item.value}</h3>
						<span>{item.description}</span>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-split" aria-labelledby="coherence-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<h2 id="coherence-title">The through-line</h2>
			</div>
			<div class="about-copy">
				<p>
					What keeps me interested in this field is the gap between a useful model and a
					reliable machine. Closing that gap requires theory, software discipline, test
					evidence, and respect for physical behavior.
				</p>
				<p>
					That interest started early with taking things apart to understand how they
					worked. It eventually became a more disciplined question: how should machines
					sense, respond, act, and adapt under real-world constraints?
				</p>
				<p>
					My work connects control theory, real-time embedded implementation, and the
					behavior of machines operating under physical constraints. Models, software,
					diagnostics, and validation should not remain separate disciplines; they should
					support the same system behavior.
				</p>
				<p>
					That path runs from research in real-time control and diagnostics
					into production embedded systems, where decisions must survive timing
					limits, integration complexity, safety-related constraints, test evidence,
					and delivery pressure.
				</p>
			</div>
		</div>
	</section>

	<section class="section about-work-style" aria-labelledby="work-style-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<h2 id="work-style-title">How I work</h2>
				<p>Engineering judgment across models, software, and machines.</p>
			</div>
			<div class="work-style-list">
				{workPrinciples.map((item) => (
					<article>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="technical-scope-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="technical-scope-title">Technical scope</h2>
				<p>Where I tend to operate.</p>
				<p>
					I work on engineered systems where software decisions have physical consequences.
					Control intent, embedded implementation, and system-level evidence need to move
					together.
				</p>
			</div>
			<div class="capability-grid">
				{capabilityGroups.map((item) => (
					<article class="capability-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-split" aria-labelledby="research-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<h2 id="research-title">Research foundation</h2>
				<p>PhD-level rigor, applied to production engineering.</p>
			</div>
			<div class="about-copy">
				<p>
					My academic foundation in electrical engineering, real-time control, and
					diagnostics shapes how I reason about dynamic systems, modeling, estimation,
					diagnostic reasoning, fault response, and experimental evidence.
				</p>
				<p>
					On this site, research is not the main identity. It is the foundation behind a
					production engineering practice: disciplined analysis, careful assumptions, clear
					validation thinking, and respect for the distance between analytical correctness
					and dependable behavior in the field.
				</p>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="evidence-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="evidence-title">Evaluate the work</h2>
				<p>
					This page explains the professional through-line. The rest of the site gives
					different kinds of proof.
				</p>
			</div>
			<div class="evidence-grid">
				{evidenceLinks.map((item) => (
					<article class="evidence-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
						<a href={item.href}>{item.linkText}</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-final" aria-labelledby="final-title">
		<div class="page-container about-final__inner">
			<div>
				<h2 id="final-title">Contact</h2>
				<p>
					For roles, collaborations, or technical conversations around embedded controls,
					diagnostics, and reliable physical systems, get in touch.
				</p>
			</div>
			<div class="about-final__actions">
				<a class="button primary" href={withBase('/contact')}>Contact Carlos</a>
				<a class="button" href={withBase('/contact')}>LinkedIn and CV details</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.about-hero {
		padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
		border-bottom: 1px solid var(--color-border-soft);
	}

	.about-hero__inner {
		display: grid;
		gap: 1rem;
		max-width: 880px;
	}

	.about-hero h1 {
		max-width: 780px;
		font-size: clamp(2.5rem, 6vw, 4.75rem);
		line-height: 1;
	}

	.about-hero__lead {
		max-width: 760px;
		color: var(--color-text);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.55;
	}

	.about-hero__body {
		max-width: 760px;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.7;
	}

	.about-hero .button-row {
		margin-top: 0.75rem;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.section-intro--compact {
		margin-bottom: 1rem;
	}

	.proof-grid {
		display: grid;
		grid-template-columns: 1fr;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.proof-item {
		display: grid;
		gap: 0.45rem;
		padding: 1.1rem 0;
	}

	.proof-item + .proof-item {
		border-top: 1px solid var(--color-border);
	}

	.proof-item p {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.proof-item h3 {
		font-size: 1.1rem;
		line-height: 1.35;
	}

	.proof-item span {
		max-width: 260px;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.about-split__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	.split-heading {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
	}

	.about-split h2,
	.section-intro h2,
	.about-final h2 {
		max-width: 760px;
		font-size: clamp(1.7rem, 3.5vw, 2.65rem);
		line-height: 1.08;
	}

	.split-heading p,
	.about-final p {
		max-width: 700px;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.about-copy {
		display: grid;
		gap: 1rem;
		max-width: 760px;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.7;
	}

	.work-style-list {
		display: grid;
		max-width: 760px;
		border-top: 1px solid var(--color-border);
	}

	.work-style-list article {
		display: grid;
		gap: 0.45rem;
		border-bottom: 1px solid var(--color-border);
		padding: 1rem 0;
	}

	.work-style-list h3,
	.capability-item h3,
	.evidence-item h3 {
		font-size: 1rem;
		line-height: 1.35;
	}

	.work-style-list p,
	.capability-item p,
	.evidence-item p,
	.section-intro p {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.section-intro {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
		margin-bottom: 1.5rem;
	}

	.capability-grid,
	.evidence-grid {
		display: grid;
		grid-template-columns: 1fr;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.capability-item,
	.evidence-item {
		display: grid;
		gap: 0.55rem;
		padding: 1.1rem 0;
	}

	.capability-item + .capability-item,
	.evidence-item + .evidence-item {
		border-top: 1px solid var(--color-border);
	}

	.evidence-item a {
		width: fit-content;
		color: var(--color-accent);
		font-weight: 700;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.evidence-item a:hover,
	.evidence-item a:focus-visible {
		color: var(--color-text);
	}

	.about-final {
		border-top: 1px solid var(--color-border-soft);
	}

	.about-final__inner {
		display: grid;
		gap: 1.4rem;
		align-items: start;
	}

	.about-final__inner > div:first-child {
		display: grid;
		gap: 0.7rem;
	}

	.about-final__actions {
		display: grid;
		gap: 0.9rem;
		align-items: start;
	}

	.about-final__actions > .button {
		width: 100%;
	}

	@media (min-width: 760px) {
		.proof-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.proof-item {
			padding: 1.2rem;
		}

		.proof-item + .proof-item {
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.proof-item:nth-child(3) {
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.proof-item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}

		.capability-grid,
		.evidence-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capability-item,
		.evidence-item {
			padding: 1.2rem;
		}

		.capability-item + .capability-item,
		.evidence-item + .evidence-item {
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.capability-item:nth-child(odd),
		.evidence-item:nth-child(odd) {
			border-left: 0;
		}

		.capability-item:nth-child(n + 3),
		.evidence-item:nth-child(n + 3) {
			border-top: 1px solid var(--color-border);
		}
	}

	@media (min-width: 980px) {
		.about-split__grid {
			grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1fr);
			gap: clamp(2rem, 5vw, 4rem);
		}

		.capability-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.capability-item:nth-child(3n + 1) {
			border-left: 0;
		}

		.capability-item:nth-child(3) {
			border-top: 0;
		}

		.capability-item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}

		.about-final__inner {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 2rem;
		}

		.about-final__actions {
			min-width: 230px;
		}
	}

	@media (max-width: 640px) {
		.about-hero {
			padding-block: 3.5rem 2.75rem;
		}
	}
</style>
