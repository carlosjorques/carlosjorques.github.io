---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);

type TextPart = {
	text: string;
	strong?: boolean;
};

const professionalFoundation = [
	{
		context: 'EXPERIENCE',
		anchor: '10+ years of embedded controls',
		description: [
			{ text: 'Production-ready embedded control software across automotive, heavy-duty, autonomous-machine, and Tier 1 / client delivery environments.' },
		] satisfies TextPart[],
	},
	{
		context: 'LEADERSHIP',
		anchor: 'Technical architecture and direction',
		description: [
			{ text: 'Guiding cross-functional teams across model-based control development, ' },
			{ text: 'embedded software' },
			{ text: ', ' },
			{ text: 'diagnostics' },
			{ text: ', integration, ' },
			{ text: 'validation' },
			{ text: ', and delivery.' },
		] satisfies TextPart[],
	},
	{
		context: 'SCOPE',
		anchor: 'Full system integration and validation',
		description: [
			{ text: 'Controls architecture, active diagnostics, ' },
			{ text: 'safety-related constraints' },
			{ text: ', and end-to-end integration for systems in demanding environments.' },
		] satisfies TextPart[],
	},
	{
		context: 'BACKGROUND',
		anchor: 'PhD in control systems',
		description: [
			{ text: 'Peer-reviewed research' },
			{ text: ', academic rigor, and ' },
			{ text: 'patent work' },
			{ text: ' translated into production-oriented engineering decisions.' },
		] satisfies TextPart[],
	},
];

const capabilities = [
	{
		domain: 'Controls Architecture',
		challenge: 'Define behavior before implementation',
		description: [
			{
				text: 'Defining dynamic intent, transient handling, operating-envelope boundaries, estimation, observers, and control architecture before software complexity takes over.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Real-Time Embedded Software',
		challenge: 'Translate control intent into reliable execution',
		description: [
			{
				text: 'Shaping model-based pipelines, generated-code boundaries, software interfaces, ',
			},
			{ text: 'timing loops', strong: true },
			{
				text: ', C/C++ integration points, and maintainable target implementation.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Diagnostics & Fault Isolation',
		challenge: 'Make system health observable',
		description: [
			{ text: 'Designing observability, ' },
			{ text: 'signal-health monitoring', strong: true },
			{
				text: ', virtual sensing, fault response, and degradation strategies so systems can detect, degrade, and recover instead of failing silently.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Validation, MIL/SIL/HIL, and Field Evidence',
		challenge: 'Connect requirements with evidence',
		description: [
			{
				text: 'Bridging functional requirements with traceability, physical evidence, ',
			},
			{
				text: 'model-, software-, hardware-in-the-loop testing',
				strong: true,
			},
			{
				text: ', logs, calibration feedback, and field-oriented validation.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'System Integration',
		challenge: 'Keep software aligned with the machine',
		description: [
			{
				text: 'Aligning actuators, sensors, data buses, calibration parameters, software interfaces, safety-related constraints, and physical subsystems under real operating loads.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Technical Leadership',
		challenge: 'Turn technical ambiguity into shared direction',
		description: [
			{ text: 'Creating clarity around ' },
			{ text: 'technical direction', strong: true },
			{
				text: ', architecture, ownership, quality, delivery sequence, and release readiness so multidisciplinary teams can execute with autonomy and accountability.',
			},
		] satisfies TextPart[],
	},
];

const appliedExpertise = [
	{
		domain: 'Heavy-Duty Transportation',
		focus: [
			{
				text: 'Thermal management of electrified powertrains, battery systems, charger coordination, and combustion-control research.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Safety-Related Diagnostics and Fault Handling',
		focus: [
			{
				text: 'Software layers that observe system health, detect faults, support degradation strategies, and keep physical behavior predictable.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Autonomous Mobility Systems',
		focus: [
			{
				text: 'Propulsion and torque-control work for autonomous electric machines, including safety monitoring, validation, and field behavior.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Industry Standards and Production Deployment',
		focus: [
			{ text: 'Work shaped by ISO 26262, A-SPICE, AUTOSAR-oriented development, CI/CD, MIL/SIL/HIL testing' },
			{ text: ', supplier interfaces, and vehicle-level validation.' },
		] satisfies TextPart[],
	},
];

const evidenceLinks = [
	{
		title: 'Writing',
		description:
			'Technical thinking on embedded controls, diagnostics, physical systems, software architecture, and engineering judgment.',
		href: withBase('/writing'),
		linkText: 'Read my articles',
	},
	{
		title: 'Work',
		description:
			'A selection of my projects, engineering contributions, publications, patents, and research context.',
		href: withBase('/work'),
		linkText: 'View selected work, patents, and publications',
	},
];
---

<Layout
	title="About Carlos Jorques | Embedded Controls Architect"
	description="About Carlos Jorques, an embedded controls architect and technical leader developing control algorithms and real-time embedded software for reliable physical systems."
>
	<section class="about-hero">
		<div class="page-container about-hero__inner">
			<h1>Hi, I’m Carlos.</h1>
			<div class="about-hero__content">
				<p class="about-hero__lead">
					I design <strong>embedded control systems</strong> for physical machines.
				</p>

				<p class="about-hero__body">
					I lead technical teams where <strong>real-time control</strong>,
					<strong>embedded software</strong>, diagnostics, validation, and
					<strong>safety-related systems</strong> have to come together in production,
					from <strong>electrified vehicles</strong> to <strong>autonomous machines</strong>.
				</p>

				<p class="about-hero__body">
					Physical systems shape how people move, build, transport, and use energy.
					For me, improving their <strong>control software</strong> means helping machines
					consume less energy, respond more safely to faults, reduce downtime, and make
					advanced technologies more dependable in daily life.
				</p>

				<p class="about-hero__body">
					Based in <strong>Spain</strong>, I work with international engineering teams
					on systems where control software, physical hardware, uncertainty, diagnostics, validation,
					safety-related development, and production constraints have to come together.
				</p>

				<div class="button-row" aria-label="About page primary navigation links">
					<a class="button primary" href={withBase('/contact')}>Contact Carlos / Access CV</a>
					<a class="button" href={withBase('/work')}>Explore selected work</a>
					<a class="button" href={withBase('/writing')}>Read my articles</a>
				</div>
			</div>
			<figure class="about-hero__portrait">
				<img
					src={withBase('/images/carlos-jorques-intro.webp')}
					alt="Portrait of Carlos Jorques"
					width="768"
					height="1024"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</figure>
		</div>
	</section>

	<section class="section about-proof" aria-labelledby="professional-foundation-title">
		<div class="page-container">
			<div class="section-intro section-intro--compact">
				<h2 id="professional-foundation-title">Professional Foundation</h2>
				<p>
					Over the past decade, I have contributed to
					<strong>production and research work</strong> for <strong>Scania trucks</strong>,
					<strong>Volvo CE autonomous haulers</strong>,
					<strong>Mahle electrified powertrains</strong>, and
					<strong>Tier 1 / client delivery environments</strong>.
				</p>
				<p>
					My profile combines technical direction, production delivery, system-level
					validation, and a PhD research in control algorithms.
				</p>
			</div>
			<div class="proof-grid">
				{professionalFoundation.map((item) => (
					<article class="proof-item">
						<p>{item.context}</p>
						<h3>{item.anchor}</h3>
						<span>
							{item.description.map((part) =>
								part.strong ? <strong>{part.text}</strong> : part.text
							)}
						</span>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-split" aria-labelledby="work-challenge-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<h2 id="work-challenge-title">The challenge behind the work</h2>
				<p class="section-quote">
					<span class="section-quote__mark" aria-hidden="true">"</span>
					<em class="section-quote__text">
						How can machines sense, decide, and act under uncertainty in ways that
						make everyday systems safer, more efficient, and more useful?
					</em>
				</p>
			</div>
			<div class="about-copy">
				<p>
					That question has stayed with me since my early interest in <strong>robotics</strong>: the
					fascination that a machine could read its environment, react to it, and
					become useful through <strong>controlled behavior</strong>.
				</p>
				<p>
					<strong>Control theory</strong> gave me a framework for designing that behavior.
					<strong>Electrical engineering</strong> and <strong>doctoral research</strong> gave me the
					tools to reason about dynamic systems, uncertainty, diagnostics, and evidence.
				</p>
				<p>
					<strong>Production</strong> is where the theory is tested. Timing limits, cost boundaries,
					safety criteria, supplier interfaces, calibration maturity, validation
					evidence, and delivery pressure all shape what can actually work. My role
					is to help advanced control and software architectures remain <strong>clear,
					testable, and useful</strong> in that environment.
				</p>
				<p>
					Today I apply that systems thinking to vehicles and intelligent machines,
					providing technical guidance across <strong>architecture, validation, and delivery</strong>
					so the systems we build can operate reliably in the real world.
				</p>
				<div class="in-context-cta">
					<span>Evidence</span>
					<a href={withBase('/work')} class="text-link">See selected work, patents, and publications</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section about-work-style" aria-labelledby="execution-approach-title">
		<div class="page-container">
			<div class="about-work-style__lead">
				<div class="section-intro about-work-style__intro">
					<h2 id="execution-approach-title">Professional approach</h2>
					<p class="section-quote">
						<span class="section-quote__mark" aria-hidden="true">"</span>
						<em class="section-quote__text">An elegant algorithm is only the beginning.</em>
					</p>
					<p>
						The real engineering challenge is turning advanced algorithms into software that can be
						<strong>compiled, integrated, verified, calibrated, trusted, and mantained</strong> in the field.
					</p>
					<p>
						I value <strong>reliability over complexity</strong>: advanced algorithms only matter when they
						respect hardware constraints, safety-related requirements, validation evidence,
						and the realities of production delivery.
					</p>
					<p>
						My approach is <strong>disciplined curiosity</strong>: frame the question,
						<strong>test the assumptions</strong>, turn <strong>evidence into decisions</strong>,
						and use <strong>feedback</strong> to improve the next iteration.
						Try deliberately, <strong>manage the risk</strong>, and keep learning while moving toward delivery.
					</p>
					<p>
						I bridge high-level strategy and robust implementation by shaping architectures,
						supporting technical decisions, and helping teams build software that can be
						trusted in the real world.
					</p>
					<a class="text-link" href={withBase('/writing')}>
						Read more about disciplined curiosity →
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="technical-areas-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="technical-areas-title">Technical areas</h2>
				<p>
					The main technical areas where my work connects control design, embedded
					implementation, diagnostics, validation, and system behavior.
				</p>
			</div>
			<div class="capability-grid">
				{capabilities.map((item) => (
					<article class="capability-item">
						<p class="capability-item__area">{item.challenge}</p>
						<h3>{item.domain}</h3>
						<p>
							{item.description.map((part) =>
								part.strong ? <strong>{part.text}</strong> : part.text
							)}
						</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="applied-domains-title">
		<div class="page-container applied-domains__inner">
			<div class="section-intro">
				<h2 id="applied-domains-title">Applied domains</h2>
				<p>
					Examples of the product and engineering contexts where my experience applies.
				</p>
			</div>
			<div class="applied-domains__body">
				<figure class="applied-domain-visual">
					<img
						src={withBase('/images/volvo-ta15-autonomous-hauler.webp')}
						alt="Volvo CE autonomous hauler operating in an industrial environment"
						width="1050"
						height="1200"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>
						<span>
							A real-world machine is where control intent, embedded software,
							diagnostics, validation, and field behavior have to become one dependable
							system.
						</span>
					</figcaption>
				</figure>

				<div class="applied-domains__content">
					<div class="challenge-grid">
						{appliedExpertise.map((item) => (
							<article class="challenge-item">
								<h3>{item.domain}</h3>
								<p>
									{item.focus.map((part) =>
										part.strong ? <strong>{part.text}</strong> : part.text
									)}
								</p>
							</article>
						))}
					</div>
					<div class="section-footer-cta">
						<p>Want more details of my professional path?</p>
						<a class="text-link" href={withBase('/contact')}>Access CV or connect via LinkedIn →</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="explore-work-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="explore-work-title">Explore more of my work</h2>
			</div>
			<div class="evidence-grid">
				{evidenceLinks.map((item) => (
					<article class="evidence-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
						<a href={item.href}>{item.linkText}</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-final" aria-labelledby="connect-title">
		<div class="page-container about-final__inner">
			<div>
				<h2 id="connect-title">Let’s connect</h2>
				<p>
					For roles, collaborations, or technical conversations around
					<strong>embedded controls, diagnostics, safety-related development, and reliable physical systems</strong>, I’m
					open to hearing from you.
				</p>
			</div>
			<div class="about-final__actions">
				<a class="button primary" href={withBase('/contact')}>Contact Carlos / Access CV</a>
				<a class="button" href="https://www.linkedin.com/in/carlosjorques/" target="_blank" rel="noopener noreferrer">View LinkedIn Profile</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	@import url("https://fonts.googleapis.com/css2?family=Stack+Sans+Text:wght@200..700&display=swap");

	.about-hero {
		padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
		border-bottom: 1px solid var(--color-border-soft);
		background: var(--color-page);
	}

	.about-hero__inner {
		display: grid;
		row-gap: 1rem;
		column-gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
		max-width: 1120px;
	}

	.about-hero__content {
		display: grid;
		gap: 1rem;
		max-width: 700px;
	}

	.about-hero h1 {
		max-width: 700px;
		font-size: clamp(2.35rem, 5.2vw, 4.35rem);
		line-height: 1.02;
	}

	.about-hero__lead {
		max-width: 700px;
		color: var(--color-text);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.55;
	}

	.about-hero__body {
		max-width: 680px;
		color: var(--color-muted);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.about-hero strong,
	.about-copy strong,
	.about-work-style__intro strong,
	.about-final strong,
	.proof-item strong,
	.capability-item strong,
	.challenge-item strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.about-hero .button-row {
		margin-top: var(--spacing-06);
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.about-hero__portrait {
		margin: var(--spacing-05) 0 0;
		width: min(100%, 380px);
		justify-self: start;
	}

	.about-hero__portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		height: auto;
		object-fit: cover;
		object-position: center;
		transition: transform var(--motion-duration-moderate-02) var(--motion-standard-productive);
	}

	.about-hero__portrait:hover img {
		transform: translateY(-4px);
	}

	.section-intro--compact {
		margin-bottom: var(--spacing-06);
	}

	.proof-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.25rem, 3vw, 1.75rem);
		background: transparent;
	}

	.proof-item {
		display: grid;
		gap: 0.45rem;
		padding: 1.2rem;
		border: 1px solid var(--color-card-border);
		background: var(--color-card-bg);
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.proof-item:hover {
		background: var(--color-card-bg-hover);
		border-color: var(--color-card-border-hover);
		transform: translateY(-2px);
	}

	.proof-item p {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.proof-item h3 {
		color: var(--color-text);
		font-size: 1.2rem;
		line-height: 1.35;
	}

	.proof-item span {
		max-width: 100%;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.about-split__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	.about-work-style__lead {
		display: grid;
		gap: clamp(1.4rem, 3vw, 2rem);
		align-items: start;
	}

	.about-work-style__intro {
		gap: 0.85rem;
		max-width: 820px;
		margin-bottom: 0;
	}

	.about-work-style__intro .text-link {
		margin-top: var(--spacing-02);
	}

	.split-heading {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
	}

	.section-quote {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(0.85rem, 2vw, 1.2rem);
		align-items: start;
		margin: 0;
		max-width: 760px;
		border: 1px solid var(--color-border-soft);
		background: var(--color-quote-bg);
		color: var(--color-quote-text);
		padding: clamp(1rem, 2.4vw, 1.5rem);
		font-size: clamp(1.45rem, 3vw, 2.35rem);
		font-weight: 400;
		line-height: 1.18;
	}

	.split-heading > h2 + .section-quote,
	.about-work-style__intro > h2 + .section-quote {
		margin-top: clamp(var(--spacing-03), 1.3vw, var(--spacing-05));
	}

	.section-quote__mark {
		margin-top: -0.18em;
		color: var(--color-quote-text);
		font-family: "Stack Sans Text", sans-serif;
		font-optical-sizing: auto;
		font-style: normal;
		font-size: clamp(3rem, 6vw, 5.1rem);
		font-weight: 400;
		line-height: 1.0;
	}

	.section-quote__text {
		font-style: italic;
		font-family: var(--font-mono);
		color: var(--color-quote-text);
		letter-spacing: -0.05em;
		font-size: clamp(1.25rem, 2.4vw, 1.5rem);
	}

	.about-work-style__intro .section-quote {
		max-width: 680px;
		font-size: clamp(1.25rem, 2.4vw, 1.8rem);
	}

	.about-split h2,
	.section-intro h2,
	.about-final h2 {
		max-width: 760px;
		font-size: clamp(1.7rem, 3.5vw, 2.65rem);
		line-height: 1.08;
	}

	.split-heading p:not(.section-quote),
	.about-final p {
		max-width: 700px;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.about-copy {
		display: grid;
		gap: 1.2rem;
		max-width: 760px;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.in-context-cta,
	.section-footer-cta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: var(--spacing-05);
		padding: 1rem;
		background: var(--color-surface-soft);
		border-left: 3px solid var(--color-accent);
		transition:
			border-left-width var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.in-context-cta:hover,
	.section-footer-cta:hover,
	.in-context-cta:focus-within,
	.section-footer-cta:focus-within {
		border-left-width: 6px;
		transform: translateX(2px);
	}

	.in-context-cta span,
	.section-footer-cta p {
		color: var(--color-text);
		font-size: 0.9rem;
	}

	.capability-item h3,
	.challenge-item h3,
	.evidence-item h3 {
		color: var(--color-text);
		font-size: 1.15rem;
		line-height: 1.35;
	}

	.capability-item p,
	.challenge-item p,
	.evidence-item p,
	.section-intro p {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.capability-item__area {
		color: var(--color-accent) !important;
		font-family: var(--font-sans);
		font-size: 0.85rem !important;
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.35 !important;
		margin-bottom: var(--spacing-01);
	}

	.section-intro {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
