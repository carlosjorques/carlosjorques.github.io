---
import Layout from '../layouts/Layout.astro';
import aboutMarkdown from '../content/profile/about.md?raw';
import { parseAboutContent } from '../lib/profileMarkdown';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);

const aboutContent = parseAboutContent(aboutMarkdown);
const exploreHrefByTitle: Record<string, string> = {
	CV: '/cv',
	Work: '/work',
	Writing: '/writing',
	Contact: '/contact',
};
const evidenceLinks = aboutContent.exploreMore.items.map((item) => ({
	...item,
	href: withBase(exploreHrefByTitle[item.title] ?? '/work'),
}));
---

<Layout
	title="About Carlos Jorques | Embedded Controls Architect"
	description="About Carlos Jorques, an embedded controls architect and technical leader developing control algorithms and real-time embedded software for reliable physical systems."
>
	<section class="about-hero">
		<div class="page-container about-hero__inner">
			<h1 class="hero-title">{aboutContent.hero.title}</h1>
			<div class="about-hero__content">
				{aboutContent.hero.paragraphs.map((paragraph) => (
					<p class="about-hero__body body-text">
						{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}
					</p>
				))}

				<div class="button-row" aria-label="About page primary navigation links">
					<a class="button primary" href={withBase('/cv')}>View online CV</a>
					<a class="button" href={withBase('/work')}>Explore selected work</a>
					<a class="button" href={withBase('/writing')}>Read my articles</a>
				</div>
			</div>
			<figure class="about-hero__portrait">
				<img
					src={withBase('/images/carlos-jorques-intro.webp')}
					alt="Portrait of Carlos Jorques"
					width="768"
					height="1024"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</figure>
		</div>
	</section>

	<section class="section about-split about-band about-band--white" aria-labelledby="why-control-systems-title">
		<div class="page-container about-split__grid about-split__grid--with-visual">
			<div class="about-split__main">
				<h2 id="why-control-systems-title">{aboutContent.whyPhysicalSystems.title}</h2>
				<div class="about-copy">
					{aboutContent.whyPhysicalSystems.paragraphs.map((paragraph) => (
						<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
					))}
				</div>
			</div>
			<figure class="governor-visual">
				<div class="governor-visual__crop">
					<img
						src={withBase('/images/steam-engine-governor-patent-lines.png')}
						alt="Steam engine governor patent drawing showing a mechanical speed regulator with rotating balls, levers, and valve linkage."
						width="700"
						height="1050"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</figure>
		</div>
	</section>

	<section class="section about-split about-band about-band--white" aria-labelledby="how-i-got-here-title">
		<div class="page-container about-split__grid">
			<div class="about-split__main">
				<h2 id="how-i-got-here-title">{aboutContent.howIGotHere.title}</h2>
				<div class="about-copy">
					{aboutContent.howIGotHere.paragraphs.map((paragraph) => (
						<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
					))}
				</div>
			</div>
			<blockquote class="section-quote">
				<p>{aboutContent.howIGotHere.quote}</p>
			</blockquote>
		</div>
	</section>

	<section class="section about-split about-split--reverse about-band about-band--warm" aria-labelledby="how-i-work-title">
		<div class="page-container about-split__grid">
			<div class="about-split__main">
				<h2 id="how-i-work-title">{aboutContent.howIWork.title}</h2>
				<div class="about-copy">
					{aboutContent.howIWork.paragraphs.map((paragraph) => (
						<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
					))}
				</div>
			</div>
			<blockquote class="section-quote">
				<p>{aboutContent.howIWork.quote}</p>
			</blockquote>
		</div>
	</section>

	<section class="section about-split about-split--reverse about-band about-band--white" aria-labelledby="beyond-engineering-title">
		<div class="page-container about-split__grid">
			<div class="about-split__main">
				<h2 id="beyond-engineering-title">{aboutContent.beyondEngineering.title}</h2>
				<div class="about-copy">
					{aboutContent.beyondEngineering.paragraphs.map((paragraph) => (
						<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="explore-work-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="explore-work-title">{aboutContent.exploreMore.title}</h2>
			</div>
			<div class="evidence-grid">
				{evidenceLinks.map((item) => (
					<article class="evidence-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
						<a href={item.href}>{item.linkText}</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-final" aria-labelledby="connect-title">
		<div class="page-container about-final__inner">
			<div>
				<h2 id="connect-title">{aboutContent.connect.title}</h2>
				{aboutContent.connect.paragraphs.map((paragraph) => (
					<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
				))}
			</div>
			<div class="about-final__actions">
				<a class="button primary" href={withBase('/cv')}>View online CV</a>
				<a class="button" href="https://www.linkedin.com/in/carlosjorques/" target="_blank" rel="noopener noreferrer">View LinkedIn Profile</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.about-hero {
		padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
		border-bottom: 1px solid var(--color-border-soft);
		background: transparent;
	}

	.about-hero ~ .section {
		background: transparent;
	}

	.about-hero ~ .about-proof,
	.about-hero ~ .about-band--white {
		background: transparent;
	}

	.about-hero ~ .about-band--warm {
		background: transparent;
	}

	.about-hero ~ .about-final {
		background: transparent;
	}

	.about-hero__inner {
		display: grid;
		row-gap: clamp(1.5rem, 3vw, 2.15rem);
		column-gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
		max-width: 1120px;
	}

	.about-hero__content {
		display: grid;
		max-width: 700px;
	}

	.about-hero h1 {
		max-width: 700px;
		font-family: var(--font-display);
		font-size: var(--type-hero-name-size);
		line-height: var(--type-hero-name-line);
		letter-spacing: var(--type-hero-name-tracking);
		font-weight: var(--type-hero-name-weight);
	}

	.about-hero__lead {
		max-width: 700px;
		color: var(--color-text);
		font-size: var(--type-hero-summary-size);
		line-height: var(--type-hero-summary-line);
		letter-spacing: var(--type-hero-summary-tracking);
		font-weight: var(--type-hero-summary-weight);
	}

	.about-hero__body {
		max-width: 680px;
		color: var(--color-body-text);
		font-family: var(--font-body);
		font-size: var(--type-body-size);
		line-height: var(--type-body-line);
		letter-spacing: var(--type-body-tracking);
		margin: 0;
	}

	.about-hero__body + .about-hero__body {
		margin-top: 0.55rem;
	}

	.about-hero strong,
	.about-copy strong,
	.about-final strong,
	.proof-item strong,
	.capability-item strong,
	.challenge-item strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.about-hero .button-row {
		margin-top: var(--spacing-06);
		margin-bottom: clamp(1.8rem, 4vw, 2.75rem);
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.about-hero .button {
		min-height: 38px;
		padding: 0.45rem 0.9rem;
	}

	.about-hero .button:not(.primary):hover,
	.about-hero .button:not(.primary):focus-visible {
		border-color: var(--color-button-primary-state-bg);
	}

	.about-hero__portrait {
		margin: var(--spacing-05) 0 0;
		width: min(100%, 380px);
		overflow: hidden;
		border-radius: var(--radius);
		justify-self: start;
	}

	.about-hero__portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		height: auto;
		border-radius: inherit;
		object-fit: cover;
		object-position: center;
		transition: transform var(--motion-duration-moderate-02) var(--motion-standard-productive);
	}

	.about-hero__portrait:hover img {
		transform: translateY(-4px);
	}

	.section-intro--compact {
		margin-bottom: var(--spacing-06);
	}

	.proof-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.25rem, 3vw, 1.75rem);
		background: transparent;
	}

	.proof-item {
		display: grid;
		gap: 0.45rem;
		padding: 1.2rem;
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius);
		background: var(--color-card-bg);
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.proof-item:hover {
		background: var(--color-card-bg-hover);
		border-color: var(--color-card-border-hover);
		transform: translateY(-2px);
	}

	.proof-item h3 {
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: var(--type-eyebrow-size);
		font-weight: var(--type-eyebrow-weight);
		line-height: var(--type-eyebrow-line);
		letter-spacing: var(--type-eyebrow-tracking);
		text-transform: uppercase;
	}

	.proof-item__anchor {
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: var(--type-card-title-size);
		font-weight: var(--type-card-title-weight);
		letter-spacing: var(--type-card-title-tracking);
		line-height: var(--type-card-title-line);
		text-transform: none;
	}

	.proof-item span {
		max-width: 100%;
		color: var(--color-body-text);
		font-family: var(--font-body);
		font-size: var(--type-card-body-size);
		line-height: var(--type-card-body-line);
		letter-spacing: var(--type-card-body-tracking);
	}

	.about-split__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	.about-split__main {
		display: grid;
		gap: clamp(1rem, 2vw, 1.4rem);
		max-width: 760px;
	}

	.governor-visual {
		display: grid;
		gap: 0.65rem;
		margin: 0;
		max-width: 340px;
		justify-self: start;
		pointer-events: none;
	}

	.governor-visual__crop {
		overflow: hidden;
		background: transparent;
		aspect-ratio: 4 / 5;
	}

        .governor-visual img {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: 50% 45%;
                opacity: 0.78;
        }

        :global(:root[data-theme="dark"]) .governor-visual img {
                filter: invert(1) brightness(1.22) contrast(1.08);
                opacity: 0.92;
        }

        .section-quote {
                position: relative;
                margin: 0;
		box-sizing: border-box;
		width: min(100%, 34rem);
		max-width: 34rem;
		padding: clamp(0.5rem, 1.4vw, 0.75rem) 0 clamp(0.5rem, 1.4vw, 0.75rem) clamp(2.85rem, 4.5vw, 3.65rem);
		color: var(--color-quote-text);
	}

	.section-quote::before {
		content: "“";
		position: absolute;
		left: 0;
		top: -0.28rem;
		color: currentColor;
		font-family: var(--font-display);
		font-size: clamp(4.25rem, 7vw, 6.5rem);
		font-style: normal;
		font-weight: 600;
		line-height: 0.82;
		opacity: 0.9;
	}

	.section-quote p {
		position: relative;
		margin: 0;
		color: currentColor;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2vw, 1.8rem);
		font-style: italic;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.34;
	}

	.about-split h2,
	.section-intro h2,
	.about-final h2 {
		max-width: 760px;
		font-size: var(--type-section-title-size);
		line-height: var(--type-section-title-line);
		letter-spacing: var(--type-section-title-tracking);
		font-weight: var(--type-section-title-weight);
	}

	.about-final p {
		max-width: 700px;
		color: var(--color-body-text);
		font-size: var(--type-body-size);
		line-height: var(--type-body-line);
	}

	.about-copy {
		display: grid;
		gap: 1.2rem;
		max-width: 760px;
		color: var(--color-body-text);
		font-size: var(--type-body-size);
		line-height: var(--type-body-line);
	}

	.section-footer-cta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: var(--spacing-05);
		padding: 1rem;
		background: linear-gradient(90deg, var(--color-accent-text) 0 3px, transparent 3px);
		background-repeat: no-repeat;
		transition:
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.section-footer-cta:hover,
	.section-footer-cta:focus-within {
		transform: translateX(2px);
	}

	.section-footer-cta p {
		color: var(--color-text);
		font-size: var(--type-body-size);
	}

	.capability-item h3,
	.challenge-item h3,
	.evidence-item h3 {
		color: var(--color-text);
		font-size: var(--type-card-title-size);
		line-height: var(--type-card-title-line);
		letter-spacing: var(--type-card-title-tracking);
		font-weight: var(--type-card-title-weight);
	}

	.capability-item p,
	.challenge-item p,
	.evidence-item p,
	.section-intro p {
		color: var(--color-body-text);
		font-size: var(--type-card-body-size);
		line-height: var(--type-card-body-line);
	}

	.capability-item__area {
		color: var(--color-card-subtext) !important;
		font-family: var(--font-body);
		font-size: var(--type-meta-size) !important;
		font-weight: 500;
		letter-spacing: var(--type-meta-tracking);
		line-height: var(--type-meta-line) !important;
		margin-bottom: var(--spacing-01);
	}

	.challenge-item__context {
		color: var(--color-card-subtext) !important;
		font-family: var(--font-body);
		font-size: var(--type-meta-size) !important;
		font-style: italic;
		font-weight: 500;
		line-height: var(--type-meta-line) !important;
	}

	.section-intro {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
		margin-bottom: var(--spacing-07);
	}

	.applied-domains__inner {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	.applied-domains__inner .section-intro {
		margin-bottom: 0;
	}

	.applied-domains__body {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	.applied-domains__content {
		display: grid;
		gap: 1rem;
	}

	.applied-domain-visual {
		margin: 0;
		max-width: 520px;
	}

	.applied-domain-visual img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.applied-domain-visual figcaption {
		display: grid;
		gap: 0.35rem;
		margin-top: var(--spacing-04);
		max-width: 520px;
		background: transparent;
		color: var(--color-body-text);
		font-size: var(--type-body-size);
		line-height: 1.5;
	}

	.applied-domain-visual figcaption small {
		color: var(--color-body-text);
		font-size: var(--type-meta-size);
		line-height: 1.45;
	}

	.capability-grid,
	.challenge-grid,
	.evidence-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.25rem, 3vw, 1.75rem);
		background: transparent;
	}

	.capability-item,
	.challenge-item,
	.evidence-item {
		display: grid;
		gap: 0.35rem;
		padding: 1.5rem;
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius);
		background: var(--color-card-bg);
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.capability-item:hover,
	.challenge-item:hover,
	.evidence-item:hover {
		background: var(--color-card-bg-hover);
		border-color: var(--color-card-border-hover);
		transform: translateY(-2px);
	}

	.evidence-item a,
	.text-link {
		width: fit-content;
		color: var(--color-link);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		display: inline-block;
		transition:
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.evidence-item a:hover,
	.evidence-item a:focus-visible,
	.text-link:hover,
	.text-link:focus-visible {
		color: var(--color-link-hover);
		transform: translateX(4px);
	}

	.about-final {
		margin-top: var(--spacing-07);
		border-top: 1px solid var(--color-border-soft);
		background: var(--color-footer-bg);
	}

	.about-final__inner {
		display: grid;
		gap: 1.4rem;
		align-items: start;
	}

	.about-final__inner > div:first-child {
		display: grid;
		gap: 0.7rem;
	}

	.about-final__actions {
		display: grid;
		gap: 0.9rem;
		align-items: start;
	}

	.about-final__actions > .button {
		width: 100%;
	}

	@media (min-width: 760px) {
		.proof-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.proof-item {
			padding: 1.5rem;
		}

		.capability-grid,
		.challenge-grid,
		.evidence-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capability-item,
		.challenge-item,
		.evidence-item {
			padding: 1.5rem;
		}

	}

	@media (min-width: 980px) {
		.about-hero__inner {
			grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
			align-items: stretch;
		}

		.about-hero h1 {
			grid-column: 1;
		}

		.about-hero__content {
			grid-column: 1;
			max-width: none;
			align-self: stretch;
		}

		.about-hero .button-row {
			flex-wrap: nowrap;
		}

		.about-hero__portrait {
			grid-column: 2;
			grid-row: 1 / 3;
			margin: 0;
			align-self: center;
			justify-self: end;
		}

		.about-split__grid {
			grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
			gap: clamp(2rem, 4vw, 3rem);
		}

		.about-split__grid--with-visual {
			position: relative;
		}

		.governor-visual {
			position: absolute;
			inset-block-start: 0.15rem;
			inset-block-end: 0;
			inset-inline-end: 0;
			width: auto;
			height: calc(100% - 0.15rem);
			max-width: none;
		}

		.governor-visual__crop {
			height: 100%;
		}

		.about-split--reverse .about-split__grid {
			grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
		}

		.about-split--reverse .about-split__main {
			grid-column: 2;
		}

		.about-split--reverse .section-quote {
			grid-column: 1;
			grid-row: 1;
		}

		.capability-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.applied-domains__body {
			grid-template-columns: minmax(260px, 0.42fr) minmax(0, 1fr);
		}

		.applied-domain-visual {
			top: 2rem;
		}

		.about-final__inner {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 2rem;
		}

		.about-final__actions {
			min-width: 230px;
		}
	}

	@media (max-width: 640px) {
		.about-hero {
			padding-block: 3.5rem 2.75rem;
		}

		.about-hero__inner {
			row-gap: 1.35rem;
		}

		.about-hero__body + .about-hero__body {
			margin-top: 0.55rem;
		}

		.about-hero .button-row {
			margin-top: var(--spacing-06);
			margin-bottom: 2rem;
		}

		.section-quote {
			width: calc(100vw - 2rem);
			max-width: 100%;
			padding-left: 2.45rem;
		}

