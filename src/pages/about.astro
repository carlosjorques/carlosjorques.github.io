---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);

const proofPoints = [
	{
		label: 'Experience',
		value: '10+ years',
		description: 'Automotive embedded systems and production-oriented engineering environments.',
	},
	{
		label: 'Role level',
		value: 'Technical leadership',
		description: 'Direction across model-based control, embedded software, testing, and delivery.',
	},
	{
		label: 'Scope',
		value: 'Controls to validation',
		description: 'Embedded controls, diagnostics, validation, safety-related constraints, and integration.',
	},
	{
		label: 'Foundation',
		value: 'PhD-level rigor',
		description: 'Electrical engineering, real-time control, diagnostics, modeling, and evidence-based reasoning.',
	},
];

const workPrinciples = [
	{
		title: 'Start from behavior',
		description:
			'I begin with the behavior the system must achieve — response, stability, fault handling, timing, observability, and user value — before translating it into software and validation decisions.',
	},
	{
		title: 'Reduce uncertainty deliberately',
		description:
			'I use models, experiments, simulation, and test evidence to turn open questions into clearer assumptions, constraints, risks, and decision criteria.',
	},
	{
		title: 'Lead through clarity',
		description:
			'I help teams align around goals, trade-offs, ownership, quality, and delivery sequence so advanced control ideas can become production-ready systems.',
	},
];

const capabilityGroups = [
	{
		title: 'How should the system behave?',
		area: 'Controls architecture',
		description:
			'Defining control intent, dynamic behavior, constraints, and architecture decisions before implementation details dominate the discussion.',
	},
	{
		title: 'How does the behavior become software?',
		area: 'Real-time embedded software',
		description:
			'Shaping model-based implementation, generated code boundaries, interfaces, timing, and maintainable production software.',
	},
	{
		title: 'How does the system know when something is wrong?',
		area: 'Diagnostics and fault handling',
		description:
			'Building observability, fault response, degradation behavior, and system confidence into systems that cannot afford to fail silently.',
	},
	{
		title: 'How do we know it is ready?',
		area: 'Validation and production readiness',
		description:
			'Connecting requirements, simulation, validation, integration feedback, and production deployment to reduce delivery risk.',
	},
	{
		title: 'How does it fit into the full machine?',
		area: 'System integration',
		description:
			'Aligning sensing, actuation, calibration, software interfaces, and machine-level response across real operating conditions.',
	},
	{
		title: 'How does the team move together?',
		area: 'Technical leadership',
		description:
			'Creating clarity around trade-offs, ownership, quality, and delivery sequence so teams can move with autonomy and accountability.',
	},
];

const projectChallenges = [
	{
		title: 'Electrified powertrain and energy systems',
		description:
			'Control and software challenges where efficiency, thermal behavior, energy use, reliability, and real-time constraints have to be balanced in production-oriented environments.',
	},
	{
		title: 'Diagnostics and reliable operation',
		description:
			'Systems that need to detect, respond, degrade, and recover in understandable ways when faults or uncertainty affect physical behavior.',
	},
	{
		title: 'Autonomous and intelligent machines',
		description:
			'Machines that sense, plan, respond, and adapt to their environment, and the architectures and teams required to make that behavior dependable.',
	},
	{
		title: 'From intent to delivery',
		description:
			'Connecting intent, architecture, implementation, validation, and team execution so advanced ideas become production-ready systems.',
	},
];

const evidenceLinks = [
	{
		title: 'Writing',
		description:
			'Technical thinking on embedded controls, diagnostics, physical systems, software architecture, and engineering judgment.',
		href: withBase('/writing'),
		linkText: 'Read technical writing',
	},
	{
		title: 'Work',
		description:
			'Selected public-safe evidence of projects, engineering contributions, publications, patents, and research context.',
		href: withBase('/work'),
		linkText: 'View selected work',
	},
	{
		title: 'CV and contact',
		description:
			'For formal career details, contact information, LinkedIn, and CV access, use the contact page.',
		href: withBase('/contact'),
		linkText: 'Go to contact and CV details',
	},
];
---

<Layout
	title="About Carlos Jorques | Embedded Controls Architect"
	description="About Carlos Jorques, an embedded controls architect and technical leader developing control algorithms and real-time embedded software for reliable physical systems."
>
	<section class="about-hero">
		<div class="page-container about-hero__inner">
			<p class="eyebrow">About</p>
			<h1>Hi, I’m Carlos.</h1>
			<p class="about-hero__lead">
				I develop control algorithms and embedded software that help complex physical
				systems behave intelligently, efficiently, and reliably in the real world.
			</p>
			<p class="about-hero__body">
				My work sits between control engineering, real-time software, diagnostics,
				validation, and technical leadership. I am interested not only in how machines
				sense, respond, and adapt, but also in how engineering teams turn advanced control
				strategies into production-ready products that people can trust.
			</p>
			<p class="about-hero__body">
				That work appears in different forms: electrified vehicles, powertrain and battery
				systems, thermal management, autonomous machines, and safety-related development
				environments where software decisions have physical consequences.
			</p>
			<div class="button-row" aria-label="About page primary links">
				<a class="button primary" href={withBase('/work')}>View selected work</a>
				<a class="button" href={withBase('/writing')}>Read technical writing</a>
				<a class="button" href={withBase('/contact')}>Contact</a>
			</div>
		</div>
	</section>

	<section class="section about-proof" aria-labelledby="proof-title">
		<div class="page-container">
			<div class="section-intro section-intro--compact">
				<h2 id="proof-title">What I bring to this work</h2>
				<p>
					The work combines production experience, technical leadership, systems scope,
					and an academic foundation in control and diagnostics.
				</p>
			</div>
			<div class="proof-grid">
				{proofPoints.map((item) => (
					<article class="proof-item">
						<p>{item.label}</p>
						<h3>{item.value}</h3>
						<span>{item.description}</span>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-split" aria-labelledby="coherence-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<h2 id="coherence-title">The question behind the work</h2>
			</div>
			<div class="about-copy">
				<p>
					How do machines become intelligent enough to help us safely, efficiently, and
					reliably? And how do we make sure that the systems we build actually improve the
					way people live and work?
				</p>
				<p>
					My interest in that question started early with taking things apart to understand
					how they worked. Over time, that curiosity became more disciplined: how should a
					machine sense, respond, act, and adapt under real-world constraints?
				</p>
				<p>
					Control engineering gave me a language for that problem. Electrical engineering
					and doctoral research gave me tools to reason about dynamic systems, uncertainty,
					diagnostics, modeling, and evidence. Production engineering then made the question
					more concrete: how do those ideas survive timing limits, integration complexity,
					safety-related constraints, validation evidence, and delivery pressure?
				</p>
				<p>
					That is where I try to contribute. Earlier in my career, I pushed knowledge
					through research in real-time control and diagnostics. Today, I apply and extend
					that thinking through systems, software, architectures, and teams building
					reliable machines.
				</p>
			</div>
		</div>
	</section>

	<section class="section about-work-style" aria-labelledby="work-style-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<h2 id="work-style-title">How I work</h2>
				<p>
					The practical challenge is rarely only the algorithm. It is turning uncertain
					system behavior into decisions that can be implemented, tested, integrated, and
					trusted.
				</p>
			</div>
			<div class="work-style-list">
				{workPrinciples.map((item) => (
					<article>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="technical-scope-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="technical-scope-title">Where my skills apply</h2>
				<p>
					For recruiters and technical teams, the clearest way to understand my profile is
					through the problems I usually help solve.
				</p>
			</div>
			<div class="capability-grid">
				{capabilityGroups.map((item) => (
					<article class="capability-item">
						<h3>{item.title}</h3>
						<p class="capability-item__area">{item.area}</p>
						<p>{item.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="challenge-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="challenge-title">Where this becomes concrete</h2>
				<p>
					The abstract language of control, software, diagnostics, and validation becomes
					practical in projects where physical behavior, product constraints, and team
					execution meet.
				</p>
			</div>
			<div class="challenge-grid">
				{projectChallenges.map((item) => (
					<article class="challenge-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))}
			</div>
			<a class="text-link" href={withBase('/work')}>View selected work</a>
		</div>
	</section>

	<section class="section" aria-labelledby="evidence-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="evidence-title">Evaluate the work</h2>
				<p>
					This page explains the professional narrative. The rest of the site gives
					different kinds of proof.
				</p>
			</div>
			<div class="evidence-grid">
				{evidenceLinks.map((item) => (
					<article class="evidence-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
						<a href={item.href}>{item.linkText}</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-final" aria-labelledby="final-title">
		<div class="page-container about-final__inner">
			<div>
				<h2 id="final-title">Contact</h2>
				<p>
					For roles, collaborations, or technical conversations around embedded controls,
					diagnostics, and reliable physical systems, get in touch.
				</p>
			</div>
			<div class="about-final__actions">
				<a class="button primary" href={withBase('/contact')}>Contact Carlos</a>
				<a class="button" href={withBase('/contact')}>LinkedIn and CV details</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.about-hero {
		padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
		border-bottom: 1px solid var(--color-border-soft);
	}

	.about-hero__inner {
		display: grid;
		gap: 1rem;
		max-width: 880px;
	}

	.about-hero h1 {
		max-width: 780px;
		font-size: clamp(2.5rem, 6vw, 4.75rem);
		line-height: 1;
	}

	.about-hero__lead {
		max-width: 760px;
		color: var(--color-text);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.55;
	}

	.about-hero__body {
		max-width: 760px;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.7;
	}

	.about-hero .button-row {
		margin-top: 0.75rem;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.section-intro--compact {
		margin-bottom: 1rem;
	}

	.proof-grid {
		display: grid;
		grid-template-columns: 1fr;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.proof-item {
		display: grid;
		gap: 0.45rem;
		padding: 1.1rem 0;
	}

	.proof-item + .proof-item {
		border-top: 1px solid var(--color-border);
	}

	.proof-item p {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.proof-item h3 {
		font-size: 1.1rem;
		line-height: 1.35;
	}

	.proof-item span {
		max-width: 260px;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.about-split__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	.split-heading {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
	}

	.about-split h2,
	.section-intro h2,
	.about-final h2 {
		max-width: 760px;
		font-size: clamp(1.7rem, 3.5vw, 2.65rem);
		line-height: 1.08;
	}

	.split-heading p,
	.about-final p {
		max-width: 700px;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.about-copy {
		display: grid;
		gap: 1rem;
		max-width: 760px;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.7;
	}

	.work-style-list {
		display: grid;
		max-width: 760px;
		border-top: 1px solid var(--color-border);
	}

	.work-style-list article {
		display: grid;
		gap: 0.45rem;
		border-bottom: 1px solid var(--color-border);
		padding: 1rem 0;
	}

	.work-style-list h3,
	.capability-item h3,
	.challenge-item h3,
	.evidence-item h3 {
		font-size: 1rem;
		line-height: 1.35;
	}

	.work-style-list p,
	.capability-item p,
	.challenge-item p,
	.evidence-item p,
	.section-intro p {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.capability-item__area {
		color: var(--color-accent) !important;
		font-family: var(--font-mono);
		font-size: 0.72rem !important;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.25 !important;
		text-transform: uppercase;
	}

	.section-intro {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
		margin-bottom: 1.5rem;
	}

	.capability-grid,
	.challenge-grid,
	.evidence-grid {
		display: grid;
		grid-template-columns: 1fr;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.capability-item,
	.challenge-item,
	.evidence-item {
		display: grid;
		gap: 0.55rem;
		padding: 1.1rem 0;
	}

	.capability-item + .capability-item,
	.challenge-item + .challenge-item,
	.evidence-item + .evidence-item {
		border-top: 1px solid var(--color-border);
	}

	.evidence-item a,
	.text-link {
		width: fit-content;
		color: var(--color-accent);
		font-weight: 700;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.evidence-item a:hover,
	.evidence-item a:focus-visible,
	.text-link:hover,
	.text-link:focus-visible {
		color: var(--color-text);
	}

	.text-link {
		display: inline-flex;
		margin-top: 1rem;
	}

	.about-final {
		border-top: 1px solid var(--color-border-soft);
	}

	.about-final__inner {
		display: grid;
		gap: 1.4rem;
		align-items: start;
	}

	.about-final__inner > div:first-child {
		display: grid;
		gap: 0.7rem;
	}

	.about-final__actions {
		display: grid;
		gap: 0.9rem;
		align-items: start;
	}

	.about-final__actions > .button {
		width: 100%;
	}

	@media (min-width: 760px) {
		.proof-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.proof-item {
			padding: 1.2rem;
		}

		.proof-item + .proof-item {
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.proof-item:nth-child(3) {
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.proof-item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}

		.capability-grid,
		.challenge-grid,
		.evidence-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capability-item,
		.challenge-item,
		.evidence-item {
			padding: 1.2rem;
		}

		.capability-item + .capability-item,
		.challenge-item + .challenge-item,
		.evidence-item + .evidence-item {
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.capability-item:nth-child(odd),
		.challenge-item:nth-child(odd),
		.evidence-item:nth-child(odd) {
			border-left: 0;
		}

		.capability-item:nth-child(n + 3),
		.challenge-item:nth-child(n + 3),
		.evidence-item:nth-child(n + 3) {
			border-top: 1px solid var(--color-border);
		}
	}

	@media (min-width: 980px) {
		.about-split__grid {
			grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1fr);
			gap: clamp(2rem, 5vw, 4rem);
		}

		.capability-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.capability-item:nth-child(3n + 1) {
			border-left: 0;
		}

		.capability-item:nth-child(3) {
			border-top: 0;
		}

		.capability-item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}

		.about-final__inner {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 2rem;
		}

		.about-final__actions {
			min-width: 230px;
		}
	}

	@media (max-width: 640px) {
		.about-hero {
			padding-block: 3.5rem 2.75rem;
		}
	}
</style>
