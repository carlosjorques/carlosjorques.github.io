---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<Layout
	title="About"
	description="About Carlos Jorques, an embedded control systems architect focused on physical systems, automotive software, diagnostics, and technical delivery."
>
	<section class="section about-intro">
		<div class="about-column">
			<p class="eyebrow">About</p>
			<h1>Embedded control systems architect for physical machines</h1>
			<p class="lead">
				I lead the design of production-ready embedded control systems for vehicles and
				smart machines, connecting sensing, signal processing, embedded software, control
				algorithms, diagnostics, actuation, safety expectations, and delivery.
			</p>
			<p class="lead secondary">
				My work sits where control engineering meets real-time software: making complex
				physical systems behave reliably under production, validation, and industrialization
				constraints.
			</p>
		</div>
	</section>

	<section class="section about-proof-section">
		<div class="about-column">
			<div class="proof-list" aria-label="Professional proof points">
				<div>
					<span>10+ years</span>
					<p>Automotive embedded control systems across electric, hybrid, and combustion-based platforms.</p>
				</div>
				<div>
					<span>Technical leadership</span>
					<p>Team guidance, mentoring, task alignment, and cross-functional delivery in large engineering environments.</p>
				</div>
				<div>
					<span>Production context</span>
					<p>Model-based software, diagnostics, validation, CI/CD, safety-related development, and integration.</p>
				</div>
				<div>
					<span>Research depth</span>
					<p>PhD-trained engineer with patents and scientific publications in real-time control and diagnostics.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section about-detail">
		<div class="about-column">
			<section class="about-block" aria-labelledby="capabilities-title">
				<p class="eyebrow">Core competences</p>
				<h2 id="capabilities-title">Where I create value</h2>
				<div class="stacked-list">
					<article>
						<span>Leadership</span>
						<h3>Scaling complex technical delivery</h3>
						<p>
							I bridge strategic intent and engineering execution by aligning controls, software,
							systems, diagnostics, validation, suppliers, and delivery stakeholders. My leadership
							style is technical, practical, and centered on reducing ambiguity for teams building
							safety-related embedded software.
						</p>
					</article>
					<article>
						<span>Control</span>
						<h3>Advanced system optimization</h3>
						<p>
							I work with nonlinear, multi-domain physical systems where control decisions depend on
							sensing, signal processing, observers, estimators, diagnostics, calibration constraints,
							and actuation limits. The goal is not only algorithmic performance, but behavior that
							remains reliable on real machines.
						</p>
					</article>
					<article>
						<span>Embedded software</span>
						<h3>Production-ready reliability</h3>
						<p>
							I turn control intent into embedded software using model-based development, C/C++,
							real-time implementation discipline, CI/CD, integration testing, and validation across
							MIL, SIL, HIL, test bench, and vehicle contexts.
						</p>
					</article>
					<article>
						<span>Safety and process</span>
						<h3>Compliance and risk mitigation</h3>
						<p>
							I work in automotive development environments shaped by ISO 26262, A-SPICE,
							AUTOSAR-oriented integration, requirements traceability, diagnostics, fault handling,
							and robust verification expectations.
						</p>
					</article>
				</div>
			</section>

			<section class="about-block" aria-labelledby="experience-title">
				<p class="eyebrow">Selected experience</p>
				<h2 id="experience-title">Public-safe case themes</h2>
				<div class="case-log-list">
					<article>
						<span>01</span>
						<h3>Heavy-duty electrification</h3>
						<p>
							Embedded control work for electric vehicle thermal and battery-related functions,
							including coordination of sensing, control logic, diagnostics, auxiliaries, validation,
							and production software constraints.
						</p>
						<ul class="tag-list">
							<li class="tag">Thermal management</li>
							<li class="tag">Battery systems</li>
							<li class="tag">Simulink</li>
							<li class="tag">C/C++</li>
							<li class="tag">AUTOSAR-oriented</li>
						</ul>
					</article>
					<article>
						<span>02</span>
						<h3>Autonomous machine propulsion control</h3>
						<p>
							Control and software leadership for propulsion behavior in an autonomous electric
							machine context, connecting torque allocation, redundant actuation, diagnostics,
							safety-related requirements, and system-level testing.
						</p>
						<ul class="tag-list">
							<li class="tag">Motion control</li>
							<li class="tag">Diagnostics</li>
							<li class="tag">ISO 26262</li>
							<li class="tag">SIL / HIL</li>
							<li class="tag">Field validation</li>
						</ul>
					</article>
					<article>
						<span>03</span>
						<h3>Real-time control and diagnostics research</h3>
						<p>
							Industrial PhD work on model-based real-time diagnostics and closed-loop control for
							combustion systems, with research outcomes that support my industrial approach to
							observers, estimators, stochastic behavior, and implementation tradeoffs.
						</p>
						<ul class="tag-list">
							<li class="tag">PhD research</li>
							<li class="tag">Signal processing</li>
							<li class="tag">Observers</li>
							<li class="tag">Patents</li>
							<li class="tag">Publications</li>
						</ul>
					</article>
				</div>
			</section>

			<section class="about-block" aria-labelledby="approach-title">
				<p class="eyebrow">Professional approach</p>
				<h2 id="approach-title">Robust industrialization over unnecessary complexity</h2>
				<div class="prose">
					<p>
						The most sophisticated control system becomes a liability if it ignores hardware
						constraints, safety expectations, calibration realities, validation evidence, or the
						maintenance needs of production software. My work is defined by reliability over
						unnecessary complexity.
					</p>
					<p>
						I connect the analytical depth of control theory with the discipline needed for industrial
						software: deterministic behavior, explicit interfaces, traceable requirements, diagnostic
						coverage, integration constraints, and verification paths that teams can execute.
					</p>
				</div>
			</section>

			<section class="about-block identity-block" aria-labelledby="identity-title">
				<p class="eyebrow">Role fit</p>
				<h2 id="identity-title">Best-fit opportunities</h2>
				<ul>
					<li>Embedded control systems architecture for vehicles and smart machines.</li>
					<li>Automotive control software, diagnostics, and model-based development.</li>
					<li>Safety-related embedded development in ISO 26262 and A-SPICE-oriented environments.</li>
					<li>Technical leadership for cross-functional delivery across controls, software, systems, validation, and suppliers.</li>
				</ul>
				<a href={`${baseUrl}contact/`}>Contact</a>
			</section>
		</div>
	</section>

	<section class="section">
		<div class="about-column about-contact">
			<ContactCTA />
		</div>
	</section>
</Layout>

<style>
	.about-column {
		width: min(100% - 48px, var(--content-narrow));
		margin-inline: auto;
	}

	.about-intro h1 {
		margin: 0.45rem 0 0.75rem;
	}

	.about-intro .secondary {
		margin-top: 1rem;
	}

	.about-proof-section {
		padding-top: 0;
	}

	.proof-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1px;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		background: var(--color-border);
	}

	.proof-list div {
		display: grid;
		gap: 0.45rem;
		background: var(--color-page);
		padding: 1rem 0;
	}

	.proof-list span,
	.stacked-list span,
	.case-log-list span {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.proof-list p {
		color: var(--color-muted);
		font-size: 0.92rem;
		line-height: 1.5;
	}

	.about-detail {
		padding-top: 0;
	}

	.about-block {
		display: grid;
		gap: 1rem;
	}

	.about-block + .about-block {
		margin-top: clamp(3rem, 6vw, 4.5rem);
	}

	.about-block h2 {
		font-size: clamp(1.6rem, 3vw, 2.35rem);
		line-height: 1.12;
	}

	.stacked-list,
	.case-log-list {
		display: grid;
		gap: 0;
		margin-top: 0.5rem;
	}

	.stacked-list article,
	.case-log-list article,
	.identity-block {
		border-top: 1px solid var(--color-border);
		padding-top: 1rem;
	}

	.stacked-list article,
	.case-log-list article {
		display: grid;
		gap: 0.45rem;
		padding-bottom: 1.5rem;
	}

	.stacked-list h3,
	.case-log-list h3 {
		margin-bottom: 0.45rem;
		font-size: 1.15rem;
	}

	.stacked-list p,
	.case-log-list p,
	.identity-block li {
		color: var(--color-muted);
	}

	.case-log-list .tag-list {
		margin-top: 0.35rem;
	}

	.identity-block ul {
		margin: 0;
	}

	.identity-block a {
		display: inline-block;
		margin-top: 0.65rem;
		color: var(--color-accent);
		text-decoration: none;
	}

	.about-contact :global(.contact-cta) {
		grid-template-columns: 1fr;
	}

	@media (min-width: 760px) {
		.proof-list div {
			padding: 1rem 0;
		}
	}
</style>
