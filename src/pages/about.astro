---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);

type TextPart = {
	text: string;
	strong?: boolean;
};

const professionalFoundation = [
	{
		context: 'EXPERIENCE',
		anchor: '10+ years of embedded controls',
		description: [
			{ text: 'Production-ready embedded control software', strong: true },
			{ text: ' across automotive OEM, Tier 1, electrified powertrain, and off-highway machine environments.' },
		] satisfies TextPart[],
	},
	{
		context: 'LEADERSHIP',
		anchor: 'Technical architecture and direction',
		description: [
			{ text: 'Guiding cross-functional teams across model-based control development, ' },
			{ text: 'embedded software', strong: true },
			{ text: ', ' },
			{ text: 'diagnostics', strong: true },
			{ text: ', integration, ' },
			{ text: 'validation', strong: true },
			{ text: ', and delivery.' },
		] satisfies TextPart[],
	},
	{
		context: 'SCOPE',
		anchor: 'Full system integration and validation',
		description: [
			{ text: 'Controls architecture, active diagnostics, ' },
			{ text: 'safety-related constraints', strong: true },
			{ text: ', and end-to-end integration for systems operating under physical constraints.' },
		] satisfies TextPart[],
	},
	{
		context: 'BACKGROUND',
		anchor: 'PhD in control systems',
		description: [
			{ text: 'Peer-reviewed research', strong: true },
			{ text: ', academic rigor, and ' },
			{ text: 'patent work', strong: true },
			{ text: ' translated into production-oriented engineering decisions.' },
		] satisfies TextPart[],
	},
];

const workPrinciples = [
	{
		title: 'Start from system behavior',
		description: [
			{ text: 'Before defining software boundaries, I model the system’s ' },
			{ text: 'physical behavior', strong: true },
			{ text: ': dynamic response, stability, fault mitigation, operating envelope, and timing constraints.' },
		] satisfies TextPart[],
	},
	{
		title: 'Deliberately reduce uncertainty',
		description: [
			{
				text: 'I treat unknowns as engineering risks and reduce them early through real-world experiments, predictive simulation, logs, and ',
			},
			{ text: 'structured test evidence', strong: true },
			{ text: '.' },
		] satisfies TextPart[],
	},
	{
		title: 'Lead through explicit technical clarity',
		description: [
			{
				text: 'I align cross-functional domains around ',
			},
			{ text: 'architecture', strong: true },
			{ text: ', trade-offs, safety limits, validation evidence, and ownership.' },
		] satisfies TextPart[],
	},
];

const capabilities = [
	{
		domain: 'Controls Architecture',
		challenge: 'Define behavior before implementation detail',
		description: [
			{
				text: 'Defining dynamic intent, transient handling, operating-envelope boundaries, and control architecture before software complexity takes over.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Real-Time Embedded Software',
		challenge: 'Translate control intent into reliable execution',
		description: [
			{ text: 'Shaping model-based pipelines, generated-code boundaries, software interfaces, ' },
			{ text: 'timing loops', strong: true },
			{ text: ', and maintainable target implementation.' },
		] satisfies TextPart[],
	},
	{
		domain: 'Diagnostics & Fault Isolation',
		challenge: 'Make system health observable',
		description: [
			{ text: 'Designing observability, ' },
			{ text: 'signal-health monitoring', strong: true },
			{
				text: ', fault response, and degradation strategies so systems can detect, degrade, and recover instead of failing silently.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Validation, MIL/SIL/HIL, and Field Evidence',
		challenge: 'Connect requirements with evidence',
		description: [
			{ text: 'Bridging functional requirements with physical evidence through ' },
			{ text: 'model-, software-, hardware-in-the-loop testing', strong: true },
			{ text: ', logs, calibration feedback, and field-oriented validation.' },
		] satisfies TextPart[],
	},
	{
		domain: 'System Integration',
		challenge: 'Keep interfaces aligned with the machine',
		description: [
			{
				text: 'Aligning actuators, sensors, data buses, calibration parameters, software interfaces, and physical subsystems under real operating loads.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Technical Leadership',
		challenge: 'Turn technical ambiguity into shared direction',
		description: [
			{ text: 'Creating clarity around ' },
			{ text: 'technical direction', strong: true },
			{
				text: ', ownership, quality, and delivery sequence so multidisciplinary teams can execute with autonomy and accountability.',
			},
		] satisfies TextPart[],
	},
];

const appliedExpertise = [
	{
		domain: 'Heavy-Duty Transportation',
		focus: [
			{
				text: 'Thermal management, energy coordination, battery-related control, charger interaction, and combustion-control research.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Safety-Related Diagnostics and Fault Handling',
		focus: [
			{
				text: 'Software layers that observe system health, detect faults, support degradation strategies, and keep physical behavior predictable.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Autonomous Mobility Systems',
		focus: [
			{
				text: 'Propulsion and torque-control work for autonomous electric machines, including safety monitoring, validation, and field-oriented behavior.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Industry Standards and Production Deployment',
		focus: [
			{ text: 'Work shaped by ' },
			{ text: 'ISO 26262', strong: true },
			{ text: ', ' },
			{ text: 'A-SPICE', strong: true },
			{ text: ', ' },
			{ text: 'AUTOSAR-oriented development', strong: true },
			{ text: ', CI/CD, ' },
			{ text: 'MIL/SIL/HIL testing', strong: true },
			{ text: ', supplier interfaces, and vehicle-level validation.' },
		] satisfies TextPart[],
	},
];

const evidenceLinks = [
	{
		title: 'Writing',
		description:
			'Technical thinking on embedded controls, diagnostics, physical systems, software architecture, and engineering judgment.',
		href: withBase('/writing'),
		linkText: 'Read technical writing',
	},
	{
		title: 'Work',
		description:
			'A selection of my projects, engineering contributions, publications, patents, and research context.',
		href: withBase('/work'),
		linkText: 'View selected work, patents, and publications',
	},
	{
		title: 'Contact',
		description:
			'For role discussions, formal career details, and verified contact routes, use the contact page.',
		href: withBase('/contact'),
		linkText: 'Contact Carlos',
	},
];
---

<Layout
	title="About Carlos Jorques | Embedded Controls Architect"
	description="About Carlos Jorques, an embedded controls architect and technical leader developing control algorithms and real-time embedded software for reliable physical systems."
>
	<section class="about-hero">
		<div class="page-container about-hero__inner">
			<div class="about-hero__content">
				<p class="eyebrow">About</p>
				<h1>I design embedded control systems for physical machines.</h1>
				<p class="about-hero__lead">
					I am Carlos Jorques, an <strong>Embedded Control Systems Architect</strong>
					focused on <strong>Control Intelligence for Physical Systems</strong>.
				</p>
				<p class="about-hero__body">
					I lead technical work where sensing, signal processing, control algorithms,
					real-time embedded software, diagnostics, actuation, safety constraints, and
					delivery have to hold together in production.
				</p>
				<p class="about-hero__body">
					My background combines a PhD in control systems with more than a decade of
					automotive OEM, Tier 1, research, and delivery experience across embedded
					control, diagnostics, safety-related development, validation, and
					cross-functional technical leadership.
				</p>
				<div class="button-row" aria-label="About page primary navigation links">
					<a class="button primary" href={withBase('/contact')}>Contact Carlos</a>
					<a class="button" href={withBase('/work')}>Explore selected work</a>
					<a class="button" href={withBase('/writing')}>Read technical writing</a>
				</div>
			</div>
			<figure class="about-hero__portrait">
				<img
					src={`${baseUrl}images/carlos-jorques-intro.webp`}
					alt="Portrait of Carlos Jorques"
					width="768"
					height="1024"
					loading="eager"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section about-proof" aria-labelledby="foundation-title">
		<div class="page-container">
			<div class="section-intro section-intro--compact">
				<h2 id="foundation-title">Professional foundation</h2>
				<p>
					A concise view of the evidence behind the profile.
				</p>
			</div>
			<div class="proof-grid">
				{professionalFoundation.map((item) => (
					<article class="proof-item">
						<p>{item.context}</p>
						<h3>{item.anchor}</h3>
						<span>
							{item.description.map((part) =>
								part.strong ? <strong>{part.text}</strong> : part.text
							)}
						</span>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-split" aria-labelledby="narrative-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<h2 id="narrative-title">The work behind the title</h2>
			</div>
			<div class="about-copy">
				<p>
					My work is centered on one practical question: how can a machine sense,
					decide, and act predictably when the physical world is noisy, constrained,
					and changing?
				</p>
				<p>
					Control theory gave me a framework for designing dynamic behavior.
					Electrical engineering and doctoral research gave me tools for modeling,
					diagnostics, virtual sensing, high-speed processing, and evidence-based
					decision making.
				</p>
				<p>
					Production is where the theory is tested.
					Timing limits, cost boundaries, safety criteria, supplier interfaces, calibration maturity, validation evidence, and delivery pressure all shape what can actually work.
					My role is to help advanced control and software architectures remain clear,
					testable, and useful in that environment.
				</p>
				<p>
					Today I apply that systems thinking to vehicles and intelligent machines,
					providing technical guidance across architecture, validation, and delivery.
				</p>
				<div class="in-context-cta">
					<span>Evidence</span>
					<a href={withBase('/work')} class="text-link">See selected work, patents, and publications</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section about-work-style" aria-labelledby="work-style-title">
		<div class="page-container about-work-style__inner">
			<div class="split-heading about-work-style__intro">
				<h2 id="work-style-title">How I approach execution</h2>
				<p>
					I keep complex engineering work readable: define the system behavior, reduce
					uncertainty with evidence, make trade-offs explicit, and align teams around
					implementation and validation.
				</p>
			</div>
			<div class="work-style-list">
				{workPrinciples.map((item) => (
					<article>
						<h3>{item.title}</h3>
						<p>
							{item.description.map((part) =>
								part.strong ? <strong>{part.text}</strong> : part.text
							)}
						</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="skills-flow-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="skills-flow-title">Core Capabilities</h2>
				<p>
					The areas where I most often turn ambiguity into technical direction.
				</p>
			</div>
			<div class="capability-grid">
				{capabilities.map((item) => (
					<article class="capability-item">
						<p class="capability-item__area">{item.challenge}</p>
						<h3>{item.domain}</h3>
						<p>
							{item.description.map((part) =>
								part.strong ? <strong>{part.text}</strong> : part.text
							)}
						</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="concrete-expertise-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="concrete-expertise-title">Applied domains</h2>
				<p>
					Public-safe examples of where the capabilities become tangible.
				</p>
			</div>
			<div class="challenge-grid">
				{appliedExpertise.map((item) => (
					<article class="challenge-item">
						<h3>{item.domain}</h3>
						<p>
							{item.focus.map((part) =>
								part.strong ? <strong>{part.text}</strong> : part.text
							)}
						</p>
					</article>
				))}
			</div>
			<div class="section-footer-cta">
				<p>For formal career details, use the contact page.</p>
				<a class="text-link" href={withBase('/contact')}>Contact Carlos or connect via LinkedIn</a>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="evidence-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="evidence-title">Explore more of my work</h2>
			</div>
			<div class="evidence-grid">
				{evidenceLinks.map((item) => (
					<article class="evidence-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
						<a href={item.href}>{item.linkText}</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-final" aria-labelledby="final-title">
		<div class="page-container about-final__inner">
			<div>
				<h2 id="final-title">Let’s connect</h2>
				<p>
					For technical leadership roles or conversations around embedded controls,
					diagnostics, safety-related development, and reliable physical systems,
					contact me through the site or LinkedIn.
				</p>
			</div>
			<div class="about-final__actions">
				<a class="button primary" href={withBase('/contact')}>Contact Carlos</a>
				<a class="button" href="https://www.linkedin.com/in/carlosjorques/" target="_blank" rel="noopener noreferrer">View LinkedIn</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.about-hero {
		padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
		border-bottom: 1px solid var(--color-border-soft);
	}

	.about-hero__inner {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
		max-width: 1120px;
	}

	.about-hero__content {
		display: grid;
		gap: 1rem;
		max-width: 760px;
	}

	.about-hero h1 {
		max-width: 780px;
		font-size: clamp(2.35rem, 5.2vw, 4.35rem);
		line-height: 1.02;
	}

	.about-hero__lead {
		max-width: 760px;
		color: var(--color-text);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.55;
	}

	.about-hero__body {
		max-width: 720px;
		color: var(--color-muted);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.about-hero strong,
	.about-copy strong,
	.proof-item strong,
	.work-style-list strong,
	.capability-item strong,
	.challenge-item strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.about-hero .button-row {
		margin-top: 1.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.about-hero__portrait {
		margin: 0;
		width: min(100%, 360px);
		justify-self: start;
	}

	.about-hero__portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		height: auto;
		object-fit: cover;
		object-position: center;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.section-intro--compact {
		margin-bottom: 1.5rem;
	}

	.proof-grid {
		display: grid;
		grid-template-columns: 1fr;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.proof-item {
		display: grid;
		gap: 0.45rem;
		padding: 1.2rem 0;
	}

	.proof-item + .proof-item {
		border-top: 1px solid var(--color-border);
	}

	.proof-item p {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.proof-item h3 {
		color: var(--color-text);
		font-size: 1.2rem;
		line-height: 1.35;
	}

	.proof-item span {
		max-width: 100%;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.about-split__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	.about-work-style__inner {
		display: grid;
		gap: clamp(1.4rem, 3vw, 2rem);
	}

	.about-work-style__intro {
		max-width: 820px;
	}

	.split-heading {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
	}

	.about-split h2,
	.section-intro h2,
	.about-final h2 {
		max-width: 760px;
		font-size: clamp(1.7rem, 3.5vw, 2.65rem);
		line-height: 1.08;
	}

	.split-heading p,
	.about-final p {
		max-width: 700px;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.about-copy {
		display: grid;
		gap: 1.2rem;
		max-width: 760px;
		color: var(--color-muted);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.in-context-cta,
	.section-footer-cta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 1rem;
		padding: 1rem;
		background: var(--color-page);
		border-left: 3px solid var(--color-accent);
	}

	.in-context-cta span,
	.section-footer-cta p {
		color: var(--color-text);
		font-size: 0.9rem;
	}

	.work-style-list {
		display: grid;
		max-width: 760px;
		border-top: 1px solid var(--color-border);
	}

	.work-style-list article {
		display: grid;
		gap: 0.45rem;
		border-bottom: 1px solid var(--color-border);
		padding: 1.2rem 0;
	}

	.work-style-list h3,
	.capability-item h3,
	.challenge-item h3,
	.evidence-item h3 {
		color: var(--color-text);
		font-size: 1.15rem;
		line-height: 1.35;
	}

	.work-style-list p,
	.capability-item p,
	.challenge-item p,
	.evidence-item p,
	.section-intro p {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.capability-item__area {
		color: var(--color-accent) !important;
		font-family: var(--font-sans);
		font-size: 0.85rem !important;
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.35 !important;
		margin-bottom: 0.1rem;
	}

	.section-intro {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
		margin-bottom: 2rem;
	}

	.capability-grid,
	.challenge-grid,
	.evidence-grid {
		display: grid;
		grid-template-columns: 1fr;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.capability-item,
	.challenge-item,
	.evidence-item {
		display: grid;
		gap: 0.35rem;
		padding: 1.5rem 0;
	}

	.capability-item + .capability-item,
	.challenge-item + .challenge-item,
	.evidence-item + .evidence-item {
		border-top: 1px solid var(--color-border);
	}

	.evidence-item a,
	.text-link {
		width: fit-content;
		color: var(--color-accent);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.evidence-item a:hover,
	.evidence-item a:focus-visible,
	.text-link:hover,
	.text-link:focus-visible {
		color: var(--color-text);
	}

	.about-final {
		margin-top: 2rem;
		border-top: 1px solid var(--color-border-soft);
	}

	.about-final__inner {
		display: grid;
		gap: 1.4rem;
		align-items: start;
	}

	.about-final__inner > div:first-child {
		display: grid;
		gap: 0.7rem;
	}

	.about-final__actions {
		display: grid;
		gap: 0.9rem;
		align-items: start;
	}

	.about-final__actions > .button {
		width: 100%;
	}

	@media (min-width: 760px) {
		.proof-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.proof-item {
			padding: 1.5rem;
		}

		.proof-item + .proof-item {
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.proof-item:nth-child(3) {
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}

		.proof-item:nth-child(4) {
			border-top: 1px solid var(--color-border);
		}

		.capability-grid,
		.challenge-grid,
		.evidence-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capability-item,
		.challenge-item,
		.evidence-item {
			padding: 1.5rem;
		}

		.capability-item + .capability-item,
		.challenge-item + .challenge-item,
		.evidence-item + .evidence-item {
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.capability-item:nth-child(odd),
		.challenge-item:nth-child(odd),
		.evidence-item:nth-child(odd) {
			border-left: 0;
		}

		.capability-item:nth-child(n + 3),
		.challenge-item:nth-child(n + 3),
		.evidence-item:nth-child(n + 3) {
			border-top: 1px solid var(--color-border);
		}
	}

	@media (min-width: 980px) {
		.about-hero__inner {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
		}

		.about-hero__portrait {
			justify-self: end;
		}

		.about-split__grid {
			grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1fr);
			gap: clamp(2rem, 5vw, 4rem);
		}

		.capability-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.capability-item:nth-child(3n + 1) {
