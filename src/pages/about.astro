---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);

type TextPart = {
	text: string;
	strong?: boolean;
};

const professionalFoundation = [
	{
		context: 'EXPERIENCE',
		anchor: '10+ years of embedded controls',
		description: [
			{ text: 'Production-ready embedded control software across automotive, heavy-duty, autonomous-machine, and Tier 1 / client delivery environments.' },
		] satisfies TextPart[],
	},
	{
		context: 'LEADERSHIP',
		anchor: 'Technical teams and architecture',
		description: [
			{ text: 'Leading cross-functional teams from control intent through embedded implementation, integration, validation, and release readiness.' },
		] satisfies TextPart[],
	},
	{
		context: 'PROOF',
		anchor: 'Patents, publications, and PhD research',
		description: [
			{ text: 'Patent work, peer-reviewed publications, and doctoral research translated into production-oriented engineering judgment.' },
		] satisfies TextPart[],
	},
	{
		context: 'SYSTEMS',
		anchor: 'Safety-related production environments',
		description: [
			{ text: 'Work shaped by ISO 26262, A-SPICE, AUTOSAR-oriented development, diagnostics, MIL/SIL/HIL, and field evidence.' },
		] satisfies TextPart[],
	},
];

const capabilities = [
	{
		domain: 'Controls Architecture',
		challenge: 'Define behavior before implementation',
		description: [
			{
				text: 'Defining dynamic intent, transient handling, operating-envelope boundaries, estimation, observers, and control architecture before software complexity takes over.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Real-Time Embedded Software',
		challenge: 'Translate control intent into reliable execution',
		description: [
			{
				text: 'Shaping model-based pipelines, generated-code boundaries, software interfaces, ',
			},
			{ text: 'timing loops', strong: true },
			{
				text: ', C/C++ integration points, and maintainable target implementation.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Diagnostics & Fault Isolation',
		challenge: 'Make system health observable',
		description: [
			{ text: 'Designing observability, ' },
			{ text: 'signal-health monitoring', strong: true },
			{
				text: ', virtual sensing, fault response, and degradation strategies so systems can detect, degrade, and recover instead of failing silently.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Validation, MIL/SIL/HIL, and Field Evidence',
		challenge: 'Connect requirements with evidence',
		description: [
			{
				text: 'Bridging functional requirements with traceability, physical evidence, ',
			},
			{
				text: 'model-, software-, hardware-in-the-loop testing',
				strong: true,
			},
			{
				text: ', logs, calibration feedback, and field-oriented validation.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'System Integration',
		challenge: 'Keep software aligned with the machine',
		description: [
			{
				text: 'Aligning actuators, sensors, data buses, calibration parameters, software interfaces, safety-related constraints, and physical subsystems under real operating loads.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Technical Leadership',
		challenge: 'Turn technical ambiguity into shared direction',
		description: [
			{ text: 'Creating clarity around ' },
			{ text: 'technical direction', strong: true },
			{
				text: ', architecture, ownership, quality, delivery sequence, and release readiness so multidisciplinary teams can execute with autonomy and accountability.',
			},
		] satisfies TextPart[],
	},
];

const appliedExpertise = [
	{
		domain: 'Heavy-Duty Transportation',
		focus: [
			{
				text: 'Thermal management of electrified powertrains, battery systems, charger coordination, and combustion-control research.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Safety-Related Diagnostics and Fault Handling',
		focus: [
			{
				text: 'Software layers that observe system health, detect faults, support degradation strategies, and keep physical behavior predictable.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Autonomous Mobility Systems',
		focus: [
			{
				text: 'Propulsion and torque-control work for autonomous electric machines, including safety monitoring, validation, and field behavior.',
			},
		] satisfies TextPart[],
	},
	{
		domain: 'Industry Standards and Production Deployment',
		focus: [
			{ text: 'Work shaped by ISO 26262, A-SPICE, AUTOSAR-oriented development, CI/CD, MIL/SIL/HIL testing' },
			{ text: ', supplier interfaces, and vehicle-level validation.' },
		] satisfies TextPart[],
	},
];

const thinkingLayers = [
	{
		layer: 'Curiosity',
		title: 'Taking things apart',
		description:
			'As a child, I wanted to understand how objects worked from the inside. That habit became an engineering instinct: look below the surface, find the mechanism, and test what changes behavior.',
	},
	{
		layer: 'Form',
		title: 'Gaudí, structure, and usefulness',
		description:
			'Gaudí made technical imagination visible to me: structure, material, constraint, and human use can belong to the same decision. That still shapes how I think about engineered systems.',
	},
	{
		layer: 'Making',
		title: 'Computing, lamps, and home automation',
		description:
			'Early computing, web work, 3D-printed lamps, and home automation gave me a practical lens: behavior is designed through logic, interfaces, materials, feedback, and iteration.',
	},
	{
		layer: 'Team',
		title: 'Basketball and family rhythm',
		description:
			'Basketball has been part of my life since childhood, now also as a mentor to younger teammates. Away from work, my main rhythm is time with my partner, our son, and long walks with our dog.',
	},
];

const buildPrinciples = [
	{
		title: 'Control intent',
		description:
			'Clarify the behavior the machine needs before implementation detail starts driving the architecture.',
	},
	{
		title: 'Production software',
		description:
			'Turn models and algorithms into real-time embedded software that can be integrated, calibrated, verified, and maintained.',
	},
	{
		title: 'Evidence and risk',
		description:
			'Use diagnostics, test results, logs, requirements, and field feedback to make technical decisions visible and defensible.',
	},
	{
		title: 'Team direction',
		description:
			'Create enough architectural clarity for specialists across software, controls, validation, and hardware to move in the same direction.',
	},
];

const evidenceLinks = [
	{
		title: 'Writing',
		description:
			'Technical thinking on embedded controls, diagnostics, physical systems, software architecture, and engineering judgment.',
		href: withBase('/writing'),
		linkText: 'Read my articles',
	},
	{
		title: 'Work',
		description:
			'A selection of my projects, engineering contributions, publications, patents, and research context.',
		href: withBase('/work'),
		linkText: 'View selected work, patents, and publications',
	},
];
---

<Layout
	title="About Carlos Jorques | Embedded Controls Architect"
	description="About Carlos Jorques, an embedded controls architect and technical leader developing control algorithms and real-time embedded software for reliable physical systems."
>
	<section class="about-hero">
		<div class="page-container about-hero__inner">
			<h1>Hi, I’m Carlos.</h1>
			<div class="about-hero__content">
				<p class="about-hero__lead">
					I lead technical teams designing <strong>real-time control</strong> and
					<strong>embedded software</strong> for safety-critical physical systems.
				</p>

				<p class="about-hero__body">
					My work connects <strong>control architecture</strong>, diagnostics, validation,
					actuation, sensing, safety-related development, and production delivery,
					from <strong>electrified vehicles</strong> to <strong>autonomous machines</strong>.
				</p>

				<p class="about-hero__body">
					Physical systems shape how people move, build, transport, and use energy.
					For me, improving their <strong>control software</strong> means helping machines
					consume less energy, respond more safely to faults, reduce downtime, and make
					advanced technologies more dependable in daily life.
				</p>

				<p class="about-hero__body">
					Based in <strong>Spain</strong>, I work with international engineering teams
					on systems where control software, physical hardware, uncertainty, diagnostics, validation,
					safety-related development, and production constraints have to come together.
				</p>

				<div class="button-row" aria-label="About page primary navigation links">
					<a class="button primary" href={withBase('/contact')}>Contact Carlos / Access CV</a>
					<a class="button" href={withBase('/work')}>Explore selected work</a>
					<a class="button" href={withBase('/writing')}>Read my articles</a>
				</div>
			</div>
			<figure class="about-hero__portrait">
				<img
					src={withBase('/images/carlos-jorques-intro.webp')}
					alt="Portrait of Carlos Jorques"
					width="768"
					height="1024"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</figure>
		</div>
	</section>

	<section class="section about-proof" aria-labelledby="professional-foundation-title">
		<div class="page-container">
			<div class="section-intro section-intro--compact">
				<h2 id="professional-foundation-title">Professional Foundation</h2>
				<p>
					Over the past decade, I have contributed to <strong>production and research work</strong>
					in automotive OEM, heavy-duty transport, autonomous-machine, and Tier 1 / client
					delivery environments.
				</p>
				<p>
					My profile combines technical leadership, production delivery, system-level validation,
					patents, publications, and PhD research in control algorithms.
				</p>
			</div>
			<div class="proof-grid">
				{professionalFoundation.map((item) => (
					<article class="proof-item">
						<p>{item.context}</p>
						<h3>{item.anchor}</h3>
						<span>
							{item.description.map((part) =>
								part.strong ? <strong>{part.text}</strong> : part.text
							)}
						</span>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-split about-band about-band--warm" aria-labelledby="start-think-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<p class="eyebrow">Start / Think</p>
				<h2 id="start-think-title">Curiosity before engineering</h2>
				<p class="section-quote">
					<span class="section-quote__mark" aria-hidden="true">"</span>
					<em class="section-quote__text">
						Before I studied control systems, I was already learning to notice structure,
						feedback, timing, and behavior.
					</em>
				</p>
			</div>
			<div class="about-copy">
				<p>
					The personal part of my story is not separate from the technical one. It is where
					my way of thinking started to form.
				</p>
				<p>
					Childhood curiosity, Gaudí's physical imagination, early computing and web work,
					basketball, lamp design, and home automation all point to the same interest:
					how things are built, how people interact with them, and how behavior changes
					under constraints.
				</p>
				<p>
					That is why control engineering felt natural later. It gave a professional form to
					a question I already cared about: how can machines sense, decide, and act in ways
					that make everyday systems safer, more efficient, and more useful?
				</p>
				<div class="layer-grid">
					{thinkingLayers.map((item) => (
						<article class="layer-item">
							<p>{item.layer}</p>
							<h3>{item.title}</h3>
							<span>{item.description}</span>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="section about-split about-band about-band--white" aria-labelledby="how-i-got-here-title">
		<div class="page-container about-split__grid">
			<div class="split-heading">
				<p class="eyebrow">How I got here</p>
				<h2 id="how-i-got-here-title">The point where curiosity became direction</h2>
				<p class="section-quote">
					<span class="section-quote__mark" aria-hidden="true">"</span>
					<em class="section-quote__text">
						Control engineering gave a name, a method, and a discipline to the way I already
						saw machines.
					</em>
				</p>
			</div>
			<div class="about-copy">
				<p>
					Studying <strong>electrical engineering</strong> turned curiosity into direction.
					<strong>Control theory</strong> gave me a framework for designing behavior, and
					<strong>doctoral research</strong> gave me tools to reason about dynamic systems,
					uncertainty, diagnostics, optimization, and evidence.
				</p>
				<p>
					That path moved from academic models into industrial systems: first through
					advanced control and optimization research, then through embedded control
					software for real machines operating under timing, safety, integration, and
					delivery constraints.
				</p>
				<p>
					The decision became clear: I wanted to work where analytical thinking,
					software implementation, physical behavior, and team delivery meet.
				</p>
			</div>
		</div>
	</section>

	<section class="section about-work-style about-band about-band--warm" aria-labelledby="build-title">
		<div class="page-container">
			<div class="about-work-style__lead">
				<div class="section-intro about-work-style__intro">
					<p class="eyebrow">Build</p>
					<h2 id="build-title">Building practical engineering judgment</h2>
					<p class="section-quote">
						<span class="section-quote__mark" aria-hidden="true">"</span>
						<em class="section-quote__text">An elegant algorithm is only the beginning.</em>
					</p>
					<p>
						The real engineering challenge is turning advanced control ideas into software
						that teams can <strong>integrate, verify, calibrate, trust, and maintain</strong>
						in production.
					</p>
					<p>
						This is where I have built my professional criterion: through production work,
						project delivery, integration feedback, validation evidence, and the repeated
						discipline of making complex systems understandable enough for teams to build.
					</p>
					<p>
						My approach is <strong>disciplined curiosity</strong> applied to delivery: frame the
						question, test the assumptions, turn evidence into decisions, manage the risk,
						and keep learning while moving toward release.
					</p>
					<div class="build-grid">
						{buildPrinciples.map((item) => (
							<article class="build-item">
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</article>
						))}
					</div>
					<a class="text-link" href={withBase('/writing')}>
						Read more about disciplined curiosity →
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="technical-areas-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="technical-areas-title">Technical areas</h2>
				<p>
					The main technical areas where my work connects control design, embedded
					implementation, diagnostics, validation, and system behavior.
				</p>
			</div>
			<div class="capability-grid">
				{capabilities.map((item) => (
					<article class="capability-item">
						<p class="capability-item__area">{item.challenge}</p>
						<h3>{item.domain}</h3>
						<p>
							{item.description.map((part) =>
								part.strong ? <strong>{part.text}</strong> : part.text
							)}
						</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="applied-domains-title">
		<div class="page-container applied-domains__inner">
			<div class="section-intro">
				<h2 id="applied-domains-title">Applied domains</h2>
				<p>
					Examples of the product and engineering contexts where my experience applies.
				</p>
			</div>
			<div class="applied-domains__body">
				<figure class="applied-domain-visual">
					<img
						src={withBase('/images/volvo-ta15-autonomous-hauler.webp')}
						alt="Volvo CE autonomous hauler operating in an industrial environment"
						width="1050"
						height="1200"
						loading="lazy"
						decoding="async"
					/>
					<figcaption>
						<span>
							A real-world machine is where control intent, embedded software,
							diagnostics, validation, and field behavior have to become one dependable
							system.
						</span>
					</figcaption>
				</figure>

				<div class="applied-domains__content">
					<div class="challenge-grid">
						{appliedExpertise.map((item) => (
							<article class="challenge-item">
								<h3>{item.domain}</h3>
								<p>
									{item.focus.map((part) =>
										part.strong ? <strong>{part.text}</strong> : part.text
									)}
								</p>
							</article>
						))}
					</div>
					<div class="section-footer-cta">
						<p>Want more details of my professional path?</p>
						<a class="text-link" href={withBase('/contact')}>Access CV or connect via LinkedIn →</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="explore-work-title">
		<div class="page-container">
			<div class="section-intro">
				<h2 id="explore-work-title">Explore more of my work</h2>
			</div>
			<div class="evidence-grid">
				{evidenceLinks.map((item) => (
					<article class="evidence-item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
						<a href={item.href}>{item.linkText}</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section about-final" aria-labelledby="connect-title">
		<div class="page-container about-final__inner">
			<div>
				<h2 id="connect-title">Let’s connect</h2>
				<p>
					For roles, collaborations, or technical conversations around
					<strong>embedded controls, diagnostics, safety-related development, and reliable physical systems</strong>, I’m
					open to hearing from you.
				</p>
			</div>
			<div class="about-final__actions">
				<a class="button primary" href={withBase('/contact')}>Contact Carlos / Access CV</a>
				<a class="button" href="https://www.linkedin.com/in/carlosjorques/" target="_blank" rel="noopener noreferrer">View LinkedIn Profile</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	@import url("https://fonts.googleapis.com/css2?family=Stack+Sans+Text:wght@200..700&display=swap");

	.about-hero {
		padding-block: clamp(4rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
		border-bottom: 1px solid var(--color-border-soft);
		background: var(--color-section-bg);
	}

	.about-hero ~ .section {
		background: var(--color-section-bg);
	}

	.about-hero ~ .about-proof,
	.about-hero ~ .about-band--white {
		background: var(--color-bg);
	}

	.about-hero ~ .about-band--warm {
		background: color-mix(in srgb, var(--color-card-bg) 68%, var(--color-accent-wash));
	}

	.about-hero ~ .about-final {
		background: var(--color-footer-bg);
	}

	.about-hero__inner {
		display: grid;
		row-gap: 1rem;
		column-gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
		max-width: 1120px;
	}

	.about-hero__content {
		display: grid;
		gap: 1rem;
		max-width: 700px;
	}

	.about-hero h1 {
		max-width: 700px;
		font-size: clamp(2.35rem, 5.2vw, 4.35rem);
		line-height: 1.02;
	}

	.about-hero__lead {
		max-width: 700px;
		color: var(--color-text);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.55;
	}

	.about-hero__body {
		max-width: 680px;
		color: var(--color-body-text);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.about-hero strong,
	.about-copy strong,
	.about-work-style__intro strong,
	.about-final strong,
	.proof-item strong,
	.build-item strong,
	.capability-item strong,
	.challenge-item strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.about-hero .button-row {
		margin-top: var(--spacing-06);
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.about-hero__portrait {
		margin: var(--spacing-05) 0 0;
		width: min(100%, 380px);
		justify-self: start;
	}

	.about-hero__portrait img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		height: auto;
		object-fit: cover;
		object-position: center;
		transition: transform var(--motion-duration-moderate-02) var(--motion-standard-productive);
	}

	.about-hero__portrait:hover img {
		transform: translateY(-4px);
	}

	.section-intro--compact {
		margin-bottom: var(--spacing-06);
	}

	.proof-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.25rem, 3vw, 1.75rem);
		background: transparent;
	}

	.proof-item {
		display: grid;
		gap: 0.45rem;
		padding: 1.2rem;
		border: 1px solid var(--color-card-border);
		background: var(--color-card-bg);
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.proof-item:hover {
		background: var(--color-card-bg-hover);
		border-color: var(--color-card-border-hover);
		transform: translateY(-2px);
	}

	.proof-item p {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.proof-item h3 {
		color: var(--color-text);
		font-size: 1.2rem;
		line-height: 1.35;
	}

	.proof-item span {
		max-width: 100%;
		color: var(--color-body-text);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.about-split__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: start;
	}

	.about-work-style__lead {
		display: grid;
		gap: clamp(1.4rem, 3vw, 2rem);
		align-items: start;
	}

	.about-work-style__intro {
		gap: 0.85rem;
		max-width: 820px;
		margin-bottom: 0;
	}

	.about-work-style__intro .text-link {
		margin-top: var(--spacing-02);
	}

	.split-heading {
		display: grid;
		gap: 0.65rem;
		max-width: 760px;
	}

	.section-quote {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(0.85rem, 2vw, 1.2rem);
		align-items: start;
		margin: 0;
		max-width: 760px;
		background: var(--color-quote-bg);
		color: var(--color-quote-text);
		padding: clamp(1rem, 2.4vw, 1.5rem);
		font-size: clamp(1.45rem, 3vw, 2.35rem);
		font-weight: 400;
		line-height: 1.18;
	}

	.split-heading > h2 + .section-quote,
	.about-work-style__intro > h2 + .section-quote {
		margin-top: clamp(var(--spacing-03), 1.3vw, var(--spacing-05));
	}

	.section-quote__mark {
		margin-top: -0.18em;
		color: var(--color-quote-text);
		font-family: "Stack Sans Text", sans-serif;
		font-optical-sizing: auto;
		font-style: normal;
		font-size: clamp(3rem, 6vw, 5.1rem);
		font-weight: 400;
		line-height: 1.0;
	}

	.section-quote__text {
