---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactCTA from '../components/ContactCTA.astro';

const researchItems = await getCollection('research');
const featuredItems = researchItems.filter((item) => item.data.featured);
const supportingItems = researchItems.filter((item) => !item.data.featured);
---

<Layout
	title="Research"
	description="Research background for Carlos Jorques, supporting credibility in modeling, analysis, and control for production embedded systems."
>
	<section class="research-hero" aria-labelledby="research-title">
		<div class="page-container research-hero__inner">
			<div class="research-hero__label">
				<p class="section-eyebrow">Research</p>
				<h1 id="research-title" class="hero-title">Research foundation</h1>
			</div>
			<div class="research-hero__mission">
				<p>
					Research supports credibility, but the main identity of this site is industrial technical leadership in embedded control systems. My research background provides a foundation in modeling, analysis, and control applied to production constraints.
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container research-grid">
			{
				featuredItems.map((item) => (
					<section
						id={item.data.type === 'Selected publications' ? 'publications' : undefined}
						class="panel research-card"
					>
						<p class="eyebrow">{item.data.type}</p>
						<h2>{item.data.title}</h2>
						<p>{item.data.summary}</p>
						{item.data.link && (
							<a href={item.data.link} class="text-link">
								View public link
							</a>
						)}
					</section>
				))
			}
		</div>
	</section>

	{
		supportingItems.length > 0 && (
			<section class="section">
				<div class="container">
					<SectionHeading
						eyebrow="External research profiles"
						title="Public research links"
						description="Add verified public profiles here when Google Scholar, ORCID, university, or publication links are ready."
					/>
					<div class="research-list">
						{supportingItems.map((item) => (
							<div class="panel research-card">
								<p class="eyebrow">{item.data.type}</p>
								<h2>{item.data.title}</h2>
								<p>{item.data.summary}</p>
								{item.data.link && (
									<a href={item.data.link} class="text-link">
										View public link
									</a>
								)}
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="container">
			<ContactCTA />
		</div>
	</section>
</Layout>

<style>
	.research-hero {
		padding-block: clamp(3rem, 5vw, 4.6rem) clamp(1.55rem, 3vw, 2.25rem);
		border-bottom: 1px solid var(--color-border-soft);
		background: transparent;
	}

	.research-hero .page-container,
	.section .container {
		width: min(calc(100% - 5rem), var(--content-width));
		max-width: 100%;
	}

	.research-hero__inner,
	.research-hero__label,
	.research-hero__mission {
		display: grid;
	}

	.research-hero__inner {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(1.4rem, 5vw, 4.2rem);
		align-items: end;
	}

	.research-hero__label {
		gap: 0.85rem;
		min-width: 0;
	}

	.research-hero__label .section-eyebrow {
		margin: 0;
	}

	.research-hero__mission {
		min-width: 0;
		border-left: 1px solid var(--color-border-soft);
		padding-left: clamp(1rem, 3vw, 2rem);
	}

	.research-hero .hero-title {
		max-width: none;
		font-size: clamp(4.2rem, 8vw, 7rem);
		overflow-wrap: normal;
		word-break: normal;
	}

	.research-hero__mission p {
		max-width: 660px;
		margin: 0;
		color: var(--color-body-text);
		font-size: clamp(1.1rem, 1.45vw, 1.32rem);
		font-weight: 400;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.research-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.research-card {
		display: grid;
		gap: 0.75rem;
		padding: 1.5rem;
	}

	.research-card h2 {
		font-size: 1.15rem;
	}

	.text-link {
		color: var(--color-link);
		font-weight: 700;
	}

	.text-link:hover,
	.text-link:focus-visible {
		color: var(--color-link-hover);
	}

	.text-link:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	.research-list {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 760px) {
		.research-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.research-hero .page-container,
		.section .container {
			width: min(calc(100% - 2rem), var(--content-width));
		}

		.research-hero__inner {
			grid-template-columns: 1fr;
			align-items: start;
			gap: 1.1rem;
		}

		.research-hero__mission {
			border-left: 0;
			border-top: 1px solid var(--color-border-soft);
			padding-top: 1rem;
			padding-left: 0;
			max-width: 100%;
		}

		.research-hero .hero-title {
			font-size: clamp(3.2rem, 15vw, 4.4rem);
		}

		.research-hero__label,
		.research-hero__mission {
			overflow-wrap: anywhere;
		}
	}
</style>
