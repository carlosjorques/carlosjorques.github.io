---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { IDENTITY, LINKEDIN_URL } from '../data/identity';
import { projectCards } from '../data/projectCards';
import portrait from '../assets/carlos-jorques-intro.webp';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);
const toSlug = (id: string) => id.replace(/\.md$/, '');

const writingEntries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime() || a.id.localeCompare(b.id),
);
const seriesPattern = /^(.*), Part (\d+)$/;
const articles = writingEntries.slice(0, 4).map((entry) => {
	const series = entry.data.title.match(seriesPattern);
	return {
		pillar: series ? `Part ${series[2]}` : entry.data.category,
		series: series?.[1],
		publishDateIso: entry.data.publishDate.toISOString().slice(0, 10),
		publishDate: new Intl.DateTimeFormat('en-GB', {
			day: '2-digit',
			month: 'short',
			year: 'numeric',
		}).format(entry.data.publishDate),
		publishMonth: new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(entry.data.publishDate),
		title: series && entry.data.subtitle ? entry.data.subtitle : entry.data.title,
		description: entry.data.description,
		href: withBase(`/writing/${toSlug(entry.id)}/`),
		ctaId: `home-writing-${toSlug(entry.id)}`,
	};
});
const sharedSeries = articles.length > 1 && articles.every((article) => article.series && article.series === articles[0].series)
	? articles[0].series
	: undefined;

const selectedProjects = projectCards.map((card) => ({
	title: card.title,
	plain: card.plain,
	result: card.outcomes.find((outcome) => /\d/.test(outcome.value)),
	image: card.image,
	href: withBase(`/work/${card.slug}/`),
	ctaId: `selected-project-${card.slug}`,
}));
---

<BaseLayout
title={`${IDENTITY.name} | ${IDENTITY.primaryTitle}`}
description="Carlos Jorques, Control Systems Technical Lead. Embedded control software for complex dynamic systems, from concept to production: selected work and writing."
ogImage={withBase('/images/og-carlos-jorques.png')}
ogImageAlt="Carlos Jorques, Control Systems Technical Lead: embedded control for complex dynamic systems."
>
	<section class="hero-area">
		<div class="page-container">
			<div class="hero">
				<div class="hero__copy">
					<p class="hero-kicker">Sense · decide · act</p>
					<h1 class="hero-statement">{IDENTITY.brandLine}</h1>
					<p class="hero-lead">I am Carlos, a <strong>{IDENTITY.primaryTitle}</strong>. I design embedded control software that makes machines use less energy, detect faults early and behave predictably. I have done this for electric trucks, autonomous haulers, motors and engines, and today I lead international teams that take it from the first concept to production.</p>
					<p class="hero-location">Based in {IDENTITY.location}</p>

					<div class="hero-links button-row" aria-label="Primary routes">
						<a
							class="button primary"
							href={withBase('/work/')}
							data-analytics-event="cta_click"
							data-cta-id="hero-work"
							data-cta-placement="home-hero"
							data-cta-intent="proof"
							data-source-section="hero"
						>
							View work
						</a>
						<a
							class="button"
							href={withBase('/writing/')}
							data-analytics-event="cta_click"
							data-cta-id="hero-writing"
							data-cta-placement="home-hero"
							data-cta-intent="authority"
							data-source-section="hero"
							data-destination={withBase('/writing/')}
						>
							Read writing
						</a>
						<a
							class="hero-text-link"
							href={withBase('/about/')}
							data-analytics-event="cta_click"
							data-cta-id="hero-about"
							data-cta-placement="home-hero"
							data-cta-intent="context"
							data-source-section="hero"
							data-destination={withBase('/about/')}
						>
							About me
						</a>
					</div>
				</div>

				<figure class="hero__portrait">
					<Image
						src={portrait}
						alt={`${IDENTITY.name}, ${IDENTITY.primaryTitle}.`}
						widths={[240, 320, 480, 640]}
						sizes="(max-width: 899px) 9rem, 20rem"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</figure>
			</div>
		</div>
	</section>

	<section class="home-proof" aria-label="Professional snapshot">
		<div class="page-container">
			<dl class="home-proof__grid">
				<div class="home-proof__item">
					<dt class="home-proof__value">{IDENTITY.years} years</dt>
					<dd class="home-proof__label">designing embedded control software</dd>
				</div>
				<div class="home-proof__item">
					<dt class="home-proof__value">In production</dt>
					<dd class="home-proof__label">runs in Scania trucks; also built for Volvo CE and MAHLE</dd>
				</div>
				<div class="home-proof__item">
					<dt class="home-proof__value">PhD&nbsp;· 5&nbsp;patents</dt>
					<dd class="home-proof__label">industrial PhD in control engineering and 15 published articles</dd>
				</div>
				<div class="home-proof__item">
					<dt class="home-proof__value">Up to 21,500&nbsp;€</dt>
					<dd class="home-proof__label">saved per electric truck in 8 years by one control function</dd>
				</div>
			</dl>
		</div>
	</section>

	<section class="home-section selected-work" aria-labelledby="selected-work-title">
		<div class="page-container home-section__grid">
			<div class="section-head">
				<h2 id="selected-work-title">Selected work</h2>
				<a
					class="section-head__link"
					href={withBase('/work/')}
					data-analytics-event="cta_click"
					data-cta-id="selected-projects-all"
					data-cta-placement="home-selected-projects"
					data-cta-intent="proof"
					data-source-section="selected-projects"
				>
					All work<span aria-hidden="true">&nbsp;→</span>
				</a>
			</div>

			<div class="home-section__body">
				<ul class="selected-work__list" role="list">
					{selectedProjects.map((project) => (
						<li class="selected-work__item">
							<a
								class="selected-work__link"
								href={project.href}
								data-analytics-event="cta_click"
								data-cta-id={project.ctaId}
								data-cta-placement="home-selected-projects"
								data-cta-intent="proof"
								data-source-section="selected-projects"
								data-destination={project.href}
							>
								<span class="selected-work__art">
									<Image src={project.image} alt="" widths={[480, 720, 960]} sizes="(max-width: 560px) 100vw, (max-width: 1100px) 50vw, 540px" loading="lazy" decoding="async" />
								</span>
								<div class="selected-work__copy">
									{project.result && (
										<p class="selected-work__result"><b>{project.result.value}</b> {project.result.label}</p>
									)}
									<h3 class="selected-work__title">{project.title}</h3>
									<p class="selected-work__plain">{project.plain}</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="home-section latest" aria-labelledby="writing-title">
		<div class="page-container home-section__grid">
			<div class="section-head">
				<h2 id="writing-title">Writing</h2>
				<a
					class="section-head__link"
					href={withBase('/writing/')}
					data-analytics-event="cta_click"
					data-cta-id="home-view-all-writing"
					data-cta-placement="home-writing"
					data-cta-intent="authority"
					data-source-section="latest-writing"
				>
					All writing<span aria-hidden="true">&nbsp;→</span>
				</a>
			</div>

			<div class="home-section__body">
				{sharedSeries && (
					<div class="latest__series">
						<p class="latest__series-meta">Series · {articles.length} parts · <time datetime={articles[0].publishDateIso}>{articles[0].publishMonth}</time></p>
						<p class="latest__series-title">{sharedSeries}</p>
					</div>
				)}

				{articles.length > 0 ? (
					<ul class="latest__list" role="list">
						{articles.map((article) => (
							<li>
								<a
									href={article.href}
									class="article-link"
									data-analytics-event="writing_article_click"
									data-cta-id={article.ctaId}
									data-cta-placement="home-writing"
									data-cta-intent="authority"
									data-source-section="latest-writing"
								>
									{sharedSeries
										? <span class="article-link__label">{article.pillar}</span>
										: <time class="article-link__label" datetime={article.publishDateIso}>{article.publishDate}</time>}
									<h3 class="article-link__title">{article.title}</h3>
								</a>
							</li>
						))}
					</ul>
				) : (
					<div class="latest__planned">
						<p>Articles will appear here as they are ready.</p>
					</div>
				)}
			</div>
		</div>
	</section>

	<section class="home-closing" aria-label="Contact">
		<div class="page-container">
			<p class="home-closing__open">Open to technical lead roles, freelance and collaborations</p>
			<p class="home-closing__text">
				Read my
				<a
					href={withBase('/cv/')}
					data-analytics-event="cta_click"
					data-cta-id="home-closing-cv"
					data-cta-placement="home-closing"
					data-cta-intent="evaluate"
					data-source-section="home-closing"
				>CV</a>,
				connect on
				<a
					href={LINKEDIN_URL}
					rel="me noopener"
					data-analytics-event="linkedin_outbound_click"
					data-cta-id="home-closing-linkedin"
					data-cta-placement="home-closing"
					data-cta-intent="professional-profile"
					data-source-section="home-closing"
				>LinkedIn</a>
				or
				<a
					href={withBase('/contact/?source=home-closing#message-title')}
					data-analytics-event="cta_click"
					data-cta-id="home-closing-contact"
					data-cta-placement="home-closing"
					data-cta-intent="contact"
					data-source-section="home-closing"
					data-destination={withBase('/contact/?source=home-closing#message-title')}
				>start a conversation</a>.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.hero-area {
		position: relative;
		overflow: hidden;
		background: var(--color-page);
		color: var(--color-hero-text);
		padding-block: clamp(4.5rem, 8vw, 7rem) clamp(4rem, 6vw, 6rem);
	}

	.hero-area .page-container {
		position: relative;
		z-index: 2;
	}

	.hero {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: center;
	}

	.hero__copy {
		max-width: 760px;
		text-align: left;
	}

	.hero-kicker,
	.hero-statement,
	.hero-location,
	.hero-links,
	.hero__portrait,
	.home-proof {
		animation: carbon-enter-up var(--motion-duration-slow-01) var(--motion-entrance-expressive) both;
	}

	.hero-statement {
		animation-delay: 90ms;
	}

	.hero-links {
		animation-delay: 240ms;
	}

	.hero__portrait {
		animation-delay: 290ms;
	}

	.home-proof {
		animation-delay: 340ms;
	}

	.hero-kicker {
		margin: 0 0 var(--spacing-05);
		font-family: var(--font-mono);
		font-size: var(--type-eyebrow-size);
		font-weight: var(--type-eyebrow-weight);
		letter-spacing: var(--type-eyebrow-tracking);
		text-transform: uppercase;
		color: var(--color-hero-kicker);
	}

	.hero-statement {
		max-width: 760px;
		margin: var(--spacing-06) 0 0;
		font-size: clamp(2rem, 3.4vw, 3.5rem);
		line-height: 1.08;
		letter-spacing: -.05em;
		font-weight: 800;
		color: var(--color-hero-text);
	}

	.hero-location {
		max-width: 690px;
		margin: var(--spacing-03) 0 0;
		color: var(--color-hero-text);
		opacity: .72;
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		line-height: var(--type-meta-line);
		letter-spacing: var(--type-meta-tracking);
		text-transform: uppercase;
	}

	.hero-links {
		margin-top: var(--spacing-07);
		display: flex;
		justify-content: flex-start;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.hero__portrait {
		margin: 0;
		width: 100%;
		aspect-ratio: 4 / 3;
		justify-self: center;
		overflow: hidden;
		border: 1px solid var(--color-border-soft);
		border-radius: var(--radius);
		background: var(--color-surface-soft);
	}

	.hero__portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
	}

	.home-proof {
		padding-block: clamp(1.75rem, 3vw, 2.25rem);
		background: var(--color-surface-soft);
		animation: carbon-enter-up var(--motion-duration-slow-01) var(--motion-entrance-expressive) 340ms both;
	}

	.home-proof__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem 2rem;
		margin: 0;
	}

	.home-proof__item {
		display: grid;
		align-content: start;
		gap: .3rem;
	}

	.home-proof__value {
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 1.8vw, 1.45rem);
		font-weight: 800;
		letter-spacing: -.03em;
		line-height: 1.15;
	}

	.home-proof__label {
		margin: 0;
		max-width: 16rem;
		color: var(--color-muted);
		font-family: var(--font-body);
		font-size: .86rem;
		letter-spacing: 0;
		line-height: 1.45;
		text-transform: none;
	}

	.home-section {
		background: var(--color-section-bg);
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.home-section__grid {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.25rem);
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
	}

	.selected-work .home-section__grid {
		padding-top: 0;
		border-top: 0;
	}

	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: .5rem 1.5rem;
	}

	.section-head h2 {
		max-width: none;
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 2.6vw, 2.1rem);
		font-weight: var(--type-section-title-weight);
		letter-spacing: -0.035em;
		line-height: 1.1;
	}

	.section-head__link {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		color: var(--color-link);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: var(--type-chip-weight);
		letter-spacing: var(--type-chip-tracking);
		line-height: var(--type-chip-line);
		text-decoration: none;
		text-transform: uppercase;
		border-bottom: 1px solid transparent;
		transition: border-color var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.section-head__link:hover,
	.section-head__link:focus-visible {
		color: var(--color-link-hover);
		border-bottom-color: var(--color-link-hover);
	}

	.selected-work__list,
	.latest__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.latest__list li + li {
		border-top: 1px solid var(--color-border-soft);
	}

	.selected-work__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2.5vw, 2rem);
	}

	@media (max-width: 560px) {
		.selected-work__list {
			grid-template-columns: 1fr;
		}
	}

	.selected-work__link {
		display: grid;
		gap: .85rem;
		align-content: start;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.selected-work__art {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: 4px;
		background: var(--color-surface-soft);
	}

	.selected-work__art img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--motion-duration-moderate-01) var(--motion-standard-productive);
	}

	.selected-work__copy {
		display: grid;
		gap: .35rem;
		min-width: 0;
	}

	.selected-work__copy .selected-work__title {
		margin: 0;
		color: var(--color-body-text);
		font-family: var(--font-body);
		font-size: clamp(1rem, 1.3vw, 1.08rem);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.35;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: .22em;
		transition: text-decoration-color var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.selected-work__plain {
		margin: 0;
		color: var(--color-muted);
		font-size: .95rem;
		line-height: 1.5;
	}

	.selected-work__result {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 .55rem;
		color: var(--color-text);
		font-size: 1.02rem;
		line-height: 1.3;
	}

	.selected-work__result b {
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 3vw, 2.4rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
	}

	.article-link__title {
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 1.6vw, 1.3rem);
		font-weight: var(--type-card-title-weight);
		letter-spacing: var(--type-card-title-tracking);
		line-height: var(--type-card-title-line);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: .22em;
		transition: text-decoration-color var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.selected-work__link:hover .selected-work__title,
	.selected-work__link:focus-visible .selected-work__title,
	.article-link:hover .article-link__title,
	.article-link:focus-visible .article-link__title {
		text-decoration-color: var(--color-border-strong);
	}

	.selected-work__link:hover .selected-work__art img,
	.selected-work__link:focus-visible .selected-work__art img {
		transform: scale(1.04);
	}

	.selected-work__link:focus-visible,
	.article-link:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 4px;
	}

	.latest__series {
		padding-bottom: .75rem;
	}

	.latest__series-meta {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		letter-spacing: var(--type-chip-tracking);
		line-height: 1.4;
		text-transform: uppercase;
	}

	.latest__series-title {
		margin: .3rem 0 0;
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.35;
	}

	.latest__list {
		border-left: 2px solid var(--color-border-soft);
	}

	.latest__list li + li {
		border-top: 0;
	}

	.article-link {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 1rem;
		align-items: baseline;
		padding: .45rem 0 .45rem 1rem;
		color: inherit;
		text-decoration: none;
	}

	.article-link__label {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		letter-spacing: var(--type-chip-tracking);
		line-height: 1.4;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.article-link .article-link__title {
		color: var(--color-body-text);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.45;
	}

	.article-link:hover .article-link__title,
	.article-link:focus-visible .article-link__title {
		color: var(--color-text);
	}

	.latest__planned p {
		margin: 0;
		color: var(--color-body-text);
		font-size: .92rem;
		line-height: 1.5;
	}

	.home-closing {
		padding-block: var(--spacing-06);
		background-color: var(--color-surface-soft);
	}

	.home-closing__open {
		margin: 0 0 .5rem;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		letter-spacing: var(--type-meta-tracking);
		line-height: var(--type-meta-line);
		text-transform: uppercase;
	}

	.home-closing__text {
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: var(--type-hero-role-size);
		font-weight: var(--type-hero-role-weight);
		letter-spacing: var(--type-hero-role-tracking);
