---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { CONTACT_DESTINATIONS, IDENTITY, LINKEDIN_URL } from '../data/identity';
import { projectCards } from '../data/projectCards';
import { getUpcomingParts, getWritingArticles, groupWriting } from '../data/writing';
import WritingPublicationList from '../components/writing/WritingPublicationList.astro';
import TruckTuneGame from '../components/TruckTuneGame.astro';
import portrait from '../assets/carlos-jorques-intro.webp';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href === '/' ? normalizedBase : `${normalizedBase}${href.replace(/^\//, '')}`);

// Same publications as "Latest publications" on /writing/: a series counts as one entry.
const publishedWriting = await getWritingArticles({ includeDrafts: false });
const latestWriting = groupWriting(publishedWriting, await getUpcomingParts(publishedWriting)).latest;
const series = latestWriting.find((item) => item.kind === 'series');
const otherWriting = latestWriting.filter((item) => item.kind !== 'series');

const projects = projectCards.map((card) => ({
	title: card.title,
	company: card.company,
	plain: card.plain,
	result: card.outcomes.find((outcome) => /\d/.test(outcome.value)),
	image: card.image,
	href: withBase(`/work/${card.slug}/`),
	ctaId: `selected-project-${card.slug}`,
}));
const [featured, ...otherProjects] = projects;

const proof = [
	{ value: `${IDENTITY.years} years`, label: 'designing embedded control software' },
	{ value: 'In production', label: 'my control software runs in Scania trucks on the road' },
	{ value: 'PhD\u00a0· 5\u00a0patents', label: 'industrial PhD on engine control systems and 15 published articles' },
	{ value: 'Up to 4.6×', label: 'the value of the electricity saved, battery sized for it' },
];

const links = {
	work: withBase('/work/'),
	cv: withBase('/cv/'),
	about: withBase('/about/'),
	writing: withBase('/writing/'),
	contact: withBase('/contact/?source=home-closing#message-title'),
};
---

<BaseLayout
	title={`${IDENTITY.name} | ${IDENTITY.primaryTitle}`}
	description="Carlos Jorques, Control Systems Technical Lead. Embedded control software for complex dynamic systems, from concept to production: selected work and writing."
	ogImage={withBase('/images/og-carlos-jorques.png')}
	ogImageAlt="Carlos Jorques, Control Systems Technical Lead: embedded control for complex dynamic systems."
>
	<div class="page-container home">
		<section class="home-hero" aria-labelledby="home-title">
			<div class="home-hero__text">
				<p class="home-eyebrow">{IDENTITY.primaryTitle} · {IDENTITY.location}</p>
				<h1 id="home-title">{IDENTITY.brandLine}</h1>
				<p class="home-lead">I am Carlos, a <strong>{IDENTITY.primaryTitle}</strong>. I design embedded control software that makes machines use less energy, detect faults early and behave predictably. I have done this for electric trucks, autonomous haulers, motors and engines. Today I lead international teams that develop it and take it into production.</p>
				<p class="home-actions">
					<a href={links.work} data-analytics-event="cta_click" data-cta-id="hero-work" data-cta-placement="hero" data-cta-intent="evidence" data-source-section="hero" data-destination={links.work}>See my work</a>
					<a href={links.cv} data-analytics-event="cta_click" data-cta-id="hero-cv" data-cta-placement="hero" data-cta-intent="formal-proof" data-source-section="hero" data-destination={links.cv}>Read my CV</a>
					<a href={links.about} data-analytics-event="cta_click" data-cta-id="hero-about" data-cta-placement="hero" data-cta-intent="background" data-source-section="hero" data-destination={links.about}>More about me</a>
				</p>
			</div>
			<Image class="home-portrait" src={portrait} alt="Portrait of Carlos Jorques" widths={[320, 640]} sizes="(max-width: 760px) 4.5rem, 15rem" loading="eager" fetchpriority="high" />
			<a class="home-now" href={featured.href} data-analytics-event="cta_click" data-cta-id={featured.ctaId} data-cta-placement="hero" data-cta-intent="evidence" data-source-section="hero-now" data-destination={featured.href}>
				<span class="home-now__text">
					<span class="home-now__kick"><span class="led" aria-hidden="true"></span>Now · ALTEN for Scania</span>
					<span class="home-now__title">Leading predictive thermal control for Scania’s electric trucks<span aria-hidden="true">&nbsp;&rarr;</span></span>
				</span>
				{featured.result && <span class="home-num"><b>{featured.result.value}</b><span>{featured.result.label}</span></span>}
			</a>
		</section>

		<section class="home-proof" aria-labelledby="proof-title">
			<h2 id="proof-title" class="sr-only">In short</h2>
			<dl>{proof.map((item) => <div><dt>{item.value}</dt><dd>{item.label}</dd></div>)}</dl>
		</section>

		<section class="home-section" aria-labelledby="work-title">
			<div class="home-head"><h2 id="work-title">Selected work</h2><a href={links.work}>All work</a></div>
			<ol class="home-work" role="list">
				{otherProjects.map((project) => (
					<li>
						<a href={project.href} data-analytics-event="cta_click" data-cta-id={project.ctaId} data-cta-placement="selected-work" data-cta-intent="evidence" data-source-section="selected-work" data-destination={project.href}>
							<span class="home-work__img"><Image src={project.image} alt="" widths={[200, 400]} sizes="144px" loading="lazy" /></span>
							<span class="home-work__text">
								<span class="home-work__co">{project.company}</span>
								<span class="home-work__title">{project.title}</span>
								<span class="home-work__plain">{project.plain}</span>
							</span>
							{project.result && <span class="home-num"><b>{project.result.value}</b><span>{project.result.label}</span></span>}
						</a>
					</li>
				))}
			</ol>
		</section>

		<section class="home-section home-bench" aria-labelledby="bench-title">
			<div class="home-bench__intro">
				<h2 id="bench-title">Try tuning a truck controller</h2>
				<p>The damping sets how the controller approaches its target. With too little, the response overshoots; with too much, it arrives late. To pass the truck test, the response must overshoot less than 2% and settle in less than 1.5 s.</p>
			</div>
			<TruckTuneGame id="home-game" prizeHref={featured.href} />
		</section>

		{latestWriting.length > 0 && (
			<section class="home-section" aria-labelledby="writing-title">
				<div class="home-head"><h2 id="writing-title">Writing</h2><a href={links.writing}>All writing</a></div>
				{series && series.kind === 'series' && (
					<article class="home-series">
						<p class="home-series__kick">Series · {series.group.parts.length} parts · {series.group.totalMinutes} min</p>
						<h3><a href={series.group.href}>{series.group.definition.title}</a></h3>
						<p class="home-series__text">{series.group.definition.teaser ?? series.group.definition.summary}</p>
						<ol class="home-parts" role="list">
							{series.group.parts.map((part, i) => (
								<li><span class="home-parts__n">Part {i + 1}</span><span class="home-parts__body"><a href={part.href}>{part.title}</a><span class="home-parts__text">{part.teaser ?? part.description}</span></span><span class="home-parts__min">{part.minutes} min</span></li>
							))}
						</ol>
					</article>
				)}
				{otherWriting.length > 0 && <WritingPublicationList publications={otherWriting} variant="compact" placement="home-writing" sourceSection="latest-writing" />}
			</section>
		)}

		<section class="home-close" aria-labelledby="close-title">
			<Image class="home-close__face" src={portrait} alt="" widths={[160, 320]} sizes="128px" />
			<div>
				<h2 id="close-title">Looking for someone to lead your control software?</h2>
				<p>I am open to technical lead roles and to collaborations. Read my <a href={links.cv} data-analytics-event="cta_click" data-cta-id="closing-cv" data-cta-placement="closing" data-cta-intent="formal-proof" data-source-section="closing" data-destination={links.cv}>CV</a>, connect on <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" data-analytics-event="linkedin_outbound_click" data-cta-id="closing-linkedin" data-cta-placement="closing" data-cta-intent="professional-profile" data-source-section="closing" data-destination={LINKEDIN_URL}>LinkedIn</a> or <a href={links.contact} data-analytics-event="cta_click" data-cta-id="closing-contact" data-cta-placement="closing" data-cta-intent="contact" data-source-section="closing" data-destination={links.contact}>write to me</a>.</p>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.home h2 { margin: 0; font-size: 1.6rem; }
	.home-hero { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 2rem 3rem; align-items: center; padding: 3.5rem 0 2rem; }
	.home-eyebrow { margin: 0 0 .9rem; color: var(--color-muted); font-family: var(--font-sans); font-size: .92rem; font-weight: 500; }
	.home-hero h1 { margin: 0 0 1.4rem; max-width: none; font-size: clamp(2.2rem, 6vw, 3.3rem); line-height: 1.08; letter-spacing: -.03em; }
	.home-lead { margin: 0 0 1.25rem; font-size: 1.2rem; line-height: 1.65; color: var(--color-body-text); }
	.home-lead strong { color: var(--color-text); font-weight: 600; }
	.home-actions { display: flex; flex-wrap: wrap; gap: .5rem 1.6rem; margin: 0; font-family: var(--font-sans); }
	.home-actions a { color: var(--color-text); font-weight: 500; }
	.home-actions a::after { content: ' \2192'; }
	.home-actions a:hover { color: var(--color-link-hover); }
	:global(.home-portrait) { display: block; width: 15rem; height: 15rem; border-radius: 50%; object-fit: cover; }
	.home-now { grid-column: 1 / -1; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) 8.5rem; gap: 1.5rem; align-items: center; margin-top: .75rem; padding: 1.1rem 1.4rem; border-radius: .6rem; background: var(--color-surface-soft); font-family: var(--font-sans); text-decoration: none; }
	.home-now:hover { background: color-mix(in srgb, var(--color-accent-bright) 14%, var(--color-surface-soft)); }
	.home-now__text { display: grid; gap: .2rem; }
	.home-now__kick { display: inline-flex; align-items: center; gap: .45rem; color: var(--color-muted); font-size: .85rem; }
	.home-now__title { color: var(--color-text); font-size: 1.15rem; font-weight: 600; line-height: 1.3; }
	.home-now:hover .home-now__title { color: var(--color-link-hover); }

	.home-num { display: grid; gap: .1rem; text-align: right; font-family: var(--font-sans); }
	.home-num b { justify-self: end; color: var(--color-text); font-size: 1.45rem; font-weight: 600; line-height: 1.15; white-space: nowrap; background: var(--mark-band); }
	.home-num span { color: var(--color-muted); font-size: .84rem; line-height: 1.35; }

	.home-proof { padding: 1.5rem 0 1rem; }
	.home-proof dl { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.75rem; margin: 0; padding: 1.25rem 0; border-block: 1px solid var(--color-border); }
	.home-proof dt { color: var(--color-text); font-family: var(--font-sans); font-size: 1.02rem; font-weight: 600; }
	.home-proof dd { margin: .15rem 0 0; color: var(--color-muted); font-family: var(--font-sans); font-size: .86rem; line-height: 1.45; }

	.home-section { padding: 3rem 0; }
	.home-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem; }
	.home-head a { color: var(--color-text); font-family: var(--font-sans); font-size: .95rem; font-weight: 500; }

	.home-work { margin: 0; padding: 0; list-style: none; }
	.home-work li { border-top: 1px solid var(--color-border); }
	.home-work a { display: grid; grid-template-columns: 9rem 1fr 8.5rem; gap: 1.5rem; align-items: center; padding: 1.25rem 0; text-decoration: none; }
	.home-work__img { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: .4rem; background: var(--color-border); }
	.home-work__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
	.home-work a:hover :global(img) { transform: scale(1.04); }
	.home-work__text { display: grid; gap: .15rem; }
	.home-work__co { color: var(--color-muted); font-family: var(--font-sans); font-size: .85rem; }
	.home-work__title { color: var(--color-text); font-family: var(--font-sans); font-size: 1.1rem; font-weight: 600; line-height: 1.3; }
	.home-work a:hover .home-work__title { color: var(--color-link-hover); }
	.home-work__plain { color: var(--color-body-text); font-size: .98rem; line-height: 1.5; }

	.home-bench { border-top: 1px solid var(--color-border); }
	.home-bench__intro { max-width: 40rem; margin-bottom: 1.75rem; }
	.home-bench__intro p { margin: .6rem 0 0; }

	.home-series { padding-top: 1.1rem; border-top: 1px solid var(--color-border); }
	.home-series__kick { margin: 0 0 .3rem; color: var(--color-muted); font-family: var(--font-sans); font-size: .92rem; }
	.home-series h3 { margin: 0; font-size: 1.25rem; line-height: 1.3; letter-spacing: -.01em; }
	.home-series h3 a { color: var(--color-text); text-decoration: none; }
	.home-series h3 a:hover { color: var(--color-link-hover); text-decoration: underline; }
	.home-series__text { margin: .3rem 0 .9rem; }
	.home-parts { margin: 0; padding: 0; list-style: none; }
	.home-parts li { display: grid; grid-template-columns: 4.5rem 1fr auto; gap: 1rem; align-items: baseline; padding: .8rem 0; border-top: 1px solid var(--color-border); }
	.home-parts__n, .home-parts__min { color: var(--color-muted); font-family: var(--font-sans); font-size: .88rem; white-space: nowrap; }
	.home-parts__body { display: grid; gap: .15rem; }
	.home-parts a { color: var(--color-text); font-family: var(--font-sans); font-weight: 500; text-decoration: none; }
	.home-parts a:hover { color: var(--color-link-hover); text-decoration: underline; }
	.home-parts__text { color: var(--color-body-text); font-size: .95rem; line-height: 1.5; }

	.home-close { display: flex; gap: 2rem; align-items: center; padding: 4rem 0 5rem; }
	:global(.home-close__face) { flex: none; width: 8rem; height: 8rem; border-radius: 50%; object-fit: cover; }
	.home-close p { max-width: 36rem; margin: .6rem 0 0; }
	.home-close a { color: var(--color-text); }

	@media (max-width: 760px) {
		/* The portrait sits beside the eyebrow, so the "Now" project fits in the first mobile screen. */
		.home-hero { grid-template-columns: 4.5rem minmax(0, 1fr); gap: 0 1rem; align-items: center; padding-top: 1.5rem; }
		.home-hero__text { display: contents; }
		:global(.home-portrait) { grid-row: 1; grid-column: 1; width: 4.5rem; height: 4.5rem; }
		.home-eyebrow { grid-row: 1; grid-column: 2; margin: 0; font-size: .84rem; }
		.home-hero h1, .home-lead, .home-actions, .home-now { grid-column: 1 / -1; }
		.home-hero h1 { margin: 1rem 0 .85rem; }
		.home-lead { margin-bottom: 1rem; font-size: 1.06rem; line-height: 1.6; }
		.home-now { margin-top: 1rem; }
		.home-now { grid-template-columns: 1fr; gap: .6rem; }
		.home-num { text-align: left; }
		.home-num b { justify-self: start; }
		.home-proof dl { grid-template-columns: repeat(2, 1fr); }
		.home-work a { grid-template-columns: 5.5rem 1fr; gap: .4rem 1rem; align-items: start; }
		.home-work .home-num { grid-column: 2; }
		.home-parts li { grid-template-columns: 1fr auto; gap: .1rem 1rem; }
		.home-parts__n { grid-column: 1 / -1; }
		.home-close { flex-direction: column; align-items: flex-start; }
	}
</style>
