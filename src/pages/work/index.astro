---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { LINKEDIN_URL } from '../../data/identity';

const projectOrder = [
	'electric-truck-thermal-management',
	'autonomous-hauler-propulsion-control',
	'heavy-duty-engine-diagnostics-control-research',
	'ebike-motor-control-power-electronics',
];
const projects = (await getCollection('projects')).sort((a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id));
---

<BaseLayout title="Work" description="Selected projects across architecture, implementation, and delivery of embedded control software shaped and led by Carlos Jorques.">
	<section class="work-overview-hero" aria-labelledby="work-title"><div class="page-container"><p class="section-eyebrow">Selected work</p><h1 id="work-title" class="hero-title">Projects that connect embedded control architecture to dependable behavior in real machines.</h1><p class="work-overview-hero__proof">Production embedded controls <span aria-hidden="true">·</span> Electrification <span aria-hidden="true">·</span> Autonomous machines</p></div></section>
	<section class="section work-projects" aria-labelledby="projects-title"><div class="page-container"><h2 id="projects-title" class="sr-only">Projects</h2><div class="project-grid">{projects.map((project) => <ProjectCard {...project.data} slug={project.id} />)}</div></div></section>
	<section class="section work-overview-cta" aria-label="Next steps"><div class="page-container"><ContactCTA title="Have an embedded systems opportunity, technical question, or collaboration in mind?" body="I’m open to related roles, technical leadership opportunities, freelance engineering work, and conversations about embedded controls, electrification, diagnostics, and intelligent physical systems." primaryLabel="Start a conversation" secondaryHref={LINKEDIN_URL} secondaryLabel="Connect on linkedin" tertiaryHref="/cv/" tertiaryLabel="View CV" /></div></section>
</BaseLayout>

<style>
	.work-overview-hero { padding: clamp(3rem, 5vw, 4.6rem) 0 0; }
	.work-overview-hero .page-container { display: grid; gap: 1rem; }
	.work-overview-hero .section-eyebrow { margin: 0; color: var(--color-muted); font-size: .82rem; font-weight: 600; letter-spacing: .08em; line-height: 1.4; }
	.work-overview-hero h1.hero-title { max-width: none; margin: 0; font-size: clamp(2.6rem, 3.8vw, 3.5rem); font-weight: 800; letter-spacing: -.05em; line-height: 1.02; }
	.work-overview-hero__proof { margin-top: 0; color: var(--color-accent-text); font-family: var(--font-mono); font-size: var(--type-meta-size); font-weight: var(--type-meta-weight); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; }
	.project-grid { display: grid; grid-template-columns: 1fr; gap: clamp(1.5rem, 3vw, 2.5rem); }
	section.work-projects { padding-top: clamp(3rem, 5vw, 5rem); }
	.work-overview-cta { padding-top: 0; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	@media (max-width: 720px) { .work-overview-hero { padding-top: 3rem; } .work-overview-hero h1.hero-title { font-size: clamp(2.15rem, 10vw, 2.45rem); line-height: 1.04; } }
</style>
