---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectCard, projectCards, validateProjectCardSlugs } from '../../data/projectCards';
import { IDENTITY } from '../../data/identity';

const projectDetails = await getCollection('projects');
validateProjectCardSlugs(projectDetails.map((project) => project.id));
const projects = projectCards.map((card) => getProjectCard(card.slug));
const withBase = (href: string) => `${import.meta.env.BASE_URL}${href.replace(/^\//, '')}`;
---

<BaseLayout title="Control software for physical machines" description="Selected projects by Carlos Jorques, Control Systems Technical Lead, in predictive thermal control, autonomous haulers, electric motors and engine control.">
	<div class="work-page">
		<section class="work-hero" aria-labelledby="work-title">
			<p class="work-eyebrow">Selected work</p>
			<div class="work-hero__copy">
				<h1 id="work-title">Projects in control software for complex physical machines.</h1>
				<p class="work-hero__lead">These four projects are selected from <strong>15 years of control software development</strong> for electric trucks, autonomous machines, electric motors and engines. As a <strong>{IDENTITY.primaryTitle}</strong>, I set the technical direction of the control software, take part in its development and organise the team, so that the work reaches the machine and serves the business plan.</p>
			</div>
		</section>
		<section class="work-projects" aria-labelledby="projects-title">
			<h2 id="projects-title" class="sr-only">Projects</h2>
			<div class="project-list">{projects.map((project, index) => <ProjectCard {...project} headingLevel={3} eager={index === 0} />)}</div>
		</section>
	</div>
	<section class="section work-overview-cta" aria-label="Next steps">
		<div class="page-container">
			<ContactCTA title="Hiring, or working on a similar control problem?" body="Send a message about a role or about the system and constraints you are working with, and I will reply with the most relevant experience." primaryHref="/contact/?context=role&source=work#message-title" primaryLabel="Discuss a role" secondaryHref="/contact/?context=technical&source=work#message-title" secondaryLabel="Discuss your challenge" tertiaryHref="/cv/" tertiaryLabel="View CV" sourceSection="work-closing" ctaIdPrefix="work-closing">
				<p class="work-more">More evidence: <a href={withBase('/cv/#credentials')}>publications and patents</a><span aria-hidden="true"> · </span><a href={withBase('/cv/#experience')}>roles and career</a><span aria-hidden="true"> · </span><a href={withBase('/writing/')}>technical writing</a></p>
			</ContactCTA>
		</div>
	</section>
</BaseLayout>

<style>
	.work-page { width: min(calc(100% - 5rem), var(--content-width)); margin: 0 auto; padding: 0; }
	.work-hero { padding: clamp(3rem, 5vw, 4.6rem) 0 0; }
	.work-eyebrow { margin: 0; color: var(--color-muted); font-family: var(--font-mono); font-size: .82rem; font-weight: 600; letter-spacing: .08em; line-height: 1.4; text-transform: uppercase; }
	.work-hero__copy { display: grid; gap: 1rem; align-content: start; margin: 1rem 0 5rem; }
	.work-hero h1 { max-width: none; margin: 0; font-size: clamp(2.6rem, 3.8vw, 3.5rem); font-weight: 800; letter-spacing: -.05em; line-height: 1.02; }
	.work-hero__lead { max-width: 52rem; margin: 0; color: var(--color-text); font-size: 1.08rem; line-height: 1.7; }
	.work-hero__lead strong { font-weight: 700; }
	.project-list { display: grid; }
	.work-overview-cta { padding-top: clamp(3rem, 6vw, 5rem); }
	.work-more { margin: .35rem 0 0; color: var(--color-muted); font-size: .92rem; line-height: 1.7; }
	.work-more a { color: var(--color-link); font-weight: 600; text-underline-offset: .2em; }
	.work-more a:hover { color: var(--color-link-hover); }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	@media (max-width: 720px) { .work-hero { padding-top: 3rem; } .work-hero__copy { margin-bottom: 2.5rem; } .work-hero h1 { font-size: clamp(2.15rem, 10vw, 2.45rem); line-height: 1.04; } }
	@media (max-width: 640px) { .work-page { width: min(calc(100% - 32px), var(--content-width)); } }
</style>
