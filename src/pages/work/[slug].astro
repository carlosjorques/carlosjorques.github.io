---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const withBase = (href: string) => `${import.meta.env.BASE_URL}${href.replace(/^\//, '')}`;
---

<BaseLayout title={`${data.title} | Work`} description={data.description}>
	<article class="project-detail">
		<div class="page-container">
			<nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBase('/work/')}>Work</a><span aria-hidden="true">/</span><span aria-current="page">{data.title}</span></nav>
			<header class="project-detail__hero">
				<div class="project-detail__hero-copy"><p class="section-eyebrow">{data.context}</p><h1>{data.title}</h1><p class="project-detail__outcome">{data.description}</p><ul class="tag-list" aria-label={`${data.title} tags`}>{data.tags.map((tag) => <li class="tag">{tag}</li>)}</ul></div>
				<figure class="project-detail__hero-media"><Image src={data.image} alt={data.imageAlt} widths={[720, 1080, 1440]} sizes="(min-width: 900px) 50vw, 100vw" /></figure>
			</header>
			<div class="project-detail__sections">
				<section aria-labelledby="context-objective"><h2 id="context-objective">Context &amp; Objective</h2><p>{data.objective}</p></section>
				<section aria-labelledby="role-scope"><h2 id="role-scope">Role &amp; Scope</h2><p>{data.roleScope}</p><p>{data.contribution}</p>{data.collaborators && <p class="project-detail__muted"><strong>Collaborators:</strong> {data.collaborators}</p>}<h3>Tools &amp; methods</h3><ul class="tag-list">{data.toolsAndMethods.map((tool) => <li class="tag">{tool}</li>)}</ul></section>
				<section aria-labelledby="constraints"><h2 id="constraints">Constraints</h2><p>{data.constraints}</p>{data.risks && <p class="project-detail__muted"><strong>Risks:</strong> {data.risks}</p>}</section>
				<section aria-labelledby="process-decisions"><h2 id="process-decisions">Process &amp; Decisions</h2><h3>Process</h3><p>{data.process}</p><h3>Key decisions</h3><p>{data.decisions}</p></section>
				<section aria-labelledby="deliverables"><h2 id="deliverables">Deliverables</h2><p>{data.deliverables}</p>{data.deliverableVisuals && <div class="project-detail__gallery">{data.deliverableVisuals.map((visual, index) => <Image src={visual} alt={`${data.title} supporting visual ${index + 1}`} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" />)}</div>}</section>
				<section aria-labelledby="outcomes-metrics"><h2 id="outcomes-metrics">Outcomes &amp; Metrics</h2><div class="metric-grid">{data.metrics.map((metric) => <div class="metric"><h3>{metric.value}</h3><p>{metric.label}</p></div>)}</div></section>
				{data.reflection && <section aria-labelledby="reflection"><h2 id="reflection">Reflection</h2><p>{data.reflection}</p></section>}
			</div>

			{data.relatedWritingUrl && <p class="related-writing"><span>Related writing</span><a href={data.relatedWritingUrl}>Read the deeper technical note <span aria-hidden="true">→</span></a></p>}
			<div class="project-detail__closing"><ContactCTA title="Interested in the engineering behind this work?" secondaryHref="/work/" secondaryLabel="View more work" /></div>
		</div>
	</article>
</BaseLayout>

<style>
	.project-detail { padding: clamp(2rem, 5vw, 4rem) 0 5rem; }
	.breadcrumb { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: clamp(2.5rem, 6vw, 5rem); color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-meta-size); }
	.breadcrumb a { color: var(--color-link); text-underline-offset: .2em; }
	.project-detail__hero { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; padding-bottom: clamp(3rem, 7vw, 6rem); border-bottom: 1px solid var(--color-border); }
	.project-detail__hero-copy { display: grid; gap: 1rem; max-width: 42rem; }
	.project-detail h1 { max-width: 14ch; }
	.project-detail__outcome { max-width: 48ch; color: var(--color-muted); font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.5; }
	.project-detail__hero-media { order: -1; margin: 0; overflow: hidden; border-radius: var(--radius); background: var(--color-surface-soft); }
	.project-detail__hero-media img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
	.project-detail__sections { display: grid; max-width: 58rem; padding: 0 0 clamp(3rem, 7vw, 6rem); }
	.project-detail__sections > section { display: grid; gap: 1rem; padding: clamp(2rem, 4vw, 3rem) 0; border-top: 1px solid var(--color-border); }
	.project-detail__sections > section:first-child { border-top: 0; padding-top: 0; }
	.project-detail h2 { max-width: 18ch; font-size: clamp(1.8rem, 3vw, 2.6rem); }
	.project-detail h3 { margin-top: .5rem; font-family: var(--font-mono); font-size: var(--type-meta-size); letter-spacing: var(--type-meta-tracking); text-transform: uppercase; }
	.project-detail__sections p { max-width: 62ch; font-size: 1.05rem; line-height: 1.7; }
	.project-detail__muted { color: var(--color-muted); }
	.project-detail__gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: .5rem; }
	.project-detail__gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--color-border); border-radius: var(--radius); }
	.metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
	.metric { display: grid; gap: .35rem; min-height: 7rem; align-content: center; border: 1px solid var(--color-card-border); border-radius: var(--radius); background: var(--color-card-bg); padding: 1rem; }
	.metric h3 { margin: 0; color: var(--color-accent-text); font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -.05em; text-transform: none; }
	.metric p { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-meta-size); line-height: 1.35; }
	.related-writing { display: flex; flex-wrap: wrap; gap: .75rem; align-items: baseline; padding: 1.25rem 0; border-top: 1px solid var(--color-border); color: var(--color-muted); }
	.related-writing span { font-family: var(--font-mono); font-size: var(--type-meta-size); text-transform: uppercase; }
	.related-writing a { color: var(--color-link); text-underline-offset: .2em; }
	.project-detail__closing { padding-top: 2rem; }
	@media (min-width: 900px) { .project-detail__hero { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } .project-detail__hero-media { order: 0; } }
</style>
