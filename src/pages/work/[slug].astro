---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getProjectCard, projectCards, validateProjectCardSlugs } from '../../data/projectCards';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	validateProjectCardSlugs(projects.map((project) => project.id));
	return projects.map((project) => ({ params: { slug: project.id }, props: { project, card: getProjectCard(project.id) } }));
}

const { project, card } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const site = Astro.site ?? new URL(Astro.url.origin);
const withBase = (href: string) => `${import.meta.env.BASE_URL}${href.replace(/^\//, '')}`;
const pageUrl = new URL(withBase(`/work/${project.id}/`), site);

const cardIndex = projectCards.findIndex((projectCard) => projectCard.slug === project.id);
const nextCard = projectCards[(cardIndex + 1) % projectCards.length];

const ogImage = await getImage({ src: card.image, width: 1200, format: 'jpg' });
const updatedIso = data.updated.toISOString().slice(0, 10);

const projectSource = `project-${project.id}`;
const contactHref = `/contact/?context=technical&source=${projectSource}#message-title`;

// Keep a number and its unit on the same line.
const nb = (text: string) => text.replace(/(\d) (?=(?:t|L|kg|kWh|rpm|bar|mg|Hz|°C|km\/h|K|€)(?!\p{L}))/gu, '$1\u00a0');
// Escape frontmatter text and turn **highlights** into <strong> for recruiter scanning.
const escapeHtml = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (text: string) => escapeHtml(nb(text)).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const plain = (text: string) => text.replace(/\*\*/g, '');
// "My role" and "Result" repeat the lead, the facts and the numbers, so the summary shows only the need and the key work.
const glance = data.glance.filter((item) => !['My role', 'Result'].includes(item.label));

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CreativeWork',
			'@id': `${pageUrl.href}#work`,
			name: data.title,
			headline: data.title,
			description: data.description,
			url: pageUrl.href,
			image: new URL(ogImage.src, site).href,
			inLanguage: 'en',
			dateModified: updatedIso,
			author: { '@id': new URL('/#person', site).href },
			keywords: data.schema.keywords,
			about: data.schema.about.map((item) => ({ '@type': 'Thing', name: item.name, ...(item.sameAs && { sameAs: item.sameAs }) })),
			mentions: data.schema.mentions.map((item) => ({
				'@type': item.type,
				name: item.name,
				...(item.sameAs && { sameAs: item.sameAs }),
				...(item.url && { url: item.url }),
			})),
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL(withBase('/'), site).href },
				{ '@type': 'ListItem', position: 2, name: 'Work', item: new URL(withBase('/work/'), site).href },
				{ '@type': 'ListItem', position: 3, name: data.title, item: pageUrl.href },
			],
		},
	],
};
---

<BaseLayout title={data.seoTitle} description={data.description} ogType="article" ogImage={ogImage.src} ogImageAlt={card.imageAlt}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<article class="project-page">
		<div class="project-page__container">
			<nav class="project-breadcrumb section-eyebrow" aria-label="Breadcrumb">
				<a href={withBase('/work/')}>Work</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{data.context}</span>
			</nav>

			<header class="project-hero">
				<p class="project-hero__eyebrow">{data.eyebrow}</p>
				<h1>{data.title}</h1>
				<p class="project-hero__lead" set:html={rich(data.intro)} />
			</header>

			<div class="project-overview">
				<dl class="project-facts">
					{data.facts.map((fact) => <div><dt>{fact.label}</dt><dd set:html={rich(fact.value)} /></div>)}
				</dl>
				<figure class="project-hero__media">
					<Image src={card.image} alt={card.imageAlt} widths={[640, 960, 1280]} sizes="(min-width: 1000px) 26rem, 100vw" loading="eager" />
				</figure>
			</div>

			<!-- One summary: the results first, then the need and the key work. The role is in the lead and the facts above. -->
			<section class="project-glance" aria-labelledby="project-glance-title">
				<h2 id="project-glance-title">At a glance</h2>
				<div class="project-glance__results">
					<h3 class="project-glance__label">Results</h3>
					<ul class="project-numbers__grid">
						{data.metrics.map((metric) => (
							<li>
								<span class="project-numbers__value">{nb(metric.value)}</span>
								<span class="project-numbers__label" set:html={rich(metric.label)} />
							</li>
						))}
					</ul>
					{data.metricsNote && <p class="project-numbers__note">{plain(nb(data.metricsNote))}</p>}
				</div>
				<dl>
					{glance.map((item) => <div><dt class="project-glance__label">{item.label}</dt><dd set:html={rich(item.text)} /></div>)}
				</dl>
			</section>

			<div class="project-prose">
				<Content />
			</div>

			<nav class="project-next" aria-label="Next project">
				<span class="project-next__label">Next project</span>
				<a href={withBase(`/work/${nextCard.slug}/`)}>{nextCard.title}<span aria-hidden="true"> →</span></a>
			</nav>

			<div class="project-page__closing">
				<ContactCTA
					title="Working on a similar control problem?"
					body="Describe the system you are working on in a short message. I will reply with how this approach could apply to it and where I have solved similar problems."
					primaryHref={contactHref}
					primaryLabel="Discuss a technical problem"
					secondaryHref="/work/"
					secondaryLabel="All work"
					sourceSection={`${projectSource}-closing`}
					ctaIdPrefix={`${projectSource}-closing`}
				/>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.project-page { padding: 0 0 5rem; }
	.project-page__container { width: min(calc(100% - 5rem), var(--content-width)); margin: 0 auto; }
	.project-breadcrumb { display: flex; flex-wrap: wrap; gap: .45rem; padding: clamp(2rem, 4vw, 3rem) 0 0; color: var(--color-muted); }
	.project-breadcrumb a { color: var(--color-text); text-decoration: none; }
	.project-breadcrumb a:hover, .project-breadcrumb a:focus-visible { color: var(--color-link); text-decoration: underline; text-underline-offset: .2em; }

	.project-hero { display: grid; gap: 1rem; padding: 1.25rem 0 clamp(1.75rem, 3vw, 2.25rem); }
	.project-hero__eyebrow { margin: 0; color: var(--color-muted); font-family: var(--font-sans); font-size: var(--type-eyebrow-size); font-weight: var(--type-eyebrow-weight); letter-spacing: var(--type-eyebrow-tracking); line-height: var(--type-eyebrow-line); text-transform: none; }
	.project-hero h1 { max-width: 28ch; margin: 0; font-size: clamp(2.2rem, 3.6vw, 3.3rem); font-weight: 600; letter-spacing: -.03em; line-height: 1.05; text-wrap: balance; }
	.project-hero__lead { max-width: none; margin: 0; font-size: 1.1rem; line-height: 1.7; }
	/* Facts beside the photo: the recruiter card. */
	.project-overview { display: grid; grid-template-columns: minmax(0, 1fr) clamp(15rem, 40%, 24rem); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; margin: 0 0 clamp(2.5rem, 5vw, 3.5rem); }
	.project-hero__media { width: 100%; aspect-ratio: 4 / 3; margin: 0; overflow: hidden; border-radius: var(--radius); background: var(--color-surface-soft); }
	.project-hero__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.project-page :global(strong) { color: var(--color-text); font-weight: 700; }

	/* Lines only between the main sections: header and overview, at a glance, body. */
	.project-facts { display: grid; gap: .7rem; margin: 0; }
	.project-facts div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; }
	.project-facts dt, .project-glance__label, .project-next__label { margin: 0; color: var(--color-muted); font-family: var(--font-mono); font-size: .85rem; font-weight: 600; letter-spacing: 0; line-height: 1.5; text-transform: none; }
	.project-facts dt { padding-top: .2rem; }
	.project-facts dd { max-width: none; margin: 0; font-size: .98rem; line-height: 1.55; }

	.project-glance, .project-prose { padding-top: clamp(2rem, 4vw, 2.75rem); border-top: 1px solid var(--color-border); }
	.project-glance { display: grid; gap: 1.75rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
	.project-glance__results { display: grid; gap: .9rem; }
	.project-glance h2, .project-prose :global(h2) { max-width: 30ch; font-size: clamp(1.35rem, 2vw, 1.7rem); font-weight: 600; letter-spacing: -.03em; line-height: 1.15; text-wrap: balance; }
	.project-glance h2 { margin: 0; }
	.project-numbers__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1.5rem 2rem; margin: 0; padding: 0; list-style: none; }
	.project-numbers__grid li { display: grid; grid-template-rows: auto 1fr; gap: .35rem; }
	.project-numbers__value { justify-self: start; color: var(--color-text); font-family: var(--font-sans); font-size: clamp(1.5rem, 2.2vw, 1.85rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.15; background: var(--mark-band); }
	.project-numbers__label { font-size: .95rem; line-height: 1.5; }
	.project-numbers__note { max-width: none; margin: 0; color: var(--color-muted); font-size: .9rem; font-style: italic; line-height: 1.6; }

	.project-glance dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 3rem; margin: 0; }
	.project-glance dl div { display: grid; gap: .4rem; align-content: start; }
	.project-glance dd { margin: 0; font-size: 1rem; line-height: 1.6; }

	/* Centred reading column, as in an article; figures and tables share its width. Full width on mobile. */
	.project-prose { --prose-width: 100%; display: grid; grid-template-columns: minmax(0, var(--prose-width)); justify-content: center; }
	.project-prose > :global(h2:first-child) { margin-top: 0; }
	.project-prose :global(h2) { margin: clamp(2.5rem, 5vw, 3.5rem) 0 1rem; }
	@media (min-width: 861px) { .project-prose :global(h2) { max-width: none; text-wrap: pretty; } }
	.project-prose :global(h3) { margin: 2rem 0 .75rem; font-size: 1.15rem; font-weight: 600; line-height: 1.3; }
	.project-prose :global(p), .project-prose :global(li) { font-size: 1.06rem; line-height: 1.72; }
	.project-prose :global(p) { margin: 0 0 1.1rem; }
	.project-prose :global(ul), .project-prose :global(ol) { display: grid; gap: .6rem; margin: 0 0 1.25rem; padding-left: 1.2rem; }
	.project-prose :global(a) { color: var(--color-link); text-underline-offset: .18em; }
	.project-prose :global(a:hover), .project-prose :global(a:focus-visible) { color: var(--color-link-hover); }
	.project-prose :global(figure), .project-prose :global(table) { width: 100%; }
	.project-prose :global(figure) { margin: 2rem 0; }
	.project-prose :global(figure img) { display: block; width: 100%; height: auto; background: #fff; }
	.project-prose :global(figcaption) { margin: .75rem 0 0; color: var(--color-muted); font-size: .9rem; line-height: 1.55; }
	.project-prose :global(table) { margin: 0 0 1.5rem; border-collapse: collapse; font-size: .95rem; }
	.project-prose :global(th), .project-prose :global(td) { padding: .55rem .75rem .55rem 0; border-bottom: 1px solid var(--color-border-soft); text-align: left; vertical-align: top; }
	.project-prose :global(th) { font-weight: 700; }
	.project-prose :global(p:last-child em:only-child) { color: var(--color-muted); font-size: .92rem; }

	.project-next { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: .35rem .75rem; margin-top: clamp(2rem, 4vw, 3rem); font-size: .95rem; }
	.project-next a { color: var(--color-link); font-weight: 600; text-underline-offset: .2em; }
	.project-next a:hover, .project-next a:focus-visible { color: var(--color-link-hover); }
	.project-page__closing { padding-top: clamp(1.75rem, 3vw, 2.5rem); }

	@media (max-width: 860px) {
		.project-overview { grid-template-columns: 1fr; }
		.project-hero__media { grid-row: 1; max-width: 34rem; }
	}
	@media (max-width: 720px) {
		.project-page__container { width: min(calc(100% - 32px), var(--content-width)); }
		.project-hero h1 { font-size: clamp(1.9rem, 8.5vw, 2.3rem); }
		.project-hero__lead, .project-prose :global(p), .project-prose :global(li) { font-size: 1.02rem; }
		.project-facts div { grid-template-columns: 1fr; gap: .1rem; }
		.project-facts { gap: .8rem; }
		.project-glance dl { grid-template-columns: 1fr; gap: 1.25rem; }
		.project-numbers__grid { grid-template-columns: 1fr; gap: 1rem; }
		.project-prose { --prose-width: 100%; }
	}
</style>
