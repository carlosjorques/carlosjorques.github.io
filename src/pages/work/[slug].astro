---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const projectSource = `project-${project.id}`;
const contactHref = `/contact/?context=technical&source=${projectSource}#message-title`;
const withBase = (href: string) => `${import.meta.env.BASE_URL}${href.replace(/^\//, '')}`;
const displayMetricLabel = (label: string) => (label === 'Controler accuracy' ? 'Controller accuracy' : label);
---

<BaseLayout title={`${data.title} | Work`} description={data.description}>
	<article class="project-page">
		<div class="project-page__container">
			<nav class="project-breadcrumb section-eyebrow" aria-label="Breadcrumb">
				<a href={withBase('/work/')}>Work</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{data.context}</span>
			</nav>

			<section class="project-hero" aria-labelledby="project-title">
				<div class="project-hero__layout">
					<div class="project-hero__copy">
						<p class="project-hero__project">{data.title}</p>
						<h1 id="project-title">{data.heroTitle ?? data.title}</h1>
						<p class="project-hero__lead">{data.overviewDescription ?? data.description}</p>
						<dl class="project-hero__meta">
							<div><dt>Organization</dt><dd>{data.company}</dd></div>
							{data.deliveryContext && <div><dt>Delivery</dt><dd>{data.deliveryContext}</dd></div>}
							<div><dt>Carlos's role</dt><dd>{data.role}</dd></div>
							<div><dt>Focus</dt><dd>{data.tags.join(' · ')}</dd></div>
						</dl>
					</div>
					<figure class="project-hero__media">
						<Image src={data.image} alt={data.imageAlt} widths={[720, 1080, 1440]} sizes="(min-width: 900px) 34vw, 100vw" />
					</figure>
				</div>
			</section>

			<section class="project-brief" aria-labelledby="project-brief-title">
				<h2 id="project-brief-title" class="project-brief__label section-eyebrow">At a glance</h2>
				<div class="project-brief__grid">
					<div><h3>Challenge</h3><p>{data.objective}</p></div>
					<div><h3>Responsibility</h3><p>{data.roleScope}</p></div>
					<div><h3>Implementation scope</h3><p>{data.contribution}</p></div>
					<div>
						<h3>Selected context</h3>
						<dl class="project-brief__metrics">
							{data.metrics.map((metric) => <div><dt>{displayMetricLabel(metric.label)}</dt><dd>{metric.value}</dd></div>)}
						</dl>
					</div>
				</div>
			</section>

			<div class="project-sections">
				<section class="editorial-section" aria-labelledby="project-context">
					<div class="section-rail">Context</div>
					<div class="story-block">
						<h2 id="project-context">{data.constraintsTitle ?? 'Engineering context and constraints'}</h2>
						<p>{data.constraints}</p>
						{data.risks && <p class="story-block__muted"><strong>Failure modes to manage:</strong> {data.risks}</p>}
					</div>
				</section>

				<section class="editorial-section" aria-labelledby="project-ownership">
					<div class="section-rail">Ownership</div>
					<div class="story-block">
						<h2 id="project-ownership">{data.roleScopeTitle ?? 'Ownership and collaboration'}</h2>
						{data.collaborators && <p><strong>Collaboration:</strong> {data.collaborators}</p>}
						<div class="project-subsection">
							<h3>Methods in scope</h3>
							<ul class="tag-list" aria-label="Methods and technologies">{data.toolsAndMethods.map((tool) => <li class="tag">{tool}</li>)}</ul>
						</div>
					</div>
				</section>

				<section class="editorial-section" aria-labelledby="project-decisions">
					<div class="section-rail">Decisions</div>
					<div class="story-block">
						<h2 id="project-decisions">{data.processTitle ?? 'Approach and key decisions'}</h2>
						<div class="project-subsection">
							<h3>How the work progressed</h3>
							<p>{data.process}</p>
						</div>
						<div class="project-subsection">
							<h3>Decisions that shaped the work</h3>
							<p>{data.decisions}</p>
						</div>
					</div>
				</section>

				<section class="editorial-section" aria-labelledby="project-implementation">
					<div class="section-rail">Implementation</div>
					<div class="story-block">
						<h2 id="project-implementation">{data.deliverablesTitle ?? 'Implementation and validation'}</h2>
						<p>{data.deliverables}</p>
						{data.deliverableVisuals && <div class="project-gallery">{data.deliverableVisuals.map((visual, index) => <Image src={visual} alt={`${data.title} supporting visual ${index + 1}`} widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" />)}</div>}
					</div>
				</section>

				{data.references && data.references.length > 0 && <section class="editorial-section" aria-labelledby="research-references">
					<div class="section-rail">References</div>
					<div class="story-block">
						<h2 id="research-references">Public references for the research context</h2>
						<ul class="reference-list">
							{data.references.map((reference) => <li><a href={reference.href} target="_blank" rel="noopener noreferrer">{reference.label}</a><span>{reference.context}</span></li>)}
						</ul>
					</div>
				</section>}

				{data.reflection && <section class="editorial-section" aria-labelledby="project-takeaway">
					<div class="section-rail">Takeaway</div>
					<div class="story-block"><h2 id="project-takeaway">{data.reflectionTitle ?? 'Engineering takeaway'}</h2><p>{data.reflection}</p></div>
				</section>}
			</div>

			<div class="project-page__closing">
				<ContactCTA
					title="Discuss a related engineering problem"
					body="Share the system, role, or technical question you are considering. I can point to the relevant project and compare the constraints with you."
					primaryHref={contactHref}
					primaryLabel="Discuss a similar problem"
					secondaryHref="/work/"
					secondaryLabel="Back to project work"
					sourceSection={`${projectSource}-closing`}
					ctaIdPrefix={`${projectSource}-closing`}
				/>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.project-page { padding: 0 0 5rem; }
	.project-page__container { width: min(calc(100% - 5rem), var(--content-width)); margin: 0 auto; }
	.project-breadcrumb { display: flex; flex-wrap: wrap; gap: .45rem; padding: clamp(2rem, 4vw, 3rem) 0 0; color: var(--color-muted); }
	.project-breadcrumb a { color: var(--color-text); text-decoration: none; }
	.project-breadcrumb a:hover, .project-breadcrumb a:focus-visible { color: var(--color-link); text-decoration: underline; text-underline-offset: .2em; }
	.project-hero { padding: 1rem 0 clamp(3.5rem, 7vw, 6rem); }
	.project-hero__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
	.project-hero__copy { display: grid; gap: 1rem; align-content: start; }
	.project-hero__project { margin: 0; color: var(--color-accent-text); font-family: var(--font-mono); font-size: var(--type-eyebrow-size); font-weight: var(--type-eyebrow-weight); letter-spacing: var(--type-eyebrow-tracking); line-height: var(--type-eyebrow-line); text-transform: uppercase; }
	.project-hero h1 { max-width: 18ch; margin: 0; font-size: clamp(2.55rem, 4vw, 3.7rem); font-weight: 800; letter-spacing: -.05em; line-height: 1.02; text-wrap: balance; }
	.project-hero__lead { max-width: 62ch; margin: 0; color: var(--color-text); font-size: 1.08rem; line-height: 1.7; }
	.project-hero__media { order: 2; width: 100%; aspect-ratio: 4 / 3; margin: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface-soft); }
	.project-hero__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.project-hero__meta { display: grid; gap: .8rem; max-width: 62ch; margin: .35rem 0 0; }
	.project-hero__meta div { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: .75rem; align-items: baseline; }
	.project-hero__meta dt, .project-brief__grid h3, .section-rail, .project-subsection h3 { color: var(--color-muted); font-family: var(--font-mono); font-size: .78rem; font-weight: 600; letter-spacing: .08em; line-height: 1.4; text-transform: uppercase; }
	.project-hero__meta dd { margin: 0; font-size: .98rem; font-weight: 600; line-height: 1.45; }
	.project-brief { display: grid; gap: 1rem; padding: 0 0 clamp(2.25rem, 4vw, 3.5rem); }
	.project-brief__label { margin: 0; }
	.project-brief__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2.5rem; }
	.project-brief__grid > div { display: grid; gap: .45rem; align-content: start; padding-top: .8rem; border-top: 1px solid var(--color-border); }
	.project-brief__grid h3 { margin: 0; color: var(--color-accent-text); }
	.project-brief__grid p { margin: 0; font-size: .98rem; line-height: 1.58; }
	.project-brief__metrics { display: grid; gap: .5rem; margin: 0; }
	.project-brief__metrics div { display: grid; gap: .12rem; }
	.project-brief__metrics dt { color: var(--color-muted); font-family: var(--font-mono); font-size: .7rem; letter-spacing: .06em; line-height: 1.35; text-transform: uppercase; }
	.project-brief__metrics dd { margin: 0; font-size: .98rem; line-height: 1.45; }
	.project-sections { border-top: 1px solid var(--color-border); }
	.editorial-section { display: grid; grid-template-columns: 16rem minmax(0, 1fr); gap: 0; padding: 1rem 0 clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--color-border); scroll-margin-top: 2rem; }
	.editorial-section:first-child { border-top: 0; }
	.section-rail { padding-top: .25rem; }
	.story-block { display: grid; gap: .8rem; max-width: 62rem; }
	.story-block h2 { max-width: 28ch; margin: 0; font-size: clamp(1.25rem, 1.7vw, 1.55rem); font-weight: 800; line-height: 1.1; letter-spacing: -.035em; text-wrap: balance; }
	.story-block p { max-width: 68ch; margin: 0; font-size: 1.06rem; line-height: 1.7; }
	.story-block strong { color: var(--color-text); }
	.story-block__muted { color: var(--color-muted); }
	.project-subsection { display: grid; gap: .65rem; margin-top: .35rem; }
	.project-subsection h3 { margin: 0; }
	.tag-list { display: flex; flex-wrap: wrap; gap: .55rem; margin: 0; padding: 0; list-style: none; }
	.tag { display: inline-flex; align-items: center; border: 1px solid var(--color-border-soft); border-radius: var(--radius-pill); background: var(--color-surface-soft); padding: .18rem .45rem; color: var(--color-tag-text); font-family: var(--font-mono); font-size: var(--type-chip-size); line-height: var(--type-chip-line); }
	.project-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: .5rem; }
	.project-gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--color-border); border-radius: var(--radius); }
	.reference-list { display: grid; gap: .8rem; margin: 0; padding-left: 1.1rem; }
	.reference-list li { display: grid; gap: .2rem; }
	.reference-list span { color: var(--color-muted); font-size: .92rem; line-height: 1.5; }
	.project-page__closing { padding-top: 2rem; }
	@media (max-width: 1000px) { .project-hero__layout { grid-template-columns: 1fr; } .project-hero__media { order: 0; max-width: 34rem; } }
	@media (max-width: 720px) { .project-page__container { width: min(calc(100% - 32px), var(--content-width)); } .project-hero { padding-top: 2.8rem; } .project-hero h1 { max-width: 20ch; font-size: clamp(2.15rem, 10vw, 2.55rem); line-height: 1.04; } .project-hero__lead, .story-block p { font-size: 1.04rem; } .project-brief__grid { grid-template-columns: 1fr; gap: 1rem; } .editorial-section { grid-template-columns: 1fr; gap: .9rem; } .project-hero__meta div { grid-template-columns: 1fr; gap: .15rem; } }
</style>
