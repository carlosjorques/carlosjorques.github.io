---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { SHOW_DRAFT_WRITING, getWritingArticles, seriesHref } from '../../data/writing';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
	const articles = await getWritingArticles();
	const entries = await getCollection('writing');
	return articles.map((article) => ({
		params: { slug: article.slug },
		props: { entry: entries.find((entry) => entry.id.replace(/\.md$/, '') === article.slug)!, article },
	}));
}

const { entry, article } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
// Set by src/plugins/rehype-split-references.mjs, which takes the section out of the body.
const references = remarkPluginFrontmatter.references as { title: string; html: string } | undefined;
const shortDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const articleSlug = article.slug;
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) =>
	href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')
		? href
		: `${normalizedBase}${href.replace(/^\//, '')}`;
const label = entry.data.draft && !SHOW_DRAFT_WRITING
	? 'Writing in preparation'
	: entry.data.publishDate.toLocaleDateString('en', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		});

const publishedDate = entry.data.publishDate.toISOString();
const metadata = [entry.data.category, entry.data.readingTime].filter(Boolean);
const relatedProject = article.relatedProject ? await getEntry('projects', article.relatedProject) : undefined;

const allArticles = await getWritingArticles();
const seriesParts = article.series
	? allArticles.filter((other) => other.series?.id === article.series!.id).sort((a, b) => a.series!.part - b.series!.part)
	: [];
const partIndex = seriesParts.findIndex((part) => part.slug === article.slug);
const previousPart = partIndex > 0 ? seriesParts[partIndex - 1] : undefined;
const nextPart = partIndex >= 0 ? seriesParts[partIndex + 1] : undefined;

// Related articles: shared topics count most, then the same project, then recency. Parts of the
// same series are left out, since the series navigation already links them.
const RELATED_MAX = 3;
const RELATED_FALLBACK = 2;
const isSeriesEntry = (other: (typeof allArticles)[number]) =>
	!other.series || !allArticles.some((part) => part.series?.id === other.series!.id && part.series.part < other.series!.part);
const relatedCandidates = allArticles
	.filter((other) => other.slug !== article.slug && (!article.series || other.series?.id !== article.series.id) && isSeriesEntry(other))
	.map((other) => ({
		other,
		score: other.topics.filter((topic) => article.topics.includes(topic)).length * 2
			+ (article.relatedProject && other.relatedProject === article.relatedProject ? 1 : 0),
	}))
	.sort((a, b) => b.score - a.score || b.other.date.valueOf() - a.other.date.valueOf());
const matched = relatedCandidates.filter(({ score }) => score > 0);
// Without a topic match, the newest articles are shown instead, so every article links onwards.
const relatedArticles = (matched.length > 0 ? matched.slice(0, RELATED_MAX) : relatedCandidates.slice(0, RELATED_FALLBACK))
	.map(({ other }) => other);
---

<Layout title={entry.data.title} description={entry.data.description}>
	<article class="writing-post">
		<header class="writing-post__hero" aria-labelledby="article-title">
			<div class="page-container writing-post__container">
				<p class="writing-post__category">{entry.data.category}</p>
				{article.series && (
					<p class="writing-post__series">
						Part {article.series.part} of <a href={seriesHref(article.series.id)}>{article.series.definition.title}</a>
					</p>
				)}
				<h1 id="article-title" class="hero-title">{entry.data.title}</h1>
				{entry.data.subtitle && <p class="writing-post__subtitle">{entry.data.subtitle}</p>}
				<p class="writing-post__lead">{entry.data.description}</p>
				<p class="writing-post__meta">
					<time datetime={publishedDate}>{label}</time>
					{metadata.map((item) => <span>{item}</span>)}
				</p>
				<ul class="tag-list writing-post__tags" aria-label="Article tags">
					{entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}
				</ul>
				{
					entry.data.heroImage && (
						<figure class="writing-post__hero-figure">
							<img src={withBase(entry.data.heroImage.src)} alt={entry.data.heroImage.alt} />
						</figure>
					)
				}
			</div>
		</header>

		<section class="writing-post__body" aria-label="Article content">
			<div class="page-container writing-post__container prose">
				<Content />
			</div>
		</section>

		{article.series && seriesParts.length > 1 && (
			<nav class="writing-post__series-nav" aria-label={`${article.series.definition.title}: other parts`}>
				<div class="page-container writing-post__container">
					<p class="writing-post__series-nav-head">
						Part {article.series.part} of {seriesParts.length} <span aria-hidden="true">&middot;</span> <a href={seriesHref(article.series.id)}>All parts of the series</a>
					</p>
					<div class="writing-post__series-nav-links">
						{previousPart ? (
							<a class="series-step series-step--prev" href={previousPart.href} rel="prev" data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-previous-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-series-nav">
								<span class="series-step__label"><span aria-hidden="true">←&nbsp;</span>Previous: Part {previousPart.series?.part}</span>
								<span class="series-step__title">{previousPart.title}</span>
							</a>
						) : <span />}
						{nextPart && (
							<a class="series-step series-step--next" href={nextPart.href} rel="next" data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-next-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-series-nav">
								<span class="series-step__label">Next: Part {nextPart.series?.part}<span aria-hidden="true">&nbsp;→</span></span>
								<span class="series-step__title">{nextPart.title}</span>
							</a>
						)}
					</div>
				</div>
			</nav>
		)}

		<footer class="writing-post__footer">
			<div class="page-container writing-post__container">
				<ContactCTA
					title="Want to compare notes?"
					body="If this article connects with a problem you are working on, send a message and I will reply with my view on the reasoning and the trade-offs."
					primaryHref="/contact/?context=technical&source=writing#message-title"
					primaryLabel="Discuss this topic"
					secondaryHref="writing/"
					secondaryLabel="Read more writing"
					sourceSection="writing-article"
					ctaIdPrefix="writing-article"
				/>
			</div>
		</footer>

		{(relatedProject || relatedArticles.length > 0) && (
			<section class="writing-post__related" aria-labelledby="article-related-title">
				<div class="page-container writing-post__container">
					<h2 id="article-related-title">Related content</h2>
					<ul class="writing-post__related-list" role="list">
						{relatedProject && (
							<li>
								<a
									href={withBase(`work/${relatedProject.id}/`)}
									data-analytics-event="related_proof_click"
									data-cta-id={`article-${articleSlug}-related-project-${relatedProject.id}`}
									data-cta-placement="writing-article"
									data-cta-intent="proof"
									data-source-section="article-related-content"
									data-destination={withBase(`work/${relatedProject.id}/`)}
								>{relatedProject.data.title}</a>
								<span class="writing-post__related-meta">Project</span>
							</li>
						)}
						{relatedArticles.map((other) => (
							<li>
								<a
									href={other.href}
									data-analytics-event="writing_article_click"
									data-cta-id={`article-${articleSlug}-related-${other.slug}`}
									data-cta-placement="writing-article"
									data-cta-intent="authority"
									data-source-section="article-related-content"
								>{other.title}{other.series && <span class="writing-post__related-context"> · Part {other.series.part} of {other.series.definition.title}</span>}</a>
								<time class="writing-post__related-meta" datetime={other.dateIso}>{shortDate.format(other.date)}</time>
							</li>
						))}
					</ul>
				</div>
			</section>
		)}

		{references && (
			<section class="writing-post__related writing-post__references" aria-labelledby="article-references-title">
				<div class="page-container writing-post__container">
					<h2 id="article-references-title">{references.title}</h2>
					<div class="writing-post__references-body" set:html={references.html} />
				</div>
			</section>
		)}
	</article>

</Layout>

<style>
	.writing-post :global(.katex-display) {
		overflow-x: auto;
		overflow-y: hidden;
		padding-block: .25rem;
	}

	.writing-post {
		background: var(--color-page);
		overflow-x: clip;
	}

	.writing-post .writing-post__container {
		box-sizing: border-box;
		width: min(calc(100% - 5rem), var(--content-width));
		max-width: 100%;
		margin-inline: auto;
	}

	.writing-post__hero {
		border-bottom: 1px solid var(--color-border-soft);
		padding-block: clamp(3rem, 5vw, 4.6rem) clamp(1.55rem, 3vw, 2.25rem);
	}

	.writing-post__hero .writing-post__container {
		display: grid;
		gap: 1rem;
	}

        .writing-post__category {
                max-width: 100%;
                margin: 0;
                color: var(--color-accent-text);
		font-family: var(--font-mono);
		font-size: var(--type-eyebrow-size);
		font-weight: var(--type-eyebrow-weight);
		letter-spacing: var(--type-eyebrow-tracking);
                line-height: var(--type-eyebrow-line);
                text-transform: uppercase;
                overflow-wrap: anywhere;
			color: var(--color-muted);
			font-size: .82rem;
			font-weight: 600;
			letter-spacing: .08em;
			line-height: 1.4;
        }

	.writing-post__series-nav { padding-top: clamp(2.5rem, 5vw, 3.5rem); }
	.writing-post__series-nav-head { margin: 0 0 1rem; color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-chip-size); letter-spacing: var(--type-chip-tracking); line-height: 1.4; text-transform: uppercase; }
	.writing-post__series-nav-head a { color: var(--color-link); text-underline-offset: .2em; }
	.writing-post__series-nav-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
	.series-step { display: grid; gap: .3rem; align-content: start; color: inherit; text-decoration: none; }
	.series-step--next { grid-column: 2; text-align: right; }
	.series-step__label { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-chip-size); letter-spacing: var(--type-chip-tracking); text-transform: uppercase; }
	.series-step__title { color: var(--color-text); font-weight: 600; line-height: 1.35; }
	.series-step:hover .series-step__title,
	.series-step:focus-visible .series-step__title { color: var(--color-link); text-decoration: underline; text-underline-offset: .2em; }
	.series-step:focus-visible { outline: 2px solid var(--color-link); outline-offset: 4px; }
	@media (max-width: 640px) {
		.writing-post__series-nav-links { grid-template-columns: 1fr; gap: .75rem; }
		.series-step--next { grid-column: 1; }
		.writing-post__series-nav-links > span:empty { display: none; }
	}

	.writing-post__series { max-width: 100%; margin: 0; color: var(--color-muted); font-size: .95rem; line-height: 1.5; }
	.writing-post__series a { color: var(--color-link); text-decoration-thickness: 1px; text-underline-offset: .2em; }
	.writing-post__series a:hover,
	.writing-post__series a:focus-visible { color: var(--color-link-hover); }

	.writing-post .hero-title {
		max-width: min(100%, 20ch);
		margin: 0;
		font-size: clamp(2.6rem, 3.8vw, 3.5rem);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.05em;
		hyphens: auto;
		overflow-wrap: normal;
		word-break: normal;
	}

	.writing-post__lead {
		max-width: 820px;
		width: 100%;
		color: var(--color-body-text);
		font-size: clamp(1rem, 1.15vw, 1.12rem);
		font-weight: 400;
		letter-spacing: var(--type-body-tracking);
		line-height: 1.55;
		overflow-wrap: anywhere;
	}

	.writing-post__subtitle {
		max-width: 760px;
		width: 100%;
		color: var(--color-text);
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 2.4vw, 2.2rem);
		font-weight: 500;
		letter-spacing: -0.035em;
		line-height: 1.08;
		overflow-wrap: anywhere;
	}

	.writing-post__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.7rem;
		min-width: 0;
		max-width: 100%;
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: var(--type-meta-weight);
		letter-spacing: var(--type-meta-tracking);
		line-height: var(--type-meta-line);
		text-transform: uppercase;
		overflow-wrap: anywhere;
	}

	.writing-post__meta time,
	.writing-post__meta span {
		min-width: 0;
		max-width: 100%;
		overflow-wrap: anywhere;
	}

	.writing-post__meta span::before {
		content: '/';
		margin-right: 0.7rem;
		color: var(--color-border);
	}

        .writing-post__tags {
                gap: 0.35rem;
                min-width: 0;
                max-width: 100%;
                padding-left: 0;
        }

	.writing-post__tags .tag {
		max-width: 100%;
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.writing-post__hero-figure {
		margin: clamp(1.3rem, 3vw, 2rem) 0 0;
		overflow: hidden;
		border: 1px solid var(--color-border-soft);
		border-radius: var(--radius);
		background: var(--color-card-bg);
	}

        .writing-post__hero-figure img {
                display: block;
                width: 100%;
                aspect-ratio: 16 / 7;
                object-fit: cover;
	}

	.writing-post__body {
		padding-block: clamp(2.4rem, 5vw, 3.6rem);
	}

	.writing-post__body :global(.prose) {
		max-width: 100%;
		width: 100%;
		overflow-wrap: anywhere;
	}

	.writing-post__body :global(.prose > * + *) {
		margin-top: 1.1rem;
	}

	.writing-post__body :global(.prose h2) {
		margin-top: clamp(1.8rem, 4vw, 2.6rem);
		max-width: none;
		color: var(--color-text);
		font-size: clamp(1.35rem, 1.8vw, 1.72rem);
		letter-spacing: -0.03em;
		line-height: 1.12;
		overflow-wrap: normal;
	}

	.writing-post__body :global(.prose h3) {
		margin-top: clamp(1.35rem, 3vw, 1.85rem);
		max-width: none;
		color: var(--color-text);
		font-size: clamp(1.12rem, 1.35vw, 1.28rem);
		letter-spacing: -0.02em;
		line-height: 1.15;
		overflow-wrap: normal;
	}

	.writing-post__body :global(.prose p),
	.writing-post__body :global(.prose li) {
		color: var(--color-body-text);
		font-size: clamp(0.95rem, 0.92vw, 1.02rem);
		line-height: 1.65;
		overflow-wrap: anywhere;
	}

	.writing-post__body :global(.prose a) {
		color: var(--color-link);
		font-weight: 700;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.writing-post__body :global(.prose a:hover),
	.writing-post__body :global(.prose a:focus-visible) {
		color: var(--color-link-hover);
	}

        .writing-post__body :global(.article-callout),
        .writing-post__body :global(.metric-card),
        .writing-post__body :global(.article-figure),
        .writing-post__body :global(.article-cta) {
                box-sizing: border-box;
                min-width: 0;
                max-width: min(100%, calc(100vw - 48px));
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius);
		background: var(--color-card-bg);
		overflow-wrap: anywhere;
	}

	.writing-post__body :global(.article-callout) {
		display: grid;
		gap: 0.85rem;
		margin-block: clamp(1.4rem, 3vw, 2rem);
		padding: clamp(1rem, 2.6vw, 1.4rem);
	}

	.writing-post__body :global(.article-callout h2),
	.writing-post__body :global(.article-callout h3) {
		margin: 0;
		max-width: none;
		font-size: clamp(1.12rem, 1.45vw, 1.32rem);
		letter-spacing: -0.02em;
		line-height: 1.1;
		overflow-wrap: normal;
	}

	.writing-post__body :global(.article-callout ul) {
		display: grid;
		gap: 0.55rem;
		margin: 0;
		padding-left: 1.2rem;
	}

	.writing-post__body :global(.article-callout li) {
		margin: 0;
	}

	.writing-post__body :global(.process-list) {
		display: grid;
		gap: 0.65rem;
		margin-block: clamp(1.2rem, 3vw, 1.8rem);
		padding: 0;
		list-style: none;
		counter-reset: process-step;
	}

	.writing-post__body :global(.process-list li) {
		counter-increment: process-step;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.75rem;
		align-items: start;
		margin: 0;
		border: 1px solid var(--color-border-soft);
		border-radius: var(--radius);
		background: var(--color-card-bg);
		padding: 0.85rem 1rem;
	}

	.writing-post__body :global(.process-list li::before) {
		content: counter(process-step, decimal-leading-zero);
		display: inline-grid;
		place-items: center;
		min-width: 2.35rem;
		border-radius: calc(var(--radius) * 0.5);
		background: var(--color-text);
		color: var(--color-page);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: 750;
		letter-spacing: 0;
		line-height: 1;
		padding: 0.42rem 0.46rem;
	}

	.writing-post__body :global(.metric-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
		gap: 0.75rem;
		margin-block: clamp(1.2rem, 3vw, 1.8rem);
	}

	.writing-post__body :global(.metric-card) {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding: clamp(0.95rem, 2.4vw, 1.2rem);
	}

	.writing-post__body :global(.metric-card strong) {
		color: var(--color-accent-text);
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 3vw, 2.35rem);
		font-weight: 600;
		letter-spacing: -0.055em;
		line-height: 0.98;
	}

	.writing-post__body :global(.metric-card span) {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: var(--type-chip-weight);
		letter-spacing: var(--type-chip-tracking);
		line-height: var(--type-chip-line);
		text-transform: uppercase;
	}

	.writing-post__body :global(.comparison-table) {
		margin-block: clamp(1.4rem, 3vw, 2rem);
		overflow-x: auto;
		border: 1px solid var(--color-border-soft);
		border-radius: var(--radius);
		background: var(--color-card-bg);
	}

	.writing-post__body :global(.comparison-table table) {
		width: 100%;
		min-width: 680px;
		border-collapse: collapse;
	}

	.writing-post__body :global(.comparison-table th),
	.writing-post__body :global(.comparison-table td) {
		border-bottom: 1px solid var(--color-border-soft);
		padding: 0.85rem 1rem;
		text-align: left;
		vertical-align: top;
	}

	.writing-post__body :global(.comparison-table th) {
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: 750;
		letter-spacing: 0;
		line-height: var(--type-chip-line);
		text-transform: uppercase;
	}

	.writing-post__body :global(.comparison-table td) {
		color: var(--color-body-text);
		font-size: var(--type-compact-size);
		line-height: var(--type-compact-line);
	}

	.writing-post__body :global(.comparison-table tr:last-child th),
	.writing-post__body :global(.comparison-table tr:last-child td) {
		border-bottom: 0;
	}

	.writing-post__body :global(.article-figure) {
		margin-block: clamp(1.5rem, 4vw, 2.4rem);
		overflow: hidden;
	}

        .writing-post__body :global(.article-figure img) {
                display: block;
                width: 100%;
                background: var(--color-surface-soft);
	}

	.writing-post__body :global(.article-figure figcaption) {
		border-top: 1px solid var(--color-border-soft);
		color: var(--color-muted);
		font-size: var(--type-compact-size);
		line-height: var(--type-compact-line);
		padding: 0.85rem 1rem 1rem;
	}

	.writing-post__body :global(.image-placeholder__frame) {
		display: grid;
		place-items: center;
		min-height: clamp(13rem, 32vw, 20rem);
		padding: clamp(1.1rem, 3vw, 1.6rem);
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--color-surface-soft) 78%, transparent), transparent),
			var(--color-card-bg);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-chip-size);
		font-weight: var(--type-chip-weight);
		letter-spacing: 0;
		line-height: var(--type-chip-line);
		text-align: center;
		text-transform: uppercase;
	}

	.writing-post__body :global(.article-cta) {
		display: grid;
		gap: 0.8rem;
		margin-top: clamp(2rem, 4vw, 3rem);
		padding: clamp(1rem, 2.6vw, 1.4rem);
	}

	.writing-post__body :global(.article-cta h2) {
