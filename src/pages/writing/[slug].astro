---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { SHOW_DRAFT_WRITING, getUpcomingParts, getWritingArticles, seriesHref } from '../../data/writing';
import { IDENTITY } from '../../data/identity';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
	const articles = await getWritingArticles();
	const entries = await getCollection('writing');
	return articles.map((article) => ({
		params: { slug: article.slug },
		props: { entry: entries.find((entry) => entry.id.replace(/\.md$/, '') === article.slug)!, article },
	}));
}

const { entry, article } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
// Set by src/plugins/rehype-split-references.mjs, which takes these sections out of the body.
const references = remarkPluginFrontmatter.references as { title: string; html: string } | undefined;
const appendix = remarkPluginFrontmatter.appendix as { title: string; html: string } | undefined;
const shortDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const articleSlug = article.slug;
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) =>
	href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')
		? href
		: `${normalizedBase}${href.replace(/^\//, '')}`;
const label = entry.data.draft && !SHOW_DRAFT_WRITING
	? 'Writing in preparation'
	: shortDate.format(entry.data.publishDate);

const publishedDate = entry.data.publishDate.toISOString();
const updatedDate = entry.data.updatedDate && entry.data.updatedDate > entry.data.publishDate ? entry.data.updatedDate : undefined;
const pageTitle = article.title;
// Contents index: the h2 sections of the body, then the sections split out after the CTA.
const contents = [
	...headings.filter((heading) => heading.depth === 2).map((heading) => ({ id: heading.slug, label: heading.text })),
	...(appendix ? [{ id: 'article-appendix-title', label: appendix.title }] : []),
	...(references ? [{ id: 'article-references-title', label: references.title }] : []),
];
const showContents = contents.length >= 4;
// Long articles get a shortcut from the header to their closing section, so a reader can see the
// result before deciding to read the whole piece.
const summaryHeading = headings.find((heading) => heading.depth === 2 && /summary|conclusion/i.test(heading.text));
const summaryMinutes = parseInt(entry.data.readingTime ?? '', 10);
const showSummaryLink = Boolean(summaryHeading) && (Number.isNaN(summaryMinutes) || summaryMinutes >= 10);
// The key figure closes the lead as a bold hook sentence.
const keyFigure = entry.data.keyFigure;
const socialImage = entry.data.socialImage;
const site = Astro.site ?? Astro.url.origin;
const absolute = (path: string) => new URL(path, site).toString();
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: article.title,
	description: entry.data.description,
	datePublished: entry.data.publishDate.toISOString().slice(0, 10),
	...(updatedDate ? { dateModified: updatedDate.toISOString().slice(0, 10) } : {}),
	inLanguage: 'en',
	url: absolute(Astro.url.pathname),
	mainEntityOfPage: absolute(Astro.url.pathname),
	keywords: entry.data.tags.join(', '),
	...(entry.data.readingTime ? { timeRequired: `PT${parseInt(entry.data.readingTime, 10)}M` } : {}),
	...(socialImage ? { image: absolute(socialImage.src) } : {}),
	author: { '@type': 'Person', '@id': absolute('/#person'), name: IDENTITY.name, url: absolute('/about/') },
	publisher: { '@id': absolute('/#person') },
	...(article.series ? {
		isPartOf: { '@type': 'CreativeWorkSeries', name: article.series.definition.title, url: absolute(seriesHref(article.series.id)) },
		position: article.series.part,
	} : {}),
};
const relatedProject = article.relatedProject ? await getEntry('projects', article.relatedProject) : undefined;

const allArticles = await getWritingArticles();
const seriesParts = article.series
	? allArticles.filter((other) => other.series?.id === article.series!.id).sort((a, b) => a.series!.part - b.series!.part)
	: [];
const partIndex = seriesParts.findIndex((part) => part.slug === article.slug);
const previousPart = partIndex > 0 ? seriesParts[partIndex - 1] : undefined;
const nextPart = partIndex >= 0 ? seriesParts[partIndex + 1] : undefined;
// Unpublished parts count in "Part X/N", and the first of them is announced after the last
// published part, without a link.
const upcomingParts = article.series
	? (await getUpcomingParts(allArticles)).filter((other) => other.series?.id === article.series!.id).sort((a, b) => a.series!.part - b.series!.part)
	: [];
const seriesTotal = seriesParts.length + upcomingParts.length;
const comingPart = !nextPart && partIndex === seriesParts.length - 1 ? upcomingParts[0] : undefined;
const monthYear = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });

// Related articles: shared topics count most, then the same project, then recency. Parts of the
// same series are left out, since the series navigation already links them.
const RELATED_MAX = 3;
const RELATED_FALLBACK = 2;
const isSeriesEntry = (other: (typeof allArticles)[number]) =>
	!other.series || !allArticles.some((part) => part.series?.id === other.series!.id && part.series.part < other.series!.part);
const relatedCandidates = allArticles
	.filter((other) => other.slug !== article.slug && (!article.series || other.series?.id !== article.series.id) && isSeriesEntry(other))
	.map((other) => ({
		other,
		score: other.topics.filter((topic) => article.topics.includes(topic)).length * 2
			+ (article.relatedProject && other.relatedProject === article.relatedProject ? 1 : 0),
	}))
	.sort((a, b) => b.score - a.score || b.other.date.valueOf() - a.other.date.valueOf());
const matched = relatedCandidates.filter(({ score }) => score > 0);
// Without a topic match, the newest articles are shown instead, so every article links onwards.
const relatedArticles = (matched.length > 0 ? matched.slice(0, RELATED_MAX) : relatedCandidates.slice(0, RELATED_FALLBACK))
	.map(({ other }) => other);
---

<Layout title={pageTitle} description={entry.data.description} ogType="article" ogImage={socialImage ? withBase(socialImage.src) : undefined} ogImageAlt={socialImage?.alt}>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
	<article class="writing-post" id="article-top">
		<header class="page-container writing-post__container writing-post__hero" aria-labelledby="article-title">
			<div class="writing-post__top">
				<p class="writing-post__eyebrow-line">
					<time datetime={publishedDate}>{label}</time>
					{updatedDate && <><span aria-hidden="true">·</span><span>Updated <time datetime={updatedDate.toISOString()}>{shortDate.format(updatedDate)}</time></span></>}
					{entry.data.readingTime && <><span aria-hidden="true">·</span><span>{entry.data.readingTime}</span></>}
					{article.series && <><span class="writing-post__sep-series" aria-hidden="true">·</span><span class="writing-post__eyebrow-series">Part {article.series.part}/{seriesTotal} of <a class="writing-post__eyebrow" href={seriesHref(article.series.id)} aria-label={`series: ${article.series.definition.title}`}>series</a></span></>}
				</p>
				{(previousPart || nextPart) ? (
					<span class="writing-post__series-top">
						{previousPart && <a href={previousPart.href} rel="prev" data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-top-previous-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-series-top"><span aria-hidden="true">←&nbsp;</span>Part {previousPart.series?.part}</a>}
						{nextPart && <a href={nextPart.href} rel="next" data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-top-next-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-series-top">Part {nextPart.series?.part}<span aria-hidden="true">&nbsp;→</span></a>}
					</span>
				) : (
					<a class="writing-post__all-top" href={withBase('writing/')} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-top-all-writing`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-header"><span aria-hidden="true">←&nbsp;</span>All writing</a>
				)}
			</div>
			<div class="writing-post__copy">
				<h1 id="article-title">{article.title}</h1>
				<p class="writing-post__lead">
					{entry.data.description}
					{article.series?.definition.partContext && (
						<span class="writing-post__lead-series"> Part of a <a href={seriesHref(article.series.id)} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-lead-series`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-header">series</a> {article.series.definition.partContext}.</span>
					)}
				</p>
				{keyFigure && (
					<p class="writing-post__hook">
						<span class="writing-post__hook-frame">{keyFigure.frame ?? 'In short'}</span>
						<strong>{keyFigure.value} {keyFigure.label}.</strong>
						{showSummaryLink && (
							<>&ensp;<a class="writing-post__hook-link" href={`#${summaryHeading!.slug}`} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-summary-shortcut`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-header">Skip to the {/summary/i.test(summaryHeading!.text) ? 'summary' : 'conclusion'} <span aria-hidden="true">↓</span></a></>
						)}
					</p>
				)}
				{showSummaryLink && !keyFigure && (
					<p class="writing-post__summary-link">
						<a href={`#${summaryHeading!.slug}`} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-summary-shortcut`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-header">Go to the {summaryHeading!.text.replace(/^\d+\.\s*/, '').toLowerCase()} <span aria-hidden="true">↓</span></a>
					</p>
				)}
				<p class="writing-post__author">
					By {IDENTITY.name}, {IDENTITY.primaryTitle}, with {IDENTITY.years} years of <a href={withBase('cv/')} data-analytics-event="related_proof_click" data-cta-id={`article-${articleSlug}-author-cv`} data-cta-placement="writing-article" data-cta-intent="proof" data-source-section="article-author">experience</a>. More <a href={withBase('about/')}>about me</a>
				</p>
				<ul class="tag-list writing-post__tags" aria-label="Article tags">
					{entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}
				</ul>
			</div>
			{
				entry.data.heroImage && (
					<figure class="writing-post__hero-figure">
						<img src={withBase(entry.data.heroImage.src)} alt={entry.data.heroImage.alt} />
					</figure>
				)
			}
		</header>

		<div class="page-container writing-post__container writing-post__grid">
			{showContents && (
				<div class="article-toc-col">
				<nav class="article-toc" aria-labelledby="article-toc-title" data-article-toc>
					<p id="article-toc-title" class="article-toc__title">Contents</p>
					<ol class="article-toc__list">
						{contents.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
					</ol>
					<p class="article-toc__nav">
						{previousPart && <a href={previousPart.href} rel="prev" aria-label={`Previous: Part ${previousPart.series?.part}, ${previousPart.title}`} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-toc-previous-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-toc"><span aria-hidden="true">←&nbsp;</span>Part {previousPart.series?.part}</a>}
						<a href="#top">Top <span aria-hidden="true">↑</span></a>
						{nextPart && <a href={nextPart.href} rel="next" aria-label={`Next: Part ${nextPart.series?.part}, ${nextPart.title}`} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-toc-next-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-toc">Part {nextPart.series?.part}<span aria-hidden="true">&nbsp;→</span></a>}
					</p>
				</nav>
				</div>
			)}

			<div class="writing-post__main">
				<section class="writing-post__body" aria-label="Article content">
					<div class="prose">
						<Content />
					</div>
				</section>
			</div>

				{article.series && seriesTotal > 1 && (
					<nav class="writing-post__series-nav" aria-label={`${article.series.definition.title}: other parts`}>
						<p class="writing-post__series-nav-head">
							Part {article.series.part} of {seriesTotal} <span aria-hidden="true">&middot;</span> <a href={seriesHref(article.series.id)}>All parts of the series</a>
						</p>
						<div class="writing-post__series-nav-links">
							{previousPart && (
								<a class="series-step series-step--prev" href={previousPart.href} rel="prev" data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-previous-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-series-nav">
									<span class="series-step__label"><span aria-hidden="true">←&nbsp;</span>Previous: Part {previousPart.series?.part}</span>
									<span class="series-step__title">{previousPart.title}</span>
								</a>
							)}
							{nextPart && (
								<a class="series-step series-step--next" href={nextPart.href} rel="next" data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-next-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-series-nav">
									<span class="series-step__label">Next: Part {nextPart.series?.part}<span aria-hidden="true">&nbsp;→</span></span>
									<span class="series-step__title">{nextPart.title}</span>
								</a>
							)}
							{comingPart && (
								<p class:list={['series-step', 'series-step--next', 'series-step--coming']}>
									<span class="series-step__label">Next: Part {comingPart.series?.part}, coming <time datetime={comingPart.dateIso.slice(0, 7)}>{monthYear.format(comingPart.date)}</time></span>
									<span class="series-step__title">{comingPart.title}</span>
								</p>
							)}
						</div>
					</nav>
				)}
		</div>

		<footer class="page-container writing-post__container writing-post__footer" data-article-end>
					<ContactCTA
						title="Working on a similar control problem?"
						body="Describe the system you are working on in a short message. I will reply with how this approach could apply to it and where I have solved similar problems."
						primaryHref="/contact/?context=technical&source=writing#message-title"
						primaryLabel="Discuss a technical problem"
						secondaryHref={relatedProject ? `work/${relatedProject.id}/` : 'work/'}
						secondaryLabel={relatedProject ? 'View the related project' : 'View work'}
						sourceSection="writing-article"
						ctaIdPrefix="writing-article"
					/>
		</footer>

		<div class="page-container writing-post__container writing-post__grid writing-post__after">
			<div class="writing-post__main">
				{(relatedProject || relatedArticles.length > 0) && (
					<section class="writing-post__related" aria-labelledby="article-related-title">
						<div class="writing-post__related-head">
							<h2 id="article-related-title">Related content</h2>
							<a class="writing-post__all" href={withBase('writing/')} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-all-writing`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-related-content">All articles <span aria-hidden="true">→</span></a>
						</div>
						<ul class="writing-post__related-list" role="list">
							{relatedProject && (
								<li>
									<a
										href={withBase(`work/${relatedProject.id}/`)}
										data-analytics-event="related_proof_click"
										data-cta-id={`article-${articleSlug}-related-project-${relatedProject.id}`}
										data-cta-placement="writing-article"
										data-cta-intent="proof"
										data-source-section="article-related-content"
										data-destination={withBase(`work/${relatedProject.id}/`)}
									>{relatedProject.data.title}</a>
									<span class="writing-post__related-meta">Project</span>
								</li>
							)}
							{relatedArticles.map((other) => (
								<li>
									<a
										href={other.href}
										data-analytics-event="writing_article_click"
										data-cta-id={`article-${articleSlug}-related-${other.slug}`}
										data-cta-placement="writing-article"
										data-cta-intent="authority"
										data-source-section="article-related-content"
									>{other.title}{other.series && <span class="writing-post__related-context"> · Part {other.series.part} of {other.series.definition.title}</span>}</a>
									<time class="writing-post__related-meta" datetime={other.dateIso}>{shortDate.format(other.date)}</time>
								</li>
							))}
						</ul>
					</section>
				)}

				{appendix && (
					<section class="writing-post__body writing-post__appendix" aria-labelledby="article-appendix-title">
						<div class="prose">
							<h2 id="article-appendix-title">{appendix.title}</h2>
							<Fragment set:html={appendix.html} />
						</div>
					</section>
				)}

				{references && (
					<section class="writing-post__related writing-post__references" aria-labelledby="article-references-title">
						<h2 id="article-references-title">{references.title}</h2>
						<div class="writing-post__references-body" set:html={references.html} />
					</section>
				)}

				<p class="writing-post__back"><a href="#top">Back to top <span aria-hidden="true">↑</span></a></p>
			</div>
		</div>

		<dialog class="figure-viewer" aria-label="Enlarged figure" data-figure-viewer>
			<button class="figure-viewer__close" type="button" data-figure-viewer-close>Close <span aria-hidden="true">✕</span></button>
			<div class="figure-viewer__frame"><img alt="" data-figure-viewer-img /></div>
			<p class="figure-viewer__caption" data-figure-viewer-caption></p>
		</dialog>

		{showContents && (
			<nav class="article-jump" aria-label="Article contents" data-article-jump>
				<details>
					<summary>Contents</summary>
					<div class="article-jump__panel">
						<ol>
							{contents.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
						</ol>
						<p class="article-jump__nav">
							{previousPart && <a href={previousPart.href} rel="prev" aria-label={`Previous: Part ${previousPart.series?.part}, ${previousPart.title}`} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-jump-previous-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-jump"><span aria-hidden="true">←&nbsp;</span>Part {previousPart.series?.part}</a>}
							<a href="#top">Top <span aria-hidden="true">↑</span></a>
							{nextPart && <a href={nextPart.href} rel="next" aria-label={`Next: Part ${nextPart.series?.part}, ${nextPart.title}`} data-analytics-event="writing_article_click" data-cta-id={`article-${articleSlug}-jump-next-part`} data-cta-placement="writing-article" data-cta-intent="authority" data-source-section="article-jump">Part {nextPart.series?.part}<span aria-hidden="true">&nbsp;→</span></a>}
						</p>
					</div>
				</details>
			</nav>
		)}
	</article>
</Layout>

<script>
	// Contents index: highlights the current section; the floating menu (narrow screens) stays
	// hidden while the article header is visible and closes on link click, outside click or Escape.
	const indexes = [...document.querySelectorAll<HTMLElement>('[data-article-toc], [data-article-jump]')];
	const links = indexes.flatMap((index) => [...index.querySelectorAll<HTMLAnchorElement>('ol a')]);
	const targets = [...new Set(links.map((link) => link.hash))]
		.map((hash) => document.getElementById(decodeURIComponent(hash.slice(1))))
		.filter((el): el is HTMLElement => el !== null);

	if (targets.length) {
		const setActive = () => {
			const line = innerHeight * 0.3;
			let current = '';
			targets.forEach((target) => {
				if (target.getBoundingClientRect().top <= line) current = `#${target.id}`;
			});
			links.forEach((link) => {
				if (current && link.hash === current) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			});
		};
		let ticking = false;
		addEventListener('scroll', () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				setActive();
				ticking = false;
			});
		}, { passive: true });
		setActive();
	}

	const jump = document.querySelector<HTMLElement>('[data-article-jump]');
	const jumpMenu = jump?.querySelector('details');
	const hero = document.querySelector('.writing-post__hero');
	const end = document.querySelector('[data-article-end]');
	if (jump && jumpMenu && hero) {
		// Hidden while the header is visible, and again from the contact block onwards.
		let heroVisible = true;
		let endReached = false;
		const update = () => {
			const hidden = heroVisible || endReached;
			jump.classList.toggle('is-hidden', hidden);
			if (hidden) jumpMenu.open = false;
		};
		update();
		new IntersectionObserver(([entry]) => {
			heroVisible = entry.isIntersecting;
			update();
		}).observe(hero);
		if (end) {
			new IntersectionObserver(([entry]) => {
				endReached = entry.isIntersecting || entry.boundingClientRect.top < 0;
				update();
			}).observe(end);
		}
		jump.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) jumpMenu.open = false;
		});
		document.addEventListener('click', (event) => {
			if (jumpMenu.open && !jump.contains(event.target as Node)) jumpMenu.open = false;
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && jumpMenu.open) {
				jumpMenu.open = false;
				jumpMenu.querySelector('summary')?.focus();
			}
		});
	}

	// Figure viewer: each article image opens full size in a dialog, with its caption below it.
	// Escape, the close button or a click outside the image closes it, and focus returns to the figure.
	const viewer = document.querySelector<HTMLDialogElement>('[data-figure-viewer]');
	const viewerImg = viewer?.querySelector<HTMLImageElement>('[data-figure-viewer-img]');
	const viewerCaption = viewer?.querySelector<HTMLElement>('[data-figure-viewer-caption]');
	if (viewer && viewerImg && viewerCaption && typeof viewer.showModal === 'function') {
		let opener: HTMLElement | undefined;
		document.querySelectorAll<HTMLImageElement>('.writing-post__body .article-figure img').forEach((img) => {
			const figure = img.closest('figure');
			const caption = figure?.querySelector('figcaption')?.textContent?.trim() ?? '';
			const number = caption.match(/^(Figure\s+\d+)/)?.[1];
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'figure-zoom';
			button.setAttribute('aria-label', `Enlarge ${number ?? 'figure'}`);
			img.replaceWith(button);
			button.append(img);
			button.addEventListener('click', () => {
				viewerImg.src = img.currentSrc || img.src;
				viewerImg.alt = img.alt;
				viewerCaption.textContent = caption;
				viewerCaption.hidden = !caption;
				viewer.showModal();
				opener = button;
			});
		});
		const close = () => viewer.close();
		viewer.querySelector('[data-figure-viewer-close]')?.addEventListener('click', close);
		viewer.addEventListener('click', (event) => {
			if (event.target !== viewerImg && !viewerCaption.contains(event.target as Node)) close();
		});
		viewer.addEventListener('close', () => {
