---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import WritingList from '../../components/writing/WritingList.astro';
import WritingPublicationList from '../../components/writing/WritingPublicationList.astro';
import WritingTopicFilter from '../../components/writing/WritingTopicFilter.astro';
import { IDENTITY } from '../../data/identity';
import { getUpcomingParts, getWritingArticles, groupWriting, seriesHref } from '../../data/writing';

// The filter only earns its space once the list is long enough to need it.
const FILTER_THRESHOLD = 8;
// Previous articles beyond this count stay behind "Show all" (with JavaScript only).
const PREVIOUS_VISIBLE = 10;

const withBase = (href: string) => `${import.meta.env.BASE_URL}${href.replace(/^\//, '')}`;
const articles = await getWritingArticles();
const { latest, years } = groupWriting(articles, await getUpcomingParts(articles));
const showFilter = articles.length >= FILTER_THRESHOLD;
const previousCount = years.reduce((sum, group) => sum + group.articles.length, 0);

const pageTitle = 'Writing on control for complex dynamic systems';
const pageDescription = 'Articles by Carlos Jorques on how control software for machines is designed and tested, and what it changes for the companies that build and operate them.';
const site = Astro.site ?? new URL(Astro.url.origin);
const absolute = (href: string) => new URL(href, site).toString();
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	'@id': absolute(withBase('/writing/')),
	url: absolute(withBase('/writing/')),
	name: pageTitle,
	description: pageDescription,
	author: { '@id': absolute('/#person') },
	inLanguage: 'en',
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: articles.filter((article) => !article.isDraft).map((article, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'BlogPosting',
				'@id': absolute(article.href),
				url: absolute(article.href),
				headline: article.fullTitle,
				description: article.description,
				datePublished: article.dateIso,
				author: { '@id': absolute('/#person') },
				...(article.series ? { isPartOf: { '@type': 'CreativeWorkSeries', name: article.series.definition.title, url: absolute(seriesHref(article.series.id)) } } : {}),
			},
		})),
	},
};
---


<BaseLayout title={pageTitle} description={pageDescription} ogImage="/images/og-writing.png" ogImageAlt="Writing by Carlos Jorques: notes on control software for complex dynamic systems.">
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<div class="writing-page">
		<section class="writing-hero" aria-labelledby="writing-title">
			<div class="writing-hero__top">
				<p class="writing-eyebrow">Writing</p>
				<a class="writing-rss" href={withBase('/rss.xml')}>RSS feed</a>
			</div>
			<div class="writing-hero__copy">
				<h1 id="writing-title">Notes on control software for complex dynamic systems.</h1>
				<p class="writing-hero__lead">Control software decides how a machine uses its energy and how it reacts when something goes wrong. In these articles I explain how that software is designed and tested, and what it changes for the companies that build and operate the machines.</p>
				<p class="writing-hero__author">By {IDENTITY.name}, {IDENTITY.primaryTitle}, with {IDENTITY.years} years of <a href={withBase('/cv/')} data-analytics-event="related_proof_click" data-cta-id="writing-hero-cv" data-cta-placement="writing-index" data-cta-intent="proof" data-source-section="writing-hero">experience</a>. More <a href={withBase('/about/')}>about me</a></p>
			</div>
		</section>

		{showFilter && <WritingTopicFilter articles={articles} />}

		{articles.length === 0 && <p class="writing-empty">The first articles are in preparation.</p>}

		{latest.length > 0 && (
			<section class="writing-section" aria-labelledby="latest-title" data-filter-group>
				<h2 id="latest-title" class="writing-section__title">Latest publications</h2>
				<WritingPublicationList publications={latest} />
			</section>
		)}

		{years.length > 0 && (
			<section class="writing-section" aria-labelledby="previous-title" data-filter-group data-show-all-scope>
				<h2 id="previous-title" class="writing-section__title">{latest.length > 0 ? 'Previous articles' : 'Articles'}</h2>
				<div id="previous-list">
					{years.map((group) => (
						<div class="writing-year" data-filter-group>
							<h3 class="writing-year__label">{group.year}</h3>
							<WritingList articles={group.articles} label="date" variant="compact" headingLevel={4} sourceSection="writing-previous" />
						</div>
					))}
				</div>
				{previousCount > PREVIOUS_VISIBLE && (
					<button class="writing-more" type="button" aria-controls="previous-list" aria-expanded="false" data-show-all={PREVIOUS_VISIBLE} hidden>
						Show all {previousCount} articles
					</button>
				)}
			</section>
		)}

		<p class="writing-empty" data-filter-empty hidden>No articles on this topic yet.</p>
	</div>

	<section class="section writing-closing" aria-label="Next steps">
		<div class="page-container">
			<ContactCTA
				title="Working on a similar control problem?"
				body="Describe the system you are working on in a short message. I will reply with my view and where I have solved similar problems."
				primaryHref="/contact/?context=technical&source=writing#message-title"
				primaryLabel="Discuss a technical problem"
				secondaryHref="/work/"
				secondaryLabel="View work"
				sourceSection="writing-closing"
				ctaIdPrefix="writing-closing"
			/>
		</div>
	</section>

	<script>
		// "Show all": without JavaScript every previous article stays visible.
		const scope = document.querySelector<HTMLElement>('[data-show-all-scope]');
		const button = scope?.querySelector<HTMLButtonElement>('[data-show-all]');
		if (scope && button) {
			const limit = Number(button.dataset.showAll);
			const items = Array.from(scope.querySelectorAll<HTMLElement>('[data-filter-item]'));
			const years = Array.from(scope.querySelectorAll<HTMLElement>('.writing-year'));
			const label = button.textContent?.trim() ?? 'Show all';
			items.slice(limit).forEach((item) => item.setAttribute('data-overflow', ''));
			years.forEach((year) => year.toggleAttribute('data-overflow', !year.querySelector('[data-filter-item]:not([data-overflow])')));

			let expanded = false;
			let filtered = false;
			const render = () => {
				scope.classList.toggle('is-collapsed', !expanded && !filtered);
				button.hidden = filtered;
				button.setAttribute('aria-expanded', String(expanded));
				button.textContent = expanded ? 'Show fewer' : label;
			};
			button.addEventListener('click', () => {
				expanded = !expanded;
				render();
				if (!expanded) button.scrollIntoView({ block: 'nearest' });
			});
			// While a topic is selected, every matching article is shown.
			document.addEventListener('writing-filter', (event) => {
				filtered = Boolean((event as CustomEvent<{ topic: string }>).detail.topic);
				render();
			});
			render();
		}
	</script>
</BaseLayout>

<style>
	.writing-page { width: min(calc(100% - 5rem), var(--content-width)); margin: 0 auto; padding: 0; }
	.writing-hero { padding: clamp(3rem, 5vw, 4.6rem) 0 0; border-bottom: 1px solid var(--color-border); }
	.writing-hero + :global(*) { margin-top: clamp(2rem, 4vw, 2.75rem); }
	.writing-hero__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
	.writing-eyebrow,
	.writing-rss { margin: 0; color: var(--color-muted); font-family: var(--font-mono); font-size: .82rem; font-weight: 600; letter-spacing: .08em; line-height: 1.4; text-transform: uppercase; }
	.writing-rss { font-weight: 400; text-decoration: none; }
	.writing-rss:hover,
	.writing-rss:focus-visible { color: var(--color-link); text-decoration: underline; text-underline-offset: .2em; }
	.writing-hero__copy { display: grid; gap: 1rem; align-content: start; margin: 1rem 0 4rem; }
	.writing-hero h1 { max-width: none; margin: 0; font-size: clamp(2.6rem, 3.8vw, 3.5rem); font-weight: 800; letter-spacing: -.05em; line-height: 1.02; }
	.writing-hero__lead { max-width: 52rem; margin: 0; color: var(--color-text); font-size: 1.08rem; line-height: 1.7; }
	.writing-hero__author { max-width: 52rem; margin: 0; color: var(--color-muted); font-size: .92rem; line-height: 1.55; }
	.writing-hero__author a { color: var(--color-link); text-decoration-thickness: 1px; text-underline-offset: .2em; }
	.writing-hero__author a:hover,
	.writing-hero__author a:focus-visible { color: var(--color-link-hover); }

	.writing-section + .writing-section { margin-top: clamp(3.5rem, 7vw, 5rem); }
	.writing-section__title { max-width: none; margin: 0 0 1.5rem; color: var(--color-text); font-family: var(--font-display); font-size: clamp(1.6rem, 2.6vw, 2.1rem); font-weight: var(--type-section-title-weight); letter-spacing: -.035em; line-height: 1.1; }
	.writing-year__label { max-width: none; margin: 0; color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-chip-size); font-weight: 400; letter-spacing: var(--type-chip-tracking); line-height: 1.4; text-transform: uppercase; }
	.writing-year + .writing-year { margin-top: 2rem; }
	.writing-year__label { margin-bottom: .5rem; }

	.writing-empty { margin: 0; color: var(--color-body-text); }
	.writing-more { margin-top: 1.5rem; border: 1px solid var(--color-border-soft); border-radius: 999px; background: transparent; padding: .5rem 1rem; color: var(--color-text); font-family: var(--font-mono); font-size: var(--type-chip-size); letter-spacing: var(--type-chip-tracking); line-height: 1.4; text-transform: uppercase; cursor: pointer; }
	.writing-more:hover { border-color: var(--color-border-strong); }
	.writing-more:focus-visible { outline: 2px solid var(--color-link); outline-offset: 3px; }
	.is-collapsed :global([data-overflow]) { display: none; }
	.writing-closing { padding-top: clamp(3rem, 6vw, 5rem); }

	@media (max-width: 720px) {
		.writing-hero { padding-top: 3rem; }
		.writing-hero__copy { margin-bottom: 2.5rem; }
		.writing-hero h1 { font-size: clamp(2.15rem, 10vw, 2.45rem); line-height: 1.04; }
	}
	@media (max-width: 640px) { .writing-page { width: min(calc(100% - 32px), var(--content-width)); } }
</style>
