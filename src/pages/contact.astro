---
import Layout from '../layouts/Layout.astro';
import { CONTACT_DESTINATIONS, IDENTITY } from '../data/identity';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) =>
	href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')
		? href
		: `${normalizedBase}${href.replace(/^\//, '')}`;

const linkedinHref = CONTACT_DESTINATIONS.linkedin;
const web3FormsAccessKey = '7f35453b-2e22-4022-bb4b-46573f04453b';
const validContactContexts = ['role', 'technical', 'collaboration'] as const;
const requestedContext = Astro.url.searchParams.get('context');
const contactContext = validContactContexts.find((context) => context === requestedContext);
const contactSource = Astro.url.searchParams.get('source')?.match(/^[a-z0-9-]+$/i)?.[0] ?? '';
const replyTime = 'two working days';
/** Example text in the message box for each topic; the script swaps it when the topic changes. */
const messageHints = {
	role: 'e.g. The role, the team and the system it works on.',
	technical: 'e.g. The system, what it has to do and the constraint that makes it hard.',
	collaboration: 'e.g. The idea, your part in it and what you would like from me.',
} as const;
const pageDescription = `Contact ${IDENTITY.name}, ${IDENTITY.primaryTitle}, about a role, a control problem in an embedded system or a collaboration. Reply within ${replyTime}.`;
const site = Astro.site ?? Astro.url.origin;
const contactPageLd = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: `Contact ${IDENTITY.name}`,
	description: pageDescription,
	url: new URL('/contact/', site).href,
	about: { '@id': new URL('/#person', site).href },
};
---

<Layout
	title={`Contact ${IDENTITY.name} | ${IDENTITY.primaryTitle}`}
	description={pageDescription}
	ogImage={withBase('/images/og-carlos-jorques.png')}
	ogImageAlt={`${IDENTITY.name}, ${IDENTITY.primaryTitle}: ${IDENTITY.brandStatement.toLowerCase()}.`}
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(contactPageLd)} />
	<section class="contact-hero" aria-labelledby="contact-title">
		<div class="page-container">
			<p class="section-eyebrow">Contact</p>
			<h1 id="contact-title" class="hero-title">Let’s talk.</h1>
			<p class="contact-hero__lead">I lead the development of embedded control software for complex dynamic systems, such as electric vehicles and autonomous machines. Send me a message below about a role, a control problem in your system or a collaboration, or connect on <a href={linkedinHref} target="_blank" rel="noopener noreferrer" data-analytics-event="linkedin_outbound_click" data-cta-id="contact-linkedin" data-cta-placement="contact-hero-copy" data-cta-intent="professional-profile" data-source-section="contact-hero" data-destination={linkedinHref}>LinkedIn</a>. My <a href={withBase(CONTACT_DESTINATIONS.cv)} download data-analytics-event="cv_pdf_download" data-cta-id="contact-hero-cv" data-cta-placement="contact-hero-copy" data-cta-intent="formal-proof" data-source-section="contact-hero" data-destination={withBase(CONTACT_DESTINATIONS.cv)}>CV</a> is also available as a PDF.</p>
			<p class="contact-hero__work">Recent work: thermal management control for <a href={withBase('/work/electric-truck-thermal-management/')} data-analytics-event="cta_click" data-cta-id="contact-hero-work-scania" data-cta-placement="contact-hero-copy" data-cta-intent="proof" data-source-section="contact-hero">Scania’s electric trucks</a> and speed control for <a href={withBase('/work/autonomous-hauler-propulsion-control/')} data-analytics-event="cta_click" data-cta-id="contact-hero-work-volvo" data-cta-placement="contact-hero-copy" data-cta-intent="proof" data-source-section="contact-hero">Volvo’s autonomous electric hauler</a>.</p>
			<p class="contact-hero__proof"><span class="contact-hero__proof-items"><span>{IDENTITY.years} years in vehicle control software</span><span>Based in {IDENTITY.location}</span><span class="contact-hero__proof-remote">Working remotely with international teams</span></span></p>
		</div>
	</section>

	<section class="section contact-content" aria-labelledby="message-title">
		<div class="page-container contact-content__inner">
			<form
				class="contact-form"
				action="https://api.web3forms.com/submit"
				method="POST"
				aria-labelledby="message-title"
				aria-describedby="form-intro privacy-note"
				data-contact-form
				data-contact-success-event="contact_form_submit"
				data-contact-success-cta-id="contact-web3forms-form"
				data-contact-success-placement="contact-form"
				data-contact-success-intent="contact"
				data-contact-success-source-section="contact-form"
				data-source-page={contactSource || undefined}
			>
				<input type="hidden" name="access_key" value={web3FormsAccessKey} />
				<input type="hidden" name="subject" value="Portfolio contact from Carlos Jorques website" />
				<input type="hidden" name="source_page" value={contactSource} data-source-page-field />
				<div class="contact-form__header">
					<h2 id="message-title">How can I help?</h2>
					<p id="form-intro" class="contact-note">A few lines on what you are working on are enough. I reply within {replyTime}.</p>
				</div>

					<div class="form-field">
						<label for="contact-name">Name <span aria-hidden="true">*</span></label>
						<input id="contact-name" name="name" type="text" autocomplete="name" placeholder="e.g. Alex Morgan" required aria-describedby="contact-name-error" />
						<p class="field-error" id="contact-name-error">Enter your name.</p>
					</div>

					<div class="form-field">
						<label for="contact-email">Email <span aria-hidden="true">*</span></label>
						<input id="contact-email" name="email" type="email" autocomplete="email" placeholder="e.g. alex@company.com" required aria-describedby="contact-email-error" />
						<p class="field-error" id="contact-email-error">Enter a valid email address.</p>
					</div>

					<fieldset class="form-field form-fieldset">
						<legend>What is it about?</legend>
						<div class="radio-group">
							<label><input type="radio" name="context" value="role" checked={contactContext === 'role' || !contactContext} /> A role</label>
							<label><input type="radio" name="context" value="technical" checked={contactContext === 'technical'} /> A technical problem</label>
							<label><input type="radio" name="context" value="collaboration" checked={contactContext === 'collaboration'} /> A collaboration</label>
						</div>
					</fieldset>

					<div class="form-field">
						<label for="contact-message">Message <span aria-hidden="true">*</span></label>
						<textarea id="contact-message" name="message" rows="8" placeholder={messageHints[contactContext ?? 'role']} data-hints={JSON.stringify(messageHints)} required aria-describedby="contact-message-error"></textarea>
						<p class="field-error" id="contact-message-error">Enter a message.</p>
					</div>

				<div class="contact-honeypot" aria-hidden="true">
					<label for="contact-botcheck">Leave this unchecked</label>
					<input id="contact-botcheck" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" />
				</div>

					<p class="contact-note" id="privacy-note">I will use your details only to reply to your message. Read the <a href={withBase('/privacy/')}>privacy notice</a>.</p>
					<button class="button primary" type="submit" aria-describedby="privacy-note">Send message</button>
					<p id="form-status" class="contact-note contact-status" role="status" aria-live="polite" tabindex="-1"></p>
					<p class="contact-note contact-fallback" id="contact-fallback" hidden>If it still fails, you can send me a message on <a href={linkedinHref} target="_blank" rel="noopener noreferrer" data-analytics-event="linkedin_outbound_click" data-cta-id="contact-fallback-linkedin" data-cta-placement="contact-form-failure" data-cta-intent="professional-profile" data-source-section="contact-form-failure" data-destination={linkedinHref}>LinkedIn</a>.</p>
					<p class="contact-note contact-next" id="contact-next" hidden>In the meantime, you can read about <a href={withBase('/work/')}>my work</a> or <a href={withBase('/writing/')}>my writing</a>.</p>
			</form>

		</div>
	</section>
</Layout>

<style>
	.contact-hero { padding:clamp(3rem,5vw,4.6rem) 0 0; }
	.contact-hero .page-container,
	.contact-content .page-container { width:min(calc(100% - 5rem),var(--content-width)); }
	.contact-hero .page-container { display:grid; gap:1rem; }
	.contact-hero .section-eyebrow { margin:0; color:var(--color-muted); font-size:.82rem; font-weight:600; letter-spacing:.08em; line-height:1.4; }
	.contact-hero .hero-title { max-width:none; margin:0; font-size:clamp(2.6rem,3.8vw,3.5rem); font-weight:800; letter-spacing:-.05em; line-height:1.02; }
	.contact-hero__lead { max-width:52rem; margin:0; color:var(--color-text); font-size:1.08rem; line-height:1.7; }
	.contact-hero__lead a { color:var(--color-link); font-weight:700; text-decoration:underline; text-underline-offset:.2em; }
	.contact-hero__lead a:hover,
	.contact-hero__lead a:focus-visible { color:var(--color-link-hover); }
	.contact-hero__proof,
	.form-field > label,
	.form-fieldset legend { color:var(--color-muted); font-family:var(--font-mono); font-size:.82rem; font-weight:600; letter-spacing:.08em; line-height:1.4; text-transform:uppercase; }
	.contact-hero__proof { margin:0; overflow:hidden; }
	.contact-hero__proof-items { display:flex; flex-wrap:wrap; row-gap:.2rem; margin-left:-1.6em; }
	.contact-hero__proof-items > span { white-space:nowrap; }
	/* Every item carries its own separator; the one at the start of a line falls into the clipped negative margin. */
	.contact-hero__proof-items > span::before { content:'·'; content:'·' / ''; display:inline-block; width:1.6em; text-align:center; }
	.contact-hero__work { max-width:52rem; margin:0; color:var(--color-body-text); font-size:var(--type-card-body-size); line-height:var(--type-card-body-line); }
	.contact-hero__work a { color:var(--color-link); font-weight:700; text-decoration:underline; text-underline-offset:.2em; }
	.contact-hero__work a:hover,
	.contact-hero__work a:focus-visible { color:var(--color-link-hover); }
	.contact-content { padding-block:clamp(3rem,5vw,5rem); }
	.contact-content__inner { display:grid; gap:1.5rem; border-top:1px solid var(--color-border); padding-top:clamp(2rem,4vw,3rem); }
	.contact-form { display:grid; gap:1rem; min-width:0; }
	.contact-form h2 { max-width:100%; margin:0; font-size:clamp(1.7rem,3vw,2.4rem); font-weight:800; letter-spacing:-.04em; line-height:1.08; }
	#message-title { scroll-margin-top:2rem; }
	.contact-form__header p,
	.contact-note { max-width:40rem; margin:0; color:var(--color-body-text); font-size:var(--type-card-body-size); line-height:var(--type-card-body-line); }
	.contact-form { max-width:52rem; border:0; border-radius:0; background:transparent; padding:0; }
	.contact-form__header { display:grid; gap:.65rem; }
	.form-field { display:grid; gap:.45rem; }
	.form-field input[type="text"],
	.form-field input[type="email"],
	.form-field textarea { width:100%; border:1px solid var(--color-border); border-radius:.65rem; background:var(--color-page); padding:.85rem 1rem; color:var(--color-text); font:inherit; }
	.form-field input::placeholder,
	.form-field textarea::placeholder { color:var(--color-muted); opacity:1; }
	.form-field textarea { min-height:10rem; resize:vertical; }
	.form-field input:focus-visible,
	.form-field textarea:focus-visible,
	.radio-group input:focus-visible { outline:2px solid var(--color-focus); outline-offset:3px; }
	.form-fieldset { margin:0; border:0; padding:0; }
	.form-fieldset legend { padding:0; }
	.radio-group { display:flex; flex-wrap:wrap; gap:.75rem 1rem; margin-top:.25rem; }
	.radio-group label { display:flex; gap:.5rem; align-items:center; color:var(--color-body-text); font-size:var(--type-card-body-size); line-height:var(--type-card-body-line); }
	.radio-group input { width:1rem; height:1rem; accent-color:var(--color-text); }
	.field-error { display:none; margin:0; color:var(--color-error); font-size:var(--type-meta-size); line-height:var(--type-meta-line); }
	.form-field input:user-invalid + .field-error,
	.form-field textarea:user-invalid ~ .field-error { display:block; }
	.contact-note a { color:var(--color-link); font-weight:700; text-decoration:underline; text-underline-offset:.2em; }
	.contact-note a:hover,
	.contact-note a:focus-visible { color:var(--color-link-hover); }
	.contact-status { font-weight:600; }
	.contact-status:focus { outline:none; }
	.contact-status:empty { display:none; }
	.contact-form .button { justify-self:start; min-width:12rem; }
	.contact-form .button[hidden] { display:none; }
	.contact-honeypot { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); clip-path:inset(50%); white-space:nowrap; }
	.button:disabled,
	.button[disabled] { cursor:not-allowed; opacity:.55; transform:none; }
	@media(max-width:720px) {
		.contact-hero { padding-top:3rem; }
		.contact-hero .page-container,
		.contact-content .page-container { width:min(calc(100% - 32px),var(--content-width)); }
		.contact-hero .hero-title { font-size:clamp(2.15rem,10vw,2.45rem); line-height:1.04; }
		.contact-hero__lead { font-size:1.05rem; }
		.contact-hero__proof-items { display:grid; margin-left:0; }
		.contact-hero__proof-items > span { white-space:normal; }
		.contact-hero__proof-items > span::before { display:none; }
		.contact-hero__proof-remote { display:none; }
		.contact-content { padding-top:3rem; }
		.contact-form .button { justify-self:stretch; }
	}
</style>

<script>
	const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const formStatus = document.querySelector<HTMLElement>('#form-status');
	const submitButton = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const contactFallback = document.querySelector<HTMLElement>('#contact-fallback');
	const contactNext = document.querySelector<HTMLElement>('#contact-next');
	const messageField = contactForm?.querySelector<HTMLTextAreaElement>('#contact-message');
	const messageHints: Record<string, string> = JSON.parse(messageField?.dataset.hints ?? '{}');
	const updateMessageHint = () => {
		const selected = contactForm?.querySelector<HTMLInputElement>('input[name="context"]:checked')?.value;
		if (messageField && selected && messageHints[selected]) messageField.placeholder = messageHints[selected];
	};
	const defaultSubmitLabel = submitButton?.textContent?.trim() ?? 'Send message';
	const contextInputs = Array.from(contactForm?.querySelectorAll<HTMLInputElement>('input[name="context"]') ?? []);
	const queryParams = new URLSearchParams(window.location.search);
	const querySource = queryParams.get('source');
	const sourcePageField = contactForm?.querySelector<HTMLInputElement>('[data-source-page-field]');
	if (querySource && /^[a-z0-9-]+$/i.test(querySource) && sourcePageField) {
		sourcePageField.value = querySource;
	}
	const queryContext = queryParams.get('context');
	const initialContext = contextInputs.find((input) => input.value === queryContext)?.value ?? 'role';
	const restoreInitialContext = () => {
		contextInputs.forEach((input) => {
			input.checked = input.value === initialContext;
		});
		updateMessageHint();
	};
	restoreInitialContext();
	contextInputs.forEach((input) => input.addEventListener('change', updateMessageHint));

	const restoreSubmitButton = () => {
		if (submitButton?.dataset.submissionState !== 'sent') return;
		submitButton.hidden = false;
		delete submitButton.dataset.submissionState;
		if (formStatus) formStatus.textContent = '';
		if (contactNext) contactNext.hidden = true;
	};

	contactForm?.addEventListener('input', restoreSubmitButton);
	contactForm?.addEventListener('change', restoreSubmitButton);

	contactForm?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!contactForm.reportValidity()) return;

		const formData = new FormData(contactForm);

		if (formStatus) formStatus.textContent = 'Sending your message...';
		if (contactFallback) contactFallback.hidden = true;
		if (contactNext) contactNext.hidden = true;
		if (submitButton) {
			submitButton.disabled = true;
			submitButton.textContent = 'Sending...';
		}

		try {
			const result = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(Object.fromEntries(formData.entries())),
			});

			const body = await result.json().catch(() => ({}));
			if (!result.ok || body.success !== true) throw new Error('Message could not be sent.');

			contactForm.reset();
			restoreInitialContext();
			if (formStatus) formStatus.textContent = 'Message sent. I will reply to your email within two working days.';
			if (contactNext) contactNext.hidden = false;
			if (submitButton) {
				submitButton.textContent = defaultSubmitLabel;
				submitButton.hidden = true;
				submitButton.dataset.submissionState = 'sent';
			}
			formStatus?.focus();
			(window as any).trackPortfolioEvent?.(contactForm.dataset.contactSuccessEvent, {
				cta_id: contactForm.dataset.contactSuccessCtaId,
				cta_text: 'Send message',
				placement: contactForm.dataset.contactSuccessPlacement,
				page_type: document.body?.dataset.pageType ?? 'contact',
				destination: 'https://api.web3forms.com/submit',
				intent: contactForm.dataset.contactSuccessIntent,
				source_section: contactForm.dataset.contactSuccessSourceSection,
				source_page: contactForm.dataset.sourcePage,
			});
		} catch (error) {
			if (formStatus) formStatus.textContent = 'The message could not be sent. Please try again in a few minutes.';
			if (contactFallback) contactFallback.hidden = false;
			if (submitButton) submitButton.textContent = defaultSubmitLabel;
		} finally {
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>
