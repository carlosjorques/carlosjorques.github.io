---
import Layout from '../layouts/Layout.astro';
import { LINKEDIN_URL } from '../data/identity';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) =>
	href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')
		? href
		: `${normalizedBase}${href.replace(/^\//, '')}`;

const cvPdfHref = '/cv/Carlos_Jorques_CV.pdf';
const linkedinHref = LINKEDIN_URL;
const web3FormsAccessKey = '7f35453b-2e22-4022-bb4b-46573f04453b';
const contactContext = Astro.url.searchParams.get('context') === 'role' ? 'role' : '';
const contactSource = Astro.url.searchParams.get('source')?.match(/^[a-z0-9-]+$/i)?.[0] ?? '';
---

<Layout
	title="Contact Carlos Jorques | Embedded Controls Technical Lead"
	description="Contact Carlos Jorques about embedded controls, electrification, autonomy, diagnostics, safety-critical software, technical leadership, or collaboration."
>
	<section class="contact-hero" aria-labelledby="contact-title">
		<div class="page-container">
			<p class="section-eyebrow">Contact</p>
			<h1 id="contact-title" class="hero-title">Let’s talk.</h1>
			<p class="contact-hero__lead">I’m Carlos, an Embedded Control Systems Architect and Technical Lead. For a quick role-fit overview, <a href={withBase(cvPdfHref)} data-analytics-event="cv_pdf_download" data-cta-id="contact-download-cv" data-cta-placement="contact-hero-copy" data-cta-intent="formal-proof" data-source-section="contact-hero">download my CV (PDF)</a>. For technical conversations or collaboration, <a href={linkedinHref} target="_blank" rel="noopener noreferrer" data-analytics-event="linkedin_outbound_click" data-cta-id="contact-linkedin" data-cta-placement="contact-hero-copy" data-cta-intent="professional-profile" data-source-section="contact-hero">connect on LinkedIn</a> or send a message below.</p>
			<p class="contact-hero__proof">Based in Spain <span aria-hidden="true">·</span> Working remotely with international teams</p>
		</div>
	</section>

	<section class="section contact-content" aria-labelledby="message-title">
		<div class="page-container contact-content__inner">
			<form
				class="contact-form"
				action="https://api.web3forms.com/submit"
				method="POST"
				aria-labelledby="message-title"
				aria-describedby="form-status privacy-note"
				data-contact-form
				data-analytics-event="contact_form_submit"
				data-cta-id="contact-web3forms-form"
				data-cta-placement="contact-form"
				data-cta-intent="contact"
				data-source-section="contact-form"
				data-source-page={contactSource || undefined}
			>
				<input type="hidden" name="access_key" value={web3FormsAccessKey} />
				<input type="hidden" name="subject" value="Portfolio contact from Carlos Jorques website" />
				<input type="hidden" name="source_page" value={contactSource} data-source-page-field />
				<div class="contact-form__header">
					<h2 id="message-title">How can I help?</h2>
					<p id="form-status" class="contact-note" role="status" aria-live="polite">Tell me what you are working on, exploring, or hoping to discuss. A little context helps me reply usefully.</p>
				</div>

					<div class="form-field">
						<label for="contact-name">Name <span aria-hidden="true">*</span></label>
						<input id="contact-name" name="name" type="text" autocomplete="name" placeholder="e.g. Alex Morgan" required aria-describedby="contact-name-error" />
						<p class="field-error" id="contact-name-error">Enter your name.</p>
					</div>

					<div class="form-field">
						<label for="contact-email">Email <span aria-hidden="true">*</span></label>
						<input id="contact-email" name="email" type="email" autocomplete="email" placeholder="e.g. alex@company.com" required aria-describedby="contact-email-error" />
						<p class="field-error" id="contact-email-error">Enter a valid email address.</p>
					</div>

					<fieldset class="form-field form-fieldset">
						<legend>What are you reaching out about?</legend>
						<div class="radio-group">
							<label><input type="radio" name="context" value="project" /> Project</label>
							<label><input type="radio" name="context" value="role" checked={contactContext === 'role'} /> Role</label>
							<label><input type="radio" name="context" value="collaboration" /> Collaboration</label>
							<label><input type="radio" name="context" value="other" /> Other</label>
						</div>
					</fieldset>

					<div class="form-field">
						<label for="contact-message">Message <span aria-hidden="true">*</span></label>
						<textarea id="contact-message" name="message" rows="8" placeholder="e.g. I’d like to discuss a role, project, or technical question about embedded controls." required aria-describedby="contact-message-error"></textarea>
						<p class="field-error" id="contact-message-error">Enter a message.</p>
					</div>

				<div class="contact-honeypot" aria-hidden="true">
					<label for="contact-botcheck">Leave this unchecked</label>
					<input id="contact-botcheck" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" />
				</div>

					<p class="contact-note" id="privacy-note">I&apos;ll use your details only to reply to your message. <a href={withBase('/privacy')}>Read the privacy notice.</a></p>
					<button class="button primary" type="submit" aria-describedby="privacy-note form-status">Send message</button>
			</form>

		</div>
	</section>
</Layout>

<style>
	.contact-hero { padding:clamp(3rem,5vw,4.6rem) 0 0; }
	.contact-hero .page-container,
	.contact-content .page-container { width:min(calc(100% - 5rem),var(--content-width)); }
	.contact-hero .page-container { display:grid; gap:1rem; }
	.contact-hero .section-eyebrow { margin:0; color:var(--color-muted); font-size:.82rem; font-weight:600; letter-spacing:.08em; line-height:1.4; }
	.contact-hero .hero-title { max-width:none; margin:0; font-size:clamp(2.6rem,3.8vw,3.5rem); font-weight:800; letter-spacing:-.05em; line-height:1.02; }
	.contact-hero__lead { max-width:52rem; margin:0; color:var(--color-text); font-size:1.08rem; line-height:1.7; }
	.contact-hero__lead a { color:var(--color-link); font-weight:700; text-decoration:underline; text-underline-offset:.2em; }
	.contact-hero__lead a:hover,
	.contact-hero__lead a:focus-visible { color:var(--color-link-hover); }
	.contact-hero__proof,
	.form-field label,
	.form-fieldset legend { color:var(--color-muted); font-family:var(--font-mono); font-size:.82rem; font-weight:600; letter-spacing:.08em; line-height:1.4; text-transform:uppercase; }
	.contact-hero__proof { margin:0; }
	.contact-content { padding-block:clamp(3rem,5vw,5rem); }
	.contact-content__inner { display:grid; gap:1.5rem; border-top:1px solid var(--color-border); padding-top:clamp(2rem,4vw,3rem); }
	.contact-form { display:grid; gap:1rem; min-width:0; }
	.contact-form h2 { max-width:100%; margin:0; font-size:clamp(1.7rem,3vw,2.4rem); font-weight:800; letter-spacing:-.04em; line-height:1.08; }
	#message-title { scroll-margin-top:2rem; }
	.contact-form__header p,
	.contact-note { max-width:40rem; margin:0; color:var(--color-body-text); font-size:var(--type-card-body-size); line-height:var(--type-card-body-line); }
	.contact-form { max-width:52rem; border:0; border-radius:0; background:transparent; padding:0; }
	.contact-form__header { display:grid; gap:.65rem; }
	.form-field { display:grid; gap:.45rem; }
	.form-field input[type="text"],
	.form-field input[type="email"],
	.form-field textarea { width:100%; border:1px solid var(--color-border); border-radius:.65rem; background:var(--color-page); padding:.85rem 1rem; color:var(--color-text); font:inherit; }
	.form-field input::placeholder,
	.form-field textarea::placeholder { color:var(--color-muted); opacity:.72; }
	.form-field textarea { min-height:10rem; resize:vertical; }
	.form-field input:focus-visible,
	.form-field textarea:focus-visible,
	.radio-group input:focus-visible { outline:2px solid var(--color-focus); outline-offset:3px; }
	.form-fieldset { margin:0; border:0; padding:0; }
	.radio-group { display:flex; flex-wrap:wrap; gap:.75rem 1rem; margin-top:.25rem; }
	.radio-group label { display:flex; gap:.5rem; align-items:center; color:var(--color-body-text); font-size:var(--type-card-body-size); line-height:var(--type-card-body-line); }
	.radio-group input { width:1rem; height:1rem; accent-color:var(--color-accent-text); }
	.field-error { display:none; margin:0; color:var(--color-accent-text); font-size:var(--type-meta-size); line-height:var(--type-meta-line); }
	.form-field input:user-invalid + .field-error,
	.form-field textarea:user-invalid ~ .field-error { display:block; }
	.contact-note a { color:var(--color-link); font-weight:700; text-decoration:underline; text-underline-offset:.2em; }
	.contact-note a:hover,
	.contact-note a:focus-visible { color:var(--color-link-hover); }
	.contact-note--status:empty { display:none; }
	.contact-honeypot { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); clip-path:inset(50%); white-space:nowrap; }
	.button:disabled,
	.button[disabled] { cursor:not-allowed; opacity:.55; transform:none; }
	@media(max-width:720px) {
		.contact-hero { padding-top:3rem; }
		.contact-hero .page-container,
		.contact-content .page-container { width:min(calc(100% - 32px),var(--content-width)); }
		.contact-hero .hero-title { font-size:clamp(2.15rem,10vw,2.45rem); line-height:1.04; }
		.contact-hero__lead { font-size:1.05rem; }
		.contact-content { padding-top:3rem; }
	}
</style>

<script>
	const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const formStatus = document.querySelector<HTMLElement>('#form-status');
	const submitButton = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const defaultSubmitLabel = submitButton?.textContent?.trim() ?? 'Send message';
	const roleContextInput = contactForm?.querySelector<HTMLInputElement>('input[name="context"][value="role"]');
	const queryParams = new URLSearchParams(window.location.search);
	const querySource = queryParams.get('source');
	const sourcePageField = contactForm?.querySelector<HTMLInputElement>('[data-source-page-field]');
	if (querySource && /^[a-z0-9-]+$/i.test(querySource) && sourcePageField) {
		sourcePageField.value = querySource;
	}
	if (queryParams.get('context') === 'role' && roleContextInput) {
		roleContextInput.checked = true;
	}

	const restoreSubmitButton = () => {
		if (submitButton?.dataset.submissionState !== 'sent') return;
		submitButton.textContent = defaultSubmitLabel;
		delete submitButton.dataset.submissionState;
	};

	contactForm?.addEventListener('input', restoreSubmitButton);
	contactForm?.addEventListener('change', restoreSubmitButton);

	contactForm?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!contactForm.reportValidity()) return;

		const formData = new FormData(contactForm);

		if (formStatus) formStatus.textContent = 'Sending your message…';
		if (submitButton) {
			submitButton.disabled = true;
			submitButton.textContent = 'Sending…';
		}

		try {
			const result = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(Object.fromEntries(formData.entries())),
			});

			const body = await result.json().catch(() => ({}));
			if (!result.ok || body.success !== true) throw new Error('Message could not be sent.');

			contactForm.reset();
			if (formStatus) formStatus.textContent = 'Thanks — your message has been sent. I’ll reply soon.';
			if (submitButton) {
				submitButton.textContent = 'Message sent!';
				submitButton.dataset.submissionState = 'sent';
			}
			(window as any).trackPortfolioEvent?.(contactForm.dataset.analyticsEvent, {
				cta_id: contactForm.dataset.ctaId,
				cta_text: 'Send message',
				placement: contactForm.dataset.ctaPlacement,
				page_type: document.body?.dataset.pageType ?? 'contact',
				destination: 'https://api.web3forms.com/submit',
				intent: contactForm.dataset.ctaIntent,
				source_section: contactForm.dataset.sourceSection,
				source_page: contactForm.dataset.sourcePage,
			});
		} catch (error) {
			if (formStatus) formStatus.textContent = error instanceof Error ? error.message : 'Message could not be sent. Please try again later.';
			if (submitButton) submitButton.textContent = defaultSubmitLabel;
		} finally {
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>
