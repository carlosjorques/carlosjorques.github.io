---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) =>
	href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')
		? href
		: `${normalizedBase}${href.replace(/^\//, '')}`;

const contactEmail = 'carlosjorques@gmail.com';
const emailHref = `mailto:${contactEmail}`;
const cvPdfHref = '/cv/Carlos_Jorques_CV.pdf';
const linkedinHref = 'https://www.linkedin.com/in/carlosjorques/';
---

<Layout
	title="Contact Carlos Jorques | Embedded Controls Engineer"
	description="Contact Carlos Jorques about embedded controls, electrification, autonomy, diagnostics, safety-critical software, technical leadership, or collaboration."
>
	<section class="contact-hero" aria-labelledby="contact-title">
		<div class="page-container contact-hero__inner">
			<div class="contact-hero__label">
				<p class="section-eyebrow">Contact</p>
				<h1 id="contact-title" class="hero-title">Get in touch</h1>
			</div>
			<div class="contact-hero__mission">
				<p>
					If you are working on embedded controls, electrification, autonomy, diagnostics, validation, or safety-critical software, I would be glad to hear from you.
				</p>
				<p>Open to technical discussions, architecture conversations, and role opportunities.</p>
				<p>Based in Spain - working remotely with international teams.</p>
			</div>
		</div>
	</section>

	<section class="section contact-content" aria-labelledby="direct-contact-title">
		<div class="page-container contact-content__grid">
			<div class="contact-stack">
				<article class="direct-contact-card">
					<p class="contact-card__label">Direct email</p>
					<h2 id="direct-contact-title">Email Carlos</h2>
					<p class="direct-contact-card__copy">
						For roles, collaborations, technical conversations, or focused questions about embedded control software for physical systems.
					</p>
					<div class="button-row direct-contact-card__actions">
						<a
							class="button primary"
							href={emailHref}
							data-analytics-event="contact_email_click"
							data-cta-id="contact-email-primary"
							data-cta-placement="contact-direct-card"
							data-cta-intent="contact"
							data-source-section="direct-email"
						>
							Email Carlos
						</a>
						<button
							class="button"
							type="button"
							data-copy-email
							data-email={contactEmail}
							data-analytics-event="contact_copy_email"
							data-cta-id="contact-copy-email"
							data-cta-placement="contact-direct-card"
							data-cta-intent="contact"
							data-source-section="direct-email"
							aria-describedby="copy-email-status"
						>
							Copy email
						</button>
					</div>
					<p class="contact-note contact-note--status" id="copy-email-status" data-copy-email-status role="status" aria-live="polite"></p>
				</article>

				<nav class="secondary-contact-links" aria-label="Secondary contact links">
					<a
						href={linkedinHref}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Open Carlos Jorques on LinkedIn in a new tab"
						data-analytics-event="linkedin_outbound_click"
						data-cta-id="contact-linkedin"
						data-cta-placement="contact-secondary-links"
						data-cta-intent="professional-profile"
						data-source-section="contact-secondary"
					>
						<span>LinkedIn</span>
						<strong>Professional profile</strong>
					</a>
					<a
						href={withBase(cvPdfHref)}
						data-analytics-event="cv_pdf_download"
						data-cta-id="contact-download-cv"
						data-cta-placement="contact-secondary-links"
						data-cta-intent="formal-proof"
						data-source-section="contact-secondary"
					>
						<span>Download PDF CV</span>
						<strong>PDF resume</strong>
					</a>
					<a
						href={withBase('/cv')}
						data-analytics-event="cta_click"
						data-cta-id="contact-online-cv"
						data-cta-placement="contact-secondary-links"
						data-cta-intent="formal-proof"
						data-source-section="contact-secondary"
					>
						<span>Online CV</span>
						<strong>Structured experience overview</strong>
					</a>
				</nav>
			</div>

			<form
				class="contact-form"
				action={emailHref}
				method="post"
				enctype="text/plain"
				aria-labelledby="message-title"
				aria-describedby="form-status privacy-note"
				data-contact-form
				data-analytics-event="contact_form_submit"
				data-cta-id="contact-mailto-form"
				data-cta-placement="contact-form"
				data-cta-intent="contact"
				data-source-section="contact-form"
			>
				<div class="contact-form__header">
					<h2 id="message-title">Send a message</h2>
					<p id="form-status" class="contact-note" role="status" aria-live="polite">
						Use this form for a short introduction, project context, role discussion, or collaboration proposal.
					</p>
				</div>

				<div class="form-field">
					<label for="contact-name">Name <span aria-hidden="true">*</span></label>
					<input id="contact-name" name="name" type="text" autocomplete="name" required aria-describedby="contact-name-error" />
					<p class="field-error" id="contact-name-error">Enter your name.</p>
				</div>

				<div class="form-field">
					<label for="contact-email">Email <span aria-hidden="true">*</span></label>
					<input id="contact-email" name="email" type="email" autocomplete="email" required aria-describedby="contact-email-error" />
					<p class="field-error" id="contact-email-error">Enter a valid email address.</p>
				</div>

				<fieldset class="form-field form-fieldset">
					<legend>What are you reaching out about?</legend>
					<div class="radio-group">
						<label><input type="radio" name="context" value="project" /> Project</label>
						<label><input type="radio" name="context" value="role" /> Role</label>
						<label><input type="radio" name="context" value="collaboration" /> Collaboration</label>
						<label><input type="radio" name="context" value="other" /> Other</label>
					</div>
				</fieldset>

				<div class="form-field">
					<label for="contact-message">Message <span aria-hidden="true">*</span></label>
					<textarea id="contact-message" name="message" rows="8" required aria-describedby="contact-message-helper contact-message-error"></textarea>
					<p class="field-helper" id="contact-message-helper">Share the role, system, collaboration model, location or remote setup, and any useful technical context.</p>
					<p class="field-error" id="contact-message-error">Enter a message.</p>
				</div>

				<div class="contact-honeypot" aria-hidden="true">
					<label for="contact-company">Company</label>
					<input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
					<p>Leave this field empty.</p>
				</div>

				<p class="contact-note" id="privacy-note">
					I&apos;ll use your details only to reply to your message. <a href={withBase('/privacy')}>Read the privacy notice.</a>
				</p>
				<button class="button primary" type="submit" aria-describedby="privacy-note form-status">Send message</button>
			</form>
		</div>
	</section>
</Layout>

<style>
	.contact-hero {
		padding-block: clamp(3rem, 5vw, 4.6rem) clamp(1.55rem, 3vw, 2.25rem);
		border-bottom: 1px solid var(--color-border-soft);
		background: transparent;
	}

	.contact-hero .page-container,
	.contact-content .page-container {
		width: min(calc(100% - 5rem), var(--content-width));
		max-width: 100%;
	}

	.contact-hero__inner,
	.contact-hero__label,
	.contact-hero__mission {
		display: grid;
	}

	.contact-hero__inner {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(1.4rem, 5vw, 4.2rem);
		align-items: end;
	}

	.contact-hero__label {
		gap: 0.85rem;
		min-width: 0;
	}

	.contact-hero__label .section-eyebrow {
		margin: 0;
	}

	.contact-hero__mission {
		gap: 0.75rem;
		min-width: 0;
		border-left: 1px solid var(--color-border-soft);
		padding-left: clamp(1rem, 3vw, 2rem);
	}

	.contact-hero .hero-title {
		max-width: none;
		font-size: clamp(4.2rem, 9vw, 8rem);
		overflow-wrap: normal;
		word-break: normal;
	}

	.contact-hero__mission p {
		max-width: 660px;
		margin: 0;
		color: var(--color-body-text);
		font-size: clamp(1.1rem, 1.45vw, 1.32rem);
		font-weight: 400;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.contact-content {
		background: transparent;
	}

	.contact-content__grid {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	.contact-stack {
		display: grid;
		gap: var(--spacing-06);
	}

	.direct-contact-card,
	.contact-form {
		display: grid;
		gap: var(--spacing-05);
		border: 0;
		border-top: 1px solid var(--color-border);
		border-radius: 0;
		background: transparent;
		padding: clamp(1.4rem, 3vw, 2rem) 0 0;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.direct-contact-card:hover,
	.direct-contact-card:focus-within,
	.contact-form:focus-within {
		border-color: var(--color-border-strong);
		background: transparent;
	}

	.contact-card__label {
		color: var(--color-accent-text);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: var(--type-meta-weight);
		letter-spacing: var(--type-meta-tracking);
		line-height: var(--type-meta-line);
		text-transform: uppercase;
	}

	.direct-contact-card h2,
	.contact-form h2 {
		max-width: 100%;
		font-size: clamp(1.55rem, 2.5vw, 2.35rem);
		letter-spacing: -0.045em;
		line-height: 1.05;
	}

	.direct-contact-card__copy,
	.contact-form__header p,
	.field-helper,
	.contact-note {
		color: var(--color-body-text);
		font-size: var(--type-card-body-size);
		line-height: var(--type-card-body-line);
	}

	.contact-note a {
		color: var(--color-link);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.contact-note a:hover,
	.contact-note a:focus-visible {
		color: var(--color-link-hover);
	}

	.contact-note--status:empty {
		display: none;
	}

	.direct-contact-card__actions,
	.secondary-contact-links {
		display: grid;
		gap: 0.75rem;
	}

	.secondary-contact-links a {
		display: grid;
		gap: 0.25rem;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0;
		background: transparent;
		padding: 1rem 0;
		color: var(--color-text);
		text-decoration: none;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.secondary-contact-links a:hover,
	.secondary-contact-links a:focus-visible {
		border-color: var(--color-accent-text);
		background: transparent;
		transform: translateX(4px);
	}

	.secondary-contact-links span,
	.form-field label,
	.form-fieldset legend {
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: var(--type-meta-weight);
		letter-spacing: var(--type-meta-tracking);
		line-height: var(--type-meta-line);
		text-transform: uppercase;
	}

	.secondary-contact-links strong {
		color: var(--color-body-text);
		font-size: var(--type-card-body-size);
		line-height: var(--type-card-body-line);
	}

	.contact-form__header {
		display: grid;
		gap: 0.65rem;
	}

	.form-field {
		display: grid;
		gap: 0.45rem;
	}

	.form-field input[type="text"],
	.form-field input[type="email"],
	.form-field textarea {
		width: 100%;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0;
		background: transparent;
		padding: 0.78rem 0;
		color: var(--color-text);
		font: inherit;
	}

	.form-field textarea {
		min-height: 11rem;
		resize: vertical;
	}

	.form-field input:focus-visible,
	.form-field textarea:focus-visible,
	.radio-group input:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 3px;
	}

	.form-fieldset {
		margin: 0;
		border: 0;
		padding: 0;
	}

	.radio-group {
		display: grid;
		gap: 0.55rem;
		margin-top: var(--spacing-03);
	}

	.radio-group label {
		display: flex;
		gap: 0.55rem;
		align-items: center;
		color: var(--color-body-text);
		font-size: var(--type-card-body-size);
		line-height: var(--type-card-body-line);
	}

	.radio-group input {
		width: 1rem;
		height: 1rem;
		accent-color: var(--color-accent-text);
	}

	.field-error {
		display: none;
		color: var(--color-accent-text);
		font-size: var(--type-meta-size);
		line-height: var(--type-meta-line);
	}

	.form-field input:user-invalid + .field-error,
	.form-field textarea:user-invalid ~ .field-error {
		display: block;
	}

	.contact-honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.button:disabled,
	.button[disabled] {
		cursor: not-allowed;
		opacity: 0.55;
		transform: none;
	}

	@media (min-width: 760px) {
		.direct-contact-card__actions {
			grid-template-columns: repeat(2, minmax(0, max-content));
		}
	}

	@media (min-width: 980px) {
		.contact-content__grid {
			grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.contact-hero {
			padding-block: 3.5rem 2.75rem;
		}

		.contact-hero .page-container,
		.contact-content .page-container {
			width: min(calc(100% - 2rem), var(--content-width));
		}

		.contact-hero__inner {
			grid-template-columns: 1fr;
			align-items: start;
			gap: 1.1rem;
		}

		.contact-hero__mission {
			border-left: 0;
			border-top: 1px solid var(--color-border-soft);
			padding-top: 1rem;
			padding-left: 0;
			max-width: 100%;
		}

		.contact-hero .hero-title {
			font-size: clamp(3.2rem, 15vw, 4.4rem);
		}

		.contact-hero__label,
		.contact-hero__mission {
			overflow-wrap: anywhere;
		}
	}
</style>

<style>
	.contact-hero .page-container,
	.contact-content .page-container { width:min(calc(100% - 3rem),78rem); }
	.contact-hero { padding:6rem 0 4rem; border:0; }
	.contact-hero__inner { display:block; }
	.contact-hero__label { gap:1rem; }
	.contact-hero .section-eyebrow { color:var(--color-muted); }
	.contact-hero .hero-title { max-width:none; font-size:clamp(3rem,4.8vw,5rem); line-height:1.02; letter-spacing:-.05em; font-weight:800; }
	.contact-hero__mission { max-width:52rem; margin-top:1.5rem; padding:0; border:0; }
	.contact-hero__mission p { font-size:1.08rem; line-height:1.7; color:var(--color-text); }
	.contact-content { padding-block:0 5rem; }
	.contact-content__grid { padding-top:2.5rem; border-top:1px solid var(--color-border); }
	.direct-contact-card,.contact-form { padding-top:0; border-top:0; }
	.direct-contact-card h2,.contact-form h2 { font-size:clamp(1.7rem,3vw,2.4rem); line-height:1.08; letter-spacing:-.04em; font-weight:800; }
	.contact-card__label,.secondary-contact-links span,.form-field label,.form-fieldset legend { color:var(--color-muted); font-size:.82rem; font-weight:600; letter-spacing:.08em; }
	.form-field input[type='text'],.form-field input[type='email'],.form-field textarea { border:1px solid var(--color-border); border-radius:.9rem; background:var(--color-card-bg); padding:.85rem 1rem; }
	@media(max-width:720px){.contact-hero .page-container,.contact-content .page-container{width:min(calc(100% - 1.5rem),78rem)}.contact-hero{padding:4rem 0 3rem}}
</style>

<script>
	const encodeMailBody = (form: HTMLFormElement) => {
		const data = new FormData(form);
		const context = data.get('context');
		const lines = [
			`Name: ${data.get('name') ?? ''}`,
			`Email: ${data.get('email') ?? ''}`,
			`Context: ${typeof context === 'string' && context ? context : 'Not specified'}`,
			'',
			`${data.get('message') ?? ''}`,
		];

		return encodeURIComponent(lines.join('\n'));
	};

	const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
	const copyStatus = document.querySelector<HTMLElement>('[data-copy-email-status]');
	const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const formStatus = document.querySelector<HTMLElement>('#form-status');

	copyButton?.addEventListener('click', async () => {
		const email = copyButton.dataset.email;

		if (!email || !copyStatus) {
			return;
		}

		try {
			await navigator.clipboard.writeText(email);
			copyStatus.textContent = 'Email address copied.';
		} catch {
			copyStatus.textContent = 'Could not copy the email address. Select and copy it manually.';
		}
	});

	contactForm?.addEventListener('submit', (event) => {
		event.preventDefault();

		if (!contactForm.reportValidity()) {
			return;
		}

		if (formStatus) {
			formStatus.textContent = 'Opening your email client with the message details.';
		}

		(window as any).trackPortfolioEvent?.(contactForm.dataset.analyticsEvent, {
			cta_id: contactForm.dataset.ctaId,
			cta_text: 'Send message',
			placement: contactForm.dataset.ctaPlacement,
			page_type: document.body?.dataset.pageType ?? 'contact',
			destination: contactForm.getAttribute('action') ?? undefined,
			intent: contactForm.dataset.ctaIntent,
			source_section: contactForm.dataset.sourceSection,
		});

		const subject = encodeURIComponent('Portfolio contact');
		window.location.href = `mailto:${copyButton?.dataset.email ?? ''}?subject=${subject}&body=${encodeMailBody(contactForm)}`;
	});
</script>
