---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`);
---

<Layout
	title="Contact"
	description="Contact Carlos Jorques for embedded control systems architecture, automotive software/control projects, and technical leadership roles."
>
	<section class="section">
		<div class="container contact-grid">
			<div>
				<SectionHeading
					eyebrow="Contact"
					title="Discuss control intelligence for physical systems"
					description="For technical leadership roles, embedded control systems architecture, automotive software/control projects, or discussions around control intelligence for physical systems, feel free to contact me."
				/>
			</div>
			<div class="contact-panel">
				<div>
					<span>Email</span>
					<strong>Launch TODO: add preferred public email</strong>
				</div>
				<div>
					<span>LinkedIn</span>
					<strong>Launch TODO: add verified LinkedIn profile</strong>
				</div>
				<a href={withBase('/cv')}>
					<span>Online CV</span>
					<strong>View Carlos Jorques's structured online CV</strong>
				</a>
				<a href={withBase('/cv/Carlos_Jorques_CV.pdf')}>
					<span>PDF CV</span>
					<strong>Download Carlos Jorques's PDF CV</strong>
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}

	.contact-panel {
		display: grid;
		gap: 1rem;
		background: transparent;
	}

	.contact-panel div,
	.contact-panel a {
		display: grid;
		gap: 0.4rem;
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius);
		background: var(--color-card-bg);
		padding: 1rem;
		color: var(--color-text);
		text-decoration: none;
		transition:
			background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
			transform var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.contact-panel a:hover,
	.contact-panel a:focus-visible {
		border-color: var(--color-card-border-hover);
		background: var(--color-card-bg-hover);
		transform: translateY(-2px);
	}

	.contact-panel span {
		color: var(--color-subtle);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.contact-panel strong {
		font-size: 1.05rem;
		overflow-wrap: anywhere;
	}

	@media (min-width: 850px) {
		.contact-grid {
			grid-template-columns: minmax(0, 1fr) 320px;
			gap: 2rem;
		}
	}
</style>
