---
import Layout from '../layouts/Layout.astro';
import { cvProfile } from '../data/cvMarkdown';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => {
	if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
		return href;
	}

	return href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`;
};

const toolGroupsWithExtensions = cvProfile.tools.map((group, index) => ({
	group,
	extended: cvProfile.extendedTools[index] ?? null,
}));

const expertiseCardId = (title: string) =>
	`expertise-${title
		.toLowerCase()
		.replace(/&/g, 'and')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '')}`;

const experienceItemId = (item: (typeof cvProfile.experience)[number], index: number) =>
        `experience-${index + 1}-${item.title
                .toLowerCase()
                .replace(/&/g, 'and')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '')}`;

const earlierExperienceItemId = (item: (typeof cvProfile.earlierExperience)[number], index: number) =>
        `earlier-experience-${index + 1}-${item.title
                .toLowerCase()
                .replace(/&/g, 'and')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '')}`;

const addUnique = (items: string[], item: string) => {
        if (!items.includes(item)) {
                items.push(item);
        }
};

const groupExperienceDetails = (item: (typeof cvProfile.experience)[number]) => {
	const grouped = {
		technicalScope: [] as string[],
		deliveryValidation: [] as string[],
		leadershipCollaboration: [] as string[],
	};

	item.detailGroups?.forEach((group) => {
		group.items.forEach((detail) => {
			const normalized = detail.toLowerCase();
			const isLeadership =
				/mentor|coordination|supplier|stakeholder|planning|scrum|agile|knowledge|conference|thesis|key people|project management/.test(normalized);
			const isDelivery =
				/validation|test|mil|sil|hil|bench|wind tunnel|track|on-road|vehicle|field|calibration|ci\/cd|pipeline|debugging|issue tracking|ecu flashing|release|integration quality|cycle time|data analysis|process|a-spice|spice/.test(normalized);

			if (isLeadership) {
				addUnique(grouped.leadershipCollaboration, detail);
			} else if (isDelivery || group.title === 'Validation scope') {
				addUnique(grouped.deliveryValidation, detail);
			} else {
				addUnique(grouped.technicalScope, detail);
			}
		});
	});

	return grouped;
};

const hasExperienceDetails = (groups: ReturnType<typeof groupExperienceDetails>) =>
	groups.technicalScope.length > 0 || groups.deliveryValidation.length > 0 || groups.leadershipCollaboration.length > 0;

const profileJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	mainEntity: {
		'@type': 'Person',
		name: cvProfile.hero.title,
		jobTitle: 'Senior Electronics Engineer and Embedded Controls Architect',
		description:
			'Senior electronics and embedded controls engineer specializing in EV thermal management, BMS, autonomous propulsion control, diagnostics, functional safety, model-based development, and real-time embedded software.',
		url: Astro.url.href,
		sameAs: [cvProfile.links.linkedin],
	},
};
---

<Layout
	title="Senior Embedded Controls Engineer CV | Carlos Jorques"
	description="Senior electronics and embedded controls engineer specializing in EV thermal management, BMS, autonomous propulsion control, diagnostics, functional safety, model-based development, and real-time embedded software."
>
	<script type="application/ld+json" set:html={JSON.stringify(profileJsonLd)} />

	<div class="cv-page">
		<div class="cv-scroll-progress" aria-hidden="true">
			<span class="cv-scroll-progress__bar" data-cv-scroll-progress></span>
		</div>

		<a class="cv-scroll-jump" href="#top" aria-label="Scroll to the top of the page" data-cv-scroll-jump>
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M12 17V7.5" />
				<path d="M8.75 10.75 12 7.5l3.25 3.25" />
			</svg>
		</a>

		<section class="cv-hero" aria-labelledby="cv-title">
			<div class="page-container cv-hero__inner">
				<div class="cv-hero__content">
					<h1 id="cv-title" class="cv-hero__name hero-title">{cvProfile.hero.title}</h1>
					<p class="cv-hero__subtitle hero-role cv-hero__role">{cvProfile.hero.subtitle}</p>
					<p class="cv-hero__summary hero-summary">{cvProfile.hero.summary}</p>
					<p class="cv-hero__extended">{cvProfile.hero.secondarySummary}</p>
					<p class="cv-hero__extended">{cvProfile.hero.tertiarySummary}</p>

					<div class="button-row cv-actions" aria-label="CV actions">
						{cvProfile.actions.map((action) => (
							<a
								class={action.primary ? 'button primary' : 'button'}
								href={withBase(action.href)}
								target={action.external ? '_blank' : undefined}
								rel={action.external ? 'noopener noreferrer' : undefined}
								download={action.download ? true : undefined}
								data-analytics={action.analytics}
							>
								{action.label}
							</a>
						))}
					</div>
				</div>

				<aside class="cv-hero__evidence" aria-label="Recruiter snapshot">
					<ul class="cv-proof-grid" aria-label="Career proof points">
						{cvProfile.proofTiles.map((tile) => (
							<li>
								<strong>{tile.value}</strong>
								<span>{tile.label}</span>
							</li>
						))}
					</ul>

					<div class="cv-role-strip" aria-label="Relevant roles">
						<p>Relevant for</p>
						<ul class="cv-chip-list cv-chip-list--strong">
							{cvProfile.relevantFor.map((role) => (
								<li>{role}</li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</section>

		<div class="page-container cv-shell">
			<nav class="cv-section-nav" aria-label="CV sections">
				<div class="cv-section-nav__inner">
					<span>CV sections</span>
					<ul>
						{cvProfile.sectionNav.map((item) => (
							<li>
								<a href={item.href} data-cv-section-link data-analytics="cv_section_nav_click">{item.label}</a>
							</li>
						))}
					</ul>
					<div class="cv-section-nav__actions" aria-label="CV quick actions">
						<a href={withBase(cvProfile.links.pdf)} download data-analytics="cv_pdf_download">Download PDF</a>
						<a href={withBase(cvProfile.links.contact)} data-analytics="cv_contact_click">Contact</a>
					</div>
				</div>
			</nav>

			<div class="cv-main-flow">
				<section class="cv-section" id="expertise" aria-labelledby="core-expertise-heading" data-cv-section>
					<div class="page-container">
						<header class="cv-section__intro cv-section__intro--expertise">
							<h2 id="core-expertise-heading">Core Expertise</h2>
							<p>
								A capability map across embedded controls architecture, automotive software, electric and autonomous vehicle systems,
								production software validation, diagnostics, safety, robustness, and technical leadership.
							</p>
						</header>
						<div class="core-expertise-grid">
							{cvProfile.expertise.map((group) => {
								const panelId = `${expertiseCardId(group.title)}-detail-panel`;
								const titleId = `${expertiseCardId(group.title)}-title`;
								return (
									<article class="cv-card cv-card--interactive cv-expertise-card" data-expertise-card data-panel-id={panelId} data-expanded="false" aria-labelledby={titleId}>
										<button
											class="cv-expertise-card__icon-button"
											type="button"
											aria-expanded="false"
											aria-controls={panelId}
											aria-label={`View details for ${group.title}`}
											data-expertise-toggle
											data-analytics="cv_expertise_evidence_open"
										>
											<span aria-hidden="true">+</span>
										</button>
										<header class="cv-expertise-card__header">
											<h3 id={titleId} class="cv-expertise-card__title">{group.title}</h3>
											{group.compactSummary && <p class="cv-expertise-card__summary">{group.compactSummary}</p>}
										</header>
										<div class="cv-expertise-card__capabilities-block">
											<ul class="cv-expertise-card__capabilities">
												{group.items.map((item) => (
													<li>{item}</li>
												))}
											</ul>
										</div>
										<button class="cv-expertise-card__toggle" type="button" aria-expanded="false" aria-controls={panelId} data-expertise-toggle>
											<span data-expertise-toggle-label>View details</span>
										</button>
										<div class="core-expertise-detail" id={panelId} data-expertise-detail hidden>
											{group.detailSummary && <p class="core-expertise-detail__summary">{group.detailSummary}</p>}
											<div class="core-expertise-detail__grid">
												{group.representativeWork && group.representativeWork.length > 0 && (
													<section class="cv-detail-group" aria-label={`${group.title} representative work`}>
														<h4>Representative work</h4>
														<ul>
															{group.representativeWork.map((item) => (
																<li>{item}</li>
															))}
														</ul>
													</section>
												)}
												{group.methods && group.methods.length > 0 && (
													<section class="cv-detail-group" aria-label={`${group.title} methods and evidence`}>
														<h4>Methods and evidence</h4>
														<ul>
															{group.methods.map((item) => (
																<li>{item}</li>
															))}
														</ul>
													</section>
												)}
											</div>
										</div>
									</article>
								);
							})}
						</div>
					</div>
				</section>

		<section class="cv-section cv-section--compact" id="impact" aria-labelledby="impact-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="impact-title">Engineering Outcomes</h2>
				</div>
				<ul class="cv-impact-list">
					{cvProfile.impactHighlights.map((highlight, index) => (
						<li>
							<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<p>{highlight}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="cv-section" id="experience" aria-labelledby="experience-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="experience-title">Experience</h2>
					<p>
						Selected professional experience across embedded controls, automotive software, electric vehicles,
						autonomous machines, diagnostics, validation, and technical leadership.
					</p>
				</div>

				<ol class="cv-timeline" aria-label="Professional experience timeline">
					{cvProfile.experience.map((item, index) => {
						const detailsId = `${experienceItemId(item, index)}-details`;
						const groupedDetails = groupExperienceDetails(item);
						const deliveryValidationCollaboration = [
							...groupedDetails.deliveryValidation,
							...groupedDetails.leadershipCollaboration,
						];
						const detailGroups = [
							groupedDetails.technicalScope.length > 0
								? { title: 'Technical scope', items: groupedDetails.technicalScope }
								: null,
							deliveryValidationCollaboration.length > 0
								? {
									title: 'Delivery, validation, and collaboration',
									items: deliveryValidationCollaboration,
								}
								: null,
						].filter((group): group is { title: string; items: string[] } => Boolean(group));
						const canExpand = hasExperienceDetails(groupedDetails);
						return (
                                                <li class={index === 0 ? 'cv-role cv-role--current' : 'cv-role'}>
                                                        <aside class="cv-role__milestone" aria-label={`${item.dates}${item.organization ? `, ${item.organization}` : ''}`}>
                                                                <span class="cv-role__marker" aria-hidden="true"></span>
                                                                <div class="cv-role__milestone-meta">
                                                                        <p class="cv-role__period">{item.dates}</p>
                                                                        {item.organization && <p class="cv-role__organization">{item.organization}</p>}
                                                                        {item.location && <p class="cv-role__location">{item.location}</p>}
                                                                </div>
                                                        </aside>
                                                        <article class="cv-role__content" data-experience-card data-experience-details-id={detailsId} data-expanded="false">
                                                                {canExpand && (
                                                                        <button
                                                                                class="cv-role__icon-button"
                                                                                type="button"
                                                                                aria-expanded="false"
                                                                                aria-controls={detailsId}
                                                                                aria-label={`View details for ${item.title}`}
                                                                                data-experience-toggle
                                                                                data-analytics="cv_experience_depth_open"
                                                                        >
                                                                                <span aria-hidden="true" data-experience-toggle-icon>+</span>
                                                                        </button>
                                                                )}
                                                                <header class="cv-role__header">
                                                                        <h3>{item.title}</h3>
                                                                        <p class="cv-role__summary">{item.summary}</p>
                                                                </header>
                                                                <ul class="cv-role__bullets" aria-label={`${item.title} key responsibilities`}>
                                                                        {item.highlights.slice(0, 3).map((highlight) => (
                                                                                <li>{highlight}</li>
                                                                        ))}
                                                                </ul>
								<ul class="cv-chip-list" aria-label={`${item.title} technologies and methods`}>
									{item.tags.slice(0, 8).map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
								{canExpand && (
									<button
										class="cv-role__toggle"
										type="button"
										aria-expanded="false"
										aria-controls={detailsId}
										data-experience-toggle
										data-analytics="cv_experience_depth_open"
									>
										<span data-experience-toggle-label>Technical details</span>
										<span aria-hidden="true" data-experience-toggle-icon>+</span>
									</button>
								)}
								{canExpand && (
									<div id={detailsId} class="cv-role__details" data-experience-details hidden>
										<div class={detailGroups.length === 1 ? 'cv-role__details-grid cv-role__details-grid--single' : 'cv-role__details-grid'}>
											{detailGroups.map((group) => (
												<section class="cv-detail-group" aria-label={`${item.title} ${group.title.toLowerCase()}`}>
													<h4>{group.title}</h4>
													<ul>
														{group.items.map((detail) => (
															<li>{detail}</li>
														))}
													</ul>
												</section>
											))}
										</div>
									</div>
								)}
							</article>
						</li>
                                                );
                                        })}
                                        <li class="cv-role cv-role--earlier">
                                                <aside class="cv-role__milestone" aria-label="May 2013-2014, Earlier experience">
                                                        <span class="cv-role__marker" aria-hidden="true"></span>
                                                        <div class="cv-role__milestone-meta">
                                                                <p class="cv-role__period">May 2013-2014</p>
                                                                <p class="cv-role__organization">Earlier experience</p>
                                                        </div>
                                                </aside>
                                                <section class="cv-role__content cv-role__content--earlier" aria-label="Earlier experience roles">
                                                        <div class="cv-earlier-grid">
                                                                {cvProfile.earlierExperience.map((item, index) => {
                                                                        const detailsId = `${earlierExperienceItemId(item, index)}-details`;
                                                                        const titleId = `${earlierExperienceItemId(item, index)}-title`;

                                                                        return (
                                                                                <article
                                                                                        class="cv-role__content cv-role__content--compact cv-earlier-card"
                                                                                        data-earlier-experience-card
                                                                                        data-earlier-experience-details-id={detailsId}
                                                                                        data-expanded="false"
                                                                                        aria-labelledby={titleId}
                                                                                >
                                                                                        <header class="cv-role__header cv-role__header--compact">
                                                                                                <p class="cv-role__meta-inline">
                                                                                                        <span>{item.dates}</span>
                                                                                                        <span>{item.organization}</span>
                                                                                                </p>
                                                                                                <h4 id={titleId} class="cv-role__title cv-role__title--compact">{item.title}</h4>
                                                                                                <p class="cv-role__summary cv-role__summary--compact">{item.summary}</p>
                                                                                        </header>
                                                                                        <button
                                                                                                class="cv-role__toggle cv-role__toggle--compact"
                                                                                                type="button"
                                                                                                aria-expanded="false"
                                                                                                aria-controls={detailsId}
                                                                                                data-earlier-experience-toggle
                                                                                                data-analytics="cv_earlier_experience_open"
                                                                                        >
                                                                                                <span data-earlier-experience-toggle-label>Technical details</span>
                                                                                                <span aria-hidden="true" data-earlier-experience-toggle-icon>+</span>
                                                                                        </button>
                                                                                        <div class="cv-role__details cv-role__details--compact" id={detailsId} data-earlier-experience-details hidden>
                                                                                                <section class="cv-detail-group" aria-label={`${item.title} details`}>
                                                                                                        <h5>Details</h5>
                                                                                                        <ul>
                                                                                                                {item.bullets.map((bullet) => (
                                                                                                                        <li>{bullet}</li>
                                                                                                                ))}
                                                                                                        </ul>
                                                                                                </section>
                                                                                        </div>
                                                                                </article>
                                                                        );
                                                                })}
                                                        </div>
                                                </section>
                                        </li>
                                </ol>
                        </div>
                </section>

		<section class="cv-section" id="case-studies" aria-labelledby="case-studies-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="case-studies-title">Selected Case Studies</h2>
					<p>Control concepts translated into embedded software for electrified, autonomous, and safety-relevant systems.</p>
				</div>
				<div class="cv-case-grid">
					{cvProfile.caseStudies.map((item) => (
						<article class="cv-card cv-case-card cv-card--interactive" data-analytics="cv_case_study_view">
							<h3>{item.title}</h3>
							<p>{item.statement}</p>
							<dl>
								<div>
									<dt>Role</dt>
									<dd>{item.role}</dd>
								</div>
								<div>
									<dt>Focus</dt>
									<dd>{item.focus}</dd>
								</div>
								<div>
									<dt>Proof</dt>
									<dd>{item.proof}</dd>
								</div>
							</dl>
							<!-- TODO: Add "View related work" links when dedicated Work entries exist. -->
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="cv-section" id="research" aria-labelledby="research-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="research-title">Research, Patents & Publications</h2>
					<p>{cvProfile.research.intro}</p>
				</div>

				<div class="cv-research-layout">
					<article class="cv-card">
						<h3>Research themes</h3>
						<ul class="cv-chip-list" aria-label="Research themes">
							{cvProfile.research.themes.map((theme) => (
								<li>{theme}</li>
							))}
						</ul>
					</article>
					<article class="cv-card">
						<h3>Research evidence</h3>
						<ul class="cv-research-stats">
							{cvProfile.research.evidence.map((item) => (
								<li>
									<strong>{item.value}</strong>
									<span>{item.label}</span>
								</li>
							))}
						</ul>
					</article>
				</div>

				<article class="cv-card cv-publications">
					<h3>Published research outcomes</h3>
					<ul>
						{cvProfile.research.outcomes.map((outcome) => (
							<li>{outcome}</li>
						))}
					</ul>
					<details class="cv-disclosure" data-analytics="cv_patents_open">
						<summary>Show patent records</summary>
						<ul class="cv-disclosure__content cv-compact-list">
							{cvProfile.research.patents.map((patent) => (
								<li>{patent}</li>
							))}
						</ul>
					</details>
					<details class="cv-disclosure" data-analytics="cv_publications_open">
						<summary>Show selected publication records</summary>
						<ol class="cv-disclosure__content">
							{cvProfile.research.selectedPublications.map((publication) => (
								<li>{publication}</li>
							))}
							{cvProfile.research.additionalPublications.map((publication) => (
								<li>{publication}</li>
							))}
						</ol>
					</details>
				</article>
			</div>
		</section>

		<section class="cv-section" id="education" aria-labelledby="education-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="education-title">Education</h2>
				</div>
				<div class="cv-card-grid cv-card-grid--education">
					{cvProfile.education.map((item) => (
						<article class="cv-card cv-education-card cv-card--interactive">
							<p class="cv-card__meta">{item.year}</p>
							<h3>{item.degree}</h3>
							{item.dissertation && (
								<p><strong>Dissertation:</strong> {item.dissertation}</p>
							)}
							{item.focus && <p><strong>Focus:</strong> {item.focus}</p>}
							<p>{item.description}</p>
							{item.links && (
								<ul class="cv-link-list" aria-label={`${item.degree} links`}>
									{item.links.map((link) => (
										<li>
											<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
										</li>
									))}
								</ul>
							)}
						</article>
					))}
				</div>
			</div>
		</section>

				<section class="cv-section" id="tools" aria-labelledby="tools-title" data-cv-section>
					<div class="page-container">
						<div class="cv-section__intro">
							<h2 id="tools-title">Tools, Methods, Standards, and Languages</h2>
						</div>
						<div class="cv-card-grid cv-card-grid--tools">
					{toolGroupsWithExtensions.map(({ group, extended }) => (
						<article class="cv-card cv-card--compact cv-tool-card">
							<h3>{group.title}</h3>
							<ul class="cv-chip-list" aria-label={`${group.title} list`}>
								{group.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
							{extended && (
								<details class="cv-disclosure cv-disclosure--inline cv-tool-card__details" data-analytics="cv_extended_stack_open">
									<summary>Show more</summary>
									<ul class="cv-chip-list cv-chip-list--extended" aria-label={`${extended.title} extended list`}>
										{extended.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</details>
							)}
						</article>
					))}
					<article class="cv-card cv-card--compact">
						<h3>Languages</h3>
						<ul class="cv-language-list">
							{cvProfile.languages.map((item) => (
								<li>
									<strong>{item.language}</strong>
									<span>{item.level}</span>
								</li>
							))}
						</ul>
					</article>
				</div>

				<section class="cv-courses" aria-labelledby="courses-title">
					<h3 id="courses-title">Courses &amp; Recognition</h3>
					<ul class="cv-impact-list cv-impact-list--compact">
						{cvProfile.coursesAndRecognition.featured.map((item, index) => (
							<li>
								<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
