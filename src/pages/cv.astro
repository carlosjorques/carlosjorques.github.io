		summary: '[One-line contribution placeholder.]',
		meta: '[Domain placeholder] · [Associated role or period placeholder]',
	},
];

const credentialGroups: CredentialGroup[] = [
	{
		id: 'credential-education',
		title: 'Education',
		visibleItems: ['[Education record placeholder]'],
	},
	{
		id: 'credential-research',
		title: 'Research and publications',
		visibleItems: ['[Research summary placeholder]'],
		disclosure: {
			collapsedLabel: 'See publications',
			expandedLabel: 'Hide publications',
			details: ['[Publication placeholder 01]', '[Publication placeholder 02]', '[Publication placeholder 03]'],
		},
	},
	{
		id: 'credential-patents',
		title: 'Patents',
		visibleItems: ['[Patent summary placeholder]'],
		disclosure: {
			collapsedLabel: 'See all patents',
			expandedLabel: 'Hide patents',
			details: ['[Patent placeholder 01]', '[Patent placeholder 02]', '[Patent placeholder 03]'],
		},
	},
	{
