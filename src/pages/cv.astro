<script is:inline>
	(() => {
		const progressBar = document.querySelector('[data-cv-scroll-progress]');
		const scrollJump = document.querySelector('[data-cv-scroll-jump]');
		const navLinks = Array.from(document.querySelectorAll('[data-cv-section-link]'));
		const sections = navLinks
			.map((link) => {
				const href = link.getAttribute('href');
				return href ? document.querySelector(href) : null;
			})
			.filter(Boolean);

		if (progressBar) {
			let progressFrame = 0;

			const updateProgress = () => {
				progressFrame = 0;
				const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
				const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
				progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
			};

			const requestProgressUpdate = () => {
				if (progressFrame === 0) {
					progressFrame = window.requestAnimationFrame(updateProgress);
				}
			};

			updateProgress();
			window.addEventListener('scroll', requestProgressUpdate, { passive: true });
			window.addEventListener('resize', requestProgressUpdate);
		}

		if (scrollJump) {
			scrollJump.addEventListener('click', (event) => {
				event.preventDefault();
				window.scrollTo({
					top: 0,
					behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
				});
			});
		}

		if ('IntersectionObserver' in window && navLinks.length > 0 && sections.length > 0) {
			const setActiveSection = (id) => {
				navLinks.forEach((link) => {
					const isActive = link.getAttribute('href') === `#${id}`;
					if (isActive) {
						link.setAttribute('aria-current', 'true');
					} else {
						link.removeAttribute('aria-current');
					}
				});
			};

			const observer = new IntersectionObserver(
				(entries) => {
					const activeEntry = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

					if (activeEntry?.target?.id) {
						setActiveSection(activeEntry.target.id);
					}
				},
				{
					rootMargin: '-24% 0px -58% 0px',
					threshold: [0.1, 0.25, 0.5],
				}
			);

			sections.forEach((section) => observer.observe(section));
		}

		const emitAnalyticsEvent = (element) => {
			window.dispatchEvent(
				new CustomEvent('cv:analytics', {
					detail: {
						event: element.dataset.analytics,
						href: element.getAttribute?.('href') ?? undefined,
					},
				})
			);
		};

		document.querySelectorAll('a[data-analytics]').forEach((link) => {
			link.addEventListener('click', () => emitAnalyticsEvent(link));
		});

		const expertiseCards = Array.from(document.querySelectorAll('[data-expertise-card]'));

		const setActiveExpertiseCard = (activeCard) => {
			expertiseCards.forEach((card) => {
				const isActive = Boolean(activeCard) && card === activeCard;
				const panelId = card.dataset.panelId;
				card.dataset.expanded = String(isActive);

				card.querySelectorAll('[data-expertise-toggle]').forEach((toggle) => {
					toggle.setAttribute('aria-expanded', String(isActive));

					if (toggle.classList.contains('cv-expertise-card__icon-button')) {
						const title = card.querySelector('.cv-expertise-card__title')?.textContent?.trim() ?? 'this expertise area';
						toggle.setAttribute('aria-label', `${isActive ? 'Hide' : 'View'} details for ${title}`);
						const icon = toggle.querySelector('[aria-hidden="true"]');
						if (icon) {
							icon.textContent = isActive ? '-' : '+';
						}
					}
				});

				card.querySelectorAll('[data-expertise-toggle-label]').forEach((label) => {
					label.textContent = isActive ? 'Hide details' : 'View details';
				});

				card.querySelectorAll('[data-expertise-detail]').forEach((panel) => {
					if (panel.id === panelId) {
						panel.hidden = !isActive;
					}
				});
			});
		};

		document.querySelectorAll('[data-expertise-toggle]').forEach((button) => {
			button.addEventListener('click', () => {
				const card = button.closest('[data-expertise-card]');

				if (!card) {
					return;
				}

				const shouldExpand = card.dataset.expanded !== 'true';
				setActiveExpertiseCard(shouldExpand ? card : null);

				if (shouldExpand && button instanceof HTMLElement && button.dataset.analytics) {
					emitAnalyticsEvent(button);
				}
			});
		});

		const experienceCards = Array.from(document.querySelectorAll('[data-experience-card]'));

		const setActiveExperienceCard = (activeCard) => {
			experienceCards.forEach((card) => {
				const isActive = Boolean(activeCard) && card === activeCard;
				const detailsId = card.dataset.experienceDetailsId;
				card.dataset.expanded = String(isActive);

				card.querySelectorAll('[data-experience-toggle]').forEach((toggle) => {
					toggle.setAttribute('aria-expanded', String(isActive));

					if (toggle.classList.contains('cv-role__icon-button')) {
						const title = card.querySelector('.cv-role__header h3')?.textContent?.trim() ?? 'this experience';
						toggle.setAttribute('aria-label', `${isActive ? 'Hide' : 'View'} details for ${title}`);
					}
				});

				card.querySelectorAll('[data-experience-toggle-label]').forEach((label) => {
					label.textContent = isActive ? 'Hide details' : 'Technical details';
				});

				card.querySelectorAll('[data-experience-toggle-icon]').forEach((icon) => {
					icon.textContent = isActive ? '-' : '+';
				});

				card.querySelectorAll('[data-experience-details]').forEach((details) => {
					if (details.id === detailsId) {
						details.hidden = !isActive;
					}
				});
			});
		};

                document.querySelectorAll('[data-experience-toggle]').forEach((button) => {
                        button.addEventListener('click', () => {
                                const card = button.closest('[data-experience-card]');

                                if (!card) {
					return;
				}

				const shouldExpand = card.dataset.expanded !== 'true';
				setActiveExperienceCard(shouldExpand ? card : null);

				if (shouldExpand && button instanceof HTMLElement && button.dataset.analytics) {
					emitAnalyticsEvent(button);
                                }
                        });
                });

                const earlierExperienceCards = Array.from(document.querySelectorAll('[data-earlier-experience-card]'));

                const setActiveEarlierExperienceCard = (activeCard) => {
                        earlierExperienceCards.forEach((card) => {
                                const isActive = Boolean(activeCard) && card === activeCard;
                                const detailsId = card.dataset.earlierExperienceDetailsId;
                                card.dataset.expanded = String(isActive);

                                card.querySelectorAll('[data-earlier-experience-toggle]').forEach((toggle) => {
                                        toggle.setAttribute('aria-expanded', String(isActive));
                                });

                card.querySelectorAll('[data-earlier-experience-toggle-label]').forEach((label) => {
                                        label.textContent = isActive ? 'Hide details' : 'Technical details';
                                });

                                card.querySelectorAll('[data-earlier-experience-toggle-icon]').forEach((icon) => {
                                        icon.textContent = isActive ? '-' : '+';
                                });

                                card.querySelectorAll('[data-earlier-experience-details]').forEach((details) => {
                                        if (details.id === detailsId) {
                                                details.hidden = !isActive;
                                        }
                                });
                        });
                };

                document.querySelectorAll('[data-earlier-experience-toggle]').forEach((button) => {
                        button.addEventListener('click', () => {
                                const card = button.closest('[data-earlier-experience-card]');

                                if (!card) {
                                        return;
                                }

                                const shouldExpand = card.dataset.expanded !== 'true';
                                setActiveEarlierExperienceCard(shouldExpand ? card : null);

                                if (shouldExpand && button instanceof HTMLElement && button.dataset.analytics) {
                                        emitAnalyticsEvent(button);
                                }
                        });
                });

                document.querySelectorAll('details[data-analytics]').forEach((details) => {
                        details.addEventListener('toggle', () => {
                                if (!details.open) {
                                        return;
                                }

				emitAnalyticsEvent(details);
			});
		});
	})();
</script>

