const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) =>
	href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')
		? href
		: `${normalizedBase}${href.replace(/^\//, '')}`;

const unpublishedMarker = ['place', 'holder'].join('');
const unpublishedFragmentPattern = new RegExp(
	String.raw`\[[^\]]*(?:${unpublishedMarker}|location|selected|specific)[^\]]*\]`,
	'gi',
);
const cleanDisplayText = (value?: string) =>
	(value ?? '')
		.replace(unpublishedFragmentPattern, '')
		.replace(/\s*·\s*(?=·|$)/g, '')
		.replace(/(^|\s)·\s*$/g, '')
		.replace(/\s{2,}/g, ' ')
		.trim();
const hasVisibleText = (value?: string) => Boolean(cleanDisplayText(value));
const visibleItems = (items?: string[]) => (items ?? []).map(cleanDisplayText).filter(Boolean);
const hasVisibleLink = (label?: string, href?: string) => hasVisibleText(label) && hasVisibleText(href);
const detailGroupTitleMap: Record<string, string> = {
	'Selected outcomes': 'Selected impact',
	'Validation/production context': 'Validation and delivery',
	'Related-project links': 'Related selected work',
};
const detailGroupOrder = [
	'Selected impact',
	'Technical scope',
	'Validation and delivery',
	'Leadership and collaboration',
	'Related selected work',
];
const visibleDetailGroups = (groups?: DetailGroup[]) =>
	(groups ?? [])
		.map((group) => ({ ...group, title: detailGroupTitleMap[group.title] ?? group.title, items: visibleItems(group.items) }))
		.filter((group) => detailGroupOrder.includes(group.title) && group.items.length > 0)
		.sort((a, b) => detailGroupOrder.indexOf(a.title) - detailGroupOrder.indexOf(b.title));

