			gap: 1.25rem 1.5rem;
		}
	}

	@media (max-width: 980px) {
		.cv-hero__inner,
		.cv-section__layout,
		.cv-experience-group__section {
			grid-template-columns: 1fr;
		}

		.cv-experience-group__header-stick {
			position: static;
			top: auto;
			padding-bottom: 0;
		}

	}

	@media (max-width: 760px) {
		.cv-section-nav-float {
			opacity: 0;
			pointer-events: none;
				transform: translateY(0.5rem);
				transition:
					opacity var(--motion-duration-fast-02) var(--motion-standard-productive),
					transform var(--motion-duration-fast-02) var(--motion-standard-productive);
			visibility: visible;
		}

		.cv-section-nav-float:focus-within,
		.cv-page[data-cv-scrolling='true'] .cv-section-nav-float {
			opacity: 1;
			pointer-events: auto;
			transform: none;
			visibility: visible;
			transition-delay: 0s;
		}

		.cv-page {
			width: min(calc(100% - 2rem), var(--content-width));
			padding-bottom: 5.5rem;
		}

		.cv-hero {
			padding: 3rem 0 2rem;
		}

		.cv-hero .hero-title {
			font-size: clamp(2.15rem, 10vw, 2.45rem);
			line-height: 1.04;
		}

		.cv-card-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cv-page *,
		.cv-page *::before,
		.cv-page *::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			scroll-behavior: auto !important;
			transition-duration: 0.001ms !important;
		}
	}

	@media print {
		:global(.site-header),
		:global(.site-footer),
		:global(.skip-link),
		.cv-section-nav-float,
		.cv-disclosure-button,
		.cv-see-all-button,
		.cv-secondary-details > summary {
			display: none !important;
		}

		.cv-secondary-details > .cv-secondary-details__body {
			display: grid !important;
		}

		.cv-page {
			width: 100%;
			padding-bottom: 0;
		}

		.cv-hero,
		.cv-section {
			padding: 1rem 0;
			background: transparent;
		}

		.cv-disclosure-panel[hidden] {
			display: grid !important;
		}

		.cv-role--extra[hidden] {
			display: list-item !important;
		}

		.cv-card,
		.cv-role__card,
		.cv-project-row,
		.cv-credential-group,
		.cv-method-group {
			break-inside: avoid;
		}

		.cv-experience-group__header-stick {
			position: static;
			top: auto;
			background: transparent;
		}
	}
</style>

<script is:inline>
	(() => {
		const root = document;
		const cvPage = root.querySelector('.cv-page');
		const toggles = Array.from(root.querySelectorAll('[data-disclosure-toggle]'));
		const navLinks = Array.from(root.querySelectorAll('[data-cv-nav-link]'));
		const sectionNav = root.querySelector('.cv-section-nav-float');
		const sectionNavTrigger = root.getElementById('cv-sections-trigger');
		const sectionMenu = root.getElementById('cv-sections-menu');
		const closingSection = root.querySelector('.cv-closing');
		const seeAllRolesButton = root.querySelector('[data-see-all-roles]');
		const extraRoles = Array.from(root.querySelectorAll('[data-role-visibility="extra"]'));

		const setDisclosureState = (button, expanded) => {
			const panelId = button.getAttribute('aria-controls');
			if (!panelId) return;

			const panel = root.getElementById(panelId);
			if (!panel) return;

			button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
			const collapsedLabel = button.getAttribute('data-label-collapsed') ?? 'View details';
			const expandedLabel = button.getAttribute('data-label-expanded') ?? 'Hide details';
			const label = button.querySelector('span');
			if (label) label.textContent = expanded ? expandedLabel : collapsedLabel;
			panel.hidden = !expanded;
			panel.inert = !expanded;
		};

		toggles.forEach((button) => {
			setDisclosureState(button, button.getAttribute('aria-expanded') === 'true');
			button.addEventListener('click', () => {
				const expanded = button.getAttribute('aria-expanded') === 'true';
				setDisclosureState(button, !expanded);
			});
		});

		const setExtraRolesState = (expanded) => {
			extraRoles.forEach((role) => {
				role.hidden = !expanded;
			});

			if (seeAllRolesButton instanceof HTMLButtonElement) {
				seeAllRolesButton.setAttribute('aria-expanded', expanded ? 'true' : 'false');
				const collapsedLabel = seeAllRolesButton.getAttribute('data-label-collapsed') ?? 'See earlier experience';
				const expandedLabel = seeAllRolesButton.getAttribute('data-label-expanded') ?? 'Hide earlier experience';
				seeAllRolesButton.textContent = expanded ? expandedLabel : collapsedLabel;
			}

		};

		if (extraRoles.length > 0) {
			setExtraRolesState(false);
			seeAllRolesButton?.addEventListener('click', () => {
				const expanded = seeAllRolesButton.getAttribute('aria-expanded') === 'true';
				setExtraRolesState(!expanded);
			});
		}

		const setSectionMenuState = (open, restoreFocus = false) => {
			if (!(sectionNavTrigger instanceof HTMLButtonElement) || !(sectionMenu instanceof HTMLElement)) return;

			sectionNavTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
			sectionMenu.hidden = !open;
			if (!open && restoreFocus) sectionNavTrigger.focus();
		};

		if (sectionNavTrigger instanceof HTMLButtonElement && sectionMenu instanceof HTMLElement) {
			setSectionMenuState(false);
			sectionNavTrigger.addEventListener('click', () => {
				const open = sectionNavTrigger.getAttribute('aria-expanded') === 'true';
				setSectionMenuState(!open);
			});

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && sectionNavTrigger.getAttribute('aria-expanded') === 'true') {
					setSectionMenuState(false, true);
				}
			});

			document.addEventListener('pointerdown', (event) => {
				if (sectionNavTrigger.getAttribute('aria-expanded') !== 'true') return;
				if (event.target instanceof Node && sectionNav?.contains(event.target)) return;
				setSectionMenuState(false);
			});
		}

		const sections = navLinks
			.map((link) => {
				const target = link.getAttribute('data-target');
				if (!target) return null;
				const section = root.getElementById(target);
				return section ? { id: target, section } : null;
			})
			.filter(Boolean);

		if (sections.length > 0) {
			const setActiveLink = (id) => {
				navLinks.forEach((link) => {
					link.setAttribute('aria-current', link.getAttribute('data-target') === id ? 'true' : 'false');
				});
			};

			const updateActiveSection = () => {
				const probeLine = Math.min(window.innerHeight * 0.35, 240);
				const sectionOffsets = sections.map((item) => {
					const rect = item.section.getBoundingClientRect();
					return {
						id: item.id,
						top: rect.top,
						bottom: rect.bottom,
					};
				});

				const containing = sectionOffsets.find((item) => item.top <= probeLine && item.bottom > probeLine);
				if (containing) {
					setActiveLink(containing.id);
					return;
				}

				const pastSections = sectionOffsets.filter((item) => item.top <= probeLine);
				if (pastSections.length > 0) {
					setActiveLink(pastSections[pastSections.length - 1].id);
					return;
				}

				setActiveLink(sectionOffsets[0].id);
			};

			let ticking = false;
			const requestUpdate = () => {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(() => {
					updateActiveSection();
					ticking = false;
				});
			};

			requestUpdate();
			window.addEventListener('scroll', requestUpdate, { passive: true });
			window.addEventListener('resize', requestUpdate);
		}

		if (sectionNav && closingSection instanceof HTMLElement && 'IntersectionObserver' in window) {
			const contactObserver = new IntersectionObserver(([entry]) => {
				sectionNav.toggleAttribute('data-cv-nav-suppressed', entry.isIntersecting);
			}, { threshold: 0.15 });
			contactObserver.observe(closingSection);
		}

		navLinks.forEach((link) => {
			link.addEventListener('click', () => {
				link.blur();
				setSectionMenuState(false);
			});
		});

		if (cvPage && sectionNav) {
			let scrollIdleTimer;
			const showMobileNavWhileScrolling = () => {
				if (!window.matchMedia('(max-width: 760px)').matches) return;
				cvPage.setAttribute('data-cv-scrolling', 'true');
				window.clearTimeout(scrollIdleTimer);
				scrollIdleTimer = window.setTimeout(() => {
					if (sectionNavTrigger?.getAttribute('aria-expanded') !== 'true') {
						cvPage.removeAttribute('data-cv-scrolling');
					}
				}, 1200);
			};

			window.addEventListener('scroll', showMobileNavWhileScrolling, { passive: true });
		}
	})();
</script>
