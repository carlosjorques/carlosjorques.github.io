};

type DetailGroup = {
	title: string;
	items?: string[];
};

type ExpertiseItem = {
	id: string;
	title: string;
	scope: string;
	ownership: string;
	evidence: string[];
	methodsAndConstraints: string[];
	relatedProject?: {
