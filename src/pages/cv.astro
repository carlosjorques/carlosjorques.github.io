			{ title: 'Technical scope', items: ['[Technical-scope placeholder 01]', '[Technical-scope placeholder 02]'] },
			{ title: 'Leadership and collaboration', items: ['[Leadership placeholder 01]', '[Leadership placeholder 02]'] },
