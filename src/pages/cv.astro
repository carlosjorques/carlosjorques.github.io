	.cv-section { display:grid; grid-template-columns:16rem minmax(0,1fr); gap:0 2rem; padding:1rem 0 clamp(2.5rem,5vw,4rem); border-top:1px solid var(--color-border); scroll-margin-top:2rem; }
	.cv-rail { display:grid; align-content:start; gap:.5rem; padding-top:.25rem; }
