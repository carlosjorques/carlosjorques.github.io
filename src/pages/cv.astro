---
import Layout from '../layouts/Layout.astro';
import { cvProfile } from '../data/cvMarkdown';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => {
	if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
		return href;
	}

	return href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`;
};

const getRoleDetailCount = (item: (typeof cvProfile.experience)[number]) =>
	(item.detailGroups ?? []).reduce((count, group) => count + group.items.length, 0);

const toolGroupsWithExtensions = cvProfile.tools.map((group, index) => ({
	group,
	extended: cvProfile.extendedTools[index] ?? null,
}));

const profileJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	mainEntity: {
		'@type': 'Person',
		name: cvProfile.hero.title,
		jobTitle: 'Senior Electronics Engineer and Embedded Controls Architect',
		description:
			'Senior electronics and embedded controls engineer specializing in EV thermal management, BMS, autonomous propulsion control, diagnostics, functional safety, model-based development, and real-time embedded software.',
		url: Astro.url.href,
		sameAs: [cvProfile.links.linkedin],
	},
};
---

<Layout
	title="Senior Embedded Controls Engineer CV | Carlos Jorques"
	description="Senior electronics and embedded controls engineer specializing in EV thermal management, BMS, autonomous propulsion control, diagnostics, functional safety, model-based development, and real-time embedded software."
>
	<script type="application/ld+json" set:html={JSON.stringify(profileJsonLd)} />

	<div class="cv-page">
		<div class="cv-scroll-progress" aria-hidden="true">
			<span class="cv-scroll-progress__bar" data-cv-scroll-progress></span>
		</div>

		<a class="cv-scroll-jump" href="#top" aria-label="Scroll to the top of the page" data-cv-scroll-jump>
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<path d="M12 17V7.5" />
				<path d="M8.75 10.75 12 7.5l3.25 3.25" />
			</svg>
		</a>

		<section class="cv-hero" aria-labelledby="cv-title">
			<div class="page-container cv-hero__inner">
				<div class="cv-hero__content">
					<h1 id="cv-title" class="cv-hero__name hero-title">{cvProfile.hero.title}</h1>
					<p class="cv-hero__subtitle hero-role cv-hero__role">{cvProfile.hero.subtitle}</p>
					<p class="cv-hero__summary hero-summary">{cvProfile.hero.summary}</p>
					<p class="cv-hero__extended">{cvProfile.hero.secondarySummary}</p>

					<div class="button-row cv-actions" aria-label="CV actions">
						{cvProfile.actions.map((action) => (
							<a
								class={action.primary ? 'button primary' : 'button'}
								href={withBase(action.href)}
								target={action.external ? '_blank' : undefined}
								rel={action.external ? 'noopener noreferrer' : undefined}
								download={action.download ? true : undefined}
								data-analytics={action.analytics}
							>
								{action.label}
							</a>
						))}
					</div>
				</div>

				<aside class="cv-hero__evidence" aria-label="Recruiter snapshot">
					<ul class="cv-proof-grid" aria-label="Career proof points">
						{cvProfile.proofTiles.map((tile) => (
							<li>
								<strong>{tile.value}</strong>
								<span>{tile.label}</span>
							</li>
						))}
					</ul>

					<div class="cv-role-strip" aria-label="Relevant roles">
						<p>Relevant for</p>
						<ul class="cv-chip-list cv-chip-list--strong">
							{cvProfile.relevantFor.map((role) => (
								<li>{role}</li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</section>

		<div class="page-container cv-shell">
			<nav class="cv-section-nav" aria-label="CV sections">
				<div class="cv-section-nav__inner">
					<span>CV sections</span>
					<ul>
						{cvProfile.sectionNav.map((item) => (
							<li>
								<a href={item.href} data-cv-section-link data-analytics="cv_section_nav_click">{item.label}</a>
							</li>
						))}
					</ul>
					<div class="cv-section-nav__actions" aria-label="CV quick actions">
						<a href={withBase(cvProfile.links.pdf)} download data-analytics="cv_pdf_download">Download PDF</a>
						<a href={withBase(cvProfile.links.contact)} data-analytics="cv_contact_click">Contact</a>
					</div>
				</div>
			</nav>

			<div class="cv-main-flow">
			<section class="cv-section cv-readable" id="summary" aria-labelledby="summary-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="summary-title">Summary</h2>
				</div>
				<div class="cv-summary-block">
					{cvProfile.executiveSummary.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</div>
			</div>
		</section>

		<section class="cv-section" id="expertise" aria-labelledby="expertise-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="expertise-title">Core Expertise</h2>
				</div>
				<div class="cv-featured-expertise-grid">
					{cvProfile.expertise.map((group, index) => (
						<article class={index === 0 ? 'cv-card cv-card--interactive cv-expertise-card cv-expertise-card--featured' : 'cv-card cv-card--interactive cv-expertise-card'}>
							<h3>{group.title}</h3>
							<ul>
								{group.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
							{group.evidence && group.evidence.length >= 4 && (
								<details class="cv-disclosure cv-disclosure--inline" data-analytics="cv_expertise_evidence_open">
									<summary>Technical evidence</summary>
									<ul class="cv-disclosure__content">
										{group.evidence.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</details>
							)}
							{group.chips && (
								<ul class="cv-chip-list" aria-label={`${group.title} methods`}>
									{group.chips.map((chip) => (
										<li>{chip}</li>
									))}
								</ul>
							)}
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="cv-section cv-section--compact" id="impact" aria-labelledby="impact-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="impact-title">Engineering Outcomes</h2>
				</div>
				<ul class="cv-impact-list">
					{cvProfile.impactHighlights.map((highlight, index) => (
						<li>
							<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<p>{highlight}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="cv-section" id="experience" aria-labelledby="experience-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="experience-title">Experience</h2>
				</div>

				<div class="cv-timeline" aria-label="Professional experience timeline">
					{cvProfile.experience.map((item, index) => (
						<article class={index === 0 ? 'cv-role cv-role--current' : 'cv-role'}>
							<div class="cv-role__marker current-role-marker" aria-hidden="true">
								<span>{String(index + 1).padStart(2, '0')}</span>
							</div>
							<div class="cv-role__content">
								<div class="cv-role__header">
									<div>
										<p class="cv-role__period">{item.dates}</p>
										{item.organization && <p class="cv-role__organization">{item.organization}</p>}
										<h3>{item.title}</h3>
									</div>
									{item.location && <p class="cv-role__location">{item.location}</p>}
								</div>
								<p class="cv-role__summary">{item.summary}</p>
								<div class="cv-role__ownership">
									<h4>Key ownership</h4>
									<ul class="cv-role__bullets">
										{item.highlights.slice(0, 2).map((highlight) => (
											<li>{highlight}</li>
										))}
									</ul>
								</div>
								<ul class="cv-chip-list" aria-label={`${item.title} technologies and methods`}>
									{item.tags.slice(0, 8).map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
								{getRoleDetailCount(item) >= 4 && (
									<details class="cv-disclosure" data-analytics="cv_experience_depth_open">
										<summary>{item.detailGroups?.[0]?.title ?? 'Technical details'}</summary>
										<div class="cv-disclosure__content">
											{item.detailGroups?.map((group) => (
												<section class="cv-detail-group" aria-label={group.title}>
													<h4>{group.title}</h4>
													<ul>
														{group.items.map((detail) => (
															<li>{detail}</li>
														))}
													</ul>
												</section>
											))}
										</div>
									</details>
								)}
							</div>
						</article>
					))}
				</div>

				<section class="cv-earlier-experience" aria-labelledby="earlier-experience-title">
					<div class="cv-section__intro cv-section__intro--tight">
						<h3 id="earlier-experience-title">Earlier experience</h3>
						<p>Earlier roles covering thesis work at Scania, hardware engineering, and software research.</p>
					</div>
					<div class="cv-card-grid cv-card-grid--three">
						{cvProfile.earlierExperience.map((item) => (
							<article class="cv-card cv-card--compact">
								<p class="cv-card__meta">{item.dates}</p>
								<h3>{item.title} - {item.organization}</h3>
								<p>{item.summary}</p>
							</article>
						))}
					</div>
					<details class="cv-disclosure cv-disclosure--wide" data-analytics="cv_earlier_experience_open">
						<summary>Earlier experience details</summary>
						<div class="cv-disclosure__content cv-earlier-details">
							{cvProfile.earlierExperience.map((item) => (
								<section class="cv-detail-group" aria-label={`${item.title} details`}>
									<h4>{item.title} - {item.organization}</h4>
									<ul>
										{item.bullets.map((bullet) => (
											<li>{bullet}</li>
										))}
									</ul>
								</section>
							))}
						</div>
					</details>
				</section>
			</div>
		</section>

		<section class="cv-section" id="case-studies" aria-labelledby="case-studies-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="case-studies-title">Selected Case Studies</h2>
					<p>Control concepts translated into embedded software for electrified, autonomous, and safety-relevant systems.</p>
				</div>
				<div class="cv-case-grid">
					{cvProfile.caseStudies.map((item) => (
						<article class="cv-card cv-case-card cv-card--interactive" data-analytics="cv_case_study_view">
							<h3>{item.title}</h3>
							<p>{item.statement}</p>
							<dl>
								<div>
									<dt>Role</dt>
									<dd>{item.role}</dd>
								</div>
								<div>
									<dt>Focus</dt>
									<dd>{item.focus}</dd>
								</div>
								<div>
									<dt>Proof</dt>
									<dd>{item.proof}</dd>
								</div>
							</dl>
							<!-- TODO: Add "View related work" links when dedicated Work entries exist. -->
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="cv-section" id="research" aria-labelledby="research-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="research-title">Research, Patents & Publications</h2>
					<p>{cvProfile.research.intro}</p>
				</div>

				<div class="cv-research-layout">
					<article class="cv-card">
						<h3>Research themes</h3>
						<ul class="cv-chip-list" aria-label="Research themes">
							{cvProfile.research.themes.map((theme) => (
								<li>{theme}</li>
							))}
						</ul>
					</article>
					<article class="cv-card">
						<h3>Research evidence</h3>
						<ul class="cv-research-stats">
							{cvProfile.research.evidence.map((item) => (
								<li>
									<strong>{item.value}</strong>
									<span>{item.label}</span>
								</li>
							))}
						</ul>
					</article>
				</div>

				<article class="cv-card cv-publications">
					<h3>Published research outcomes</h3>
					<ul>
						{cvProfile.research.outcomes.map((outcome) => (
							<li>{outcome}</li>
						))}
					</ul>
					<details class="cv-disclosure" data-analytics="cv_patents_open">
						<summary>Show patent records</summary>
						<ul class="cv-disclosure__content cv-compact-list">
							{cvProfile.research.patents.map((patent) => (
								<li>{patent}</li>
							))}
						</ul>
					</details>
					<details class="cv-disclosure" data-analytics="cv_publications_open">
						<summary>Show selected publication records</summary>
						<ol class="cv-disclosure__content">
							{cvProfile.research.selectedPublications.map((publication) => (
								<li>{publication}</li>
							))}
							{cvProfile.research.additionalPublications.map((publication) => (
								<li>{publication}</li>
							))}
						</ol>
					</details>
				</article>
			</div>
		</section>

		<section class="cv-section" id="education" aria-labelledby="education-title" data-cv-section>
			<div class="page-container">
				<div class="cv-section__intro">
					<h2 id="education-title">Education</h2>
				</div>
				<div class="cv-card-grid cv-card-grid--education">
					{cvProfile.education.map((item) => (
						<article class="cv-card cv-education-card cv-card--interactive">
							<p class="cv-card__meta">{item.year}</p>
							<h3>{item.degree}</h3>
							{item.dissertation && (
								<p><strong>Dissertation:</strong> {item.dissertation}</p>
							)}
							{item.focus && <p><strong>Focus:</strong> {item.focus}</p>}
							<p>{item.description}</p>
							{item.links && (
								<ul class="cv-link-list" aria-label={`${item.degree} links`}>
									{item.links.map((link) => (
										<li>
											<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
										</li>
									))}
								</ul>
							)}
						</article>
					))}
				</div>
			</div>
		</section>

				<section class="cv-section" id="tools" aria-labelledby="tools-title" data-cv-section>
					<div class="page-container">
						<div class="cv-section__intro">
							<h2 id="tools-title">Tools, Methods, Standards, and Languages</h2>
						</div>
						<div class="cv-card-grid cv-card-grid--tools">
					{toolGroupsWithExtensions.map(({ group, extended }) => (
						<article class="cv-card cv-card--compact cv-tool-card">
							<h3>{group.title}</h3>
							<ul class="cv-chip-list" aria-label={`${group.title} list`}>
								{group.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
							{extended && (
								<details class="cv-disclosure cv-disclosure--inline cv-tool-card__details" data-analytics="cv_extended_stack_open">
									<summary>Show more</summary>
									<ul class="cv-chip-list cv-chip-list--extended" aria-label={`${extended.title} extended list`}>
										{extended.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</details>
							)}
						</article>
					))}
					<article class="cv-card cv-card--compact">
						<h3>Languages</h3>
						<ul class="cv-language-list">
							{cvProfile.languages.map((item) => (
								<li>
									<strong>{item.language}</strong>
									<span>{item.level}</span>
								</li>
							))}
						</ul>
					</article>
				</div>

				<section class="cv-courses" aria-labelledby="courses-title">
					<h3 id="courses-title">Courses &amp; Recognition</h3>
					<ul class="cv-impact-list cv-impact-list--compact">
						{cvProfile.coursesAndRecognition.featured.map((item, index) => (
							<li>
								<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<p>{item}</p>
							</li>
						))}
					</ul>
					<details class="cv-disclosure cv-disclosure--wide" data-analytics="cv_courses_recognition_open">
						<summary>Show more courses and recognition</summary>
						<ul class="cv-disclosure__content">
							{cvProfile.coursesAndRecognition.additional.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</details>
				</section>
			</div>
		</section>

		<section class="cv-section cv-final" id="contact" aria-labelledby="contact-title" data-cv-section>
			<div class="page-container cv-final__inner">
				<div>
					<h2 id="contact-title">Let's Connect</h2>
					<p>{cvProfile.finalContact}</p>
				</div>
				<div class="button-row cv-final__actions" aria-label="Bottom CV actions">
					{cvProfile.actions.map((action) => (
						<a
							class={action.primary ? 'button primary' : 'button'}
							href={withBase(action.href)}
							target={action.external ? '_blank' : undefined}
							rel={action.external ? 'noopener noreferrer' : undefined}
							download={action.download ? true : undefined}
							data-analytics={action.analytics}
						>
							{action.label}
						</a>
					))}
				</div>
			</div>
		</section>
			</div>
		</div>
	</div>
</Layout>

<script is:inline>
	(() => {
		const progressBar = document.querySelector('[data-cv-scroll-progress]');
		const scrollJump = document.querySelector('[data-cv-scroll-jump]');
		const navLinks = Array.from(document.querySelectorAll('[data-cv-section-link]'));
		const sections = navLinks
			.map((link) => {
				const href = link.getAttribute('href');
				return href ? document.querySelector(href) : null;
			})
			.filter(Boolean);

		if (progressBar) {
			let progressFrame = 0;

			const updateProgress = () => {
				progressFrame = 0;
				const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
				const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
				progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
			};

			const requestProgressUpdate = () => {
				if (progressFrame === 0) {
					progressFrame = window.requestAnimationFrame(updateProgress);
				}
			};

			updateProgress();
			window.addEventListener('scroll', requestProgressUpdate, { passive: true });
			window.addEventListener('resize', requestProgressUpdate);
		}

		if (scrollJump) {
			scrollJump.addEventListener('click', (event) => {
				event.preventDefault();
				window.scrollTo({
					top: 0,
					behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
				});
			});
		}

		if ('IntersectionObserver' in window && navLinks.length > 0 && sections.length > 0) {
			const setActiveSection = (id) => {
				navLinks.forEach((link) => {
					const isActive = link.getAttribute('href') === `#${id}`;
					if (isActive) {
						link.setAttribute('aria-current', 'true');
					} else {
						link.removeAttribute('aria-current');
					}
				});
			};

			const observer = new IntersectionObserver(
				(entries) => {
					const activeEntry = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

					if (activeEntry?.target?.id) {
						setActiveSection(activeEntry.target.id);
					}
				},
				{
					rootMargin: '-24% 0px -58% 0px',
					threshold: [0.1, 0.25, 0.5],
				}
			);

			sections.forEach((section) => observer.observe(section));
		}

		const emitAnalyticsEvent = (element) => {
			window.dispatchEvent(
				new CustomEvent('cv:analytics', {
					detail: {
						event: element.dataset.analytics,
						href: element.getAttribute?.('href') ?? undefined,
					},
				})
			);
		};

		document.querySelectorAll('a[data-analytics]').forEach((link) => {
			link.addEventListener('click', () => emitAnalyticsEvent(link));
		});

		document.querySelectorAll('details[data-analytics]').forEach((details) => {
			details.addEventListener('toggle', () => {
				if (!details.open) {
					return;
				}

				emitAnalyticsEvent(details);
			});
		});
	})();
</script>

<style>
	.cv-page {
		--cv-max-measure: 66ch;
	}

	:global(.cv-page .page-container) {
		width: min(calc(100% - 2rem), 78rem);
	}

	.cv-shell {
		display: grid;
		grid-template-columns: minmax(11rem, 14rem) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.cv-main-flow {
		min-width: 0;
	}

	:global(.cv-main-flow .page-container) {
		width: 100%;
		max-width: none;
	}

	.cv-scroll-progress {
		position: fixed;
		z-index: 30;
		top: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: transparent;
		pointer-events: none;
	}

        .cv-scroll-progress__bar {
                display: block;
                width: 100%;
                height: 100%;
                background: var(--color-accent-text);
                transform: scaleX(0);
                transform-origin: left center;
        }

        .cv-scroll-jump {
                position: fixed;
                right: 1rem;
                bottom: 1rem;
                z-index: 28;
                display: inline-grid;
                width: 2.45rem;
                height: 2.45rem;
                place-items: center;
                border: 1px solid color-mix(in srgb, var(--color-page) 12%, transparent);
                border-radius: var(--radius-pill);
                background: var(--color-text);
                color: var(--color-page);
                text-decoration: none;
                box-shadow: 0 10px 24px color-mix(in srgb, #000 22%, transparent);
                transition:
                        transform var(--motion-duration-fast-02) var(--motion-standard-productive),
                        border-color var(--motion-duration-fast-02) var(--motion-standard-productive),
                        background-color var(--motion-duration-fast-02) var(--motion-standard-productive),
                        box-shadow var(--motion-duration-fast-02) var(--motion-standard-productive);
        }

        .cv-scroll-jump svg {
                width: 1.15rem;
                height: 1.15rem;
                stroke: currentColor;
                stroke-width: 1.4;
                fill: none;
                stroke-linecap: round;
                stroke-linejoin: round;
        }

        .cv-scroll-jump:hover,
        .cv-scroll-jump:focus-visible {
