import Layout from '../layouts/Layout.astro';

type CvAction = {
	label: string;
	href: string;
	primary?: boolean;
	download?: boolean;
};

type SectionNavItem = {
	id: string;
	label: string;
};

type ProofItem = {
	value: string;
	label: string;
};

type DetailGroup = {
	title: string;
	items: string[];
};

type ExpertiseItem = {
	id: string;
	eyebrow: string;
	title: string;
	scope: string;
	keywords: string[];
	details: DetailGroup[];
};

type ExperienceItem = {
	id: string;
