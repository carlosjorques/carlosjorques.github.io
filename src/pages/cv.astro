---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { CONTACT_DESTINATIONS, IDENTITY, LINKEDIN_URL } from '../data/identity';

interface Role {
	id: string;
	title: string;
	org?: string;
	location?: string;
	period: string;
	summary: string;
	results?: string[];
	keyResult?: string;
	bullets?: string[];
	skills?: string[];
	slug?: string;
}

interface Group {
	id: string;
	name: string;
	note?: string;
	location: string;
	period: string;
	roles: Role[];
}

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) => (href.startsWith('http') || href.startsWith('#') ? href : `${normalizedBase}${href.replace(/^\//, '')}`);
const work = (slug: string) => withBase(`/work/${slug}/`);
const pdfUrl = withBase(CONTACT_DESTINATIONS.cv);
const contactUrl = withBase('/contact/?context=role&source=cv#message-title');

const facts = [IDENTITY.location, 'EU citizen', 'Remote with international teams'];

const profile = [
	[
		{ label: 'Current role', href: '#role-scania-thermal', items: ['Technical Leader at ALTEN', 'Assignment: Scania'] },
		{ label: 'Experience', href: '#experience', items: [`${IDENTITY.years} years in embedded control software`] },
	],
	[
		{ label: 'Expertise', href: '#skills', items: ['Control architecture', 'Predictive control and estimation', 'Diagnostics and safety-related software (ISO 26262)', 'MIL/SIL/HIL validation', 'Technical leadership'] },
		{ label: 'Systems', href: withBase('/work/'), items: ['Electric trucks', 'Autonomous haulers', 'Electric motors', 'Diesel engines'] },
		{ label: 'Tools', href: '#tools', items: ['MATLAB/Simulink', 'C and C++', 'AUTOSAR', 'CI/CD'] },
	],
	[
		{ label: 'Education', href: '#education', items: ['PhD in Mechanical Engineering, Lund University', 'MSc in Electrical and in Industrial Engineering'] },
		{ label: 'Languages', href: '#languages', items: ['English', 'Spanish', 'Swedish', 'Valencian'] },
	],
];
const results = [
	{ type: 'Business', prefix: 'up to', value: '21,500 €', text: 'lower TCO per truck, modelled', href: work('electric-truck-thermal-management') },
	{ type: 'Leadership', value: '3–12', text: 'engineers in the teams I led', href: '#role-volvo' },
	{ type: 'Innovation', value: '5 · 15', text: 'patents · published articles', href: '#record' },
	{ type: 'Control', value: '< 1 km/h', text: 'speed error, autonomous hauler', href: work('autonomous-hauler-propulsion-control') },
	{ type: 'Estimation', value: '±0.6 °C', text: 'battery temperature prediction', href: '#role-scania-thermal' },
	{ type: 'Optimisation', value: '2–4%', text: 'less truck energy in tests', href: work('electric-truck-thermal-management') },
];

const languages = [
	{ name: 'English', level: 'Fluent' },
	{ name: 'Spanish', level: 'Native' },
	{ name: 'Swedish', level: 'Fluent' },
	{ name: 'Valencian', level: 'Native' },
];

const groups: Group[] = [
