		title: 'Certifications and recognition',
		visibleItems: ['[Certification or recognition placeholder]'],
	},
];

const methodGroups: MethodGroup[] = [
	{ title: 'Control and architecture methods', items: ['[Method placeholder 01]', '[Method placeholder 02]', '[Method placeholder 03]'] },
	{ title: 'Embedded software', items: ['[Embedded-software placeholder 01]', '[Embedded-software placeholder 02]', '[Embedded-software placeholder 03]'] },
	{ title: 'Validation', items: ['[Validation placeholder 01]', '[Validation placeholder 02]', '[Validation placeholder 03]'] },
	{ title: 'Standards and processes', items: ['[Standard or process placeholder 01]', '[Standard or process placeholder 02]', '[Standard or process placeholder 03]'] },
	{ title: 'Tools and environments', items: ['[Tool placeholder 01]', '[Tool placeholder 02]', '[Tool placeholder 03]'] },
	{ title: 'Languages', items: ['[Language placeholder 01]', '[Language placeholder 02]', '[Language placeholder 03]'] },
	{ title: 'Continuing learning', items: ['[Learning placeholder 01]', '[Learning placeholder 02]', '[Learning placeholder 03]'] },
