		],
	},
	{
		id: 'experience-role-03',
		title: '[Job title placeholder]',
		context: '[Employer or client context placeholder]',
		meta: '[Dates] · [Location]',
		mandate: '[One-line mandate placeholder.]',
		contributions: ['[Contribution placeholder 01]', '[Contribution placeholder 02]', '[Contribution placeholder 03]'],
		ownership: '[Ownership or leadership scope placeholder]',
		details: [
			{ title: 'Responsibilities', items: ['[Responsibility placeholder 01]', '[Responsibility placeholder 02]'] },
			{ title: 'Selected outcomes', items: ['[Outcome placeholder 01]', '[Outcome placeholder 02]'] },
			{ title: 'Technical scope', items: ['[Technical-scope placeholder 01]', '[Technical-scope placeholder 02]'] },
