<script is:inline>
	(() => {
		const root = document;
		const toggles = Array.from(root.querySelectorAll('[data-disclosure-toggle]'));
		const navLinks = Array.from(root.querySelectorAll('[data-cv-nav-link]'));
		const seeAllRolesButton = root.querySelector('[data-see-all-roles]');
		const extraRoles = Array.from(root.querySelectorAll('[data-role-visibility="extra"]'));

		const setDisclosureState = (button, expanded) => {
			const panelId = button.getAttribute('aria-controls');
			if (!panelId) return;

			const panel = root.getElementById(panelId);
			if (!panel) return;

			button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
			const collapsedLabel = button.getAttribute('data-label-collapsed') ?? 'View details';
			const expandedLabel = button.getAttribute('data-label-expanded') ?? 'Hide details';
			const label = button.querySelector('span');
			if (label) label.textContent = expanded ? expandedLabel : collapsedLabel;
			panel.hidden = !expanded;
		};

		toggles.forEach((button) => {
			setDisclosureState(button, button.getAttribute('aria-expanded') === 'true');
			button.addEventListener('click', () => {
				const expanded = button.getAttribute('aria-expanded') === 'true';
				setDisclosureState(button, !expanded);
			});
		});

		const setExtraRolesState = (expanded) => {
			extraRoles.forEach((role) => {
				role.hidden = !expanded;
			});

			if (seeAllRolesButton instanceof HTMLButtonElement) {
				seeAllRolesButton.setAttribute('aria-expanded', expanded ? 'true' : 'false');
				const collapsedLabel = seeAllRolesButton.getAttribute('data-label-collapsed') ?? 'See all experience';
				const expandedLabel = seeAllRolesButton.getAttribute('data-label-expanded') ?? 'Show recent experience';
				seeAllRolesButton.textContent = expanded ? expandedLabel : collapsedLabel;
			}
		};

		if (extraRoles.length > 0) {
			setExtraRolesState(false);
			seeAllRolesButton?.addEventListener('click', () => {
				const expanded = seeAllRolesButton.getAttribute('aria-expanded') === 'true';
				setExtraRolesState(!expanded);
			});
		}

		const sections = navLinks
			.map((link) => {
				const target = link.getAttribute('data-target');
				if (!target) return null;
				const section = root.getElementById(target);
				return section ? { id: target, section } : null;
			})
			.filter(Boolean);

		if (sections.length > 0) {
			const setActiveLink = (id) => {
				navLinks.forEach((link) => {
					link.setAttribute('aria-current', link.getAttribute('data-target') === id ? 'true' : 'false');
				});
			};

			const updateActiveSection = () => {
				const probeLine = Math.min(window.innerHeight * 0.35, 240);
				const sectionOffsets = sections.map((item) => {
					const rect = item.section.getBoundingClientRect();
					return {
						id: item.id,
						top: rect.top,
						bottom: rect.bottom,
					};
				});

				const containing = sectionOffsets.find((item) => item.top <= probeLine && item.bottom > probeLine);
				if (containing) {
					setActiveLink(containing.id);
					return;
				}

				const pastSections = sectionOffsets.filter((item) => item.top <= probeLine);
				if (pastSections.length > 0) {
					setActiveLink(pastSections[pastSections.length - 1].id);
					return;
				}

				setActiveLink(sectionOffsets[0].id);
			};

			let ticking = false;
			const requestUpdate = () => {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(() => {
					updateActiveSection();
					ticking = false;
				});
			};

			requestUpdate();
			window.addEventListener('scroll', requestUpdate, { passive: true });
			window.addEventListener('resize', requestUpdate);
		}

		navLinks.forEach((link) => {
			link.addEventListener('click', () => link.blur());
		});
	})();
</script>
