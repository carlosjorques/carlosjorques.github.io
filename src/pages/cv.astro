		summary: '[One-line contribution placeholder.]',
		meta: '[Domain placeholder] · [Associated role or period placeholder]',
		linkLabel: 'View project detail',
		linkHref: '/work/project-placeholder-01',
	},
	{
		title: '[Project or system placeholder 02]',
		summary: '[One-line contribution placeholder.]',
		meta: '[Domain placeholder] · [Associated role or period placeholder]',
	},
	{
