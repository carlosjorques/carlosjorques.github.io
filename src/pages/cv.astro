};

type ExperienceItem = {
	id: string;
	title: string;
	context: string;
	meta: string;
	mandate: string;
	contributions: string[];
	scope?: string;
	details?: DetailGroup[];
};

type ExperienceGroup = {
	id: string;
	heading: string;
	meta: string;
	location: string;
	roles: ExperienceItem[];
};

type ExperienceRenderRole = ExperienceItem & {
	displayContext: string;
};

type ExperienceRenderGroup = ExperienceGroup & {
	isExtra: boolean;
	roles: ExperienceRenderRole[];
};

type ProjectRow = {
	title: string;
	summary: string;
	meta: string;
	linkLabel?: string;
