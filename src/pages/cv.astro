		},
	},
	{
		id: 'credential-patents',
		title: 'Patents',
		visibleItems: ['5 patent records across control, diagnostics, and combustion-related inventions.'],
		disclosure: {
			collapsedLabel: 'See all patents',
			expandedLabel: 'Hide patents',
			details: [
				'Method and system for determining in-cycle a pilot injection fuel mass in a combustion chamber of an engine · WO2019045623A1 · 2019-03-07',
				'Method and system for fuel pump regulation · WO2016043652A1 · 2016-03-24',
				'System and method for improving heat release evaluation at a reciprocating internal combustion engine · WO2017217912A1 · 2017-12-21',
				'Method and system for diagnosing a fuel system II · WO2017003366A1 · 2017-01-05',
				'Method and system for diagnosing a fuel system · WO2017003365A1 · 2017-01-05',
			],
		},
	},
	{
		id: 'credential-continuing-learning',
		title: 'Continuous learning',
		visibleItems: [
			'Power Electronic Converters, 2022',
			'Introduction to Electromobility, Swedish Electromobility Centre, 2020',
			'GT Power, Gamma Technologies, 2015',
		],
		disclosure: {
			collapsedLabel: 'See all learning',
			expandedLabel: 'Hide learning',
			details: [
				'LangChain and LLMs with Python, Alten, 2025',
				'Project Management: Product Owner and Kanban, Cualtis, 2024',
			],
		},
	},
	{
		id: 'credential-certifications',
		title: 'Certifications and recognition',
		visibleItems: [
			'Scania Innovation Challenge, Scania, 2019',
			'Outstanding Oral Presentation Award, SAE, 2017',
		],
		disclosure: {
			collapsedLabel: 'See earlier recognition',
			expandedLabel: 'Hide earlier recognition',
			details: [
				'Double Degree Scholarship, COIICV, 2013',
				'Best Academic Record for First Year, Polytechnic University of Valencia, 2009',
			],
		},
	},
];

const methodGroups: MethodGroup[] = [
	{
		title: 'Control and architecture',
		items: [
			'Methods: model-based development, control architecture, system identification, observer design, virtual sensing, and model adaptation.',
			'Analysis: signal processing, Kalman filtering, stochastic modeling, optimization, and model predictive control.',
		],
	},
	{
		title: 'Embedded implementation',
		items: [
			'Implementation: generated-code integration, application-layer software, diagnostics implementation, and ECU flashing.',
			'Tooling: C, C++, Python, MATLAB/Simulink, Stateflow, Embedded Coder, CAPL, and LabVIEW FPGA.',
		],
	},
	{
		title: 'Validation and calibration',
		items: [
			'Practices: MIL, SIL, HIL, unit and integration testing, regression testing, and fault injection.',
			'Environments: test bench, wind tunnel, test track, on-road testing, field-data analysis, calibration support, and ECU debugging.',
		],
	},
	{
		title: 'Standards and vehicle networks',
		items: [
			'Standards: ISO 26262, A-SPICE, AUTOSAR-oriented development, functional safety analysis, and traceability.',
			'Vehicle networks and tools: CAN, J1939, CANalyzer, and CANoe.',
		],
	},
	{
		title: 'Engineering delivery',
		items: [
			'Practices: requirements alignment, architecture coordination, code review, issue tracking, release workflows, agile delivery, mentoring, and cross-functional coordination.',
			'Tooling: Git, GitLab, Jenkins, Jira, CI/CD, SAFe, Scrum, and Kanban.',
		],
	},
	{
		title: 'Languages',
		items: ['Spanish · native', 'Catalan · native', 'English · full professional', 'Swedish · full professional'],
	},
];

const normalizeRoleContext = (context: string, groupHeading: string) => {
	if (context === groupHeading) return '';
	const prefix = `${groupHeading} · `;
	const normalized = context.startsWith(prefix) ? context.slice(prefix.length) : context;
	return normalized.replace(/\s*-\s*Assignment\b/i, ' - Assignment').trim();
};
const formatExperienceMeta = (value?: string) =>
	cleanDisplayText(value).replace(/\s*-\s*/g, '–').replace(/\s*·\s*/g, ' · ');
const experienceExpandedThroughRole = 'experience-role-03';
const experienceRoleOrder = experienceGroups.flatMap((group) => group.roles.map((role) => role.id));
const experienceExpandedThroughIndex = experienceRoleOrder.indexOf(experienceExpandedThroughRole);
const experienceRenderGroups: ExperienceRenderGroup[] = [];

{
	for (const group of experienceGroups) {
		const roles = group.roles.map((role) => ({
			...role,
			isExtra:
				experienceExpandedThroughIndex >= 0
					? experienceRoleOrder.indexOf(role.id) > experienceExpandedThroughIndex
					: group.defaultVisible === false,
			displayContext: normalizeRoleContext(role.context, group.heading),
		}));
		experienceRenderGroups.push({
			...group,
			isExtra: roles.every((role) => role.isExtra),
			roles,
		});
	}
}

const visibleProofItems = proofItems
	.map((item) => ({ value: cleanDisplayText(item.value), label: cleanDisplayText(item.label) }))
	.filter((item) => item.value && item.label);
const visibleOverviewParagraphs = visibleItems(overview.paragraphs);
const visibleOverviewScopeItems = visibleItems(overview.scopeItems);
const visibleSelectedEvidence = visibleItems(selectedEvidence);
const visibleProjectRows = projectRows
	.map((row) => ({
		...row,
		title: cleanDisplayText(row.title),
		summary: cleanDisplayText(row.summary),
		meta: cleanDisplayText(row.meta),
		linkHref: cleanDisplayText(row.linkHref),
	}))
	.filter((row) => row.title && row.summary && row.meta);
