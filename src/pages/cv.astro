---

<Layout
	title={`${IDENTITY.name} | ${IDENTITY.primaryTitle} | CV`}
	description={`CV of ${IDENTITY.name}, ${IDENTITY.primaryTitle} with ${IDENTITY.years} years of embedded control software for electric trucks, autonomous haulers, electric motors and engines.`}
>
	<div class="cv-page">
		<section class="cv-hero" aria-labelledby="cv-title">
			<h1 id="cv-title">{IDENTITY.name}</h1>
			<p class="cv-hero__title">{IDENTITY.primaryTitle}</p>
			<p class="cv-hero__lead">I lead the development of <strong>embedded control software</strong> for physical machines, from the first concept to production. In <strong>{IDENTITY.years} years</strong> I have done it for electric trucks, autonomous haulers, electric motors and diesel engines, and software I developed <strong>runs in trucks on the road today</strong>. I combine a <strong>PhD and 5 patents</strong> in control with hands-on technical leadership, and I weigh every technical decision against its value for the business.</p>
			<ul class="cv-facts" aria-label="Location and work setup">
				{facts.map((fact) => <li>{fact}</li>)}
			</ul>
			<ul class="cv-print-contact" aria-label="Contact">
				<li>carlosjorques.com</li>
				<li>Contact: carlosjorques.com/contact</li>
				<li>LinkedIn: linkedin.com/in/carlosjorques</li>
			</ul>
			<div class="button-row cv-hero__actions">
				<a class="button primary" href={pdfUrl} download data-analytics-event="cv_pdf_download" data-cta-id="cv-hero-pdf" data-source-section="cv-hero">Download PDF</a>
				<a class="button" href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" data-analytics-event="linkedin_outbound_click" data-cta-id="cv-hero-linkedin" data-source-section="cv-hero">LinkedIn</a>
				<a class="button" href={contactUrl} data-analytics-event="cta_click" data-cta-id="cv-hero-contact" data-source-section="cv-hero">Contact</a>
			</div>
		</section>

		<section class="cv-section cv-section--band" id="glance" aria-labelledby="glance-title">
			<div class="cv-rail"><h2 id="glance-title">At a glance</h2></div>
			<div class="cv-glance-grid">
				<div class="cv-glance-col">
					<h3 class="cv-subhead">Profile</h3>
					{profile.map((group) => (
						<dl class="cv-glance">
							{group.map((item) => (
								<div>
									<dt><a href={item.href}>{item.label}</a></dt>
									<dd><ul>{item.items.map((entry) => <li>{entry}</li>)}</ul></dd>
								</div>
							))}
						</dl>
					))}
				</div>
				<div class="cv-glance-col">
					<h3 class="cv-subhead">Key results</h3>
					<ul class="cv-results">
						{results.map((result) => (
							<li>
								<a href={result.href}>
									<span class="cv-results__type">{result.type}</span>
									<strong class="cv-results__value">{result.prefix && <small>{result.prefix} </small>}{result.value}</strong>
									<span class="cv-results__text">{result.text}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<section class="cv-section" id="experience" aria-labelledby="experience-title">
			<div class="cv-rail">
				<h2 id="experience-title">Experience</h2>
				<button class="cv-expand" type="button" aria-controls="experience-roles" aria-expanded="false" hidden>Expand all roles</button>
			</div>
			<div class="cv-body">
				<div class="cv-groups" id="experience-roles">
					{groups.map((group) => (
						<div class="cv-group" id={`exp-${group.id}`}>
							<h3 class="cv-group__head">
								<span class="cv-group__name">{group.name}</span>
								<span class="cv-group__meta">{[group.note, group.location, group.period].filter(Boolean).join(' · ')}</span>
							</h3>
							{group.roles.map((role) => {
								const head = (
									<span class="cv-role__main">
										<span class="cv-role__title">{role.title}</span>
										<span class="cv-role__meta">{role.org && <span class="cv-role__org">{role.org}</span>}{role.org && ' · '}{role.location && `${role.location} · `}{role.period}</span>
										<span class="cv-role__summary">{role.summary}{role.keyResult && <span class="cv-role__key"> Key result: <strong>{role.keyResult}</strong>.</span>}</span>
									</span>
								);
								return role.bullets ? (
									<details class="cv-role" id={`role-${role.id}`}>
										<summary>{head}</summary>
										<div class="cv-role__body">
											{role.results && (
												<>
													<p class="cv-role__label">Key results</p>
													<ul class="cv-role__results">
														{role.results.map((result) => <li set:html={result} />)}
													</ul>
												</>
											)}
											<p class="cv-role__label">Responsibilities and contributions</p>
											<ul class="cv-role__tasks">
												{role.bullets.map((bullet) => <li>{bullet}</li>)}
											</ul>
											{role.skills && (
												<>
													<p class="cv-role__label">Related skills</p>
													<p class="cv-role__skills">{role.skills.join(' · ')}</p>
												</>
											)}
											{role.slug && <a class="cv-role__link" href={work(role.slug)}>Read the project</a>}
										</div>
									</details>
								) : (
									<div class="cv-role cv-role--static" id={`role-${role.id}`}>{head}</div>
								);
							})}
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="cv-section" id="skills" aria-labelledby="skills-title">
			<div class="cv-rail">
				<h2 id="skills-title">Skills and tools</h2>
			</div>
			<div class="cv-body cv-skills">
				<p class="cv-skills__label">Skills</p>
				<div class="cv-skills__grid">
					{skillGroups.map((group) => (
						<div class="cv-skills__group">
							<h3>{group.group}</h3>
							<p>{group.items.join(' · ')}</p>
						</div>
					))}
				</div>
				<p class="cv-skills__label" id="tools">Tools</p>
				<div class="cv-skills__grid">
					{tools.map((group) => (
						<div class="cv-skills__group">
							<h3>{group.group}</h3>
							<p>{group.items}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="cv-section" id="education" aria-labelledby="education-title">
			<div class="cv-rail"><h2 id="education-title">Education and languages</h2></div>
			<div class="cv-body">
				<ul class="cv-list">
					{education.map((item) => (
						<li><strong>{item.degree}</strong><span>{item.place} · {item.year}{item.href && <> · <a href={item.href} target="_blank" rel="noopener noreferrer">{item.linkText}</a></>}</span></li>
					))}
				</ul>
				<ul class="cv-languages" id="languages" aria-label="Languages">
					{languages.map((item) => <li><strong>{item.name}</strong> <span>{item.level}</span></li>)}
				</ul>
			</div>
		</section>
		<section class="cv-section" id="record" aria-labelledby="record-title">
			<div class="cv-rail"><h2 id="record-title">Patents, publications and awards</h2></div>
			<div class="cv-body">
				<p>Ideas from my master’s thesis and PhD research became five granted international patents, filed with Scania, on fuel-system diagnostics, fuel-pump regulation and in-cycle combustion sensing. My control methods ran in real time on heavy-duty engines and were published in Control Engineering Practice, IFAC, ACC and SAE, where one of my talks received the Outstanding Oral Presentation Award.</p>
				<details class="cv-details">
					<summary>Patents (5)</summary>
					<ul class="cv-plain">
						{patents.map((patent) => (
							<li><a href={`https://patents.google.com/patent/${patent.id}/en`} target="_blank" rel="noopener noreferrer">{patent.title}</a> · {patent.id} · {patent.year}</li>
						))}
					</ul>
				</details>
				<details class="cv-details">
					<summary>Published articles (15)</summary>
					<ul class="cv-plain">
						{publications.map((item) => (
							<li>{item.doi || item.href ? <a href={item.href ?? `https://doi.org/${item.doi}`} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title} · {item.venue} · {item.year}</li>
						))}
					</ul>
				</details>
				<details class="cv-details">
					<summary>Awards, courses and scholarships</summary>
					<ul class="cv-plain">
						{[...awards, ...courses].map((item) => <li>{item}</li>)}
					</ul>
				</details>
			</div>
		</section>

		<section class="section cv-closing" aria-label="Contact">
			<ContactCTA
				eyebrow="Contact"
				title="Have a role in mind?"
				body="Send me the role and a few lines of context, and I will reply with the experience that fits it."
				primaryHref="/contact/?context=role&source=cv#message-title"
				primaryLabel="Talk about a role"
				secondaryHref={CONTACT_DESTINATIONS.cv}
				secondaryLabel="Download PDF"
				tertiaryHref={LINKEDIN_URL}
				tertiaryLabel="LinkedIn"
				sourceSection="cv-closing"
				ctaIdPrefix="cv-closing"
			/>
		</section>

		<nav class="cv-jump" aria-label="CV sections">
			<details>
				<summary>Jump to section</summary>
				<ul>
					{jumpLinks.map((link) => <li><a href={`#${link.id}`}>{link.label}</a></li>)}
				</ul>
			</details>
		</nav>
	</div>
</Layout>

<script>
	const openTarget = () => {
		const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
		if (target instanceof HTMLDetailsElement) target.open = true;
	};
	openTarget();
	window.addEventListener('hashchange', openTarget);

	let closedForPrint: HTMLDetailsElement[] = [];
	window.addEventListener('beforeprint', () => {
		closedForPrint = [...document.querySelectorAll<HTMLDetailsElement>('.cv-page details:not([open])')];
		closedForPrint.forEach((item) => (item.open = true));
	});
	window.addEventListener('afterprint', () => {
		closedForPrint.forEach((item) => (item.open = false));
		closedForPrint = [];
	});

	const expand = document.querySelector<HTMLButtonElement>('.cv-expand');
	const roles = [...document.querySelectorAll<HTMLDetailsElement>('#experience-roles details')];
	if (expand && roles.length) {
		const sync = () => {
			const allOpen = roles.every((role) => role.open);
			expand.textContent = allOpen ? 'Collapse all roles' : 'Expand all roles';
			expand.setAttribute('aria-expanded', String(allOpen));
		};
		expand.hidden = false;
		expand.addEventListener('click', () => {
			const open = !roles.every((role) => role.open);
			roles.forEach((role) => (role.open = open));
			sync();
		});
		roles.forEach((role) => role.addEventListener('toggle', sync));
	}

	const jump = document.querySelector<HTMLElement>('.cv-jump');
	const jumpMenu = jump?.querySelector('details');
	const hero = document.querySelector('.cv-hero');
	if (jump && jumpMenu && hero) {
		jump.classList.add('is-hidden');
		new IntersectionObserver(([entry]) => {
			jump.classList.toggle('is-hidden', entry.isIntersecting);
			if (entry.isIntersecting) jumpMenu.open = false;
		}).observe(hero);
		jump.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) jumpMenu.open = false;
		});
		document.addEventListener('click', (event) => {
			if (jumpMenu.open && !jump.contains(event.target as Node)) jumpMenu.open = false;
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && jumpMenu.open) {
				jumpMenu.open = false;
				jumpMenu.querySelector('summary')?.focus();
			}
		});

		const links = [...jump.querySelectorAll<HTMLAnchorElement>('a')];
		const sections = links
			.map((link) => document.getElementById(link.hash.slice(1)))
			.filter((el): el is HTMLElement => el !== null && el.tagName === 'SECTION');
		const setActive = () => {
			const line = innerHeight * 0.3;
			let current = 'cv-title';
			sections.forEach((section) => {
				if (section.getBoundingClientRect().top <= line) current = section.id;
			});
			links.forEach((link) => {
				if (link.hash === `#${current}`) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			});
		};
		let ticking = false;
		addEventListener('scroll', () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				setActive();
				ticking = false;
			});
		}, { passive: true });
		setActive();
	}
</script>

<style>
	.cv-page { --cv-signal:color-mix(in srgb, var(--color-accent-text) 82%, var(--color-text)); width:min(calc(100% - 5rem),var(--content-width)); margin:0 auto; }
