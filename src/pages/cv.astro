type ProjectRow = {
	system: string;
	context: string;
	contribution: string;
	rolePeriod: string;
	expertise: string;
	linkLabel?: string;
	linkHref?: string;
};

type CredentialGroup = {
	id: string;
	title: string;
	visibleItems: string[];
	details?: DetailGroup[];
};

type MethodGroup = {
