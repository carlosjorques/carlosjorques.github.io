<script>
	const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
	const timelineSections = Array.from(document.querySelectorAll('[data-experience-timeline]'));

	if (timelineSections.length > 0) {
		let animationFrame = 0;

		const updateTimelineProgress = () => {
			animationFrame = 0;

			timelineSections.forEach((section) => {
				const fill = section.querySelector('[data-experience-fill]');
				const cards = Array.from(section.querySelectorAll('[data-role-card]'));
				const milestones = Array.from(section.querySelectorAll('[data-milestone-item]'));

				if (!fill || cards.length === 0) {
					return;
				}

				const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
				const scrollY = window.scrollY || window.pageYOffset;
				const firstCard = cards[0].getBoundingClientRect();
				const lastCard = cards[cards.length - 1].getBoundingClientRect();
				const start = firstCard.top + scrollY - viewportHeight * 0.55;
				const end = lastCard.bottom + scrollY - viewportHeight * 0.55;
				const progress = end > start ? clamp((scrollY - start) / (end - start), 0, 1) : 0;

				fill.style.transform = `scaleY(${progress})`;

				cards.forEach((card, index) => {
					const cardRect = card.getBoundingClientRect();
					const isActive = cardRect.top <= viewportHeight * 0.56 && cardRect.bottom >= viewportHeight * 0.42;
					const isComplete = cardRect.bottom < viewportHeight * 0.48;
					milestones[index]?.classList.toggle('is-active', isActive);
					milestones[index]?.classList.toggle('is-complete', isComplete);
				});
			});
		};

		const requestTimelineUpdate = () => {
			if (animationFrame === 0) {
				animationFrame = window.requestAnimationFrame(updateTimelineProgress);
			}
		};

		updateTimelineProgress();
		window.addEventListener('scroll', requestTimelineUpdate, { passive: true });
		window.addEventListener('resize', requestTimelineUpdate);
	}
</script>

