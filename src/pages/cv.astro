---

<Layout
	title="CV | Carlos Jorques"
	description="Structural CV page skeleton for Carlos Jorques, following the portfolio’s established layout, section rhythm, and reusable interaction patterns."
>
	<div class="cv-page">
		<section id="overview" class="cv-hero" aria-labelledby="cv-title">
			<div class="page-container">
				<div class="cv-hero__inner">
					<div class="cv-hero__copy">
						<p class="section-eyebrow">Online CV</p>
						<h1 id="cv-title" class="hero-title">[Professional title]</h1>
						<p class="cv-hero__role">[Short positioning placeholder]</p>
						<p class="cv-hero__summary">[Overview placeholder describing what this CV page will communicate.]</p>
						<div class="button-row cv-hero__actions">
							{actions.map((action) => (
								<a
									class:list={['button', { primary: action.primary }]}
									href={withBase(action.href)}
								>
									{action.label}
								</a>
							))}
						</div>
						<p id="download-cv" class="cv-placeholder-note">[Download target placeholder]</p>
					</div>
					<aside class="cv-proof panel" aria-label="Professional proof snapshot">
						<p class="cv-proof__label">Professional snapshot</p>
						<ul class="cv-proof__list">
							{proofItems.map((item) => (
								<li>
									<strong>{item.value}</strong>
									<span>{item.label}</span>
								</li>
							))}
						</ul>
					</aside>
				</div>
			</div>
		</section>

		<div class="cv-section-nav-shell">
			<div class="page-container">
				<nav class="cv-section-nav cv-section-nav--desktop" aria-label="CV sections">
					<ul>
						{sectionNav.map((item) => (
							<li>
								<a class="cv-nav-link" href={`#${item.id}`} data-cv-nav-link data-target={item.id}>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>

				<details class="cv-section-nav-mobile">
					<summary>CV sections</summary>
					<nav aria-label="CV sections">
						<ul>
							{sectionNav.map((item) => (
								<li>
									<a class="cv-nav-link" href={`#${item.id}`} data-cv-nav-link data-target={item.id}>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</details>

				<div class="cv-section-nav__actions" aria-label="CV actions">
					<a class="button" href={withBase('#download-cv')} download>Download CV</a>
					<a class="button" href={withBase('/contact')}>Contact</a>
				</div>
			</div>
		</div>

		<main class="cv-main-flow">
			<section id="expertise" class="cv-section" aria-labelledby="expertise-title">
				<div class="page-container cv-section__layout">
					<div class="cv-section__rail">
						<p class="section-eyebrow">Core expertise</p>
						<h2 id="expertise-title" class="cv-section__heading">[Expertise section title]</h2>
						<p class="cv-section__intro-copy">[Short placeholder introduction for the expertise section.]</p>
					</div>
					<div class="cv-section__content">
						<div class="cv-card-grid">
							{expertiseItems.map((item, index) => (
								<article class="cv-card cv-disclosure-item" aria-labelledby={`${item.id}-title`}>
									<div class="cv-card__collapsed">
										<p class="cv-card__eyebrow">{item.eyebrow}</p>
										<h3 id={`${item.id}-title`}>{item.title}</h3>
										<p class="cv-card__summary">{item.scope}</p>
										<ul class="tag-list cv-card__keywords" aria-label={`${item.title} keywords`}>
											{item.keywords.map((keyword) => (
												<li class="tag">{keyword}</li>
											))}
										</ul>
										<button
											class="cv-disclosure-button"
											type="button"
											aria-expanded="false"
											aria-controls={`${item.id}-details`}
											data-disclosure-toggle
											data-label-collapsed="Show structure"
											data-label-expanded="Hide structure"
										>
											<span>Show structure</span>
											<span aria-hidden="true">+</span>
										</button>
									</div>
									<div id={`${item.id}-details`} class="cv-disclosure-panel" hidden>
										{item.details.map((group) => (
											<section class="cv-detail-group" aria-labelledby={`${item.id}-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
												<h4 id={`${item.id}-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{group.title}</h4>
												<ul>
													{group.items.map((detail) => (
														<li>{detail}</li>
													))}
												</ul>
											</section>
										))}
										{index === 0 && (
											<p class="cv-related-link">
												<a href={withBase('/work')}>View selected work</a>
											</p>
										)}
									</div>
								</article>
							))}
						</div>
					</div>
				</div>
			</section>

			<section id="experience" class="cv-section" aria-labelledby="experience-title">
				<div class="page-container cv-section__layout">
					<div class="cv-section__rail">
						<p class="section-eyebrow">Experience</p>
						<h2 id="experience-title" class="cv-section__heading">[Experience section title]</h2>
						<p class="cv-section__intro-copy">[Short placeholder introduction for reverse-chronology role history.]</p>
					</div>
					<div class="cv-section__content">
						<div class="cv-section__toolbar">
							<button class="cv-toolbar-button" type="button" data-expand-all="experience">Expand all</button>
							<button class="cv-toolbar-button" type="button" data-collapse-all="experience">Collapse all</button>
						</div>
						<ol class="cv-experience-list">
							{experienceItems.map((item) => (
								<li class="cv-role">
									<article class="cv-role__card cv-disclosure-item" aria-labelledby={`${item.id}-title`}>
										<div class="cv-role__collapsed">
											<div class="cv-role__identity">
												<p class="cv-role__meta">{item.meta}</p>
												<h3 id={`${item.id}-title`}>{item.title}</h3>
												<p class="cv-role__context">{item.context}</p>
											</div>
											<div class="cv-role__summary-block">
												<p class="cv-role__mandate">{item.mandate}</p>
												<ul class="cv-role__contributions">
													{item.contributions.map((contribution) => (
														<li>{contribution}</li>
													))}
												</ul>
												<p class="cv-role__ownership">
													<span>Ownership</span>
													{item.ownership}
												</p>
												<button
													class="cv-disclosure-button"
													type="button"
													aria-expanded="false"
													aria-controls={`${item.id}-details`}
													data-disclosure-toggle
													data-disclosure-group="experience"
													data-label-collapsed="Show structure"
													data-label-expanded="Hide structure"
												>
													<span>Show structure</span>
													<span aria-hidden="true">+</span>
												</button>
											</div>
										</div>
										<div id={`${item.id}-details`} class="cv-disclosure-panel cv-disclosure-panel--role" hidden>
											{item.details.map((group) => (
												<section class="cv-detail-group" aria-labelledby={`${item.id}-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
													<h4 id={`${item.id}-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{group.title}</h4>
													<ul>
														{group.items.map((detail) => (
															<li>{detail}</li>
														))}
													</ul>
												</section>
											))}
											<p class="cv-related-link">
												<a href={withBase('/work')}>View selected work</a>
											</p>
										</div>
									</article>
								</li>
							))}
						</ol>
					</div>
				</div>
			</section>

			<section id="projects" class="cv-section" aria-labelledby="projects-title">
				<div class="page-container cv-section__layout">
					<div class="cv-section__rail">
						<p class="section-eyebrow">Project record</p>
						<h2 id="projects-title" class="cv-section__heading">[Project record section title]</h2>
						<p class="cv-section__intro-copy">[Short placeholder introduction for the compact project index.]</p>
					</div>
					<div class="cv-section__content">
						<div class="cv-project-list" role="list">
							{projectRows.map((row) => (
								<article class="cv-project-row" role="listitem">
									<div>
										<p class="cv-project-row__label">Project or system</p>
										<h3>{row.system}</h3>
									</div>
									<dl class="cv-project-row__meta">
										<div>
											<dt>Domain or context</dt>
											<dd>{row.context}</dd>
										</div>
										<div>
											<dt>Contribution</dt>
											<dd>{row.contribution}</dd>
										</div>
										<div>
											<dt>Associated role or period</dt>
											<dd>{row.rolePeriod}</dd>
										</div>
										<div>
											<dt>Expertise references</dt>
											<dd>{row.expertise}</dd>
