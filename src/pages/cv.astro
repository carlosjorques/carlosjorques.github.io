const visibleExperienceCount = 3;
---

<Layout
	title="CV | Carlos Jorques"
	description="Structural CV page skeleton for Carlos Jorques, aligned with the portfolio’s established layout, spacing, and responsive patterns."
>
	<div class="cv-page">
		<section id="cv-hero" class="cv-hero" aria-labelledby="cv-title">
			<div class="page-container">
				<div class="cv-hero__inner">
					<div class="cv-hero__copy">
						<p class="section-eyebrow">Online CV</p>
						<h1 id="cv-title" class="hero-title">[Professional title]</h1>
						<p class="cv-hero__positioning">[Concise positioning placeholder paragraph for the professional profile presented on this page.]</p>
						<div class="button-row cv-hero__actions">
							{actions.map((action) => (
								<a class:list={['button', { primary: action.primary }]} href={withBase(action.href)}>
									{action.label}
								</a>
							))}
						</div>
					</div>
					<aside class="cv-proof panel" aria-label="Professional snapshot">
						<p class="cv-proof__label">Professional snapshot</p>
						<ul class="cv-proof__list">
							{proofItems.map((item) => (
								<li>
									<strong>{item.value}</strong>
									<span>{item.label}</span>
								</li>
							))}
						</ul>
					</aside>
				</div>
			</div>
		</section>

		<div class="cv-section-nav-shell">
			<div class="page-container">
				<nav class="cv-section-nav cv-section-nav--desktop" aria-label="CV sections">
					<ul>
						{sectionNav.map((item) => (
							<li>
								<a class="cv-nav-link" href={`#${item.id}`} data-cv-nav-link data-target={item.id}>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>

				<details class="cv-section-nav-mobile">
					<summary>CV sections</summary>
					<nav aria-label="CV sections">
						<ul>
							{sectionNav.map((item) => (
								<li>
									<a class="cv-nav-link" href={`#${item.id}`} data-cv-nav-link data-target={item.id}>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</details>
			</div>
		</div>

		<main class="cv-main-flow">
			<section id="overview" class="cv-section" aria-labelledby="overview-title">
				<div class="page-container cv-section__layout">
					<h2 id="overview-title" class="cv-section__rail-heading">Overview</h2>
					<div class="cv-section__content">
						<h3>{overview.heading}</h3>
						<div class="cv-prose">
							{overview.paragraphs.map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</div>
						<ul class="cv-scope-list">
							{overview.scopeItems.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<section id="expertise" class="cv-section" aria-labelledby="expertise-title">
				<div class="page-container cv-section__layout">
					<h2 id="expertise-title" class="cv-section__rail-heading">Core expertise</h2>
					<div class="cv-section__content">
						<div class="cv-card-grid">
							{expertiseItems.map((item) => (
								<article class="cv-card panel cv-disclosure-item" aria-labelledby={`${item.id}-title`}>
									<div class="cv-card__collapsed">
										<h3 id={`${item.id}-title`}>{item.title}</h3>
										<p class="cv-card__summary">{item.scope}</p>
										<button
											class="cv-disclosure-button"
											type="button"
											aria-expanded="false"
											aria-controls={`${item.id}-details`}
											data-disclosure-toggle
											data-label-collapsed="View expertise details"
											data-label-expanded="Hide expertise details"
										>
											<span>View expertise details</span>
										</button>
									</div>
									<div id={`${item.id}-details`} class="cv-disclosure-panel" hidden>
										<section class="cv-detail-group" aria-labelledby={`${item.id}-problems`}>
											<h4 id={`${item.id}-problems`}>Problems addressed</h4>
											<ul>
												{item.problemsAddressed.map((detail) => (
													<li>{detail}</li>
												))}
											</ul>
										</section>
										<section class="cv-detail-group" aria-labelledby={`${item.id}-ownership`}>
											<h4 id={`${item.id}-ownership`}>Scope of ownership</h4>
											<ul>
												{item.ownership.map((detail) => (
													<li>{detail}</li>
												))}
											</ul>
										</section>
										<section class="cv-detail-group" aria-labelledby={`${item.id}-methods`}>
											<h4 id={`${item.id}-methods`}>Methods and constraints</h4>
											<ul>
												{item.methodsAndConstraints.map((detail) => (
													<li>{detail}</li>
												))}
											</ul>
										</section>
										<section class="cv-detail-group" aria-labelledby={`${item.id}-applications`}>
											<h4 id={`${item.id}-applications`}>Representative applications</h4>
											<ul>
												{item.applications.map((detail) => (
													<li>{detail}</li>
												))}
											</ul>
										</section>
										{item.relatedProject && (
											<p class="cv-related-link">
												<a href={withBase(item.relatedProject.href)}>{item.relatedProject.label}</a>
											</p>
										)}
									</div>
								</article>
							))}
						</div>
					</div>
				</div>
			</section>

			<section id="experience" class="cv-section" aria-labelledby="experience-title">
				<div class="page-container cv-section__layout">
					<h2 id="experience-title" class="cv-section__rail-heading">Experience</h2>
					<div class="cv-section__content">
						<ol id="experience-list" class="cv-experience-list">
							{experienceItems.map((item, index) => (
								<li class:list={['cv-role', { 'cv-role--extra': index >= visibleExperienceCount }]} data-role-visibility={index >= visibleExperienceCount ? 'extra' : 'primary'}>
									<article class="cv-role__card cv-disclosure-item" aria-labelledby={`${item.id}-title`}>
										<div class="cv-role__collapsed">
											<div class="cv-role__identity">
												<p class="cv-role__meta">{item.meta}</p>
												<h3 id={`${item.id}-title`}>{item.title}</h3>
												<p class="cv-role__context">{item.context}</p>
											</div>
											<div class="cv-role__summary-block">
												<p class="cv-role__mandate">{item.mandate}</p>
												<ul class="cv-role__contributions">
													{item.contributions.map((contribution) => (
														<li>{contribution}</li>
													))}
												</ul>
												<p class="cv-role__ownership">
													<span>Ownership</span>
													{item.ownership}
												</p>
												<button
													class="cv-disclosure-button"
													type="button"
													aria-expanded="false"
													aria-controls={`${item.id}-details`}
													data-disclosure-toggle
													data-label-collapsed="View role details"
													data-label-expanded="Hide role details"
												>
													<span>View role details</span>
												</button>
											</div>
										</div>
										<div id={`${item.id}-details`} class="cv-disclosure-panel cv-disclosure-panel--role" hidden>
											{item.details.map((group) => (
												<section class="cv-detail-group" aria-labelledby={`${item.id}-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
													<h4 id={`${item.id}-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{group.title}</h4>
													<ul>
														{group.items.map((detail) => (
															<li>{detail}</li>
														))}
													</ul>
												</section>
											))}
										</div>
									</article>
								</li>
							))}
						</ol>
						{experienceItems.length > visibleExperienceCount && (
							<button
								class="cv-see-all-button"
								type="button"
								aria-expanded="false"
								aria-controls="experience-list"
								data-see-all-roles
								data-label-collapsed={`See all experience (${experienceItems.length} roles)`}
								data-label-expanded="Show recent experience"
							>
								See all experience ({experienceItems.length} roles)
							</button>
						)}
					</div>
				</div>
			</section>

			<section id="projects" class="cv-section" aria-labelledby="projects-title">
				<div class="page-container cv-section__layout">
					<h2 id="projects-title" class="cv-section__rail-heading">Project record</h2>
					<div class="cv-section__content">
						<div class="cv-project-list" role="list">
							{projectRows.map((row) => (
								<article class="cv-project-row" role="listitem">
									<h3>{row.title}</h3>
									<p class="cv-project-row__summary">{row.summary}</p>
									<p class="cv-project-row__meta">{row.meta}</p>
									{row.linkHref && row.linkLabel && (
										<p class="cv-project-row__link">
											<a href={withBase(row.linkHref)}>{row.linkLabel}</a>
										</p>
									)}
								</article>
							))}
						</div>
						<p class="cv-section-cta">
							<a href={withBase('/work')}>Explore selected work</a>
						</p>
					</div>
				</div>
			</section>

			<section id="credentials" class="cv-section" aria-labelledby="credentials-title">
				<div class="page-container cv-section__layout">
					<h2 id="credentials-title" class="cv-section__rail-heading">Education and professional record</h2>
					<div class="cv-section__content">
						<div class="cv-credentials-list">
							{credentialGroups.map((group) => (
								<section class="cv-credential-group" aria-labelledby={`${group.id}-title`}>
									<h3 id={`${group.id}-title`}>{group.title}</h3>
									<ul class="cv-credential-group__visible">
										{group.visibleItems.map((item) => (
											<li>{item}</li>
										))}
									</ul>
									{group.disclosure && (
										<>
											<button
												class="cv-disclosure-button"
												type="button"
												aria-expanded="false"
												aria-controls={`${group.id}-details`}
												data-disclosure-toggle
												data-label-collapsed={group.disclosure.collapsedLabel}
												data-label-expanded={group.disclosure.expandedLabel}
											>
												<span>{group.disclosure.collapsedLabel}</span>
											</button>
											<div id={`${group.id}-details`} class="cv-disclosure-panel" hidden>
												<ul class="cv-plain-list">
													{group.disclosure.details.map((detail) => (
														<li>{detail}</li>
													))}
												</ul>
											</div>
										</>
									)}
								</section>
							))}
						</div>
					</div>
				</div>
			</section>

			<section id="methods" class="cv-section" aria-labelledby="methods-title">
				<div class="page-container cv-section__layout">
					<h2 id="methods-title" class="cv-section__rail-heading">Methods, tools and additional information</h2>
					<div class="cv-section__content">
						<div class="cv-method-groups">
							{methodGroups.map((group) => (
