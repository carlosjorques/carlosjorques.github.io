				'In-Cycle Closed-Loop Combustion Controllability with Pilot-Main Injections · THIESEL 2018 · 2018',
				'Predictive In-Cycle Closed-Loop Combustion Control with Pilot-Main Injections · IFAC-PapersOnLine · 2020',
				'In-Cycle Closed-Loop Combustion Control with Pilot-Main Injections for Maximum Indicated Efficiency · IFAC PapersOnLine · 2018',
				'Internal Combustion Engine Cylinder Volume Trace Deviation · SAE International Journal of Engines · 2018',
				'Cylinder Pressure Based Method for In-Cycle Pilot Misfire Detection · SAE International Journal of Advances and Current Practices in Mobility · 2019',
				'Bayesian Method for Fuel Mass Estimation of Short Pilot Injections based on its Misfire Probability · ACC · 2020',
				'Multi-Cylinder Adaptation of In-Cycle Predictive Combustion Models · SAE Technical Paper Series · 2020',
				'In-Cycle Closed-Loop Combustion Control for Pilot Misfire Compensation · SAE International Journal of Advances and Current Practices in Mobility · 2020',
				'Stochastic Set-Point Optimization for In-Cycle Closed-Loop Combustion Control Operation · SAE Technical Paper Series · 2021',
				'Modular Design and Integration of In-Cycle Closed-Loop Combustion Controllers for a Wide-Range of Operating Conditions · ACC · 2021',
				'FPGA Implementation of In-Cycle Closed-Loop Combustion Control Methods · SAE Technical Paper Series · 2021',
				'Indicated efficiency optimization by in-cycle closed-loop combustion control of diesel engines · Control Engineering Practice · 2022',
			],
		},
	},
	{
		id: 'credential-patents',
		title: 'Patents',
		visibleItems: ['5 patent records across control, diagnostics, and combustion-related inventions.'],
		disclosure: {
			collapsedLabel: 'See all patents',
			expandedLabel: 'Hide patents',
			details: [
				'Method and system for determining in-cycle a pilot injection fuel mass in a combustion chamber of an engine · WO2019045623A1 · 2019-03-07',
				'Method and system for fuel pump regulation · WO2016043652A1 · 2016-03-24',
				'System and method for improving heat release evaluation at a reciprocating internal combustion engine · WO2017217912A1 · 2017-12-21',
				'Method and system for diagnosing a fuel system II · WO2017003366A1 · 2017-01-05',
				'Method and system for diagnosing a fuel system · WO2017003365A1 · 2017-01-05',
			],
		},
	},
	{
		id: 'credential-continuing-learning',
		title: 'Continuous learning',
		visibleItems: [
			'LangChain and LLMs with Python, Alten, 2025',
			'Project Management: Product Owner and Kanban, Cualtis, 2024',
			'Power Electronic Converters, 2022',
			'Introduction to Electromobility, Swedish Electromobility Centre, 2020',
			'GT Power, Gamma Technologies, 2015',
		],
	},
	{
		id: 'credential-certifications',
		title: 'Certifications and recognition',
		visibleItems: [
			'Scania Innovation Challenge, Scania, 2019',
			'Outstanding Oral Presentation Award, SAE, 2017',
			'Double Degree Scholarship, COIICV, 2013',
			'Best Academic Record for First Year, Polytechnic University of Valencia, 2009',
		],
	},
];

const methodGroups: MethodGroup[] = [
	{
		title: 'Control and architecture',
		items: [
			'Model-based development, control architecture, system identification, observer design, virtual sensing, model adaptation, signal processing, Kalman filtering, stochastic modeling, optimization, and model predictive control.',
		],
	},
	{
		title: 'Embedded implementation',
		items: [
			'C, C++, Python, MATLAB/Simulink, Stateflow, Embedded Coder, CAPL, LabVIEW FPGA, generated-code integration, application-layer software, diagnostics implementation, and ECU flashing.',
		],
	},
	{
		title: 'Validation and calibration',
		items: [
			'MIL, SIL, HIL, unit tests, integration tests, regression testing, fault injection, test bench, wind tunnel, test track, on-road testing, field-data analysis, calibration support, and ECU debugging.',
		],
	},
	{
		title: 'Standards and vehicle networks',
		items: [
			'ISO 26262, A-SPICE, AUTOSAR-oriented development, functional safety analysis, traceability, CAN, J1939, CANalyzer, and CANoe.',
		],
	},
	{
		title: 'Engineering delivery',
		items: [
			'Requirements alignment, architecture coordination, code review, issue tracking, release workflows, agile delivery, CI/CD, mentoring, cross-functional coordination, Git, GitLab, Jenkins, Jira, SAFe, Scrum, and Kanban.',
		],
	},
	{
		title: 'Languages',
		items: ['Spanish · native', 'Catalan · native', 'English · full professional', 'Swedish · full professional'],
	},
];

const visibleExperienceCount = 4;
const totalExperienceRoles = experienceGroups.reduce((count, group) => count + group.roles.length, 0);
const normalizeRoleContext = (context: string, groupHeading: string) => {
	if (context === groupHeading) return '';
	const prefix = `${groupHeading} · `;
	return context.startsWith(prefix) ? context.slice(prefix.length) : context;
};
const experienceRenderGroups: ExperienceRenderGroup[] = [];

{
	let visibleRolesUsed = 0;

	for (const group of experienceGroups) {
		const isExtra = visibleRolesUsed >= visibleExperienceCount;
		experienceRenderGroups.push({
			...group,
			isExtra,
			roles: group.roles.map((role) => ({
				...role,
				displayContext: normalizeRoleContext(role.context, group.heading),
			})),
		});
		visibleRolesUsed += group.roles.length;
	}
}

const visibleProofItems = proofItems
	.map((item) => ({ value: cleanDisplayText(item.value), label: cleanDisplayText(item.label) }))
	.filter((item) => item.value && item.label);
const visibleOverviewParagraphs = visibleItems(overview.paragraphs);
const visibleOverviewScopeItems = visibleItems(overview.scopeItems);
const visibleProjectRows = projectRows
	.map((row) => ({
		...row,
		title: cleanDisplayText(row.title),
		summary: cleanDisplayText(row.summary),
		meta: cleanDisplayText(row.meta),
		linkLabel: cleanDisplayText(row.linkLabel),
		linkHref: cleanDisplayText(row.linkHref),
	}))
	.filter((row) => row.title && row.summary && row.meta);
---

<Layout
	title="CV | Carlos Jorques"
	description="Structural CV page skeleton for Carlos Jorques, aligned with the portfolio’s established layout, spacing, and responsive patterns."
>
	<div class="cv-page">
		<section id="cv-hero" class="cv-hero" aria-labelledby="cv-title">
			<div class="page-container">
				<div class="cv-hero__inner">
					<div class="cv-hero__copy">
						<p class="section-eyebrow">Online CV</p>
						<h1 id="cv-title" class="hero-title">Carlos Jorques, Ph.D.</h1>
						<p class="cv-hero__positioning">
							I lead the architecture and delivery of real-time control software for electric and autonomous heavy-duty vehicles, connecting control design, embedded implementation, diagnostics and validation.
						</p>
						<div class="button-row cv-hero__actions">
							{actions.map((action) => (
								<a class:list={['button', { primary: action.primary }]} href={withBase(action.href)}>
									{action.label}
								</a>
							))}
						</div>
						<p class="cv-hero__meta">Valencia, Spain · Open to selected opportunities</p>
					</div>
					<aside class="cv-proof panel" aria-label="Professional snapshot">
						<p class="cv-proof__label">At a glance</p>
						<ul class="cv-proof__list">
							{visibleProofItems.map((item) => (
								<li>
									<strong>{item.value}</strong>
									<span>{item.label}</span>
								</li>
							))}
						</ul>
					</aside>
				</div>
			</div>
		</section>

		<nav class="cv-section-nav-float" aria-label="CV sections">
			<button class="cv-section-nav-float__trigger" type="button" aria-label="Show CV sections" tabindex="-1">
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
			</button>
			<ul>
				{sectionNav.map((item) => (
					<li>
						<a class="cv-nav-link" href={`#${item.id}`} data-cv-nav-link data-target={item.id}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<main class="cv-main-flow">
			<section id="overview" class="cv-section" aria-labelledby="overview-title">
				<div class="page-container cv-section__layout">
					<h2 id="overview-title" class="cv-section__rail-heading">Overview</h2>
					<div class="cv-section__content">
						{hasVisibleText(overview.heading) && <h3>{cleanDisplayText(overview.heading)}</h3>}
						{visibleOverviewParagraphs.length > 0 && (
							<div class="cv-prose">
								{visibleOverviewParagraphs.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						)}
						{visibleOverviewScopeItems.length > 0 && (
							<ul class="cv-scope-list">
								{visibleOverviewScopeItems.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						)}
					</div>
				</div>
			</section>

			<section id="experience" class="cv-section" aria-labelledby="experience-title">
				<div class="page-container cv-section__layout">
					<h2 id="experience-title" class="cv-section__rail-heading">Experience</h2>
					<div class="cv-section__content cv-section__content--wide">
						<ol id="experience-list" class="cv-experience-list">
							{experienceRenderGroups.map((group) => (
								<li class:list={['cv-experience-group', { 'cv-role--extra': group.isExtra }]} data-role-visibility={group.isExtra ? 'extra' : 'primary'}>
									<section class="cv-experience-group__section" aria-labelledby={`${group.id}-title`}>
										<header class="cv-experience-group__header">
											<div class="cv-experience-group__header-stick">
												{hasVisibleText(group.heading) && <h3 id={`${group.id}-title`}>{cleanDisplayText(group.heading)}</h3>}
												{hasVisibleText(group.meta) && <p class="cv-experience-group__meta">{cleanDisplayText(group.meta)}</p>}
												{hasVisibleText(group.location) && <p class="cv-experience-group__location">{cleanDisplayText(group.location)}</p>}
											</div>
										</header>
										<ol class="cv-experience-group__roles">
											{group.roles.map((item) => {
												const detailGroups = visibleDetailGroups(item.details);
												const visibleContributions = visibleItems(item.contributions).slice(0, 2);
												const roleTitle = cleanDisplayText(item.title);
												const roleMeta = cleanDisplayText(item.meta);
												const roleContext = cleanDisplayText(item.displayContext);
												const roleMandate = cleanDisplayText(item.mandate);
												const roleScope = cleanDisplayText(item.scope);
												return (
												<li class="cv-role">
													<article class="cv-role__card cv-disclosure-item" aria-labelledby={`${item.id}-title`}>
														<div class="cv-role__collapsed">
															<div class="cv-role__taxonomy">
																{roleMeta && <p class="cv-role__date">{roleMeta}</p>}
																{roleContext && (
																	<p class="cv-role__employer">{roleContext}</p>
																)}
																{roleTitle && <h4 id={`${item.id}-title`}>{roleTitle}</h4>}
															</div>
															<div class="cv-role__summary-block">
																{roleMandate && <p class="cv-role__mandate">{roleMandate}</p>}
																{visibleContributions.length > 0 && (
																	<ul class="cv-role__contributions" aria-label={`Selected evidence for ${roleTitle || 'this role'}`}>
																		{visibleContributions.map((contribution) => (
																			<li>{contribution}</li>
																		))}
																	</ul>
																)}
																{roleScope && <p class="cv-role__scope">{roleScope}</p>}
																{detailGroups.length > 0 && (
																	<button
																		class="cv-disclosure-button"
																		type="button"
																		aria-expanded="false"
																		aria-controls={`${item.id}-details`}
																		data-disclosure-toggle
																		data-label-collapsed="View role details"
																		data-label-expanded="Hide role details"
																	>
																		<span>View role details</span>
																	</button>
																)}
															</div>
														</div>
														{detailGroups.length > 0 && (
															<div id={`${item.id}-details`} class="cv-disclosure-panel cv-disclosure-panel--role" hidden>
																{detailGroups.map((detailGroup) => (
																<section class="cv-detail-group" aria-labelledby={`${item.id}-${detailGroup.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
																	<h5 id={`${item.id}-${detailGroup.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{detailGroup.title}</h5>
																	<ul>
																		{detailGroup.items.map((detail) => (
																			<li>{detail}</li>
																		))}
																	</ul>
																</section>
																))}
															</div>
														)}
													</article>
												</li>
											)})}
										</ol>
									</section>
								</li>
							))}
						</ol>
						{experienceRenderGroups.some((group) => group.isExtra) && (
							<button
								class="cv-see-all-button"
								type="button"
								aria-expanded="false"
								aria-controls="experience-list"
								data-see-all-roles
								data-label-collapsed={`See all experience (${totalExperienceRoles} roles)`}
								data-label-expanded="Show recent experience"
							>
								<span>See all experience ({totalExperienceRoles} roles)</span>
							</button>
						)}
					</div>
				</div>
			</section>

			<section id="expertise" class="cv-section" aria-labelledby="expertise-title">
				<div class="page-container cv-section__layout">
					<h2 id="expertise-title" class="cv-section__rail-heading">Core expertise</h2>
					<div class="cv-section__content cv-section__content--wide">
						<div class="cv-card-grid">
							{expertiseItems.map((item) => {
								const title = cleanDisplayText(item.title);
								const scope = cleanDisplayText(item.scope);
								const ownership = cleanDisplayText(item.ownership);
								const evidence = visibleItems(item.evidence);
								const methodsAndConstraints = visibleItems(item.methodsAndConstraints);
								const hasDetails =
									Boolean(ownership) ||
									evidence.length > 0 ||
									methodsAndConstraints.length > 0 ||
									Boolean(item.relatedProject && hasVisibleLink(item.relatedProject.label, item.relatedProject.href));

								return title && scope ? (
								<article class="cv-card panel cv-disclosure-item" aria-labelledby={`${item.id}-title`}>
									<div class="cv-card__collapsed">
										<h3 id={`${item.id}-title`}>{title}</h3>
										<p class="cv-card__summary">{scope}</p>
										{hasDetails && (
											<button
												class="cv-disclosure-button"
												type="button"
												aria-expanded="false"
												aria-controls={`${item.id}-details`}
												data-disclosure-toggle
												data-label-collapsed="View expertise details"
												data-label-expanded="Hide expertise details"
											>
												<span>View expertise details</span>
											</button>
										)}
									</div>
									{hasDetails && (
										<div id={`${item.id}-details`} class="cv-disclosure-panel" hidden>
										{ownership && (
											<section class="cv-detail-group" aria-labelledby={`${item.id}-ownership`}>
												<h4 id={`${item.id}-ownership`}>In Practice</h4>
												<p>{ownership}</p>
											</section>
										)}
										{evidence.length > 0 && (
											<section class="cv-detail-group" aria-labelledby={`${item.id}-evidence`}>
												<h4 id={`${item.id}-evidence`}>Track Record</h4>
												<ul>
													{evidence.map((detail) => (
														<li>{detail}</li>
													))}
												</ul>
											</section>
										)}
										{methodsAndConstraints.length > 0 && (
											<section class="cv-detail-group" aria-labelledby={`${item.id}-methods`}>
												<h4 id={`${item.id}-methods`}>How It's Shaped</h4>
												<ul>
													{methodsAndConstraints.map((detail) => (
														<li>{detail}</li>
													))}
												</ul>
											</section>
										)}
										{item.relatedProject && hasVisibleLink(item.relatedProject.label, item.relatedProject.href) && (
											<p class="cv-related-link">
												<a href={withBase(cleanDisplayText(item.relatedProject.href))}>{cleanDisplayText(item.relatedProject.label)}</a>
											</p>
										)}
										</div>
									)}
								</article>
								) : null;
							})}
						</div>
					</div>
				</div>
			</section>

			<section id="projects" class="cv-section" aria-labelledby="projects-title">
				<div class="page-container cv-section__layout">
					<h2 id="projects-title" class="cv-section__rail-heading">Project record</h2>
					<div class="cv-section__content">
						<div class="cv-project-list" role="list">
							{visibleProjectRows.map((row) => (
								<article class="cv-project-row" role="listitem">
									<h3>{row.title}</h3>
									<p class="cv-project-row__summary">{row.summary}</p>
									<p class="cv-project-row__meta">{row.meta}</p>
									{hasVisibleLink(row.linkLabel, row.linkHref) && (
										<p class="cv-project-row__link">
											<a href={withBase(row.linkHref)}>{row.linkLabel}</a>
										</p>
									)}
								</article>
							))}
						</div>
						<p class="cv-section-cta">
							<a href={withBase('/work')}>Explore selected work</a>
						</p>
					</div>
				</div>
			</section>

			<section id="credentials" class="cv-section" aria-labelledby="credentials-title">
				<div class="page-container cv-section__layout">
					<h2 id="credentials-title" class="cv-section__rail-heading">Education and professional record</h2>
					<div class="cv-section__content">
						<div class="cv-credentials-list">
							{credentialGroups.map((group) => (
								(() => {
									const groupItems = visibleItems(group.visibleItems);
									const disclosureDetails = visibleItems(group.disclosure?.details);
									const groupTitle = cleanDisplayText(group.title);
									const hasDisclosure = Boolean(group.disclosure && disclosureDetails.length > 0);
									const hasContent = groupItems.length > 0 || hasVisibleLink(group.linkLabel, group.linkHref) || hasDisclosure;
									return groupTitle && hasContent ? (
								<section class="cv-credential-group" aria-labelledby={`${group.id}-title`}>
									<h3 id={`${group.id}-title`}>{groupTitle}</h3>
									{groupItems.length > 0 && (
										<ul class="cv-credential-group__visible">
											{groupItems.map((item) => (
											<li>{item}</li>
											))}
										</ul>
									)}
									{hasVisibleLink(group.linkLabel, group.linkHref) && (
										<p class="cv-credential-group__link">
											<a href={withBase(cleanDisplayText(group.linkHref))}>{cleanDisplayText(group.linkLabel)}</a>
										</p>
									)}
									{hasDisclosure && (
										<>
											<button
												class="cv-disclosure-button"
												type="button"
												aria-expanded="false"
												aria-controls={`${group.id}-details`}
												data-disclosure-toggle
												data-label-collapsed={group.disclosure.collapsedLabel}
												data-label-expanded={group.disclosure.expandedLabel}
											>
												<span>{group.disclosure.collapsedLabel}</span>
											</button>
											<div id={`${group.id}-details`} class="cv-disclosure-panel" hidden>
												<ul class="cv-plain-list">
													{disclosureDetails.map((detail) => (
														<li>{detail}</li>
													))}
												</ul>
											</div>
										</>
									)}
								</section>
									) : null;
								})()
							))}
						</div>
					</div>
				</div>
			</section>

			<section id="methods" class="cv-section" aria-labelledby="methods-title">
				<div class="page-container cv-section__layout">
					<h2 id="methods-title" class="cv-section__rail-heading">Methods, tools and additional information</h2>
					<div class="cv-section__content">
						<div class="cv-method-groups">
							{methodGroups.map((group) => (
								(() => {
									const items = visibleItems(group.items);
									return items.length > 0 ? (
								<section class="cv-method-group" aria-labelledby={`method-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
									<h3 id={`method-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{cleanDisplayText(group.title)}</h3>
									<ul>
										{items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</section>
									) : null;
								})()
							))}
						</div>
					</div>
				</div>
			</section>

			<section class="cv-section cv-closing" aria-labelledby="cv-closing-title">
				<div class="page-container cv-section__layout">
					<h2 id="cv-closing-title" class="cv-section__rail-heading">Contact</h2>
					<div class="cv-section__content">
						<h3>Looking for an embedded controls technical lead?</h3>
						<div class="cv-prose">
							<p>
								For roles or technical conversations involving embedded controls, electric vehicles, battery and thermal management,
								diagnostics, functional safety, autonomous machines, or reliable physical systems, contact me directly or download the PDF CV.
							</p>
							<p>Based in Spain and open to selected remote or hybrid opportunities with international teams.</p>
						</div>
						<div class="button-row">
							<a class="button primary" href={withBase('/contact')}>Contact</a>
							<a class="button" href={withBase('/cv/Carlos_Jorques_CV.pdf')}>Download PDF CV</a>
						</div>
					</div>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.cv-page {
		width: min(calc(100% - 5rem), var(--content-width));
		margin: 0 auto;
		padding-bottom: 5rem;
		--cv-anchor-offset: 1.5rem;
	}

	.cv-page .page-container {
		width: 100%;
	}

	.cv-hero,
	.cv-section {
		scroll-margin-top: var(--cv-anchor-offset);
	}

	.cv-hero {
		padding: clamp(3rem, 5vw, 4.6rem) 0 2.5rem;
	}

	.cv-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}

	.cv-hero__copy {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.cv-hero .section-eyebrow {
		margin: 0;
		color: var(--color-muted);
	}

	.cv-hero .hero-title {
		max-width: none;
		font-size: clamp(2.6rem, 3.8vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.05em;
		line-height: 1.02;
	}

	.cv-hero__positioning {
		max-width: 52rem;
		margin: 0;
		color: var(--color-text);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.cv-hero__actions {
		margin-top: 0.5rem;
	}

	.cv-hero__meta {
		margin: 0.85rem 0 0;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.08em;
