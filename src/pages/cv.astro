                        color-mix(in srgb, var(--color-footer-bg) 28%, var(--color-page)) 0%,
                        var(--color-page) 100%
                );
                background-repeat: no-repeat;
                background-position: top left;
                background-size: 100% clamp(5rem, 8vw, 6.5rem);
        }

	.cv-section--compact {
		padding-block: clamp(2.25rem, 5vw, 4rem);
	}

