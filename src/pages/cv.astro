<script is:inline>
	(() => {
		const root = document;
		const toggles = Array.from(root.querySelectorAll('[data-disclosure-toggle]'));
		const navLinks = Array.from(root.querySelectorAll('[data-cv-nav-link]'));
		const mobileNav = root.querySelector('.cv-section-nav-mobile');
		const experienceExpandAll = root.querySelector('[data-expand-all="experience"]');
		const experienceCollapseAll = root.querySelector('[data-collapse-all="experience"]');

		const setDisclosureState = (button, expanded) => {
			const panelId = button.getAttribute('aria-controls');
			if (!panelId) return;

			const panel = root.getElementById(panelId);
			if (!panel) return;

			button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
			const collapsedLabel = button.getAttribute('data-label-collapsed') ?? 'Show structure';
			const expandedLabel = button.getAttribute('data-label-expanded') ?? 'Hide structure';
			const label = button.querySelector('span');
			const icon = button.querySelector('[aria-hidden="true"]');
			if (label) label.textContent = expanded ? expandedLabel : collapsedLabel;
			if (icon) icon.textContent = expanded ? '−' : '+';
			panel.hidden = !expanded;
		};

		toggles.forEach((button) => {
			setDisclosureState(button, button.getAttribute('aria-expanded') === 'true');
			button.addEventListener('click', () => {
				const expanded = button.getAttribute('aria-expanded') === 'true';
				setDisclosureState(button, !expanded);
			});
		});

		const experienceButtons = toggles.filter(
			(button) => button.getAttribute('data-disclosure-group') === 'experience',
		);

		experienceExpandAll?.addEventListener('click', () => {
			experienceButtons.forEach((button) => setDisclosureState(button, true));
		});

		experienceCollapseAll?.addEventListener('click', () => {
			experienceButtons.forEach((button) => setDisclosureState(button, false));
		});

		const sections = navLinks
			.map((link) => {
				const target = link.getAttribute('data-target');
				if (!target) return null;
				const section = root.getElementById(target);
				return section ? { id: target, section } : null;
			})
			.filter(Boolean);

		if ('IntersectionObserver' in window && sections.length > 0) {
			const setActiveLink = (id) => {
				navLinks.forEach((link) => {
					link.setAttribute('aria-current', link.getAttribute('data-target') === id ? 'true' : 'false');
				});
			};

			const observer = new IntersectionObserver(
				(entries) => {
					const visible = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

					if (visible?.target?.id) {
						setActiveLink(visible.target.id);
					}
				},
				{
					rootMargin: '-25% 0px -55% 0px',
					threshold: [0.2, 0.45, 0.7],
				},
			);

			sections.forEach((item) => observer.observe(item.section));
			setActiveLink('overview');
		}

		navLinks.forEach((link) => {
			link.addEventListener('click', () => {
				if (mobileNav?.hasAttribute('open')) {
					mobileNav.removeAttribute('open');
				}
			});
		});
	})();
</script>
