<Layout
	title="Online CV - Senior Electronics Engineer and Embedded Controls Architect"
	description="Recruiter-first online CV for Carlos Jorques, a senior electronics engineer and embedded controls architect working across electric and autonomous vehicle systems, real-time control, diagnostics, functional safety, and production embedded software."
>
	<section class="cv-hero" aria-labelledby="cv-title">
		<div class="page-container cv-hero__inner">
			<div class="cv-hero__content">
				<p class="eyebrow">Online CV</p>
				<h1 id="cv-title">Carlos Jorques</h1>
				<p class="cv-hero__subtitle">
					Senior Electronics Engineer | Embedded Controls Architect | Electric & Autonomous Vehicle Systems
				</p>
				<p class="cv-hero__summary">
					Senior electronics and embedded controls engineer with 10+ years of experience developing real-time
					control software for automotive and heavy-duty vehicle systems. I work at the intersection of automatic
					control, model-based development, diagnostics, functional safety, validation, and production embedded
					software.
				</p>
				<p class="cv-hero__extended">
					My background spans electric trucks, battery and powertrain thermal management, autonomous electric
					haulers, power electronics interfaces, heavy-duty engine diagnostics, and industrial research in
					real-time control. I translate control concepts into robust, testable, safety-aware embedded software
					for complex physical systems.
				</p>
				<div class="button-row cv-actions" aria-label="CV actions">
					{actions.map((action) => (
						<a
							class={action.primary ? 'button primary' : 'button'}
							href={action.href}
							target={action.external ? '_blank' : undefined}
							rel={action.external ? 'noopener noreferrer' : undefined}
							download={action.download ? true : undefined}
						>
							{action.label}
						</a>
					))}
				</div>
			</div>

			<ul class="cv-proof-grid" aria-label="Career proof points">
				{proofCards.map((card) => (
					<li>
						<strong>{card.value}</strong>
						<span>{card.label}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<nav class="cv-jump-nav" aria-label="CV section navigation">
		<div class="page-container cv-jump-nav__inner">
			<span>Jump to</span>
			{quickNav.map((item) => (
				<a href={item.href}>{item.label}</a>
			))}
		</div>
	</nav>

	<section class="cv-section cv-section--compact" id="relevant-for" aria-labelledby="relevant-for-title">
		<div class="page-container cv-section__split">
			<div class="cv-section__intro">
