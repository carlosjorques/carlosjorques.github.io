                isolation: isolate;
        }

        .cv-section-nav-shell::before {
                content: '';
                position: absolute;
                inset: 0 calc(50% - 50vw);
                z-index: -1;
                border-bottom: 1px solid color-mix(in srgb, var(--color-card-border) 38%, transparent);
