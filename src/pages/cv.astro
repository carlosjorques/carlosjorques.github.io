---
import Layout from '../layouts/Layout.astro';

type CvAction = {
	label: string;
	href: string;
	primary?: boolean;
};

type SectionNavItem = {
	id: string;
	label: string;
};

type OverviewItem = {
	heading: string;
	paragraphs: string[];
	scopeItems: string[];
};

type DetailGroup = {
	title: string;
	items: string[];
};

type ExpertiseItem = {
	id: string;
	title: string;
	scope: string;
	methodsAndConstraints: string[];
	problemsAddressed: string[];
	ownership: string[];
	applications: string[];
	relatedProject?: {
		label: string;
		href: string;
	};
};

type ExperienceItem = {
	id: string;
	title: string;
	context: string;
	meta: string;
	mandate: string;
	contributions: string[];
	ownership: string;
	details: DetailGroup[];
};

type ProjectRow = {
	title: string;
	summary: string;
	meta: string;
	linkLabel?: string;
	linkHref?: string;
};

type CredentialGroup = {
	id: string;
	title: string;
	visibleItems: string[];
	disclosure?: {
		collapsedLabel: string;
		expandedLabel: string;
		details: string[];
	};
};

type MethodGroup = {
	title: string;
	items: string[];
};

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (href: string) =>
	href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')
		? href
		: `${normalizedBase}${href.replace(/^\//, '')}`;

const actions: CvAction[] = [
	{ label: 'Download CV', href: '#download-cv', primary: true },
	{ label: 'Contact', href: '/contact' },
];

const sectionNav: SectionNavItem[] = [
	{ id: 'overview', label: 'Overview' },
	{ id: 'expertise', label: 'Expertise' },
	{ id: 'experience', label: 'Experience' },
	{ id: 'projects', label: 'Projects' },
	{ id: 'credentials', label: 'Credentials' },
	{ id: 'methods', label: 'Methods' },
];

const proofItems = [
