		max-height: calc(100vh - var(--site-header-height, 4rem) - 4rem);
		overflow: auto;
		border-left: 1px solid var(--color-border);
		padding-left: 1rem;
	}

	.cv-section-nav__inner {
		display: grid;
		gap: 1rem;
		align-items: start;
		padding-block: 0.25rem;
	}

	.cv-section-nav span,
	.cv-section-nav a,
	.cv-card__meta,
	.cv-role__period,
	.cv-role__location,
	.cv-disclosure > summary {
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: var(--type-meta-weight);
		letter-spacing: var(--type-meta-tracking);
		line-height: var(--type-meta-line);
		text-transform: uppercase;
	}

	.cv-section-nav span {
		color: var(--color-soft);
	}

	.cv-section-nav ul {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cv-section-nav li {
		margin: 0;
	}

	.cv-section-nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--color-text);
		text-decoration: none;
		transition:
			color 140ms cubic-bezier(0.2, 0, 0, 1),
			transform 140ms cubic-bezier(0.2, 0, 0, 1);
	}

	.cv-section-nav a::before {
		content: '';
		width: 0.38rem;
		height: 0.38rem;
		border: 1px solid currentColor;
		background: transparent;
		transform: rotate(45deg);
		transition:
			background-color 140ms cubic-bezier(0.2, 0, 0, 1),
			transform 140ms cubic-bezier(0.2, 0, 0, 1);
	}

	.cv-section-nav a::after {
		content: '';
		position: absolute;
		right: auto;
		bottom: -0.22rem;
		left: 0.92rem;
		width: calc(100% - 0.92rem);
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 140ms cubic-bezier(0.2, 0, 0, 1);
	}

		.cv-section-nav a:hover,
		.cv-section-nav a:focus-visible,
		.cv-section-nav a[aria-current='true'] {
				color: var(--color-accent-text);
		}

	.cv-section-nav a[aria-current='true']::after,
	.cv-section-nav a:hover::after,
	.cv-section-nav a:focus-visible::after {
		transform: scaleX(1);
	}

		.cv-section-nav a[aria-current='true']::before {
				background: currentColor;
				transform: rotate(45deg) scale(1.12);
		}

	.cv-section-nav__actions {
		display: grid;
		gap: 0.45rem;
		border-top: 1px solid var(--color-border-soft);
		padding-top: 1rem;
	}

	.cv-section-nav__actions a {
		color: var(--color-soft);
		font-size: var(--type-nav-size);
	}

        .cv-section {
                padding-block: clamp(3rem, 6vw, 5rem);
                scroll-margin-top: 5.5rem;
                background-color: var(--color-page);
                background-image: linear-gradient(
