<Layout
	title="CV | Carlos Jorques"
	description="Online CV of Carlos Jorques, embedded controls architect and technical leader working across control systems, real-time embedded software, diagnostics, validation, and reliable physical systems."
>
	<section class="cv-hero">
		<div class="page-container cv-hero__inner">
			<p class="eyebrow">Online CV</p>
			<h1>Carlos Jorques</h1>
			<p class="cv-hero__subtitle">Embedded Controls Architect / Technical Leader</p>
			<p class="cv-hero__summary">
				Senior control systems engineer and embedded software developer with more than 10 years of automotive experience across electric vehicles, hybrid powertrains, and advanced combustion engines. His work connects control algorithm development, model-based design, real-time embedded software, diagnostics, validation, and technical leadership.
			</p>
			<div class="button-row cv-actions" aria-label="CV page primary actions">
				<a class="button primary" href={withBase('/contact')}>Contact Carlos</a>
				<a class="button" href={cvPdfHref}>Download PDF CV</a>
			</div>
		</div>
	</section>

	<section class="cv-section" aria-labelledby="profile-snapshot-title">
		<div class="page-container">
			<div class="cv-section__intro">
				<h2 id="profile-snapshot-title">Profile Snapshot</h2>
			</div>
			<div class="cv-snapshot">
				{profileFacts.map((fact) => (
					<article class="cv-card cv-card--fact">
						<p>{fact.label}</p>
						<h3>{fact.value}</h3>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cv-section" aria-labelledby="core-expertise-title">
		<div class="page-container">
			<div class="cv-section__intro">
				<h2 id="core-expertise-title">Core Expertise</h2>
				<p>Capability areas supported by the source CV material.</p>
			</div>
			<div class="cv-grid cv-grid--three">
				{coreExpertise.map((group) => (
					<article class="cv-card">
						<h3>{group.title}</h3>
						<details class="cv-disclosure">
							<summary>View capability evidence</summary>
							<ul>
								{group.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</details>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="cv-section cv-experience-section" aria-labelledby="professional-experience-title" data-experience-timeline>
		<div class="page-container">
			<div class="cv-section__intro">
				<h2 id="professional-experience-title">Professional Experience</h2>
				<p>Reverse chronological role history, condensed for recruiter and hiring-manager review.</p>
			</div>
			<div class="cv-experience-layout">
				<aside class="cv-experience-nav" aria-label="Experience milestones">
					<div class="cv-progress-track" data-experience-track aria-hidden="true">
						<span class="cv-progress-fill" data-experience-fill></span>
					</div>
					<ol class="cv-milestones">
						{experience.map((item, index) => (
							<li data-milestone-item>
								<a href={`#experience-${index}`}>
									<span>{item.period}</span>
									<strong>{item.organization}</strong>
								</a>
							</li>
						))}
					</ol>
				</aside>
				<div class="cv-timeline">
					{experience.map((item, index) => (
						<article class="cv-role" id={`experience-${index}`} data-role-card>
							<div class="cv-role__header">
								<div>
									<h3>{item.role}</h3>
									<p class="cv-role__organization">{item.organization}</p>
								</div>
								<p class="cv-role__meta">{item.period} | {item.location}</p>
							</div>
							<p class="cv-role__summary">{item.summary}</p>
							<details class="cv-disclosure cv-disclosure--role">
								<summary>View role details</summary>
								<div class="cv-detail-body">
									<ul>
										{item.highlights.map((highlight) => (
											<li>{highlight}</li>
										))}
									</ul>
									<ul class="cv-tags" aria-label={`${item.role} technologies and methods`}>
										{item.tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								</div>
							</details>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="cv-section" aria-labelledby="selected-projects-title">
		<div class="page-container">
			<div class="cv-section__intro">
				<h2 id="selected-projects-title">Selected Projects and Assignments</h2>
				<p>Public-safe summaries of project-level work from the source material.</p>
			</div>
			<div class="cv-grid cv-grid--two">
				{projects.map((project) => (
					<article class="cv-card cv-project">
						<p class="cv-kicker">{project.context}</p>
						<h3>{project.title}</h3>
						<p>{project.focus}</p>
						<details class="cv-disclosure">
							<summary>View assignment details</summary>
							<dl>
								<div>
									<dt>Role</dt>
									<dd>{project.role}</dd>
								</div>
								<div>
									<dt>Contribution</dt>
									<dd>{project.contribution}</dd>
								</div>
							</dl>
							<ul class="cv-tags" aria-label={`${project.title} tags`}>
								{project.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</details>
