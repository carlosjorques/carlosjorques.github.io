<Layout
	title="Carlos Jorques | Embedded Control Systems Architect CV"
	description="Online CV of Carlos Jorques, Embedded Control Systems Architect and Technical Lead with 12+ years of experience in electric vehicles, autonomous machinery, and production embedded control software."
>
	<div class="cv-page">
		<section id="cv-hero" class="cv-hero" aria-labelledby="cv-title">
			<div class="page-container">
				<div class="cv-hero__inner">
					<div class="cv-hero__copy">
						<p class="section-eyebrow">Online CV</p>
						<h1 id="cv-title" class="hero-title">Carlos Jorques</h1>
						<p class="cv-hero__role">Embedded Control Systems Architect & Technical Lead</p>
						<p class="cv-hero__positioning">
							I lead the architecture and delivery of real-time control software for electric and autonomous heavy-duty vehicles, connecting control design, embedded implementation, diagnostics and validation.
						</p>
						<div class="button-row cv-hero__actions">
							{actions.map((action) => (
								<a
									class:list={['button', { primary: action.primary }]}
									href={withBase(action.href)}
									data-source-section="cv-hero"
								>
									{action.label}
								</a>
							))}
							<a
								class="button cv-hero__linkedin"
								href={LINKEDIN_URL}
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Connect with Carlos Jorques on LinkedIn"
								data-analytics-event="linkedin_outbound_click"
								data-cta-id="cv-hero-linkedin"
								data-cta-placement="cv-hero"
								data-cta-intent="professional-profile"
								data-source-section="cv-hero"
							>
								<span class="cv-hero__linkedin-mark" aria-hidden="true">in</span>
								<span>LinkedIn</span>
							</a>
						</div>
						<p class="cv-hero__meta">Valencia, Spain · Open to selected opportunities</p>
					</div>
					<aside class="cv-proof panel" aria-label="Professional snapshot">
						<p class="cv-proof__label">At a glance</p>
						<ul class="cv-proof__list">
							{visibleProofItems.map((item) => (
								<li>
									<strong>{item.value}</strong>
									<span>{item.label}</span>
								</li>
							))}
						</ul>
					</aside>
				</div>
			</div>
		</section>

		<nav class="cv-section-nav-float" aria-label="Jump to CV section">
			<button
				id="cv-sections-trigger"
				class="cv-section-nav-float__trigger"
				type="button"
				aria-label="Jump to CV section"
				aria-expanded="false"
				aria-controls="cv-sections-menu"
			>
				<span>Jump to section</span>
				<span class="cv-section-nav-float__chevron" aria-hidden="true">▲</span>
			</button>
			<ul id="cv-sections-menu" aria-labelledby="cv-sections-trigger" hidden>
				{sectionNav.map((item) => (
					<li>
						<a class="cv-nav-link" href={`#${item.id}`} data-cv-nav-link data-target={item.id}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
			<a class="button cv-section-nav-float__contact" href={withBase('/contact?source=cv#message-title')}>Contact</a>
		</nav>

		<div class="cv-main-flow">
			<section id="overview" class="cv-section" aria-labelledby="overview-title">
				<div class="page-container cv-section__layout">
					<h2 id="overview-title" class="cv-section__rail-heading">Overview</h2>
					<div class="cv-section__content">
						{hasVisibleText(overview.heading) && <h3>{cleanDisplayText(overview.heading)}</h3>}
						{visibleOverviewParagraphs.length > 0 && (
							<div class="cv-prose">
								{visibleOverviewParagraphs.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						)}
						{visibleOverviewScopeItems.length > 0 && (
							<ul class="cv-scope-list">
								{visibleOverviewScopeItems.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						)}
						{visibleSelectedEvidence.length > 0 && (
							<section class="cv-overview-evidence" aria-labelledby="selected-evidence-title">
								<h3 id="selected-evidence-title">Highlights</h3>
								<ul class="cv-overview-evidence__list">
									{visibleSelectedEvidence.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</section>
						)}
					</div>
				</div>
			</section>

			<section id="experience" class="cv-section" aria-labelledby="experience-title">
				<div class="page-container cv-section__layout">
					<h2 id="experience-title" class="cv-section__rail-heading">Experience</h2>
					<div class="cv-section__content cv-section__content--wide">
						<ol id="experience-list" class="cv-experience-list">
							{experienceRenderGroups.map((group) => (
								<li
									class:list={['cv-experience-group', { 'cv-role--extra': group.isExtra, 'cv-experience-group--primary': !group.isExtra, 'cv-experience-group--with-bar': group.id !== 'experience-group-earlier' }]}
									data-role-visibility={group.isExtra ? 'extra' : 'primary'}
								>
									<section class="cv-experience-group__section" aria-labelledby={`${group.id}-title`}>
										<header class="cv-experience-group__header">
											<div class="cv-experience-group__header-stick">
												{hasVisibleText(group.heading) && <h3 id={`${group.id}-title`}>{cleanDisplayText(group.heading)}</h3>}
												{hasVisibleText(group.meta) && <p class="cv-experience-group__meta">{formatExperienceMeta(group.meta)}</p>}
												{hasVisibleText(group.location) && <p class="cv-experience-group__location">{cleanDisplayText(group.location)}</p>}
											</div>
										</header>
										<ol class="cv-experience-group__roles">
											{group.roles.map((item) => {
												const detailGroups = visibleDetailGroups(item.details);
												const visibleContributions = visibleItems(item.contributions).slice(0, 2);
												const roleTitle = cleanDisplayText(item.title);
													const roleMeta = formatExperienceMeta(item.meta);
												const roleContext = cleanDisplayText(item.displayContext);
												const roleMandate = cleanDisplayText(item.mandate);
												const roleScope = cleanDisplayText(item.scope);
												return (
															<li class:list={['cv-role', { 'cv-role--extra': item.isExtra }]} data-role-visibility={item.isExtra ? 'extra' : 'primary'}>
													<article class="cv-role__card cv-disclosure-item" aria-labelledby={`${item.id}-title`}>
														<div class="cv-role__collapsed">
											<div class="cv-role__taxonomy">
												{roleTitle && <h4 id={`${item.id}-title`}>{roleTitle}</h4>}
												{roleContext && <p class="cv-role__assignment">{roleContext}</p>}
												{roleMeta && <p class="cv-role__dates">{roleMeta}</p>}
															</div>
															<div class="cv-role__summary-block">
																{roleMandate && <p class="cv-role__mandate">{roleMandate}</p>}
																{visibleContributions.length > 0 && (
																	<ul class="cv-role__contributions" aria-label={`Selected evidence for ${roleTitle || 'this role'}`}>
																		{visibleContributions.map((contribution) => (
																			<li>{contribution}</li>
																		))}
																	</ul>
																)}
																{roleScope && <p class="cv-role__scope">{roleScope}</p>}
																{detailGroups.length > 0 && (
																	<button
																		class="cv-disclosure-button"
																		type="button"
																		aria-expanded="false"
																		aria-controls={`${item.id}-details`}
																		data-disclosure-toggle
																		data-label-collapsed="View role details"
																		data-label-expanded="Hide role details"
																	>
																		<span>View role details</span>
																	</button>
																)}
															</div>
														</div>
														{detailGroups.length > 0 && (
											<div id={`${item.id}-details`} class="cv-disclosure-panel cv-disclosure-panel--role" hidden inert>
																{detailGroups.map((detailGroup) => (
																<section class="cv-detail-group" aria-labelledby={`${item.id}-${detailGroup.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
																	<h5 id={`${item.id}-${detailGroup.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{detailGroup.title}</h5>
																	<ul>
																		{detailGroup.items.map((detail) => (
																			<li>{detail}</li>
																		))}
																	</ul>
																</section>
																))}
															</div>
														)}
													</article>
												</li>
											)})}
										</ol>
									</section>
								</li>
							))}
						</ol>
						{experienceRenderGroups.some((group) => group.roles.some((role) => role.isExtra)) && (
							<div class="cv-experience-more">
								<button
									class="cv-see-all-button"
									type="button"
									aria-expanded="false"
									aria-controls="experience-list"
									data-see-all-roles
									data-label-collapsed="See all experience"
									data-label-expanded="Hide previous experience"
								>
									<span>See Previous Experience</span>
								</button>
							</div>
						)}
					</div>
				</div>
			</section>

			<section id="expertise" class="cv-section" aria-labelledby="expertise-title">
				<div class="page-container cv-section__layout">
					<h2 id="expertise-title" class="cv-section__rail-heading">Core expertise</h2>
					<div class="cv-section__content cv-section__content--wide">
						<div class="cv-card-grid">
							{expertiseItems.map((item) => {
								const title = cleanDisplayText(item.title);
								const scope = cleanDisplayText(item.scope);
								const ownership = cleanDisplayText(item.ownership);
								const evidence = visibleItems(item.evidence);
								const methodsAndConstraints = visibleItems(item.methodsAndConstraints);
								const hasDetails =
									Boolean(ownership) ||
									evidence.length > 0 ||
									methodsAndConstraints.length > 0 ||
									Boolean(item.relatedProject && hasVisibleLink(item.relatedProject.label, item.relatedProject.href));

								return title && scope ? (
								<article class="cv-card panel cv-disclosure-item" aria-labelledby={`${item.id}-title`}>
									<div class="cv-card__collapsed">
										<h3 id={`${item.id}-title`}>{title}</h3>
										<p class="cv-card__summary">{scope}</p>
										{hasDetails && (
											<button
												class="cv-disclosure-button"
												type="button"
												aria-expanded="false"
												aria-controls={`${item.id}-details`}
												data-disclosure-toggle
												data-label-collapsed="View expertise details"
												data-label-expanded="Hide expertise details"
											>
												<span>View expertise details</span>
											</button>
										)}
									</div>
									{hasDetails && (
										<div id={`${item.id}-details`} class="cv-disclosure-panel" hidden inert>
						{ownership && (
							<section class="cv-detail-group" aria-labelledby={`${item.id}-ownership`}>
								<h4 id={`${item.id}-ownership`}>What I own</h4>
												<p>{ownership}</p>
											</section>
										)}
						{evidence.length > 0 && (
							<section class="cv-detail-group" aria-labelledby={`${item.id}-evidence`}>
								<h4 id={`${item.id}-evidence`}>Representative evidence</h4>
												<ul>
													{evidence.map((detail) => (
														<li>{detail}</li>
													))}
												</ul>
											</section>
										)}
						{methodsAndConstraints.length > 0 && (
							<section class="cv-detail-group" aria-labelledby={`${item.id}-methods`}>
								<h4 id={`${item.id}-methods`}>Methods and constraints</h4>
												<ul>
													{methodsAndConstraints.map((detail) => (
														<li>{detail}</li>
													))}
												</ul>
											</section>
										)}
										{item.relatedProject && hasVisibleLink(item.relatedProject.label, item.relatedProject.href) && (
											<p class="cv-related-link">
												<a href={withBase(cleanDisplayText(item.relatedProject.href))}>{cleanDisplayText(item.relatedProject.label)}</a>
											</p>
										)}
										</div>
									)}
								</article>
								) : null;
							})}
						</div>
					</div>
				</div>
			</section>

			<section id="projects" class="cv-section" aria-labelledby="projects-title">
				<div class="page-container cv-section__layout">
						<h2 id="projects-title" class="cv-section__rail-heading">Selected project evidence</h2>
					<div class="cv-section__content">
						<div class="cv-project-list" role="list">
							{visibleProjectRows.map((row) => (
								<article class="cv-project-row" role="listitem">
									<h3>{row.title}</h3>
									<p class="cv-project-row__summary">
										{row.summary} <a class="cv-project-row__read-more" href={withBase(row.linkHref)}>Read more</a>
									</p>
									<p class="cv-project-row__meta">{row.meta}</p>
								</article>
							))}
						</div>
						<p class="cv-section-cta">
							<a href={withBase('/work')}>Explore all selected work</a>
						</p>
					</div>
				</div>
			</section>

			<section id="credentials" class="cv-section" aria-labelledby="credentials-title">
				<div class="page-container cv-section__layout">
					<h2 id="credentials-title" class="cv-section__rail-heading">Education and professional record</h2>
					<div class="cv-section__content">
						<details class="cv-secondary-details">
							<summary>
								<span>View details on education, research, patents and courses</span>
							</summary>
							<div class="cv-secondary-details__body">
							<div class="cv-credentials-list">
							{credentialGroups.map((group) => (
								(() => {
									const groupItems = visibleItems(group.visibleItems);
									const disclosureDetails = visibleItems(group.disclosure?.details);
									const groupTitle = cleanDisplayText(group.title);
									const hasDisclosure = Boolean(group.disclosure && disclosureDetails.length > 0);
									const hasContent = groupItems.length > 0 || hasVisibleLink(group.linkLabel, group.linkHref) || hasDisclosure;
									return groupTitle && hasContent ? (
								<section class="cv-credential-group" aria-labelledby={`${group.id}-title`}>
									<h3 id={`${group.id}-title`}>{groupTitle}</h3>
									{groupItems.length > 0 && (
										<ul class="cv-credential-group__visible">
											{groupItems.map((item) => (
											<li>{item}</li>
											))}
										</ul>
									)}
									{hasVisibleLink(group.linkLabel, group.linkHref) && (
										<p class="cv-credential-group__link">
											<a href={withBase(cleanDisplayText(group.linkHref))}>{cleanDisplayText(group.linkLabel)}</a>
										</p>
									)}
									{hasDisclosure && (
										<>
											<button
												class="cv-disclosure-button"
												type="button"
												aria-expanded="false"
												aria-controls={`${group.id}-details`}
												data-disclosure-toggle
												data-label-collapsed={group.disclosure.collapsedLabel}
												data-label-expanded={group.disclosure.expandedLabel}
											>
												<span>{group.disclosure.collapsedLabel}</span>
											</button>
											<div id={`${group.id}-details`} class="cv-disclosure-panel" hidden inert>
												<ul class="cv-plain-list">
													{disclosureDetails.map((detail) => (
														<li>{detail}</li>
													))}
												</ul>
											</div>
										</>
									)}
								</section>
									) : null;
								})()
							))}
							</div>
						</details>
					</div>
				</div>
			</section>

			<section id="methods" class="cv-section" aria-labelledby="methods-title">
				<div class="page-container cv-section__layout">
					<h2 id="methods-title" class="cv-section__rail-heading">Methods, tools and additional information</h2>
					<div class="cv-section__content">
						<details class="cv-secondary-details">
							<summary>
								<span>View methods, tools and additional information</span>
							</summary>
							<div class="cv-secondary-details__body">
								<div class="cv-method-groups">
							{methodGroups.map((group) => (
								(() => {
									const items = visibleItems(group.items);
									return items.length > 0 ? (
								<section class="cv-method-group" aria-labelledby={`method-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
									<h3 id={`method-${group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{cleanDisplayText(group.title)}</h3>
									<ul>
										{items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</section>
									) : null;
								})()
							))}
								</div>
							</div>
						</details>
					</div>
				</div>
			</section>

			<section class="cv-section cv-closing" aria-labelledby="cv-closing-title">
				<div class="page-container cv-section__layout">
					<h2 id="cv-closing-title" class="cv-section__rail-heading">Contact</h2>
					<div class="cv-section__content">
						<h3>Looking for an embedded controls architect or technical lead?</h3>
						<div class="cv-prose">
							<p>
								I’m open to roles involving embedded controls architecture, electrified or autonomous systems, technical leadership, and production embedded software.
							</p>
						</div>
						<div class="button-row">
							<a class="button primary" href={withBase('/contact?source=cv#message-title')}>Discuss an opportunity</a>
