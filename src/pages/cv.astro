	.cv-role__link { justify-self:start; margin-top:.9rem; font-weight:600; }

	.cv-skills { gap:.6rem; }
	.cv-skills__label { margin:0 !important; font-size:.8rem !important; font-weight:600; letter-spacing:.04em; text-transform:uppercase; color:var(--cv-signal) !important; scroll-margin-top:1.5rem; }
