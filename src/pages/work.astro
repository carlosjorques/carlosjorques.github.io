---
import BaseLayout from '../layouts/BaseLayout.astro';
import workMarkdown from '../content/profile/work.md?raw';
import { parseWorkContent } from '../lib/profileMarkdown';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => (href.startsWith('http') ? href : `${baseUrl}${href.replace(/^\//, '')}`);
const workContent = parseWorkContent(workMarkdown);
const workAnchorsByTitle: Record<string, string> = {
	'Electric Truck Thermal Management and BMS Systems': 'electric-truck-thermal-management',
	'Autonomous Electric Hauler Propulsion Control': 'autonomous-hauler-propulsion-control',
	'E-Bike Motor Control and Power Electronics Software': 'ebike-motor-control-power-electronics',
	'Heavy-Duty Engine Diagnostics and Control Research': 'heavy-duty-engine-diagnostics-control-research',
};
---

<BaseLayout
	title="Work"
	description="Selected technical work, research, patents, publications, and engineering contributions by Carlos Jorques."
>
	<section class="work-hero">
		<div class="page-container work-page">
			<h1>{workContent.hero.title}</h1>
			<div class="work-page__intro">
				{workContent.hero.paragraphs.map((paragraph) => (
					<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
				))}
			</div>
		</div>
	</section>

	<section class="section work-section work-section--selected" aria-labelledby="selected-work-title">
		<div class="page-container">
			<div class="work-section__intro">
				<h2 id="selected-work-title">{workContent.projects.title}</h2>
				{workContent.projects.intro && <p>{workContent.projects.intro}</p>}
			</div>
			<div class="work-list">
				{workContent.projects.items.map((item, index) => (
					<article class="work-case" id={workAnchorsByTitle[item.title]}>
						<h3>{item.title}</h3>
						<div class="work-case__content">
							<figure class="work-case__media">
								{item.image && (
									<img
										src={withBase(item.image)}
										alt={item.imageAlt ?? ''}
										loading={index === 0 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								)}
							</figure>
							<div class="work-case__description">
								{item.paragraphs.map((paragraph) => (
									<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
								))}
								<button class="work-case__read-more" type="button">Read more</button>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section work-section" aria-labelledby="applied-domains-title">
		<div class="page-container">
			<div class="work-section__intro">
				<h2 id="applied-domains-title">{workContent.domains.title}</h2>
			</div>
			<div class="work-grid">
				{workContent.domains.items.map((item) => (
					<article class="work-card">
						<h3>{item.title}</h3>
						{item.context && <p class="work-card__meta">{item.context}</p>}
						{item.paragraphs.map((paragraph) => (
							<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
						))}
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section work-section" aria-labelledby="research-context-title">
		<div class="page-container work-two-column">
			<div class="work-section__intro">
				<h2 id="research-context-title">{workContent.researchContext.title}</h2>
				{workContent.researchContext.paragraphs.map((paragraph) => (
					<p>{paragraph.map((part) => part.strong ? <strong>{part.text}</strong> : part.text)}</p>
				))}
			</div>
			<article class="work-card">
				<h3>{workContent.validation.title}</h3>
				<ul>
					{workContent.validation.items.map((item) => <li>{item}</li>)}
				</ul>
			</article>
		</div>
	</section>
</BaseLayout>

<style>
	.work-hero {
		padding-block: clamp(4rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4rem);
		border-bottom: 1px solid var(--color-border-soft);
		background: transparent;
	}

	.work-page {
		display: grid;
		gap: 1rem;
	}

	.work-page h1 {
		max-width: 12ch;
		font-family: var(--font-display);
		font-size: var(--type-hero-name-size);
		line-height: var(--type-hero-name-line);
		letter-spacing: var(--type-hero-name-tracking);
		font-weight: var(--type-hero-name-weight);
	}

	.work-page__intro,
	.work-section__intro {
		display: grid;
		gap: 0.75rem;
		max-width: 760px;
	}

	.work-page__intro p,
	.work-section__intro p,
	.work-card p,
	.work-card li,
	.work-case p {
		color: var(--color-body-text);
		font-size: var(--type-body-size);
		line-height: var(--type-body-line);
	}

	.work-page__intro p {
		max-width: 760px;
		color: var(--color-text);
		font-size: var(--type-hero-summary-size);
		line-height: var(--type-hero-summary-line);
		letter-spacing: var(--type-hero-summary-tracking);
		font-weight: var(--type-hero-summary-weight);
	}

	.work-section__intro {
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
	}

	.work-section h2 {
		font-size: var(--type-section-title-size);
		line-height: var(--type-section-title-line);
		letter-spacing: var(--type-section-title-tracking);
	}

	.work-grid,
	.work-list {
		display: grid;
		gap: clamp(1rem, 3vw, 1.5rem);
	}

	.work-grid {
		grid-template-columns: 1fr;
	}

	.work-card {
		display: grid;
		gap: 0.55rem;
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius);
		background: var(--color-card-bg);
		padding: clamp(1.1rem, 3vw, 1.5rem);
	}

	.work-card h3,
	.work-case h3 {
		color: var(--color-text);
		font-size: var(--type-card-title-size);
		line-height: var(--type-card-title-line);
		letter-spacing: var(--type-card-title-tracking);
	}

	.work-card__meta {
		color: var(--color-soft);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: 700;
		line-height: var(--type-meta-line);
		letter-spacing: var(--type-meta-tracking);
	}

	.work-case {
		display: grid;
		gap: clamp(0.9rem, 2vw, 1.25rem);
		border-top: 1px solid var(--color-border-soft);
		padding-top: clamp(1.25rem, 3vw, 1.75rem);
	}

	.work-case:first-child {
		border-top: 0;
		padding-top: 0;
	}

	.work-case__media {
		overflow: hidden;
		margin: 0;
		aspect-ratio: 16 / 11;
		border-radius: calc(var(--radius) * 0.8);
		background: var(--color-surface-soft);
	}

	.work-case__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.work-case__content {
		display: grid;
		gap: 1rem;
		align-items: start;
	}

	.work-case__description {
		display: grid;
		gap: 0.7rem;
		justify-items: start;
	}

	.work-case__read-more {
		margin-top: 0.25rem;
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius-pill);
		background: transparent;
		padding: 0.48rem 0.72rem;
		color: var(--color-text);
		cursor: default;
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: var(--type-meta-weight);
		letter-spacing: var(--type-meta-tracking);
		line-height: var(--type-meta-line);
		text-transform: uppercase;
	}

	.work-card ul {
		margin: 0;
		padding-left: 1.1rem;
	}

	.work-two-column {
		display: grid;
		gap: clamp(1.25rem, 4vw, 2.25rem);
		align-items: start;
	}

	@media (min-width: 760px) {
		.work-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.work-case__content {
			grid-template-columns: minmax(10rem, 0.48fr) minmax(0, 1fr);
			gap: clamp(1.25rem, 3vw, 2rem);
		}
	}

	@media (max-width: 640px) {
		.work-case__media {
			max-width: 100%;
		}
	}

	@media (min-width: 980px) {
		.work-two-column {
			grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.6fr);
		}
	}
</style>
