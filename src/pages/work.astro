---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => {
	if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
		return href;
	}

	return href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`;
};

const toTagSlug = (value: string) =>
	value
		.toLowerCase()
		.replaceAll('/', '-')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
const projectNotes = [
	{
		id: 'electric-truck-thermal-management',
		title: 'Electric Truck Thermal Management and BMS Systems',
		institution: 'Scania',
		image: '/images/work/electric-truck-thermal-bms.webp',
		imageAlt: 'Electric truck connected to a charger in snowy test conditions',
		overview:
			'Embedded control software for coordinating battery, charging, auxiliary, and thermal behavior in heavy-duty electric vehicles.',
		labels: ['BMS', 'Thermal control', 'Charging behavior', 'Diagnostics', 'Calibration', 'Vehicle validation'],
		ctaLabel: 'Read project note on Electric Truck Thermal Management and BMS Systems',
		href: '#electric-truck-thermal-management',
		proofHref: '/cv/#experience',
		proofLabel: 'CV experience',
	},
	{
		id: 'autonomous-hauler-propulsion-control',
		title: 'Autonomous Electric Hauler Propulsion Control',
		institution: 'Volvo Construction Equipment',
		image: '/images/work/autonomous-hauler-propulsion.webp',
		imageAlt: 'Autonomous electric haulers operating in a quarry',
		overview:
			'Propulsion-control software for autonomous electric machines operating in demanding off-road environments.',
		labels: ['Traction control', 'Torque allocation', 'Redundant actuators', 'Diagnostic monitoring', 'SIL/HIL', 'Vehicle validation'],
		ctaLabel: 'Read project note on Autonomous Electric Hauler Propulsion Control',
		href: '#autonomous-hauler-propulsion-control',
		proofHref: '/cv/#representative-systems',
		proofLabel: 'CV systems',
	},
	{
		id: 'ebike-motor-control-power-electronics',
		title: 'E-Bike Motor Control and Power Electronics Software',
		institution: 'MAHLE',
		image: '/images/work/ebike-motor-control.webp',
		imageAlt: 'E-bike motor and crank area after off-road use',
		overview:
			'Application-layer embedded software connecting motor-control behavior, thermal modeling, wireless charging, and converter functionality.',
		labels: ['PMSM thermal modeling', 'AUTOSAR-oriented architecture', 'DC/DC interfaces', 'Power electronics', 'Bench validation'],
		ctaLabel: 'Read project note on E-Bike Motor Control and Power Electronics Software',
		href: '#ebike-motor-control-power-electronics',
		proofHref: '/cv/#experience',
		proofLabel: 'CV experience',
	},
	{
		id: 'heavy-duty-engine-diagnostics-control-research',
		title: 'Heavy-Duty Engine Diagnostics and Control Research',
		institution: 'Lund University / Scania',
		image: '/images/work/heavy-duty-engine-diagnostics.webp',
		imageAlt: 'Heavy-duty engine test bench with sensors and measurement cables',
		overview:
			'Real-time diagnostic and combustion-control prototypes for heavy-duty engine systems with experimental validation.',
		labels: ['Diagnostics', 'Closed-loop control', 'Virtual sensing', 'Stochastic detection', 'Patents', 'Publications', 'Test-bench validation'],
		ctaLabel: 'Read project note on Heavy-Duty Engine Diagnostics and Control Research',
		href: '#heavy-duty-engine-diagnostics-control-research',
		proofHref: '/cv/#research',
		proofLabel: 'CV research record',
	},
];

const researchNotes = [
	{
		id: 'virtual-sensing-in-cycle-combustion-diagnostics',
		title: 'Virtual Sensing for In-Cycle Combustion Diagnostics',
		institution: 'Lund University / Scania',
		overview:
			'Research on estimating combustion states that are difficult to measure directly during engine operation.',
		technicalArea: ['Virtual sensing', 'In-cycle estimation', 'Combustion diagnostics', 'Heavy-duty engines'],
		outcomes: [
			'Developed model-based estimators for combustion states not directly available to production control logic.',
			'Validated virtual-sensing behavior using heavy-duty engine test-bench data.',
		],
		ctaLabel: 'Read research note on Virtual Sensing for In-Cycle Combustion Diagnostics',
		href: '#virtual-sensing-in-cycle-combustion-diagnostics',
		proofHref: '/cv/#research',
		proofLabel: 'CV research record',
	},
	{
		id: 'stochastic-fault-detection-diagnostic-decision-logic',
		title: 'Stochastic Fault Detection and Diagnostic Decision Logic',
		institution: 'Lund University / Scania',
		overview:
			'Research on detecting abnormal combustion-system behavior using probability, sensor data, and diagnostic thresholds.',
		technicalArea: ['Stochastic detection', 'Misfire diagnosis', 'Adaptive thresholds', 'Sensor fusion', 'Diagnostic logic'],
		outcomes: [
			'Developed diagnostic decision methods for combustion fault detection.',
			'Evaluated diagnostic robustness under changing operating conditions.',
		],
		ctaLabel: 'Read research note on Stochastic Fault Detection and Diagnostic Decision Logic',
		href: '#stochastic-fault-detection-diagnostic-decision-logic',
		proofHref: '/cv/#research',
		proofLabel: 'CV research record',
	},
	{
		id: 'predictive-in-cycle-combustion-control',
		title: 'Predictive In-Cycle Combustion Control',
		institution: 'Lund University / Scania',
		overview:
			'Research on predictive closed-loop controllers that adjust fuel injection within the same combustion cycle.',
		technicalArea: ['Closed-loop control', 'Predictive control', 'Combustion control', 'Model adaptation', 'FPGA implementation'],
		outcomes: [
			'Developed predictive controllers for cycle-resolved combustion regulation.',
			'Validated control robustness under model uncertainty and changing fuel conditions.',
		],
		ctaLabel: 'Read research note on Predictive In-Cycle Combustion Control',
		href: '#predictive-in-cycle-combustion-control',
		proofHref: '/cv/#research',
		proofLabel: 'CV research record',
	},
	{
		id: 'stochastic-set-point-optimization-efficiency',
		title: 'Stochastic Set-Point Optimization for Efficiency',
		institution: 'Lund University / Scania',
		overview:
			'Research on using stochastic combustion models and Monte Carlo simulation to optimize combustion-control set-points.',
		technicalArea: ['Efficiency optimization', 'Stochastic modeling', 'Monte Carlo simulation', 'Set-point optimization', 'Constraint handling'],
		outcomes: [
			'Developed set-point optimization methods for combustion efficiency.',
			'Evaluated trade-offs between efficiency, pressure-rise constraints, and misfire risk.',
		],
		ctaLabel: 'Read research note on Stochastic Set-Point Optimization for Efficiency',
		href: '#stochastic-set-point-optimization-efficiency',
		proofHref: '/cv/#research',
		proofLabel: 'CV research record',
	},
	{
		id: 'real-time-combustion-control-implementation',
		title: 'Real-Time Combustion Control Implementation',
		institution: 'Lund University / Scania',
		overview:
			'Research on implementing combustion observers, virtual sensors, and control algorithms under real-time hardware constraints.',
		technicalArea: ['Real-time implementation', 'FPGA', 'Hardware-constrained systems', 'Signal processing', 'Embedded control'],
		outcomes: [
			'Implemented in-cycle combustion-control methods for real-time execution on FPGA hardware.',
			'Quantified timing, resource, and implementation constraints for embedded control deployment.',
		],
		ctaLabel: 'Read research note on Real-Time Combustion Control Implementation',
		href: '#real-time-combustion-control-implementation',
		proofHref: '/cv/#research',
		proofLabel: 'CV research record',
	},
];

const technicalAreaGroups = [
	{
		title: 'Control and Modeling',
		items: ['Real-time control', 'Model-based implementation', 'Calibration', 'Research prototypes'],
	},
	{
		title: 'Embedded Systems',
		items: ['Embedded software', 'Power electronics', 'Hardware-constrained systems'],
	},
	{
		title: 'Diagnostics and Validation',
		items: ['Diagnostics', 'Fault handling', 'MIL/SIL/HIL', 'Bench validation', 'Vehicle validation'],
	},
	{
		title: 'Physical-System Context',
		items: ['Thermal systems', 'Energy management', 'Virtual sensing'],
	},
];
---

<BaseLayout
        title="Work"
        description="Selected projects and research notes on embedded control software for complex physical systems by Carlos Jorques."
>
	<section class="work-hero" aria-labelledby="work-title">
		<div class="page-container work-hero__inner">
			<div class="work-hero__label">
				<p class="section-eyebrow">Work</p>
				<h1 id="work-title" class="hero-title">Work</h1>
			</div>
			<div class="work-hero__mission">
				<p>
					Selected project and research notes on embedded control software, diagnostics, and validation.
				</p>
			</div>
		</div>
	</section>

	<section class="section work-section work-section--selected" id="selected-projects" aria-labelledby="project-contexts-title">
		<div class="page-container">
			<div class="work-section__intro">
				<h2 id="project-contexts-title">Selected Projects</h2>
				<p>
					Selected project contexts that point to deeper notes on system behavior, embedded control software,
					diagnostics, validation, and production constraints.
				</p>
			</div>
			<div class="work-index-grid">
				{projectNotes.map((item, index) => (
					<article class="work-index-card work-index-card--project" id={item.id} aria-labelledby={`${item.id}-title`}>
						<figure class="work-index-card__media">
							<img
								src={withBase(item.image)}
								alt={item.imageAlt}
								loading={index === 0 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</figure>
						<div class="work-index-card__body">
							<header class="work-index-card__header">
								<h3 id={`${item.id}-title`}>{item.title}</h3>
								<p class="work-index-card__institution">{item.institution}</p>
							</header>
							<p class="work-index-card__overview">{item.overview}</p>
							<ul class="work-label-list" aria-label={`${item.title} technical labels`}>
								{item.labels.map((label) => <li>{label}</li>)}
							</ul>
							<a
								class="work-note-link"
								href={item.href}
								aria-label={item.ctaLabel}
								data-analytics-event="work_anchor_click"
								data-cta-id={`work-note-${item.id}`}
								data-cta-placement="work-project-card"
								data-cta-intent="read-work-note"
								data-source-section="selected-projects"
							>
								Read note <span aria-hidden="true">-&gt;</span>
							</a>
							<p class="work-related-proof">
								<span>Related proof</span>
								<a
									href={withBase(item.proofHref)}
									data-analytics-event="related_proof_click"
									data-cta-id={`work-proof-${item.id}`}
									data-cta-placement="work-project-card"
									data-cta-intent="formal-proof"
									data-source-section={item.id}
								>
									{item.proofLabel}
								</a>
							</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section work-section" id="selected-research" aria-labelledby="selected-research-title">
		<div class="page-container">
			<div class="work-section__intro">
				<h2 id="selected-research-title">Selected Research</h2>
				<p>
					Research-connected notes from Lund University / Scania on diagnostics, control algorithms, virtual sensing,
					experimental validation, and real-time implementation. The <a
						href={withBase('/cv/#research')}
						data-analytics-event="related_proof_click"
						data-cta-id="work-research-intro-cv"
						data-cta-placement="work-research-intro"
						data-cta-intent="formal-proof"
						data-source-section="selected-research"
					>CV research record</a> contains the
					formal publication and patent record.
				</p>
			</div>
			<div class="work-index-grid work-index-grid--research">
				{researchNotes.map((item) => (
					<article class="work-index-card work-index-card--research" id={item.id} aria-labelledby={`${item.id}-title`}>
						<div class="work-index-card__body">
							<header class="work-index-card__header">
								<h3 id={`${item.id}-title`}>{item.title}</h3>
							</header>
							<p class="work-index-card__overview">{item.overview}</p>
							<div class="research-detail-grid">
								<div class="research-detail-group">
									<p class="research-detail-group__label">Technical area</p>
									<ul class="work-label-list" aria-label={`${item.title} technical areas`}>
										{item.technicalArea.map((label) => <li>{label}</li>)}
									</ul>
								</div>
								<div class="research-detail-group">
									<p class="research-detail-group__label">Research outcomes</p>
									<ul class="research-outcome-list" aria-label={`${item.title} research outcomes`}>
										{item.outcomes.map((outcome) => <li>{outcome}</li>)}
									</ul>
								</div>
							</div>
							<a
								class="work-note-link research-note-link"
								href={item.href}
								aria-label={item.ctaLabel}
								data-analytics-event="work_anchor_click"
								data-cta-id={`work-research-note-${item.id}`}
								data-cta-placement="work-research-card"
								data-cta-intent="read-research-note"
								data-source-section="selected-research"
							>
								Read research note <span aria-hidden="true">→</span>
							</a>
							<p class="work-related-proof">
								<span>Related proof</span>
								<a
									href={withBase(item.proofHref)}
									data-analytics-event="related_proof_click"
									data-cta-id={`work-research-proof-${item.id}`}
									data-cta-placement="work-research-card"
									data-cta-intent="formal-proof"
									data-source-section={item.id}
								>
									{item.proofLabel}
								</a>
							</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section work-section work-section--threads" id="technical-areas" aria-labelledby="technical-areas-title">
		<div class="page-container work-thread-summary">
			<div class="work-section__intro">
				<h2 id="technical-areas-title">Explore Technical Areas</h2>
				<p>
					The projects and research notes differ in system context, but they share a common engineering base: software
					that controls physical behavior, handles diagnostics and constraints, and is validated across models, lab
					environments, and real systems.
				</p>
			</div>
			<ul class="work-thread-group-list" aria-label="Technical area groups">
				{technicalAreaGroups.map((group) => (
					<li class="work-thread-group">
						<p class="work-thread-group__title">{group.title}</p>
						<ul class="work-thread-list" aria-label={`${group.title} tags`}>
							{group.items.map((item) => (
								<li>
									<a
										href={withBase(`/writing?tag=${toTagSlug(item)}`)}
										aria-label={`Browse posts tagged ${item}`}
										data-analytics-event="writing_article_click"
										data-cta-id={`work-topic-${toTagSlug(item)}`}
										data-cta-placement="work-technical-areas"
										data-cta-intent="authority"
										data-source-section="technical-areas"
									>
										{item}
									</a>
								</li>
							))}
						</ul>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section work-section work-final" aria-labelledby="work-final-title">
		<div class="page-container work-final__inner">
			<div class="work-final__copy">
				<h2 id="work-final-title">Continue from the evidence</h2>
				<p>
					For role conversations, technical discussions, or a formal record of the experience behind this work,
					use one of these direct paths.
				</p>
			</div>
			<div class="work-final__actions" aria-label="Continue exploring links">
				<a
					class="button primary"
					href={withBase('/contact/')}
					data-analytics-event="cta_click"
					data-cta-id="work-discuss-role"
					data-cta-placement="work-final"
					data-cta-intent="role-discussion"
					data-source-section="work-final"
				>
					Discuss a Role
				</a>
				<a
					class="button"
					href={withBase('/contact/')}
					data-analytics-event="cta_click"
					data-cta-id="work-start-technical-discussion"
					data-cta-placement="work-final"
					data-cta-intent="technical-discussion"
					data-source-section="work-final"
				>
					Start a Technical Discussion
				</a>
				<a
					class="button"
					href={withBase('/cv/')}
					data-analytics-event="cta_click"
					data-cta-id="work-view-cv"
					data-cta-placement="work-final"
					data-cta-intent="formal-proof"
					data-source-section="work-final"
				>
					View CV
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.work-hero {
		padding-block: clamp(3rem, 5vw, 4.6rem) clamp(1.55rem, 3vw, 2.25rem);
		border-bottom: 1px solid var(--color-border-soft);
		background: transparent;
	}

	.work-hero .page-container,
	.work-section .page-container {
		width: min(calc(100% - 32px), 1120px);
		max-width: 100%;
	}

	.work-hero,
	.work-section {
		overflow-x: clip;
	}

	.work-hero__inner,
	.work-hero__label,
	.work-hero__mission,
	.work-section__intro,
	.work-index-card__body,
	.work-index-card__header,
	.research-detail-grid,
	.research-detail-group,
	.work-thread-summary,
	.work-final__inner {
		display: grid;
	}

	.work-hero__inner {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(1.4rem, 5vw, 4.2rem);
		align-items: end;
	}

	.work-hero__label {
		gap: 0.85rem;
		min-width: 0;
	}

	.work-hero__label .section-eyebrow {
		margin: 0;
	}

	.work-hero__mission {
		min-width: 0;
		border-left: 1px solid var(--color-border-soft);
		padding-left: clamp(1rem, 3vw, 2rem);
	}

	.work-hero .hero-title {
		max-width: none;
		font-size: clamp(4.2rem, 8vw, 7rem);
		overflow-wrap: normal;
		word-break: normal;
	}

	.work-hero__mission p,
	.work-section__intro p,
	.work-index-card__overview {
		color: var(--color-body-text);
		overflow-wrap: anywhere;
	}

	.work-hero__mission p {
		max-width: 660px;
		margin: 0;
		font-size: clamp(1.1rem, 1.45vw, 1.32rem);
		font-weight: 400;
		line-height: 1.5;
	}

	.work-section__intro p,
	.work-index-card__overview {
		font-size: var(--type-reading-size);
		line-height: var(--type-reading-line);
	}

	.work-hero__note a,
	.work-section__intro a,
	.work-note-link {
		color: var(--color-text);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		transition:
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			text-decoration-color var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.work-hero__note a:hover,
	.work-hero__note a:focus-visible,
	.work-section__intro a:hover,
	.work-section__intro a:focus-visible,
	.work-note-link:hover,
	.work-note-link:focus-visible {
		color: var(--color-link-hover);
	}

	.work-section {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

        .work-section--selected {
                padding-block-start: clamp(1.75rem, 3.4vw, 2.8rem);
        }

        .work-section__intro {
                gap: clamp(0.5rem, 1.1vw, 0.75rem);
                max-width: 700px;
                margin-bottom: clamp(1.15rem, 2.2vw, 1.8rem);
        }

        .work-section h2 {
                max-width: 14ch;
                font-size: clamp(2.25rem, 4.4vw, 3.7rem);
                line-height: 1;
                letter-spacing: -0.055em;
                overflow-wrap: anywhere;
        }

	.work-index-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(0.85rem, 1.8vw, 1rem);
	}

	.work-index-grid--research {
		gap: clamp(0.8rem, 1.6vw, 0.95rem);
		align-items: stretch;
		grid-auto-rows: 1fr;
	}

	.work-index-card {
		display: grid;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius);
		background: transparent;
		padding: clamp(0.95rem, 1.7vw, 1.2rem);
	}

	.work-index-card--project {
		padding: 0;
	}

	.work-index-card--research {
		display: flex;
		height: 100%;
		background: transparent;
		padding: clamp(0.9rem, 1.45vw, 1.05rem);
	}

	.work-index-card__media {
		overflow: hidden;
		margin: 0;
		aspect-ratio: 3 / 2;
		background: var(--color-surface-soft);
	}

	.work-index-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.work-index-card__body {
		gap: 0.76rem;
		align-content: start;
		width: 100%;
		height: 100%;
		min-width: 0;
	}

	.work-index-card--project .work-index-card__body {
		padding: clamp(0.85rem, 1.55vw, 1.1rem);
	}

	.work-index-card__header {
		gap: 0.34rem;
	}

	.research-detail-group__label {
		margin: 0;
		color: var(--color-accent-text);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: 700;
		line-height: var(--type-meta-line);
		letter-spacing: var(--type-meta-tracking);
		text-transform: uppercase;
	}

	.work-index-card h3 {
		max-width: 26ch;
		color: var(--color-text);
		font-size: clamp(1.12rem, 1.45vw, 1.42rem);
		line-height: 1.08;
		letter-spacing: -0.035em;
		overflow-wrap: anywhere;
	}

	.work-index-card__institution {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		line-height: var(--type-meta-line);
		letter-spacing: var(--type-meta-tracking);
	}

	.work-index-card__overview {
		font-size: clamp(0.92rem, 1vw, 1rem);
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.work-index-card--research h3 {
		font-size: clamp(1.04rem, 1.25vw, 1.22rem);
		line-height: 1.13;
		letter-spacing: -0.026em;
	}

	.work-index-card--research .work-index-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.62rem;
	}

	.work-index-card--research .work-index-card__overview {
		font-size: clamp(0.88rem, 0.95vw, 0.95rem);
		line-height: 1.47;
	}

	.work-label-list,
	.work-thread-list {
		display: flex;
		flex-wrap: wrap;
