---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => {
	if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
		return href;
	}

	return href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`;
};

const projectCards = [
	{ id: 'electric-truck-thermal-management', title: 'Electric Truck Thermal Management and BMS Systems', institution: 'Scania', image: '/images/work/electric-truck-thermal-bms.webp', alt: 'Electric truck connected to a charger in snowy test conditions', overview: 'Embedded control software for coordinating battery, charging, auxiliary, and thermal behavior in heavy-duty electric vehicles.', context: 'Heavy-duty electrification and thermal behavior.', contribution: 'Control architecture, software integration, diagnostics, and validation.', constraints: 'Physical limits, timing, safety-related behavior, and vehicle evidence.', evidence: 'Production-oriented EV control delivery', tags: ['BMS', 'Thermal control', 'Charging behavior', 'Diagnostics', 'Calibration', 'Vehicle validation'], noteHref: '/work/embedded-control-system-architecture/', proofHref: '/cv/#experience', proofLabel: 'CV experience', loading: 'eager' as const },
	{ id: 'autonomous-hauler-propulsion-control', title: 'Autonomous Electric Hauler Propulsion Control', institution: 'Volvo Construction Equipment', image: '/images/work/autonomous-hauler-propulsion.webp', alt: 'Autonomous electric haulers operating in a quarry', overview: 'Propulsion-control software for autonomous electric machines operating in demanding off-road environments.', context: 'Autonomous heavy-duty mobility.', contribution: 'Propulsion, torque allocation, diagnostic monitoring, and integration.', constraints: 'Redundancy, safety-related behavior, SIL/HIL, and vehicle validation.', evidence: 'Applied autonomous-machine control delivery', tags: ['Traction control', 'Torque allocation', 'Redundant actuators', 'Diagnostic monitoring', 'SIL/HIL', 'Vehicle validation'], noteHref: '/work/cross-functional-technical-delivery/', proofHref: '/cv/#representative-systems', proofLabel: 'CV systems' },
	{ id: 'ebike-motor-control-power-electronics', title: 'E-Bike Motor Control and Power Electronics Software', institution: 'MAHLE', image: '/images/work/ebike-motor-control.webp', alt: 'E-bike motor and crank area after off-road use', overview: 'Application-layer embedded software connecting motor-control behavior, thermal modeling, wireless charging, and converter functionality.', context: 'Electrified power electronics.', contribution: 'Application software, model integration, and interfaces.', constraints: 'Thermal behavior, converter limits, AUTOSAR-oriented integration, and bench evidence.', evidence: 'Production embedded software contribution', tags: ['PMSM thermal modeling', 'AUTOSAR-oriented architecture', 'DC/DC interfaces', 'Power electronics', 'Bench validation'], noteHref: '/work/embedded-control-system-architecture/', proofHref: '/cv/#experience', proofLabel: 'CV experience' },
	{ id: 'heavy-duty-engine-diagnostics-control-research', title: 'Heavy-Duty Engine Diagnostics and Control Research', institution: 'Lund University / Scania', image: '/images/work/heavy-duty-engine-diagnostics.webp', alt: 'Heavy-duty engine test bench with sensors and measurement cables', overview: 'Real-time diagnostic and combustion-control prototypes for heavy-duty engine systems with experimental validation.', context: 'Research translated into production-relevant control evidence.', contribution: 'Diagnostics, control algorithms, virtual sensing, and test-bench validation.', constraints: 'Real-time deadlines, uncertainty, sensor evidence, and experimental repeatability.', evidence: 'PhD, patents, and publications', tags: ['Diagnostics', 'Closed-loop control', 'Virtual sensing', 'Stochastic detection', 'Patents', 'Publications'], noteHref: '/work/control-algorithms-and-diagnostics/', proofHref: '/cv/#research', proofLabel: 'CV research record' },
];
---

<BaseLayout
        title="Work"
        description="Selected projects and research notes on embedded control software for complex physical systems by Carlos Jorques."
>
	<section class="work-hero" aria-labelledby="work-title">
		<div class="page-container work-hero__inner">
			<div class="work-hero__label">
				<p class="section-eyebrow">Work</p>
				<h1 id="work-title" class="hero-title">Work</h1>
			</div>
			<div class="work-hero__mission">
				<p>
					Selected project and research notes on embedded control software, diagnostics, and validation.
				</p>
			</div>
		</div>
	</section>

	<section class="section work-section" id="synthesis" aria-labelledby="synthesis-title">
		<div class="page-container work-section__intro"><h2 id="synthesis-title">What connects this work</h2><p>I shape the path from system intent to dependable production behavior: making sensing, control decisions, embedded execution, diagnostics, and validation agree with the machine and its constraints. Across architecture, implementation, validation, and delivery, I personally connect technical direction with hands-on engineering so teams can turn control strategy into software that behaves predictably in real hardware, under uncertainty, and through release.</p></div>
	</section>

	<section class="section work-section work-section--selected" id="selected-projects" aria-labelledby="project-contexts-title">
		<div class="page-container">
			<div class="work-section__intro">
				<h2 id="project-contexts-title">Selected Projects</h2>
				<p>
					Selected project contexts that point to deeper notes on system behavior, embedded control software,
					diagnostics, validation, and production constraints.
				</p>
			</div>
			<div class="work-index-grid work-index-grid--component-cards">
				{projectCards.map((card) => <WorkCard {...card} />)}
			</div>
			<div class="work-index-grid work-index-grid--legacy" aria-hidden="true">
				<article class="work-index-card work-index-card--project" id="electric-truck-thermal-management" aria-labelledby="electric-truck-thermal-management-title">
					<figure class="work-index-card__media">
						<img
							src={withBase('/images/work/electric-truck-thermal-bms.webp')}
							alt="Electric truck connected to a charger in snowy test conditions"
							loading="eager"
							decoding="async"
						/>
					</figure>
					<div class="work-index-card__body">
						<header class="work-index-card__header">
							<h3 id="electric-truck-thermal-management-title">Electric Truck Thermal Management and BMS Systems</h3>
							<p class="work-index-card__institution">Scania</p>
						</header>
						<p class="work-index-card__overview">Embedded control software for coordinating battery, charging, auxiliary, and thermal behavior in heavy-duty electric vehicles.</p>
						<ul class="work-label-list" aria-label="Electric Truck Thermal Management and BMS Systems technical labels">
							<li>BMS</li>
							<li>Thermal control</li>
							<li>Charging behavior</li>
							<li>Diagnostics</li>
							<li>Calibration</li>
							<li>Vehicle validation</li>
						</ul>
						<a
							class="work-note-link"
							href="#electric-truck-thermal-management"
							aria-label="Read project note on Electric Truck Thermal Management and BMS Systems"
							data-analytics-event="work_anchor_click"
							data-cta-id="work-note-electric-truck-thermal-management"
							data-cta-placement="work-project-card"
							data-cta-intent="read-work-note"
							data-source-section="selected-projects"
						>
							Read note <span aria-hidden="true">-&gt;</span>
						</a>
						<p class="work-related-proof">
							<span>Related proof</span>
							<a
								href={withBase('/cv/#experience')}
								data-analytics-event="related_proof_click"
								data-cta-id="work-proof-electric-truck-thermal-management"
								data-cta-placement="work-project-card"
								data-cta-intent="formal-proof"
								data-source-section="electric-truck-thermal-management"
							>
								CV experience
							</a>
						</p>
					</div>
				</article>

				<article class="work-index-card work-index-card--project" id="autonomous-hauler-propulsion-control" aria-labelledby="autonomous-hauler-propulsion-control-title">
					<figure class="work-index-card__media">
						<img
							src={withBase('/images/work/autonomous-hauler-propulsion.webp')}
							alt="Autonomous electric haulers operating in a quarry"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div class="work-index-card__body">
						<header class="work-index-card__header">
							<h3 id="autonomous-hauler-propulsion-control-title">Autonomous Electric Hauler Propulsion Control</h3>
							<p class="work-index-card__institution">Volvo Construction Equipment</p>
						</header>
						<p class="work-index-card__overview">Propulsion-control software for autonomous electric machines operating in demanding off-road environments.</p>
						<ul class="work-label-list" aria-label="Autonomous Electric Hauler Propulsion Control technical labels">
							<li>Traction control</li>
							<li>Torque allocation</li>
							<li>Redundant actuators</li>
							<li>Diagnostic monitoring</li>
							<li>SIL/HIL</li>
							<li>Vehicle validation</li>
						</ul>
						<a
							class="work-note-link"
							href="#autonomous-hauler-propulsion-control"
							aria-label="Read project note on Autonomous Electric Hauler Propulsion Control"
							data-analytics-event="work_anchor_click"
							data-cta-id="work-note-autonomous-hauler-propulsion-control"
							data-cta-placement="work-project-card"
							data-cta-intent="read-work-note"
							data-source-section="selected-projects"
						>
							Read note <span aria-hidden="true">-&gt;</span>
						</a>
						<p class="work-related-proof">
							<span>Related proof</span>
							<a
								href={withBase('/cv/#representative-systems')}
								data-analytics-event="related_proof_click"
								data-cta-id="work-proof-autonomous-hauler-propulsion-control"
								data-cta-placement="work-project-card"
								data-cta-intent="formal-proof"
								data-source-section="autonomous-hauler-propulsion-control"
							>
								CV systems
							</a>
						</p>
					</div>
				</article>

				<article class="work-index-card work-index-card--project" id="ebike-motor-control-power-electronics" aria-labelledby="ebike-motor-control-power-electronics-title">
					<figure class="work-index-card__media">
						<img
							src={withBase('/images/work/ebike-motor-control.webp')}
							alt="E-bike motor and crank area after off-road use"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div class="work-index-card__body">
						<header class="work-index-card__header">
							<h3 id="ebike-motor-control-power-electronics-title">E-Bike Motor Control and Power Electronics Software</h3>
							<p class="work-index-card__institution">MAHLE</p>
						</header>
						<p class="work-index-card__overview">Application-layer embedded software connecting motor-control behavior, thermal modeling, wireless charging, and converter functionality.</p>
						<ul class="work-label-list" aria-label="E-Bike Motor Control and Power Electronics Software technical labels">
							<li>PMSM thermal modeling</li>
							<li>AUTOSAR-oriented architecture</li>
							<li>DC/DC interfaces</li>
							<li>Power electronics</li>
							<li>Bench validation</li>
						</ul>
						<a
							class="work-note-link"
							href="#ebike-motor-control-power-electronics"
							aria-label="Read project note on E-Bike Motor Control and Power Electronics Software"
							data-analytics-event="work_anchor_click"
							data-cta-id="work-note-ebike-motor-control-power-electronics"
							data-cta-placement="work-project-card"
							data-cta-intent="read-work-note"
							data-source-section="selected-projects"
						>
							Read note <span aria-hidden="true">-&gt;</span>
						</a>
						<p class="work-related-proof">
							<span>Related proof</span>
							<a
								href={withBase('/cv/#experience')}
								data-analytics-event="related_proof_click"
								data-cta-id="work-proof-ebike-motor-control-power-electronics"
								data-cta-placement="work-project-card"
								data-cta-intent="formal-proof"
								data-source-section="ebike-motor-control-power-electronics"
							>
								CV experience
							</a>
						</p>
					</div>
				</article>

				<article class="work-index-card work-index-card--project" id="heavy-duty-engine-diagnostics-control-research" aria-labelledby="heavy-duty-engine-diagnostics-control-research-title">
					<figure class="work-index-card__media">
						<img
							src={withBase('/images/work/heavy-duty-engine-diagnostics.webp')}
							alt="Heavy-duty engine test bench with sensors and measurement cables"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div class="work-index-card__body">
						<header class="work-index-card__header">
							<h3 id="heavy-duty-engine-diagnostics-control-research-title">Heavy-Duty Engine Diagnostics and Control Research</h3>
							<p class="work-index-card__institution">Lund University / Scania</p>
						</header>
						<p class="work-index-card__overview">Real-time diagnostic and combustion-control prototypes for heavy-duty engine systems with experimental validation.</p>
						<ul class="work-label-list" aria-label="Heavy-Duty Engine Diagnostics and Control Research technical labels">
							<li>Diagnostics</li>
							<li>Closed-loop control</li>
							<li>Virtual sensing</li>
							<li>Stochastic detection</li>
							<li>Patents</li>
							<li>Publications</li>
							<li>Test-bench validation</li>
						</ul>
						<a
							class="work-note-link"
							href="#heavy-duty-engine-diagnostics-control-research"
							aria-label="Read project note on Heavy-Duty Engine Diagnostics and Control Research"
							data-analytics-event="work_anchor_click"
							data-cta-id="work-note-heavy-duty-engine-diagnostics-control-research"
							data-cta-placement="work-project-card"
							data-cta-intent="read-work-note"
							data-source-section="selected-projects"
						>
							Read note <span aria-hidden="true">-&gt;</span>
						</a>
						<p class="work-related-proof">
							<span>Related proof</span>
							<a
								href={withBase('/cv/#research')}
								data-analytics-event="related_proof_click"
								data-cta-id="work-proof-heavy-duty-engine-diagnostics-control-research"
								data-cta-placement="work-project-card"
								data-cta-intent="formal-proof"
								data-source-section="heavy-duty-engine-diagnostics-control-research"
							>
								CV research record
							</a>
						</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="section work-section" id="selected-research" aria-labelledby="selected-research-title">
		<div class="page-container">
			<div class="work-section__intro">
				<h2 id="selected-research-title">Selected Research</h2>
				<p>
					The research record behind the diagnostics and control claims. The CV holds the formal publication and patent record. Research-connected notes from Lund University / Scania on diagnostics, control algorithms, virtual sensing, experimental validation, and real-time implementation. The <a
						href={withBase('/cv/#research')}
						data-analytics-event="related_proof_click"
						data-cta-id="work-research-intro-cv"
						data-cta-placement="work-research-intro"
						data-cta-intent="formal-proof"
						data-source-section="selected-research"
					>CV research record</a> contains the
					formal publication and patent record.
				</p>
			</div>
			<div class="work-index-grid work-index-grid--research">
				<article class="work-index-card work-index-card--research" id="virtual-sensing-in-cycle-combustion-diagnostics" aria-labelledby="virtual-sensing-in-cycle-combustion-diagnostics-title">
					<div class="work-index-card__body">
						<header class="work-index-card__header">
							<h3 id="virtual-sensing-in-cycle-combustion-diagnostics-title">Virtual Sensing for In-Cycle Combustion Diagnostics</h3>
						</header>
						<p class="work-index-card__overview">Research on estimating combustion states that are difficult to measure directly during engine operation.</p>
						<div class="research-detail-grid">
							<div class="research-detail-group">
								<p class="research-detail-group__label">Technical area</p>
								<ul class="work-label-list" aria-label="Virtual Sensing for In-Cycle Combustion Diagnostics technical areas">
									<li>Virtual sensing</li>
									<li>In-cycle estimation</li>
									<li>Combustion diagnostics</li>
									<li>Heavy-duty engines</li>
								</ul>
							</div>
							<div class="research-detail-group">
								<p class="research-detail-group__label">Research outcomes</p>
								<ul class="research-outcome-list" aria-label="Virtual Sensing for In-Cycle Combustion Diagnostics research outcomes">
									<li>Developed model-based estimators for combustion states not directly available to production control logic.</li>
									<li>Validated virtual-sensing behavior using heavy-duty engine test-bench data.</li>
								</ul>
							</div>
						</div>
						<a class="work-note-link research-note-link" href="#virtual-sensing-in-cycle-combustion-diagnostics" aria-label="Read research note on Virtual Sensing for In-Cycle Combustion Diagnostics" data-analytics-event="work_anchor_click" data-cta-id="work-research-note-virtual-sensing-in-cycle-combustion-diagnostics" data-cta-placement="work-research-card" data-cta-intent="read-research-note" data-source-section="selected-research">
							Read research note <span aria-hidden="true">-&gt;</span>
						</a>
						<p class="work-related-proof">
							<span>Related proof</span>
							<a href={withBase('/cv/#research')} data-analytics-event="related_proof_click" data-cta-id="work-research-proof-virtual-sensing-in-cycle-combustion-diagnostics" data-cta-placement="work-research-card" data-cta-intent="formal-proof" data-source-section="virtual-sensing-in-cycle-combustion-diagnostics">CV research record</a>
						</p>
					</div>
				</article>

				<article class="work-index-card work-index-card--research" id="stochastic-fault-detection-diagnostic-decision-logic" aria-labelledby="stochastic-fault-detection-diagnostic-decision-logic-title">
					<div class="work-index-card__body">
						<header class="work-index-card__header">
							<h3 id="stochastic-fault-detection-diagnostic-decision-logic-title">Stochastic Fault Detection and Diagnostic Decision Logic</h3>
						</header>
						<p class="work-index-card__overview">Research on detecting abnormal combustion-system behavior using probability, sensor data, and diagnostic thresholds.</p>
						<div class="research-detail-grid">
							<div class="research-detail-group">
								<p class="research-detail-group__label">Technical area</p>
								<ul class="work-label-list" aria-label="Stochastic Fault Detection and Diagnostic Decision Logic technical areas">
									<li>Stochastic detection</li>
									<li>Misfire diagnosis</li>
									<li>Adaptive thresholds</li>
									<li>Sensor fusion</li>
									<li>Diagnostic logic</li>
								</ul>
							</div>
							<div class="research-detail-group">
								<p class="research-detail-group__label">Research outcomes</p>
								<ul class="research-outcome-list" aria-label="Stochastic Fault Detection and Diagnostic Decision Logic research outcomes">
									<li>Developed diagnostic decision methods for combustion fault detection.</li>
									<li>Evaluated diagnostic robustness under changing operating conditions.</li>
								</ul>
							</div>
						</div>
						<a class="work-note-link research-note-link" href="#stochastic-fault-detection-diagnostic-decision-logic" aria-label="Read research note on Stochastic Fault Detection and Diagnostic Decision Logic" data-analytics-event="work_anchor_click" data-cta-id="work-research-note-stochastic-fault-detection-diagnostic-decision-logic" data-cta-placement="work-research-card" data-cta-intent="read-research-note" data-source-section="selected-research">
							Read research note <span aria-hidden="true">-&gt;</span>
						</a>
						<p class="work-related-proof">
							<span>Related proof</span>
							<a href={withBase('/cv/#research')} data-analytics-event="related_proof_click" data-cta-id="work-research-proof-stochastic-fault-detection-diagnostic-decision-logic" data-cta-placement="work-research-card" data-cta-intent="formal-proof" data-source-section="stochastic-fault-detection-diagnostic-decision-logic">CV research record</a>
						</p>
					</div>
				</article>

				<article class="work-index-card work-index-card--research" id="predictive-in-cycle-combustion-control" aria-labelledby="predictive-in-cycle-combustion-control-title">
					<div class="work-index-card__body">
						<header class="work-index-card__header">
							<h3 id="predictive-in-cycle-combustion-control-title">Predictive In-Cycle Combustion Control</h3>
						</header>
						<p class="work-index-card__overview">Research on predictive closed-loop controllers that adjust fuel injection within the same combustion cycle.</p>
						<div class="research-detail-grid">
							<div class="research-detail-group">
								<p class="research-detail-group__label">Technical area</p>
								<ul class="work-label-list" aria-label="Predictive In-Cycle Combustion Control technical areas">
									<li>Closed-loop control</li>
									<li>Predictive control</li>
									<li>Combustion control</li>
									<li>Model adaptation</li>
									<li>FPGA implementation</li>
								</ul>
							</div>
							<div class="research-detail-group">
								<p class="research-detail-group__label">Research outcomes</p>
								<ul class="research-outcome-list" aria-label="Predictive In-Cycle Combustion Control research outcomes">
									<li>Developed predictive controllers for cycle-resolved combustion regulation.</li>
									<li>Validated control robustness under model uncertainty and changing fuel conditions.</li>
								</ul>
							</div>
						</div>
						<a class="work-note-link research-note-link" href="#predictive-in-cycle-combustion-control" aria-label="Read research note on Predictive In-Cycle Combustion Control" data-analytics-event="work_anchor_click" data-cta-id="work-research-note-predictive-in-cycle-combustion-control" data-cta-placement="work-research-card" data-cta-intent="read-research-note" data-source-section="selected-research">
							Read research note <span aria-hidden="true">-&gt;</span>
						</a>
						<p class="work-related-proof">
							<span>Related proof</span>
							<a href={withBase('/cv/#research')} data-analytics-event="related_proof_click" data-cta-id="work-research-proof-predictive-in-cycle-combustion-control" data-cta-placement="work-research-card" data-cta-intent="formal-proof" data-source-section="predictive-in-cycle-combustion-control">CV research record</a>
						</p>
					</div>
				</article>

				<article class="work-index-card work-index-card--research" id="stochastic-set-point-optimization-efficiency" aria-labelledby="stochastic-set-point-optimization-efficiency-title">
					<div class="work-index-card__body">
						<header class="work-index-card__header">
							<h3 id="stochastic-set-point-optimization-efficiency-title">Stochastic Set-Point Optimization for Efficiency</h3>
						</header>
						<p class="work-index-card__overview">Research on using stochastic combustion models and Monte Carlo simulation to optimize combustion-control set-points.</p>
						<div class="research-detail-grid">
							<div class="research-detail-group">
								<p class="research-detail-group__label">Technical area</p>
								<ul class="work-label-list" aria-label="Stochastic Set-Point Optimization for Efficiency technical areas">
									<li>Efficiency optimization</li>
									<li>Stochastic modeling</li>
									<li>Monte Carlo simulation</li>
									<li>Set-point optimization</li>
									<li>Constraint handling</li>
								</ul>
							</div>
							<div class="research-detail-group">
								<p class="research-detail-group__label">Research outcomes</p>
								<ul class="research-outcome-list" aria-label="Stochastic Set-Point Optimization for Efficiency research outcomes">
									<li>Developed set-point optimization methods for combustion efficiency.</li>
									<li>Evaluated trade-offs between efficiency, pressure-rise constraints, and misfire risk.</li>
								</ul>
							</div>
						</div>
						<a class="work-note-link research-note-link" href="#stochastic-set-point-optimization-efficiency" aria-label="Read research note on Stochastic Set-Point Optimization for Efficiency" data-analytics-event="work_anchor_click" data-cta-id="work-research-note-stochastic-set-point-optimization-efficiency" data-cta-placement="work-research-card" data-cta-intent="read-research-note" data-source-section="selected-research">
							Read research note <span aria-hidden="true">-&gt;</span>
						</a>
						<p class="work-related-proof">
							<span>Related proof</span>
							<a href={withBase('/cv/#research')} data-analytics-event="related_proof_click" data-cta-id="work-research-proof-stochastic-set-point-optimization-efficiency" data-cta-placement="work-research-card" data-cta-intent="formal-proof" data-source-section="stochastic-set-point-optimization-efficiency">CV research record</a>
						</p>
