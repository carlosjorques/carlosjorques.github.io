---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
const withBase = (href: string) => {
	if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
		return href;
	}

	return href === '/' ? baseUrl : `${baseUrl}${href.replace(/^\//, '')}`;
};
const projectNotes = [
	{
		id: 'electric-truck-thermal-management',
		title: 'Electric Truck Thermal Management and BMS Systems',
		institution: 'Scania',
		image: '/images/work/electric-truck-thermal-bms.webp',
		imageAlt: 'Electric truck connected to a charger in snowy test conditions',
		overview:
			'Embedded control software for coordinating battery, charging, auxiliary, and thermal behavior in heavy-duty electric vehicles.',
		labels: ['BMS', 'Thermal control', 'Charging behavior', 'Diagnostics', 'Calibration', 'Vehicle validation'],
		ctaLabel: 'Read project note on Electric Truck Thermal Management and BMS Systems',
		href: '#electric-truck-thermal-management',
	},
	{
		id: 'autonomous-hauler-propulsion-control',
		title: 'Autonomous Electric Hauler Propulsion Control',
		institution: 'Volvo Construction Equipment',
		image: '/images/work/autonomous-hauler-propulsion.webp',
		imageAlt: 'Autonomous electric haulers operating in a quarry',
		overview:
			'Propulsion-control software for autonomous electric machines operating in demanding off-road environments.',
		labels: ['Traction control', 'Torque allocation', 'Redundant actuators', 'Diagnostic monitoring', 'SIL/HIL', 'Vehicle validation'],
		ctaLabel: 'Read project note on Autonomous Electric Hauler Propulsion Control',
		href: '#autonomous-hauler-propulsion-control',
	},
	{
		id: 'ebike-motor-control-power-electronics',
		title: 'E-Bike Motor Control and Power Electronics Software',
		institution: 'MAHLE',
		image: '/images/work/ebike-motor-control.webp',
		imageAlt: 'E-bike motor and crank area after off-road use',
		overview:
			'Application-layer embedded software connecting motor-control behavior, thermal modeling, wireless charging, and converter functionality.',
		labels: ['PMSM thermal modeling', 'AUTOSAR-oriented architecture', 'DC/DC interfaces', 'Power electronics', 'Bench validation'],
		ctaLabel: 'Read project note on E-Bike Motor Control and Power Electronics Software',
		href: '#ebike-motor-control-power-electronics',
	},
	{
		id: 'heavy-duty-engine-diagnostics-control-research',
		title: 'Heavy-Duty Engine Diagnostics and Control Research',
		institution: 'Lund University / Scania',
		image: '/images/work/heavy-duty-engine-diagnostics.webp',
		imageAlt: 'Heavy-duty engine test bench with sensors and measurement cables',
		overview:
			'Real-time diagnostic and combustion-control prototypes for heavy-duty engine systems with experimental validation.',
		labels: ['Diagnostics', 'Closed-loop control', 'Virtual sensing', 'Stochastic detection', 'Patents', 'Publications', 'Test-bench validation'],
		ctaLabel: 'Read project note on Heavy-Duty Engine Diagnostics and Control Research',
		href: '#heavy-duty-engine-diagnostics-control-research',
	},
];

const researchNotes = [
	{
		id: 'virtual-sensing-heavy-duty-engine-diagnostics',
		title: 'Virtual Sensing for Heavy-Duty Engine Diagnostics',
		institution: 'Lund University / Scania',
		overview:
			'Research on estimating internal combustion-system states that are difficult or impractical to measure directly in production environments.',
		technicalArea: ['Virtual sensing', 'Diagnostics', 'Model-based estimation', 'Heavy-duty engines'],
		outcomes: ['Industrial PhD research', 'Scientific publication', 'Patent contribution', 'Test-bench validation'],
		ctaLabel: 'Read research note on Virtual Sensing for Heavy-Duty Engine Diagnostics',
		href: '#virtual-sensing-heavy-duty-engine-diagnostics',
	},
	{
		id: 'stochastic-fault-detection-diagnostic-decision-logic',
		title: 'Stochastic Fault Detection and Diagnostic Decision Logic',
		institution: 'Lund University / Scania',
		overview:
			'Research on detecting abnormal combustion-system behavior using probabilistic reasoning, measurement data, and diagnostic thresholds.',
		technicalArea: ['Stochastic detection', 'Fault isolation', 'Diagnostic logic', 'Statistical modeling'],
		outcomes: ['Scientific publication', 'Diagnostic method development', 'Experimental validation', 'Patent-related work'],
		ctaLabel: 'Read research note on Stochastic Fault Detection and Diagnostic Decision Logic',
		href: '#stochastic-fault-detection-diagnostic-decision-logic',
	},
	{
		id: 'real-time-combustion-control-prototyping',
		title: 'Real-Time Combustion Control Prototyping',
		institution: 'Lund University / Scania',
		overview:
			'Research and prototyping work connecting combustion-control algorithms with real-time implementation and physical test-bench constraints.',
		technicalArea: ['Closed-loop control', 'Combustion control', 'Real-time implementation', 'Hardware-constrained systems'],
		outcomes: ['Industrial PhD research', 'Control prototype', 'Experimental test-bench validation', 'Publication record'],
		ctaLabel: 'Read research note on Real-Time Combustion Control Prototyping',
		href: '#real-time-combustion-control-prototyping',
	},
];

const recurringThreadGroups = [
	{
		title: 'Control behavior',
		items: ['Real-time control', 'Model-based implementation', 'Calibration', 'Research prototypes'],
	},
	{
		title: 'Embedded implementation',
		items: ['Embedded software', 'Power electronics', 'Hardware-constrained systems'],
	},
	{
		title: 'Diagnostics and validation',
		items: ['Diagnostics', 'Fault handling', 'MIL/SIL/HIL', 'Bench validation', 'Vehicle validation'],
	},
	{
		title: 'Physical-system context',
		items: ['Thermal systems', 'Energy management', 'Virtual sensing'],
	},
];
---

<BaseLayout
	title="Work"
	description="Selected projects and research notes in embedded control software for complex physical systems by Carlos Jorques."
>
	<section class="work-hero" aria-labelledby="work-title">
		<div class="page-container work-hero__inner">
			<div class="work-hero__copy">
				<h1 id="work-title">Work</h1>
				<p class="work-hero__lead">
					Selected projects and research notes in embedded control software for complex physical systems.
				</p>
				<p>
					A curated index of project and research contexts that point to deeper notes about control software,
					diagnostics, validation, and software-controlled physical systems.
				</p>
				<p class="work-hero__note">
					For full chronology, roles, publications, and patents, see the <a href={withBase('/cv/')}>CV</a>.
				</p>
			</div>
		</div>
	</section>

	<section class="section work-section work-section--selected" aria-labelledby="project-contexts-title">
		<div class="page-container">
			<div class="work-section__intro">
				<h2 id="project-contexts-title">Selected Projects</h2>
				<p>
					Selected project contexts that point to deeper notes on system behavior, embedded control software,
					diagnostics, validation, and production constraints.
				</p>
			</div>
			<div class="work-index-grid">
				{projectNotes.map((item, index) => (
					<article class="work-index-card work-index-card--project" id={item.id} aria-labelledby={`${item.id}-title`}>
						<figure class="work-index-card__media">
							<img
								src={withBase(item.image)}
								alt={item.imageAlt}
								loading={index === 0 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</figure>
						<div class="work-index-card__body">
							<header class="work-index-card__header">
								<h3 id={`${item.id}-title`}>{item.title}</h3>
								<p class="work-index-card__institution">{item.institution}</p>
							</header>
							<p class="work-index-card__overview">{item.overview}</p>
							<ul class="work-label-list" aria-label={`${item.title} technical labels`}>
								{item.labels.map((label) => <li>{label}</li>)}
							</ul>
							<a class="work-note-link" href={item.href} aria-label={item.ctaLabel}>
								Read note <span aria-hidden="true">-&gt;</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section work-section" aria-labelledby="selected-research-title">
		<div class="page-container">
			<div class="work-section__intro">
				<h2 id="selected-research-title">Selected Research</h2>
				<p>
					Research-connected notes on diagnostics, control algorithms, virtual sensing, experimental validation,
					and real-time implementation. The CV contains the formal publication and patent record.
				</p>
			</div>
			<div class="work-index-grid work-index-grid--research">
				{researchNotes.map((item) => (
					<article class="work-index-card work-index-card--research" id={item.id} aria-labelledby={`${item.id}-title`}>
						<div class="work-index-card__body">
							<header class="work-index-card__header">
								<h3 id={`${item.id}-title`}>{item.title}</h3>
								<p class="work-index-card__institution">{item.institution}</p>
							</header>
							<p class="work-index-card__overview">{item.overview}</p>
							<div class="research-detail-grid">
								<div class="research-detail-group">
									<p class="research-detail-group__label">Technical area</p>
									<ul class="work-label-list" aria-label={`${item.title} technical areas`}>
										{item.technicalArea.map((label) => <li>{label}</li>)}
									</ul>
								</div>
								<div class="research-detail-group">
									<p class="research-detail-group__label">Outcomes</p>
									<ul class="work-label-list" aria-label={`${item.title} outcomes`}>
										{item.outcomes.map((label) => <li>{label}</li>)}
									</ul>
								</div>
							</div>
							<a class="work-note-link" href={item.href} aria-label={item.ctaLabel}>
								Read research note <span aria-hidden="true">-&gt;</span>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section work-section work-section--threads" aria-labelledby="recurring-threads-title">
		<div class="page-container work-thread-summary">
			<div class="work-section__intro">
				<h2 id="recurring-threads-title">Explore Recurring Threads</h2>
				<p>
					Across these project and research notes, recurring technical threads include real-time control software,
					diagnostics, model-based implementation, calibration, thermal and energy management, power electronics,
					virtual sensing, and validation across simulation, lab, and physical systems.
				</p>
			</div>
			<ul class="work-thread-group-list" aria-label="Recurring technical thread groups">
				{recurringThreadGroups.map((group) => (
					<li class="work-thread-group">
						<p class="work-thread-group__title">{group.title}</p>
						<ul class="work-thread-list" aria-label={`${group.title} threads`}>
							{group.items.map((item) => <li>{item}</li>)}
						</ul>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section work-section work-final" aria-labelledby="work-final-title">
		<div class="page-container work-final__inner">
			<h2 id="work-final-title">For the full formal record, roles, publications, and patents:</h2>
			<div class="button-row work-final__actions">
				<a class="button primary" href={withBase('/cv/')}>View CV <span aria-hidden="true">-&gt;</span></a>
				<a class="button" href={withBase('/writing/')}>Browse writing <span aria-hidden="true">-&gt;</span></a>
				<a class="button" href={withBase('/contact/')}>Contact me <span aria-hidden="true">-&gt;</span></a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.work-hero {
		padding-block: clamp(3.5rem, 6vw, 5.5rem) clamp(2.5rem, 4.5vw, 3.8rem);
		border-bottom: 1px solid var(--color-border-soft);
		background: transparent;
	}

	.work-hero .page-container,
	.work-section .page-container {
		width: min(calc(100% - 32px), 1120px);
		max-width: 100%;
	}

	.work-hero,
	.work-section {
		overflow-x: clip;
	}

	.work-hero__inner,
	.work-hero__copy,
	.work-section__intro,
	.work-index-card__body,
	.work-index-card__header,
	.research-detail-grid,
	.research-detail-group,
	.work-thread-summary,
	.work-final__inner {
		display: grid;
	}

	.work-hero__inner {
		gap: 1rem;
	}

	.work-hero__copy {
		gap: clamp(0.85rem, 1.8vw, 1.15rem);
		max-width: 800px;
	}

	.work-hero h1 {
		max-width: 12ch;
		font-family: var(--font-display);
		font-size: clamp(4.8rem, 11vw, 8.8rem);
		font-weight: var(--type-hero-name-weight);
		line-height: var(--type-hero-name-line);
		letter-spacing: var(--type-hero-name-tracking);
		overflow-wrap: anywhere;
	}

	.work-hero p,
	.work-section__intro p,
	.work-index-card__overview {
		color: var(--color-body-text);
		font-size: var(--type-reading-size);
		line-height: var(--type-reading-line);
		overflow-wrap: anywhere;
	}

	.work-hero__lead {
		max-width: 760px;
		color: var(--color-text);
		font-size: clamp(1.16rem, 1.55vw, 1.45rem);
		font-weight: var(--type-hero-summary-weight);
		line-height: 1.42;
		letter-spacing: -0.018em;
	}

	.work-hero__note {
		margin-top: 0.25rem;
		color: var(--color-muted);
		font-size: var(--type-card-body-size);
	}

	.work-hero__note a,
	.work-note-link {
		color: var(--color-text);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		transition:
			color var(--motion-duration-fast-02) var(--motion-standard-productive),
			text-decoration-color var(--motion-duration-fast-02) var(--motion-standard-productive);
	}

	.work-hero__note a:hover,
	.work-hero__note a:focus-visible,
	.work-note-link:hover,
	.work-note-link:focus-visible {
		color: var(--color-link-hover);
	}

	.work-section {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.work-section--selected {
		padding-block-start: clamp(2.8rem, 5vw, 4.5rem);
	}

	.work-section__intro {
		gap: clamp(0.65rem, 1.5vw, 0.95rem);
		max-width: 800px;
		margin-bottom: clamp(1.45rem, 3vw, 2.35rem);
	}

	.work-section h2 {
		max-width: 14ch;
		font-size: var(--type-section-title-size);
		line-height: var(--type-section-title-line);
		letter-spacing: var(--type-section-title-tracking);
		overflow-wrap: anywhere;
	}

	.work-index-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(0.85rem, 1.8vw, 1rem);
	}

	.work-index-grid--research {
		gap: clamp(0.8rem, 1.6vw, 0.95rem);
	}

	.work-index-card {
		display: grid;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--color-card-border);
		border-radius: calc(var(--radius) * 0.75);
		background: transparent;
		padding: clamp(0.95rem, 1.7vw, 1.2rem);
	}

	.work-index-card--project {
		padding: 0;
	}

	.work-index-card--research {
		background: transparent;
	}

	.work-index-card__media {
		overflow: hidden;
		margin: 0;
		aspect-ratio: 3 / 2;
		background: var(--color-surface-soft);
	}

	.work-index-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.work-index-card__body {
		gap: 0.76rem;
		align-content: start;
		width: 100%;
		min-width: 0;
	}

	.work-index-card--project .work-index-card__body {
		padding: clamp(0.85rem, 1.55vw, 1.1rem);
	}

	.work-index-card__header {
		gap: 0.34rem;
	}

	.research-detail-group__label {
		margin: 0;
		color: var(--color-accent-text);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: 700;
		line-height: var(--type-meta-line);
		letter-spacing: var(--type-meta-tracking);
		text-transform: uppercase;
	}

	.work-index-card h3 {
		max-width: 26ch;
		color: var(--color-text);
		font-size: clamp(1.12rem, 1.45vw, 1.42rem);
		line-height: 1.08;
		letter-spacing: -0.035em;
		overflow-wrap: anywhere;
	}

	.work-index-card__institution {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		line-height: var(--type-meta-line);
		letter-spacing: var(--type-meta-tracking);
	}

	.work-index-card__overview {
		font-size: clamp(0.92rem, 1vw, 1rem);
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.work-label-list,
	.work-thread-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.34rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.work-label-list li,
	.work-thread-list li {
		margin: 0;
		border: 1px solid var(--color-border-soft);
		border-radius: calc(var(--radius) * 0.45);
		background: color-mix(in srgb, var(--color-surface-soft) 34%, transparent);
		padding: 0.19rem 0.38rem;
		color: var(--color-tag-text);
		font-family: var(--font-mono);
		font-size: clamp(0.64rem, 0.72vw, 0.72rem);
		font-weight: var(--type-chip-weight);
		line-height: 1.25;
		letter-spacing: 0;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.research-detail-grid {
		gap: 0.72rem;
		border-top: 1px solid var(--color-border-soft);
		padding-top: 0.72rem;
	}

	.research-detail-group {
		gap: 0.4rem;
	}

	.work-note-link {
		width: fit-content;
		font-size: var(--type-card-body-size);
		line-height: var(--type-card-body-line);
	}

	.work-section--threads {
		border-block: 1px solid var(--color-border-soft);
		background: color-mix(in srgb, var(--color-card-bg) 34%, transparent);
	}

	.work-thread-summary {
		gap: clamp(1.25rem, 4vw, 2.25rem);
		align-items: start;
	}

	.work-thread-group-list {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border-soft);
	}

	.work-thread-group {
		display: grid;
		gap: 0.65rem;
		margin: 0;
		border-bottom: 1px solid var(--color-border-soft);
		padding-block: 0.85rem;
	}

	.work-thread-group__title {
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: var(--type-meta-size);
		font-weight: 700;
		line-height: var(--type-meta-line);
		letter-spacing: var(--type-meta-tracking);
		text-transform: uppercase;
	}

	.work-thread-list li {
		color: var(--color-muted);
		background: transparent;
	}

	.work-final {
		border-top: 1px solid var(--color-border-soft);
		padding-block-end: clamp(4rem, 8vw, 6rem);
	}

	.work-final__inner {
		gap: 1.25rem;
		align-items: start;
	}

	.work-final h2 {
		max-width: 17ch;
		font-size: clamp(1.65rem, 3.6vw, 3.4rem);
		line-height: 1.05;
		letter-spacing: -0.055em;
	}

	.work-final__actions {
		align-items: start;
	}

	@media (min-width: 700px) {
		.work-index-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 860px) {
		.work-index-grid--research {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 980px) {
		.work-thread-summary,
		.work-final__inner {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
		}

		.work-thread-group {
			grid-template-columns: minmax(9.5rem, 0.32fr) minmax(0, 1fr);
			align-items: start;
			gap: 1rem;
		}

		.work-final__actions {
			justify-content: flex-end;
		}
	}

	@media (max-width: 640px) {
		.work-hero .page-container,
		.work-section .page-container {
			width: min(calc(100% - 48px), 1120px);
		}

		.work-hero h1 {
			font-size: clamp(3rem, 16vw, 4.2rem);
		}

		.work-hero__copy,
		.work-section__intro,
		.work-index-card__body {
			overflow-wrap: anywhere;
		}

		.work-index-card h3 {
			max-width: 21ch;
			font-size: clamp(1.04rem, 4.8vw, 1.22rem);
			word-break: break-word;
		}

		.work-label-list,
		.work-thread-list {
			gap: 0.3rem;
		}

		.work-label-list li,
		.work-thread-list li {
			max-width: 100%;
			padding: 0.18rem 0.34rem;
			font-size: 0.64rem;
		}

		.work-index-card__media {
			aspect-ratio: 3 / 2;
		}
	}
</style>
